---
import fs from "node:fs";
import path from "node:path";

import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import data from "../data/nfl/seahawks.json";

const t = data.team;
const pageTitle = `Team Stats (${data.season})`;

const fmtUpdatedPT = (iso) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));

const logoRelBase = "/images/nfl/teams";
const projectRoot = Astro.root ?? process.cwd();
const logoDiskBase = path.join(projectRoot, "public", "images", "nfl", "teams");

function logoFor(abbr) {
  const a = String(abbr || "").toUpperCase();
  for (const ext of [".svg", ".png", ".jpg"]) {
    const disk = path.join(logoDiskBase, `${a}${ext}`);
    if (fs.existsSync(disk)) return `${logoRelBase}/${a}${ext}`;
  }
  return "";
}
const seahawksLogo = logoFor(t?.abbreviation || "SEA");

// ------------------------------
// helpers
// ------------------------------
function n(v) {
  const x = Number(v);
  return Number.isFinite(x) ? x : 0;
}
function isNum(v) {
  const x = Number(v);
  return Number.isFinite(x);
}
function v(x) {
  return x === null || x === undefined || x === "" ? "-" : x;
}
function fixed1(x) {
  return x === null || x === undefined ? null : Number(x.toFixed(1));
}
function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

// ------------------------------
// 1) Try to locate a real team season stats object anywhere in JSON
// ------------------------------
function looksLikeTeamSeasonStats(o) {
  if (!o || typeof o !== "object" || Array.isArray(o)) return false;

  const keys = new Set(Object.keys(o));
  const hasGames = keys.has("games_played") || keys.has("gamesPlayed");
  const hasPoints = keys.has("total_points") || keys.has("points_for") || keys.has("pointsFor");
  const hasOffYds =
    keys.has("total_offensive_yards") ||
    keys.has("totalYards") ||
    keys.has("offense_yards") ||
    keys.has("offensive_yards");
  const hasPass = keys.has("passing_yards") || keys.has("pass_yards") || keys.has("passingYards");
  const hasRush = keys.has("rushing_yards") || keys.has("rush_yards") || keys.has("rushingYards");

  return [hasGames, hasPoints, hasOffYds, hasPass, hasRush].filter(Boolean).length >= 2;
}

function findFirstTeamSeasonStats(root) {
  const seen = new Set();
  const q = [root];
  let steps = 0;

  while (q.length && steps < 8000) {
    const cur = q.shift();
    steps++;

    if (!cur || typeof cur !== "object") continue;
    if (seen.has(cur)) continue;
    seen.add(cur);

    if (looksLikeTeamSeasonStats(cur)) return cur;

    if (Array.isArray(cur)) {
      for (const v of cur) q.push(v);
    } else {
      for (const v of Object.values(cur)) q.push(v);
    }
  }
  return null;
}

const sFound = findFirstTeamSeasonStats(data);

// ------------------------------
// 2) Build "raw games" list
// ------------------------------
const rawGames = Array.isArray(data?.games)
  ? data.games
  : Array.isArray(data?.gamesRegular) || Array.isArray(data?.gamesPostseason)
    ? [...(data.gamesRegular || []), ...(data.gamesPostseason || [])]
    : [];

function getScore(game, side /* "home" | "away" */) {
  // support multiple common score fields
  const candidates =
    side === "home"
      ? [game?.home_team_score, game?.homeScore, game?.home_points, game?.homePoints]
      : [game?.visitor_team_score, game?.away_team_score, game?.awayScore, game?.away_points, game?.awayPoints];

  for (const c of candidates) {
    const x = Number(c);
    if (Number.isFinite(x)) return x;
  }
  return null;
}

function seaScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = getScore(g, "home");
  const as = getScore(g, "away");
  if (hs === null || as === null) return null;

  if (home === "SEA") return hs;
  if (away === "SEA") return as;
  return null;
}

function oppScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = getScore(g, "home");
  const as = getScore(g, "away");
  if (hs === null || as === null) return null;

  if (home === "SEA") return as;
  if (away === "SEA") return hs;
  return null;
}

const scoredGames = rawGames
  .map((g) => ({ g, sea: seaScoreFromGame(g), opp: oppScoreFromGame(g) }))
  .filter((x) => x.sea !== null && x.opp !== null);

const games_played_fallback = scoredGames.length;

// points
const total_points_fallback = scoredGames.reduce((acc, x) => acc + n(x.sea), 0);
const points_against_fallback = scoredGames.reduce((acc, x) => acc + n(x.opp), 0);

const total_points_per_game_fallback =
  games_played_fallback > 0 ? total_points_fallback / games_played_fallback : null;

// ------------------------------
// 3) Yards from playerSeasonStats (if present)
// ------------------------------
const playerStats = Array.isArray(data?.playerSeasonStats) ? data.playerSeasonStats : [];

const passing_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.passing_yards ?? r?.passingYards), 0);
const rushing_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.rushing_yards ?? r?.rushingYards), 0);
const receiving_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.receiving_yards ?? r?.receivingYards), 0);

// Some feeds double-count offense if you sum passing + receiving; keep “total offense” as pass + rush
const total_offensive_yards_fallback = passing_yards_fallback + rushing_yards_fallback;

const passing_yards_per_game_fallback =
  games_played_fallback > 0 ? passing_yards_fallback / games_played_fallback : null;
const rushing_yards_per_game_fallback =
  games_played_fallback > 0 ? rushing_yards_fallback / games_played_fallback : null;
const total_offensive_yards_per_game_fallback =
  games_played_fallback > 0 ? total_offensive_yards_fallback / games_played_fallback : null;

// ------------------------------
// 4) Turnovers (best-effort)
// ------------------------------
// Team-level fields if present:
function pickAny(obj, keys) {
  for (const k of keys) {
    if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
  }
  return null;
}

const takeaways_from_found =
  sFound
    ? pickAny(sFound, ["misc_total_takeaways", "takeaways", "total_takeaways", "def_takeaways"])
    : null;

const giveaways_from_found =
  sFound
    ? pickAny(sFound, ["misc_total_giveaways", "giveaways", "total_giveaways", "off_giveaways"])
    : null;

const margin_from_found =
  sFound
    ? pickAny(sFound, ["misc_turnover_margin", "turnover_margin", "turnoverMargin"])
    : null;

// Player-derived takeaways: interceptions + fumble recoveries if available
const ints_thrown = playerStats.reduce((acc, r) => acc + n(r?.passing_interceptions ?? r?.interceptions), 0);
const fumbles_lost = playerStats.reduce((acc, r) => acc + n(r?.fumbles_lost ?? r?.fumblesLost), 0);

// We can’t reliably compute takeaways from player stats without defensive stats,
// so only compute giveaways from player stats.
const giveaways_fallback = (ints_thrown || fumbles_lost) ? (ints_thrown + fumbles_lost) : null;

// ------------------------------
// 5) Final stats object to render
// ------------------------------
// Prefer real stats; else computed.
const s =
  sFound ??
  (games_played_fallback > 0 || passing_yards_fallback > 0 || rushing_yards_fallback > 0 || total_points_fallback > 0
    ? {
        __computed: true,
        games_played: games_played_fallback,

        total_points: total_points_fallback || null,
        total_points_per_game: fixed1(total_points_per_game_fallback),

        // extra (not displayed unless you add it)
        points_against: points_against_fallback || null,

        passing_yards: passing_yards_fallback || null,
        passing_yards_per_game: fixed1(passing_yards_per_game_fallback),

        rushing_yards: rushing_yards_fallback || null,
        rushing_yards_per_game: fixed1(rushing_yards_per_game_fallback),

        receiving_yards: receiving_yards_fallback || null,

        total_offensive_yards: total_offensive_yards_fallback || null,
        total_offensive_yards_per_game: fixed1(total_offensive_yards_per_game_fallback),

        misc_total_takeaways: takeaways_from_found ?? null,
        misc_total_giveaways: giveaways_from_found ?? giveaways_fallback,
        misc_turnover_margin:
          isNum(margin_from_found) ? Number(margin_from_found)
          : (isNum(takeaways_from_found) && isNum(giveaways_from_found))
            ? Number(takeaways_from_found) - Number(giveaways_from_found)
            : null,
      }
    : null);

// optional: if real stats exist, still normalize key variants for rendering
function read(obj, variants) {
  for (const k of variants) {
    if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
  }
  return null;
}

const gamesPlayed = read(s, ["games_played", "gamesPlayed"]);
const totalPoints = read(s, ["total_points", "points_for", "pointsFor"]);
const totalPointsPerGame = read(s, ["total_points_per_game", "points_per_game", "pointsPerGame"]);
const totalOffYds = read(s, ["total_offensive_yards", "totalYards", "offensive_yards", "offense_yards"]);
const totalOffYdsPerGame = read(s, ["total_offensive_yards_per_game", "offense_yards_per_game", "totalYardsPerGame"]);

const passYds = read(s, ["passing_yards", "pass_yards", "passingYards"]);
const passYdsPerGame = read(s, ["passing_yards_per_game", "pass_yards_per_game", "passingYardsPerGame"]);

const rushYds = read(s, ["rushing_yards", "rush_yards", "rushingYards"]);
const rushYdsPerGame = read(s, ["rushing_yards_per_game", "rush_yards_per_game", "rushingYardsPerGame"]);

const recYds = read(s, ["receiving_yards", "receivingYards"]);

const takeaways = read(s, ["misc_total_takeaways", "takeaways", "total_takeaways"]);
const giveaways = read(s, ["misc_total_giveaways", "giveaways", "total_giveaways"]);
const margin = read(s, ["misc_turnover_margin", "turnover_margin", "turnoverMargin"]);
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Season totals and splits" activePath="/team">
  <div class="sfz-team-header">
    {seahawksLogo ? (
      <img class="sfz-team-logo" src={seahawksLogo} alt="SEA logo" loading="lazy" />
    ) : (
      <div class="sfz-team-logo sfz-team-logo-fallback" aria-hidden="true">SEA</div>
    )}

    <div class="sfz-team-text">
      <h3 class="sfz-team-name">{t?.full_name ?? "Seattle Seahawks"}</h3>
      <div class="sfz-team-meta">
        <span>{t?.conference ?? "NFC"}</span>
        <span class="sfz-dot">•</span>
        <span>{t?.division ?? "West"}</span>
      </div>
      <div class="sfz-updated">Updated: {fmtUpdatedPT(data.updatedAt)} PT</div>
    </div>
  </div>

  {!s ? (
    <div class="sfz-empty">
      <strong>No team season stats found.</strong>
      <div class="sfz-empty-sub">
        Your JSON doesn’t have team aggregates, and there weren’t enough values to compute them.
      </div>
    </div>
  ) : (
    <div class="sfz-cards">
      {s.__computed && (
        <div class="sfz-computed">
          <strong>Computed totals</strong>
          <div class="sfz-computed-sub">
            Some totals were computed from your games + playerSeasonStats because the feed didn’t include a teamSeasonStats block.
          </div>
        </div>
      )}

      <section class="sfz-card">
        <div class="sfz-card-title">Overview</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Games played</div>
            <div class="sfz-v">{v(gamesPlayed)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total points</div>
            <div class="sfz-v">{v(totalPoints)}</div>
            <div class="sfz-note">{v(totalPointsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total offense</div>
            <div class="sfz-v">{v(totalOffYds)}</div>
            <div class="sfz-note">{v(totalOffYdsPerGame)} per game</div>
          </div>
        </div>
      </section>

      <section class="sfz-card">
        <div class="sfz-card-title">Offense</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Passing yards</div>
            <div class="sfz-v">{v(passYds)}</div>
            <div class="sfz-note">{v(passYdsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Rushing yards</div>
            <div class="sfz-v">{v(rushYds)}</div>
            <div class="sfz-note">{v(rushYdsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Receiving yards</div>
            <div class="sfz-v">{v(recYds)}</div>
          </div>
        </div>
      </section>

      <section class="sfz-card">
        <div class="sfz-card-title">Turnovers</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Takeaways</div>
            <div class="sfz-v">{v(takeaways)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Giveaways</div>
            <div class="sfz-v">{v(giveaways)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Turnover margin</div>
            <div class="sfz-v">{typeof margin === "number" ? margin : "-"}</div>
          </div>
        </div>
      </section>
    </div>
  )}

  <style>
    /* overflow protection */
    .sfz-team-header,
    .sfz-team-text,
    .sfz-cards,
    .sfz-card,
    .sfz-stat-grid,
    .sfz-stat {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .sfz-team-name,
    .sfz-team-meta,
    .sfz-updated,
    .sfz-card-title,
    .sfz-k,
    .sfz-v,
    .sfz-note,
    .sfz-empty,
    .sfz-empty-sub,
    .sfz-computed,
    .sfz-computed-sub {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .sfz-team-header {
      display: flex;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1.1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.12);
    }

    .sfz-team-logo {
      width: 64px;
      height: 64px;
      object-fit: contain;
      flex: 0 0 auto;
    }

    .sfz-team-logo-fallback {
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(0, 34, 68, 0.06);
      border: 1px solid rgba(0, 34, 68, 0.10);
      color: rgba(0, 34, 68, 0.85);
      font-weight: 900;
      letter-spacing: 0.4px;
    }

    .sfz-team-text { min-width: 0; }

    .sfz-team-name {
      margin: 0;
      color: var(--navy);
      font-size: 1.45rem;
      font-weight: 900;
      line-height: 1.2;
    }

    .sfz-team-meta {
      margin-top: 0.25rem;
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
      display: flex;
      gap: 0.35rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .sfz-dot { opacity: 0.7; }

    .sfz-updated {
      margin-top: 0.35rem;
      color: rgba(15, 23, 32, 0.6);
      font-weight: 700;
      font-size: 0.92rem;
    }

    .sfz-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .sfz-computed {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: rgba(165, 172, 175, 0.18);
      padding: 0.85rem 0.95rem;
      color: rgba(15, 23, 32, 0.85);
    }

    .sfz-computed-sub {
      margin-top: 0.35rem;
      color: rgba(15, 23, 32, 0.7);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .sfz-card {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      padding: 1rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      overflow: hidden;
    }

    .sfz-card-title {
      font-weight: 900;
      color: var(--navy);
      margin-bottom: 0.75rem;
      font-size: 1.05rem;
    }

    .sfz-stat-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .sfz-stat {
      border-radius: 14px;
      border: 1px solid rgba(0, 34, 68, 0.12);
      background: rgba(0, 34, 68, 0.03);
      padding: 0.75rem 0.85rem;
    }

    .sfz-k {
      color: rgba(0, 34, 68, 0.7);
      font-weight: 900;
      font-size: 0.9rem;
    }

    .sfz-v {
      margin-top: 0.25rem;
      color: var(--navy);
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: 0.2px;
    }

    .sfz-note {
      margin-top: 0.2rem;
      color: rgba(15, 23, 32, 0.6);
      font-weight: 700;
      font-size: 0.9rem;
    }

    .sfz-empty {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: rgba(165, 172, 175, 0.18);
      padding: 0.95rem;
      color: rgba(15, 23, 32, 0.85);
    }

    .sfz-empty-sub {
      margin-top: 0.35rem;
      color: rgba(15, 23, 32, 0.7);
      font-weight: 700;
      font-size: 0.95rem;
    }

    @media (max-width: 980px) {
      .sfz-stat-grid { grid-template-columns: 1fr; }
      .sfz-team-logo { width: 56px; height: 56px; }
    }
  </style>
</SeahawksLayout>



