---
import fs from "node:fs";
import path from "node:path";

import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import SeasonContextView from "../components/SeasonContext.astro";
import { getAvailableSeasonContexts, getSeasonContext, unavailableMessage } from "../lib/season-context";
import data from "../data/nfl/seahawks.json";

const t = data.team;
const seasonContext = getSeasonContext(data, "regular season");
const seasonOptions = getAvailableSeasonContexts(data, "regular season");
const pageTitle = `Team Stats (${seasonContext.label})`;

const logoRelBase = "/images/nfl/teams";
const projectRoot = Astro.root ?? process.cwd();
const logoDiskBase = path.join(projectRoot, "public", "images", "nfl", "teams");

function logoFor(abbr) {
  const a = String(abbr || "").toUpperCase();
  for (const ext of [".svg", ".png", ".jpg"]) {
    const disk = path.join(logoDiskBase, `${a}${ext}`);
    if (fs.existsSync(disk)) return `${logoRelBase}/${a}${ext}`;
  }
  return "";
}
const seahawksLogo = logoFor(t?.abbreviation || "SEA");

// ------------------------------
// helpers
// ------------------------------
function n(v) {
  const x = Number(v);
  return Number.isFinite(x) ? x : 0;
}
function isNum(v) {
  if (v === null || v === undefined || v === "") return false;
  const x = Number(v);
  return Number.isFinite(x);
}
function v(x) {
  return x === null || x === undefined || x === "" ? "—" : x;
}
function fixed1(x) {
  return x === null || x === undefined ? null : Number(x.toFixed(1));
}
function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

// Walk any object and collect numeric values whose KEY matches one of the regexes.
// Optional min/max to avoid grabbing IDs.
function findNumbersByKey(root, regexes, { min = -Infinity, max = Infinity } = {}) {
  const out = [];
  const seen = new Set();
  const q = [{ node: root, path: "" }];

  while (q.length) {
    const { node } = q.shift();
    if (!node || typeof node !== "object") continue;
    if (seen.has(node)) continue;
    seen.add(node);

    if (Array.isArray(node)) {
      for (const child of node) q.push({ node: child });
      continue;
    }

    for (const [k, val] of Object.entries(node)) {
      if (val && typeof val === "object") q.push({ node: val });

      if (typeof val === "number" && Number.isFinite(val)) {
        if (val < min || val > max) continue;
        if (regexes.some((re) => re.test(k))) out.push(val);
      }
    }
  }

  return out;
}

// pick first non-null among candidates
function pickAny(obj, keys) {
  for (const k of keys) {
    if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
  }
  return null;
}

// ------------------------------
// 1) Find a team season stats object anywhere (best effort)
// ------------------------------
function looksLikeTeamSeasonStats(o) {
  if (!o || typeof o !== "object" || Array.isArray(o)) return false;

  const keys = new Set(Object.keys(o));
  const hasGames = keys.has("games_played") || keys.has("gamesPlayed");
  const hasPoints = keys.has("total_points") || keys.has("points_for") || keys.has("pointsFor");
  const hasOffYds =
    keys.has("total_offensive_yards") ||
    keys.has("totalYards") ||
    keys.has("offense_yards") ||
    keys.has("offensive_yards");
  const hasPass = keys.has("passing_yards") || keys.has("pass_yards") || keys.has("passingYards");
  const hasRush = keys.has("rushing_yards") || keys.has("rush_yards") || keys.has("rushingYards");

  return [hasGames, hasPoints, hasOffYds, hasPass, hasRush].filter(Boolean).length >= 2;
}

function findFirstTeamSeasonStats(root) {
  const seen = new Set();
  const q = [root];
  let steps = 0;

  while (q.length && steps < 8000) {
    const cur = q.shift();
    steps++;

    if (!cur || typeof cur !== "object") continue;
    if (seen.has(cur)) continue;
    seen.add(cur);

    if (looksLikeTeamSeasonStats(cur)) return cur;

    if (Array.isArray(cur)) {
      for (const v of cur) q.push(v);
    } else {
      for (const v of Object.values(cur)) q.push(v);
    }
  }
  return null;
}

const sFound = findFirstTeamSeasonStats(data);

// ------------------------------
// 2) Raw games list
// ------------------------------
const rawGames = Array.isArray(data?.gamesRegular)
  ? data.gamesRegular
  : Array.isArray(data?.games)
    ? data.games.filter((game) => !game?.postseason)
    : [];

// Get scores robustly:
// - first try common top-level keys
// - if not present, do deep-key sniffing for score/points under a reasonable range (0..80)
function scoreFromGameSide(game, side /* "home"|"away" */) {
  const direct =
    side === "home"
      ? [game?.home_team_score, game?.homeScore, game?.home_points, game?.homePoints]
      : [game?.visitor_team_score, game?.away_team_score, game?.awayScore, game?.away_points, game?.awayPoints];

  for (const c of direct) {
    if (c === null || c === undefined || c === "") continue;
    const x = Number(c);
    if (Number.isFinite(x)) return x;
  }

  const regexes =
    side === "home"
      ? [/^home.*(score|points)$/i, /(home|host).*(score|points)/i]
      : [/^(away|visitor).*(score|points)$/i, /(away|visitor).*(score|points)/i];

  const hits = findNumbersByKey(game, regexes, { min: 0, max: 80 });
  return hits.length ? hits[0] : null;
}

function seaScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = scoreFromGameSide(g, "home");
  const as = scoreFromGameSide(g, "away");
  if (hs === null || as === null) return null;

  if (home === "SEA") return hs;
  if (away === "SEA") return as;
  return null;
}

function oppScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = scoreFromGameSide(g, "home");
  const as = scoreFromGameSide(g, "away");
  if (hs === null || as === null) return null;

  if (home === "SEA") return as;
  if (away === "SEA") return hs;
  return null;
}

const scoredGames = rawGames
  .map((g) => ({ g, sea: seaScoreFromGame(g), opp: oppScoreFromGame(g) }))
  .filter((x) => x.sea !== null && x.opp !== null);

const games_played_from_scores = scoredGames.length;

const total_points_from_scores = scoredGames.reduce((acc, x) => acc + n(x.sea), 0);
const total_points_per_game_from_scores =
  games_played_from_scores > 0 ? total_points_from_scores / games_played_from_scores : null;

// ------------------------------
// 3) Player season stats yards (robust)
// ------------------------------
const playerStats = Array.isArray(data?.playerSeasonStats) ? data.playerSeasonStats : [];

function yardsFromPlayerStat(r, kind /* "pass"|"rush"|"rec" */) {
  // direct common keys
  const direct =
    kind === "pass"
      ? [r?.passing_yards, r?.passingYards, r?.pass_yards, r?.passYds]
      : kind === "rush"
        ? [r?.rushing_yards, r?.rushingYards, r?.rush_yards, r?.rushYds]
        : [r?.receiving_yards, r?.receivingYards, r?.rec_yards, r?.recYds];

  for (const c of direct) {
    if (c === null || c === undefined || c === "") continue;
    const x = Number(c);
    if (Number.isFinite(x)) return x;
  }

  // deep sniff for keys containing "passing yards" etc, within a safe season range
  const regexes =
    kind === "pass"
      ? [/(pass|passing).*(yd|yard)/i]
      : kind === "rush"
        ? [/(rush|rushing).*(yd|yard)/i]
        : [/(rec|receiv).*(yd|yard)/i];

  const hits = findNumbersByKey(r, regexes, { min: 0, max: 9000 });
  return hits.length ? hits[0] : null;
}

function sumAvailable(values) {
  const available = values.filter((value) => typeof value === "number" && Number.isFinite(value));
  return available.length ? available.reduce((sum, value) => sum + value, 0) : null;
}
const passing_yards_calc = sumAvailable(playerStats.map((r) => yardsFromPlayerStat(r, "pass")));
const rushing_yards_calc = sumAvailable(playerStats.map((r) => yardsFromPlayerStat(r, "rush")));
const receiving_yards_calc = sumAvailable(playerStats.map((r) => yardsFromPlayerStat(r, "rec")));

const total_offensive_yards_calc = passing_yards_calc === null || rushing_yards_calc === null ? null : passing_yards_calc + rushing_yards_calc;

// games played fallback:
// Prefer sFound.games_played, else use scored games count, else use max player games_played if present.
const games_played_from_found = sFound ? pickAny(sFound, ["games_played", "gamesPlayed"]) : null;
const games_played_from_players = (() => {
  const vals = playerStats
    .map((r) => Number(pickAny(r, ["games_played", "gamesPlayed", "gp"])))
    .filter((x) => Number.isFinite(x));
  return vals.length ? Math.max(...vals) : null;
})();

const games_played =
  (isNum(games_played_from_found) ? Number(games_played_from_found) : null) ??
  (games_played_from_scores > 0 ? games_played_from_scores : null) ??
  (isNum(games_played_from_players) ? Number(games_played_from_players) : null);

// per-game derived only if we have games_played
const pass_per_game = games_played && passing_yards_calc !== null ? passing_yards_calc / games_played : null;
const rush_per_game = games_played && rushing_yards_calc !== null ? rushing_yards_calc / games_played : null;
const off_per_game = games_played && total_offensive_yards_calc !== null ? total_offensive_yards_calc / games_played : null;

// ------------------------------
// 4) Build computed + merge with found
// ------------------------------
const computed = {
  __computed: true,
  games_played: games_played ?? null,

  total_points: games_played_from_scores > 0 ? total_points_from_scores : null,
  total_points_per_game: fixed1(total_points_per_game_from_scores),

  passing_yards: passing_yards_calc,
  passing_yards_per_game: fixed1(pass_per_game),

  rushing_yards: rushing_yards_calc,
  rushing_yards_per_game: fixed1(rush_per_game),

  receiving_yards: receiving_yards_calc,

  total_offensive_yards: total_offensive_yards_calc,
  total_offensive_yards_per_game: fixed1(off_per_game),
};

// Merge rule: if found has a real value, keep it; otherwise fill from computed.
function mergeStats(found, calc) {
  if (!found && !calc) return null;
  const out = { ...(found || {}) };

  for (const [k, val] of Object.entries(calc || {})) {
    const existing = out[k];
    const hasExisting =
      existing !== null && existing !== undefined && existing !== "" && !(typeof existing === "number" && !Number.isFinite(existing));

    if (!hasExisting && val !== null && val !== undefined && val !== "") {
      out[k] = val;
    }
  }

  // Only mark __computed if we actually used calc values
  out.__computed = Boolean(calc && Object.keys(calc).some((k) => k !== "__computed" && (out[k] === calc[k]) && calc[k] != null));
  return out;
}

const s = mergeStats(sFound, computed);

// Normalize read variants for rendering
function read(obj, variants) {
  for (const k of variants) {
    if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k];
  }
  return null;
}

const gamesPlayed = read(s, ["games_played", "gamesPlayed"]);
const totalPoints = read(s, ["total_points", "points_for", "pointsFor"]);
const totalPointsPerGame = read(s, ["total_points_per_game", "points_per_game", "pointsPerGame"]);
const totalOffYds = read(s, ["total_offensive_yards", "totalYards", "offensive_yards", "offense_yards"]);
const totalOffYdsPerGame = read(s, ["total_offensive_yards_per_game", "offense_yards_per_game", "totalYardsPerGame"]);

const passYds = read(s, ["passing_yards", "pass_yards", "passingYards"]);
const passYdsPerGame = read(s, ["passing_yards_per_game", "pass_yards_per_game", "passingYardsPerGame"]);

const rushYds = read(s, ["rushing_yards", "rush_yards", "rushingYards"]);
const rushYdsPerGame = read(s, ["rushing_yards_per_game", "rush_yards_per_game", "rushingYardsPerGame"]);

const recYds = read(s, ["receiving_yards", "receivingYards"]);
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Season totals and splits" activePath="/team">
  <SeasonContextView context={seasonContext} options={seasonOptions} prefix="Data through" />
  <div class="sfz-team-header">
    {seahawksLogo ? (
      <img class="sfz-team-logo" src={seahawksLogo} alt="SEA logo" loading="lazy" />
    ) : (
      <div class="sfz-team-logo sfz-team-logo-fallback" aria-hidden="true">SEA</div>
    )}

    <div class="sfz-team-text">
      <h2 class="sfz-team-name">{t?.full_name ?? "Seattle Seahawks"}</h2>
      <div class="sfz-team-meta">
        <span>{t?.conference ?? "NFC"}</span>
        <span class="sfz-dot">•</span>
        <span>{t?.division ?? "West"}</span>
      </div>
    </div>
  </div>

  {!seasonContext.hasStatistics || seasonContext.seasonStatus === "upcoming" || !s ? (
    <div class="sfz-empty">
      <strong>No team season stats found.</strong>
      <div class="sfz-empty-sub">{unavailableMessage(seasonContext)}</div>
    </div>
  ) : (
    <div class="sfz-cards">
      {s.__computed && (
        <div class="sfz-computed">
          <strong>Computed totals</strong>
          <div class="sfz-computed-sub">
            Computed from available {seasonContext.label} source values.
          </div>
        </div>
      )}

      <section class="sfz-card">
        <div class="sfz-card-title">Overview</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Games played</div>
            <div class="sfz-v">{v(gamesPlayed)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total points</div>
            <div class="sfz-v">{v(totalPoints)}</div>
            <div class="sfz-note">{v(totalPointsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total offense</div>
            <div class="sfz-v">{v(totalOffYds)}</div>
            <div class="sfz-note">{v(totalOffYdsPerGame)} per game</div>
          </div>
        </div>
      </section>

      <section class="sfz-card">
        <div class="sfz-card-title">Offense</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Passing yards</div>
            <div class="sfz-v">{v(passYds)}</div>
            <div class="sfz-note">{v(passYdsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Rushing yards</div>
            <div class="sfz-v">{v(rushYds)}</div>
            <div class="sfz-note">{v(rushYdsPerGame)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Receiving yards</div>
            <div class="sfz-v">{v(recYds)}</div>
          </div>
        </div>
      </section>
    </div>
  )}

  <style>
    .sfz-team-header,
    .sfz-team-text,
    .sfz-cards,
    .sfz-card,
    .sfz-stat-grid,
    .sfz-stat { min-width:0; max-width:100%; box-sizing:border-box; }

    .sfz-team-name,
    .sfz-team-meta,
    .sfz-updated,
    .sfz-card-title,
    .sfz-k,
    .sfz-v,
    .sfz-note,
    .sfz-empty,
    .sfz-empty-sub,
    .sfz-computed,
    .sfz-computed-sub { overflow-wrap:anywhere; word-break:break-word; }

    .sfz-team-header{
      display:flex; gap:1rem; align-items:center;
      margin-bottom:1.1rem; padding-bottom:1rem;
      border-bottom:1px solid rgba(0,34,68,0.12);
    }

    .sfz-team-logo{ width:64px; height:64px; object-fit:contain; flex:0 0 auto; }
    .sfz-team-logo-fallback{
      display:grid; place-items:center; border-radius:14px;
      background:rgba(0,34,68,0.06); border:1px solid rgba(0,34,68,0.10);
      color:rgba(0,34,68,0.85); font-weight:900; letter-spacing:0.4px;
      width:64px; height:64px;
    }

    .sfz-team-name{ margin:0; color:var(--navy); font-size:1.45rem; font-weight:900; line-height:1.2; }
    .sfz-team-meta{
      margin-top:.25rem; color:rgba(15,23,32,0.65);
      font-weight:800; font-size:.95rem; display:flex; gap:.35rem; align-items:center; flex-wrap:wrap;
    }
    .sfz-dot{ opacity:.7; }
    .sfz-updated{ margin-top:.35rem; color:rgba(15,23,32,0.6); font-weight:700; font-size:.92rem; }

    .sfz-cards{ display:grid; grid-template-columns:1fr; gap:.9rem; }

    .sfz-computed{
      border-radius:16px; border:1px solid rgba(0,34,68,0.14);
      background:rgba(165,172,175,0.18);
      padding:.85rem .95rem; color:rgba(15,23,32,0.85);
    }
    .sfz-computed-sub{ margin-top:.35rem; color:rgba(15,23,32,0.7); font-weight:700; font-size:.95rem; }

    .sfz-card{
      border-radius:16px; border:1px solid rgba(0,34,68,0.14);
      background:#fff; padding:1rem;
      box-shadow:0 10px 24px rgba(0,0,0,0.06);
      overflow:hidden;
    }

    .sfz-card-title{ font-weight:900; color:var(--navy); margin-bottom:.75rem; font-size:1.05rem; }

    .sfz-stat-grid{ display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:.85rem; }
    .sfz-stat{
      border-radius:14px; border:1px solid rgba(0,34,68,0.12);
      background:rgba(0,34,68,0.03);
      padding:.75rem .85rem;
    }
    .sfz-k{ color:rgba(0,34,68,0.7); font-weight:900; font-size:.9rem; }
    .sfz-v{ margin-top:.25rem; color:var(--navy); font-weight:900; font-size:1.25rem; letter-spacing:.2px; }
    .sfz-note{ margin-top:.2rem; color:rgba(15,23,32,0.6); font-weight:700; font-size:.9rem; }

    .sfz-empty{
      border-radius:16px; border:1px solid rgba(0,34,68,0.14);
      background:rgba(165,172,175,0.18);
      padding:.95rem; color:rgba(15,23,32,0.85);
    }
    .sfz-empty-sub{ margin-top:.35rem; color:rgba(15,23,32,0.7); font-weight:700; font-size:.95rem; }

    @media (max-width:980px){
      .sfz-stat-grid{ grid-template-columns:1fr; }
      .sfz-team-logo, .sfz-team-logo-fallback{ width:56px; height:56px; }
    }
  </style>
</SeahawksLayout>
