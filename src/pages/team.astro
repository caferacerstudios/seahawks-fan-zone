---
import fs from "node:fs";
import path from "node:path";

import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import data from "../data/nfl/seahawks.json";

const t = data.team;

const pageTitle = `Team Stats (${data.season})`;

const fmtUpdatedPT = (iso) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));

const logoRelBase = "/images/nfl/teams";

// ✅ Always resolve from Astro project root
const projectRoot = Astro.root ?? process.cwd();
const logoDiskBase = path.join(projectRoot, "public", "images", "nfl", "teams");

function logoFor(abbr) {
  const a = String(abbr || "").toUpperCase();
  for (const ext of [".svg", ".png", ".jpg"]) {
    const disk = path.join(logoDiskBase, `${a}${ext}`);
    if (fs.existsSync(disk)) return `${logoRelBase}/${a}${ext}`;
  }
  return "";
}

const seahawksLogo = logoFor(t?.abbreviation || "SEA");

// ------------------------------
// 1) Try to locate team stats in JSON (no guessing keys)
// ------------------------------
function looksLikeTeamSeasonStats(o) {
  if (!o || typeof o !== "object" || Array.isArray(o)) return false;

  // Pick a few “signature” fields
  const hasGames = "games_played" in o || "gamesPlayed" in o;
  const hasPoints = "total_points" in o || "points_for" in o || "pointsFor" in o;
  const hasPass = "passing_yards" in o || "pass_yards" in o || "passingYards" in o;
  const hasRush = "rushing_yards" in o || "rush_yards" in o || "rushingYards" in o;

  // Needs at least 2 of these to count
  const score = [hasGames, hasPoints, hasPass, hasRush].filter(Boolean).length;
  return score >= 2;
}

function findFirstTeamSeasonStats(root) {
  const seen = new Set();
  const q = [root];
  let steps = 0;

  while (q.length && steps < 5000) {
    const cur = q.shift();
    steps++;

    if (!cur || typeof cur !== "object") continue;
    if (seen.has(cur)) continue;
    seen.add(cur);

    if (looksLikeTeamSeasonStats(cur)) return cur;

    if (Array.isArray(cur)) {
      for (const v of cur) q.push(v);
    } else {
      for (const v of Object.values(cur)) q.push(v);
    }
  }
  return null;
}

const sFound = findFirstTeamSeasonStats(data);

// ------------------------------
// 2) If missing, compute fallback totals from available data
// ------------------------------
function n(v) {
  return typeof v === "number" && Number.isFinite(v) ? v : 0;
}

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function seaScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = Number(g?.home_team_score);
  const as = Number(g?.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  if (home === "SEA") return hs;
  if (away === "SEA") return as;
  return null;
}

function oppScoreFromGame(g) {
  const home = teamAbbr(g?.home_team);
  const away = teamAbbr(g?.visitor_team);
  const hs = Number(g?.home_team_score);
  const as = Number(g?.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  if (home === "SEA") return as;
  if (away === "SEA") return hs;
  return null;
}

const rawGames = Array.isArray(data?.games)
  ? data.games
  : Array.isArray(data?.gamesRegular) || Array.isArray(data?.gamesPostseason)
    ? [...(data.gamesRegular || []), ...(data.gamesPostseason || [])]
    : [];

const scoredGames = rawGames
  .map((g) => ({ g, sea: seaScoreFromGame(g), opp: oppScoreFromGame(g) }))
  .filter((x) => Number.isFinite(x.sea) && Number.isFinite(x.opp));

const games_played_fallback = scoredGames.length;

const total_points_fallback = scoredGames.reduce((acc, x) => acc + Number(x.sea), 0);
const total_points_per_game_fallback =
  games_played_fallback > 0 ? (total_points_fallback / games_played_fallback) : null;

// Yard totals fallback from player season stats (sum per-player totals)
const playerStats = Array.isArray(data?.playerSeasonStats) ? data.playerSeasonStats : [];
const passing_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.passing_yards), 0);
const rushing_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.rushing_yards), 0);
const receiving_yards_fallback = playerStats.reduce((acc, r) => acc + n(r?.receiving_yards), 0);

const total_offensive_yards_fallback = passing_yards_fallback + rushing_yards_fallback;

const passing_yards_per_game_fallback =
  games_played_fallback > 0 ? (passing_yards_fallback / games_played_fallback) : null;
const rushing_yards_per_game_fallback =
  games_played_fallback > 0 ? (rushing_yards_fallback / games_played_fallback) : null;
const total_offensive_yards_per_game_fallback =
  games_played_fallback > 0 ? (total_offensive_yards_fallback / games_played_fallback) : null;

// If we found real stats, use them. Otherwise use computed fallback if it’s meaningful.
const s =
  sFound ??
  (games_played_fallback > 0 || passing_yards_fallback > 0 || rushing_yards_fallback > 0
    ? {
        __computed: true,
        games_played: games_played_fallback,
        total_points: total_points_fallback,
        total_points_per_game:
          total_points_per_game_fallback === null ? null : Number(total_points_per_game_fallback.toFixed(1)),
        passing_yards: passing_yards_fallback,
        passing_yards_per_game:
          passing_yards_per_game_fallback === null ? null : Number(passing_yards_per_game_fallback.toFixed(1)),
        rushing_yards: rushing_yards_fallback,
        rushing_yards_per_game:
          rushing_yards_per_game_fallback === null ? null : Number(rushing_yards_per_game_fallback.toFixed(1)),
        receiving_yards: receiving_yards_fallback,
        total_offensive_yards: total_offensive_yards_fallback,
        total_offensive_yards_per_game:
          total_offensive_yards_per_game_fallback === null ? null : Number(total_offensive_yards_per_game_fallback.toFixed(1)),
      }
    : null);

function v(x) {
  return x === null || x === undefined || x === "" ? "-" : x;
}
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Season totals and splits" activePath="/team">
  <div class="sfz-team-header">
    {seahawksLogo ? (
      <img class="sfz-team-logo" src={seahawksLogo} alt="SEA logo" loading="lazy" />
    ) : (
      <div class="sfz-team-logo sfz-team-logo-fallback" aria-hidden="true">SEA</div>
    )}

    <div class="sfz-team-text">
      <h3 class="sfz-team-name">{t?.full_name ?? "Seattle Seahawks"}</h3>
      <div class="sfz-team-meta">
        <span>{t?.conference ?? "NFC"}</span>
        <span class="sfz-dot">•</span>
        <span>{t?.division ?? "West"}</span>
      </div>
      <div class="sfz-updated">Updated: {fmtUpdatedPT(data.updatedAt)} PT</div>
    </div>
  </div>

  {!s ? (
    <div class="sfz-empty">
      <strong>No team season stats found.</strong>
      <div class="sfz-empty-sub">
        Your current JSON file doesn’t contain team aggregates (and there weren’t enough games/player stats to compute them).
      </div>
    </div>
  ) : (
    <div class="sfz-cards">
      {s.__computed && (
        <div class="sfz-empty" style="margin-bottom:.9rem;">
          <strong>Computed totals</strong>
          <div class="sfz-empty-sub">
            Team totals were computed from games + player season stats because the JSON didn’t include a teamSeasonStats block.
          </div>
        </div>
      )}

      <section class="sfz-card">
        <div class="sfz-card-title">Overview</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Games played</div>
            <div class="sfz-v">{v(s.games_played)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total points</div>
            <div class="sfz-v">{v(s.total_points)}</div>
            <div class="sfz-note">{v(s.total_points_per_game)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Total offense</div>
            <div class="sfz-v">{v(s.total_offensive_yards)}</div>
            <div class="sfz-note">{v(s.total_offensive_yards_per_game)} per game</div>
          </div>
        </div>
      </section>

      <section class="sfz-card">
        <div class="sfz-card-title">Offense</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Passing yards</div>
            <div class="sfz-v">{v(s.passing_yards)}</div>
            <div class="sfz-note">{v(s.passing_yards_per_game)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Rushing yards</div>
            <div class="sfz-v">{v(s.rushing_yards)}</div>
            <div class="sfz-note">{v(s.rushing_yards_per_game)} per game</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Receiving yards</div>
            <div class="sfz-v">{v(s.receiving_yards)}</div>
          </div>
        </div>
      </section>

      <section class="sfz-card">
        <div class="sfz-card-title">Turnovers</div>
        <div class="sfz-stat-grid">
          <div class="sfz-stat">
            <div class="sfz-k">Takeaways</div>
            <div class="sfz-v">{v(s.misc_total_takeaways)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Giveaways</div>
            <div class="sfz-v">{v(s.misc_total_giveaways)}</div>
          </div>
          <div class="sfz-stat">
            <div class="sfz-k">Turnover margin</div>
            <div class="sfz-v">
              {typeof s.misc_turnover_margin === "number" ? s.misc_turnover_margin : "-"}
            </div>
          </div>
        </div>
      </section>
    </div>
  )}

  <style>
    /* overflow protection */
    .sfz-team-header,
    .sfz-team-text,
    .sfz-cards,
    .sfz-card,
    .sfz-stat-grid,
    .sfz-stat {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .sfz-team-name,
    .sfz-team-meta,
    .sfz-updated,
    .sfz-card-title,
    .sfz-k,
    .sfz-v,
    .sfz-note,
    .sfz-empty,
    .sfz-empty-sub {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .sfz-team-header {
      display: flex;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1.1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.12);
    }

    .sfz-team-logo {
      width: 64px;
      height: 64px;
      object-fit: contain;
      flex: 0 0 auto;
    }

    .sfz-team-logo-fallback {
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(0, 34, 68, 0.06);
      border: 1px solid rgba(0, 34, 68, 0.10);
      color: rgba(0, 34, 68, 0.85);
      font-weight: 900;
      letter-spacing: 0.4px;
    }

    .sfz-team-text { min-width: 0; }

    .sfz-team-name {
      margin: 0;
      color: var(--navy);
      font-size: 1.45rem;
      font-weight: 900;
      line-height: 1.2;
    }

    .sfz-team-meta {
      margin-top: 0.25rem;
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
      display: flex;
      gap: 0.35rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .sfz-dot { opacity: 0.7; }

    .sfz-updated {
      margin-top: 0.35rem;
      color: rgba(15, 23, 32, 0.6);
      font-weight: 700;
      font-size: 0.92rem;
    }

    .sfz-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .sfz-card {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      padding: 1rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      overflow: hidden;
    }

    .sfz-card-title {
      font-weight: 900;
      color: var(--navy);
      margin-bottom: 0.75rem;
      font-size: 1.05rem;
    }

    .sfz-stat-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .sfz-stat {
      border-radius: 14px;
      border: 1px solid rgba(0, 34, 68, 0.12);
      background: rgba(0, 34, 68, 0.03);
      padding: 0.75rem 0.85rem;
    }

    .sfz-k {
      color: rgba(0, 34, 68, 0.7);
      font-weight: 900;
      font-size: 0.9rem;
    }

    .sfz-v {
      margin-top: 0.25rem;
      color: var(--navy);
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: 0.2px;
    }

    .sfz-note {
      margin-top: 0.2rem;
      color: rgba(15, 23, 32, 0.6);
      font-weight: 700;
      font-size: 0.9rem;
    }

    .sfz-empty {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: rgba(165, 172, 175, 0.18);
      padding: 0.95rem;
      color: rgba(15, 23, 32, 0.85);
    }

    .sfz-empty-sub {
      margin-top: 0.35rem;
      color: rgba(15, 23, 32, 0.7);
      font-weight: 700;
      font-size: 0.95rem;
    }

    @media (max-width: 980px) {
      .sfz-stat-grid { grid-template-columns: 1fr; }
      .sfz-team-logo { width: 56px; height: 56px; }
    }
  </style>
</SeahawksLayout>


