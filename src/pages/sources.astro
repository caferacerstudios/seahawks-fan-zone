---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";

const pageTitle = "Contact";
const pageTagline = "Corrections, feedback, and rights requests";
---

<SeahawksLayout pageTitle={pageTitle} pageTagline={pageTagline} activePath="/contact">
  <section class="sfz-card">
    <h3>Fastest way</h3>
    <p>
      Email: <a href="mailto:contact@seahawksfanzone.com">contact@seahawksfanzone.com</a>
    </p>
    <p class="sfz-muted">
      Replace this email address with the one you actually want to use.
    </p>
  </section>

  <section class="sfz-card">
    <h3>What to include</h3>
    <ul class="sfz-list">
      <li><strong>Stats issue:</strong> which page and what looks wrong</li>
      <li><strong>Schedule issue:</strong> week, opponent, and the date shown</li>
      <li><strong>Rights request:</strong> the specific team/logo/asset and the page where it appears</li>
      <li><strong>General feedback:</strong> what you wish was easier to find or compare</li>
    </ul>
  </section>

  <section class="sfz-card">
    <h3>Response expectation</h3>
    <p>
      This is a small site. If you contact us about a clear factual error or a rights concern, we will review it and respond.
    </p>
  </section>

  <style>
    .sfz-card {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      padding: 1rem 1.05rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      margin-bottom: 0.95rem;
    }

    .sfz-card h3 {
      margin: 0 0 0.6rem;
      color: var(--navy);
      font-weight: 900;
    }

    .sfz-card p {
      margin: 0 0 0.75rem;
      color: rgba(15, 23, 32, 0.78);
      line-height: 1.6;
      font-weight: 650;
    }

    .sfz-list {
      margin: 0;
      padding-left: 1.2rem;
      color: rgba(15, 23, 32, 0.75);
      line-height: 1.55;
      font-weight: 650;
    }

    .sfz-list li {
      margin: 0.3rem 0;
    }

    .sfz-muted {
      margin-top: 0.25rem;
      color: rgba(15, 23, 32, 0.6);
      font-weight: 650;
      font-size: 0.95rem;
    }
  </style>
</SeahawksLayout>
