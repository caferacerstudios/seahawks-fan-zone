---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { absoluteUrl, SITE_NAME } from "../../lib/seo";
import { categorySlug, formatArticleDate, materiallyUpdated, publishedArticles, type NewsArticle } from "../../lib/news";

export function getStaticPaths() { return publishedArticles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
interface Props { article: NewsArticle; }
const { article } = Astro.props;
const related = publishedArticles.filter((candidate) => candidate.slug !== article.slug && (candidate.category === article.category || candidate.tags.some((tag) => article.tags.includes(tag)))).slice(0, 2);
const canonicalPath = `/news/${article.slug}`;
const seo = { title: `${article.headline} | Seahawks Fan Zone`, description: article.dek, canonicalPath, openGraphTitle: article.headline, openGraphDescription: article.dek, openGraphImage: article.hero.src, article: { headline: article.headline, author: article.author, publishedTime: article.publishedAt, modifiedTime: article.updatedAt, image: article.hero.src, section: article.category } };
const structuredData = { "@context":"https://schema.org", "@type":"Article", headline:article.headline, description:article.dek, datePublished:article.publishedAt, dateModified:article.updatedAt, mainEntityOfPage:absoluteUrl(canonicalPath), articleSection:article.category, keywords:article.tags.join(", "), author:{"@type":"Organization",name:article.author}, publisher:{"@type":"Organization",name:SITE_NAME,url:absoluteUrl("/")}, image:[absoluteUrl(article.hero.src)], isAccessibleForFree:true };
---
<SeahawksLayout {seo} {structuredData} article={seo.article} showPageHeader={false} pageType="article" season={article.season} opponent={article.opponent} articleCategory={article.category} activePath="/news" quickLinks={[{href:"/news",label:"All news"},{href:`/news/category/${categorySlug(article.category)}/`,label:article.category},{href:"/news/rss.xml",label:"RSS feed"}]}>
  <header class="article-header">
    <a class="article-category" href={`/news/category/${categorySlug(article.category)}/`}>{article.category}</a>
    <h1>{article.headline}</h1><p class="article-dek">{article.dek}</p>
    <div class="article-meta"><span>By <strong>{article.author}</strong></span><span>Published <time datetime={article.publishedAt}>{formatArticleDate(article.publishedAt)}</time></span>{materiallyUpdated(article) && <span>Updated <time datetime={article.updatedAt}>{formatArticleDate(article.updatedAt)}</time></span>}</div>
  </header>
  <figure class="article-hero"><img src={article.hero.src} alt={article.hero.alt} width={article.hero.width} height={article.hero.height} /><figcaption>Original Seahawks Fan Zone illustration.</figcaption></figure>
  <div class="article-body">{article.body.map((paragraph) => <p>{paragraph}</p>)}</div>
  {article.sources.length > 0 && <section class="article-sources" aria-labelledby="sources-heading"><h2 id="sources-heading">Sources and further reading</h2><p>Reporting and context used for this article:</p><ul>{article.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul></section>}
  <footer class="article-tags" aria-label="Article tags">{article.tags.map((tag) => <span>{tag}</span>)}</footer>
  {related.length > 0 && <section class="related"><h2>Related stories</h2><div>{related.map((item) => <ArticleCard article={item} />)}</div></section>}
  <style>
    .article-header{padding-bottom:1.4rem;border-bottom:1px solid #c3cdd2}.article-category{color:#386f13;font:900 .75rem var(--font-display);letter-spacing:.1em;text-transform:uppercase}.article-header h1{max-width:850px;margin:.5rem 0;font:900 clamp(2.6rem,8vw,5.2rem)/.92 var(--font-display);letter-spacing:-.025em;color:var(--navy-950)}.article-dek{max-width:760px!important;color:var(--slate-700);font-size:clamp(1.05rem,2.5vw,1.35rem);line-height:1.45}.article-meta{display:flex;flex-wrap:wrap;gap:.4rem 1.2rem;color:var(--slate-700);font-size:.8rem}.article-hero{margin:1.4rem 0}.article-hero img{display:block;width:100%;height:auto}.article-hero figcaption{margin-top:.35rem;color:var(--slate-700);font-size:.7rem}.article-body{max-width:720px;margin:2rem auto}.article-body p{max-width:none!important;font:1.08rem/1.75 Georgia,serif;color:#172b39}.article-body p:first-child::first-letter{float:left;margin:.08em .1em 0 0;color:var(--navy-900);font:900 3.5rem/.8 var(--font-display)}.article-sources{max-width:720px;margin:2rem auto;padding:1rem;border-left:5px solid var(--action-green);background:var(--slate-100)}.article-sources h2{margin-top:0}.article-tags{display:flex;gap:.4rem;flex-wrap:wrap;padding-top:1rem;border-top:1px solid #c3cdd2}.article-tags span{padding:.35rem .55rem;background:var(--navy-800);color:#fff;font-size:.7rem}.related{margin-top:2.5rem}.related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}@media(max-width:560px){.article-header h1{overflow-wrap:anywhere}.article-meta{display:grid}.related>div{grid-template-columns:1fr}}
  </style>
</SeahawksLayout>
