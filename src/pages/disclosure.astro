---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";

const title = "Disclosure | Seahawks Fan Zone";
const description =
  "Advertising and affiliate disclosure for Seahawks Fan Zone.";
---

<SeahawksLayout {title} {description} activePath="/disclosure" monetizationEligible={false}>
  <h1>Disclosure</h1>

  <div class="card">
    <h2>Independent fan site</h2>
    <p>
      Seahawks Fan Zone is an independent fan site. It is not affiliated with, endorsed by, or sponsored by the Seattle Seahawks,
      the National Football League, or their affiliates. Team and league names are used only to identify the subjects covered.
    </p>
  </div>

  <div class="card">
    <h2>Advertising</h2>
    <p>
      This site may display advertising, including Google AdSense ads, to help cover operating costs. Advertising is enabled only
      after production configuration and any applicable consent. An ad's presence is not an endorsement of its advertiser.
    </p>
  </div>

  <div class="card">
    <h2>Affiliate links</h2>
    <p>
      Some links to products or gear may be affiliate links. If you click an
      affiliate link and make a purchase, I may earn a small commission at no
      extra cost to you.
    </p>
  </div>

  <div class="card">
    <h2>Editorial independence</h2>
    <p>
      Ads and affiliate partnerships do not influence the stats shown on this
      site or what I choose to cover.
    </p>
  </div>

  <div class="card">
    <h2>Contact</h2>
    <p>
      Questions? Email me at <a href="mailto:laura@caferacerstudios.com">laura@caferacerstudios.com</a>.
    </p>
  </div>
</SeahawksLayout>
