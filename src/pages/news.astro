---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import TrendingNow from "../components/TrendingNow.astro";
---

<SeahawksLayout title="Seattle Seahawks News" description="Find timely Seahawks Fan Zone recaps, schedule updates, standings, and player coverage." pageTitle="News" pageTagline="The newest and most relevant Seahawks Fan Zone coverage, selected without borrowed social-media signals." activePath="/news" canonical="/news">
  <TrendingNow />

  <section class="news-directory" aria-labelledby="coverage-title">
    <p class="label">Keep reading</p>
    <h2 id="coverage-title">Seahawks coverage</h2>
    <div class="coverage-grid">
      <a href="/weekly-recap"><strong>Game recaps</strong><span>Final scores, turning points, and season context.</span></a>
      <a href="/schedule"><strong>Schedule</strong><span>Upcoming games, kickoff times, and results.</span></a>
      <a href="/team"><strong>Team stats</strong><span>Seattle's current season totals.</span></a>
      <a href="/players"><strong>Players</strong><span>Roster information and statistical leaders.</span></a>
    </div>
  </section>
  <style>
    .news-directory{margin-top:2rem}.news-directory h2{margin:.2rem 0 1rem}.label{margin:0;color:#315f12;font:900 .72rem var(--font-display);letter-spacing:.1em;text-transform:uppercase}.coverage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.coverage-grid a{display:grid;gap:.3rem;padding:1rem;border:var(--border-crisp);border-left:4px solid var(--action-green);background:#fff;color:var(--navy-900);text-decoration:none}.coverage-grid strong{font-size:1.05rem}.coverage-grid span{color:var(--slate-700);font-size:.86rem;line-height:1.4}@media(max-width:600px){.coverage-grid{grid-template-columns:1fr}}
  </style>
</SeahawksLayout>
