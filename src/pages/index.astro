---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import { formatPacificTime } from "../lib/season-context";

let nfl: any = null;
let standings: any = null;
let recapData: any = null;
try { nfl = (await import("../data/nfl/seahawks.json")).default; } catch {}
try { standings = (await import("../data/nfl/standings.json")).default; } catch {}
try { recapData = (await import("../data/nfl/gameRecaps.json")).default; } catch {}

const now = Date.now();
const abbr = (team: any) => String(team?.abbreviation ?? team?.abbr ?? "").toUpperCase();
const id = (game: any, i = 0) => String(game?.id ?? game?.game_id ?? i);
const href = (game: any, i = 0) => `/games/${encodeURIComponent(id(game, i))}`;
const time = (game: any) => { const n = new Date(game?.date ?? game?.start_time ?? game?.kickoff ?? "").getTime(); return Number.isFinite(n) ? n : null; };
const rawStatus = (game: any) => String(game?.status ?? "").trim();
const lowerStatus = (game: any) => rawStatus(game).toLowerCase();
const final = (game: any) => ["final", "finished", "complete"].some((x) => lowerStatus(game).includes(x));
const live = (game: any) => ["in progress", "live", "halftime", "q1", "q2", "q3", "q4", "overtime"].some((x) => lowerStatus(game).includes(x));
const dataTime = new Date(nfl?.updatedAt ?? "").getTime();
const trustworthyLive = (game: any) => live(game) && Number.isFinite(dataTime) && now - dataTime >= 0 && now - dataTime < 15 * 60_000;
const home = (game: any) => abbr(game?.home_team) === "SEA";
const opponent = (game: any) => home(game) ? game?.visitor_team : game?.home_team;
const opp = (game: any) => abbr(opponent(game));
const teamName = (team: any, fallback: string) => String(team?.full_name ?? team?.name ?? fallback);
const score = (game: any, sea: boolean) => {
  const value = sea === home(game) ? game?.home_team_score : game?.visitor_team_score;
  const parsed = Number(value);
  return value !== null && value !== undefined && Number.isFinite(parsed) ? parsed : null;
};
const phase = (game: any) => {
  const value = String(game?.season_type ?? game?.seasonType ?? "").toLowerCase();
  if (value.includes("pre")) return "Preseason";
  if (game?.postseason || value.includes("post") || value.includes("playoff")) return "Postseason";
  return "Regular season";
};
const week = (game: any) => game?.week !== null && game?.week !== undefined && String(game.week).trim() ? `Week ${game.week}` : "Game day";
const venue = (game: any) => game?.venue?.name ?? game?.venue ?? game?.stadium?.name ?? game?.stadium ?? null;
const marks = new Map(Object.keys(import.meta.glob("../../public/images/nfl/teams/*.{png,svg,webp}"))
  .map((path) => [path.split("/").pop()?.split(".")[0]?.toUpperCase(), path.replace("../../public", "")]));

const games = [...(nfl?.gamesPreseason ?? []), ...(nfl?.gamesRegular ?? []), ...(nfl?.gamesPostseason ?? []), ...(nfl?.games ?? [])]
  .filter((game, i, all) => all.findIndex((other, j) => id(other, j) === id(game, i)) === i)
  .sort((a, b) => (time(a) ?? Number.MAX_SAFE_INTEGER) - (time(b) ?? Number.MAX_SAFE_INTEGER));
const completed = games.filter(final);
const upcoming = games.filter((game) => !final(game) && !live(game) && (time(game) ?? 0) > now);
const featured = games.find(trustworthyLive) ?? upcoming[0] ?? completed.at(-1) ?? null;
const latest = completed.at(-1) ?? null;
const latestRecap = completed.filter((game, i) => recapData?.recaps?.[id(game, games.indexOf(game))]).at(-1) ?? null;
const latestScored = completed.filter((game) => score(game, true) !== null && score(game, false) !== null).at(-1) ?? null;
const nextThree = upcoming.slice(0, 3);
const result = (game: any) => score(game, true) === score(game, false) ? "T" : score(game, true)! > score(game, false)! ? "W" : "L";
const regularFinals = completed.filter((game) => phase(game) === "Regular season" && score(game, true) !== null && score(game, false) !== null);
const record = (rows: any[]) => rows.reduce((r, game) => { const outcome = result(game); if (outcome === "W") r.w++; if (outcome === "L") r.l++; if (outcome === "T") r.t++; return r; }, { w: 0, l: 0, t: 0 });
const recordText = (r: any) => `${r.w}-${r.l}${r.t ? `-${r.t}` : ""}`;
const pointDiff = regularFinals.length ? regularFinals.reduce((sum, game) => sum + score(game, true)! - score(game, false)!, 0) : null;
const recentResults = regularFinals.map(result);
const lastResult = recentResults.at(-1);
let streakCount = 0;
for (let i = recentResults.length - 1; i >= 0 && recentResults[i] === lastResult; i--) streakCount++;

const standingRows = Array.isArray(standings?.data) ? standings.data : Array.isArray(standings?.teams) ? standings.teams : [];
const standingTeam = (row: any) => row?.team ?? row;
const seaStanding = standingRows.find((row: any) => abbr(standingTeam(row)) === "SEA");
const division = String(seaStanding?.division ?? standingTeam(seaStanding)?.division ?? "NFC West");
const divisionRank = seaStanding?.division_rank ?? seaStanding?.divisionRank ?? null;
const ordinal = (n: number) => `${n}${n % 10 === 1 && n % 100 !== 11 ? "st" : n % 10 === 2 && n % 100 !== 12 ? "nd" : n % 10 === 3 && n % 100 !== 13 ? "rd" : "th"}`;

const stats = Number(nfl?.playerStatsSeason ?? nfl?.season) === Number(nfl?.season) && Array.isArray(nfl?.playerSeasonStats) ? nfl.playerSeasonStats : [];
const leader = (keys: string[]) => stats.map((row: any) => ({ row, value: keys.map((key) => row?.[key]).find((v) => typeof v === "number" && Number.isFinite(v)) }))
  .filter((x: any) => x.value > 0).sort((a: any, b: any) => b.value - a.value)[0];
const playerName = (row: any) => `${row?.player?.first_name ?? ""} ${row?.player?.last_name ?? ""}`.trim();
const playerHref = (row: any) => `/players/${encodeURIComponent(String(row?.player?.id ?? row?.player_id))}`;
const tacklesLeader = leader(["tackles", "total_tackles"]);
const sacksLeader = leader(["sacks"]);
const leaders = [
  ["Passing leader", "Pass yards", leader(["passing_yards", "passingYards"])],
  ["Rushing leader", "Rush yards", leader(["rushing_yards", "rushingYards"])],
  ["Receiving leader", "Rec. yards", leader(["receiving_yards", "receivingYards"])],
  ["Defensive leader", tacklesLeader ? "Tackles" : "Sacks", tacklesLeader ?? sacksLeader],
].filter(([, , item]: any) => item?.row && playerName(item.row));
const state = featured ? trustworthyLive(featured) ? "live" : final(featured) ? "final" : "upcoming" : "empty";
const action = state === "live" ? "View Game Center" : state === "final" ? "Read Recap" : "View Preview";
const hasDashboard = Boolean(latestScored || nextThree.length || divisionRank || leaders.length || latest);
---

<SeahawksLayout title={`${nfl?.season ?? "Current"} Seattle Seahawks season hub`} description="Current Seahawks games, standings, leaders, and recaps." activePath="/" showPageHeader={false} pageType="home" season={nfl?.season}>
  <p class="home-value">The current Seahawks season—game context, standings, leaders, and recaps in one fast read.</p>

  {featured ? <section class={`scoreboard scoreboard--${state}`} aria-labelledby="featured-title">
    <div class="topline"><span>{nfl?.season ?? featured?.season} {phase(featured)}</span><span>{week(featured)}</span><span class="state">{state === "live" ? rawStatus(featured) : state === "final" ? "Final" : "Kickoff"}</span></div>
    <div class="scorebody">
      <div><p class="location">{home(featured) ? "Home · vs." : "Away · at"}</p><h1 id="featured-title">{teamName(opponent(featured), opp(featured) || "Opponent")}</h1>
        {(nfl?.team?.record || opponent(featured)?.record) && <p class="records">SEA {nfl?.team?.record ?? "record unavailable"} · {opp(featured)} {opponent(featured)?.record ?? "record unavailable"}</p>}</div>
      {marks.has("SEA") && marks.has(opp(featured)) && <div class="marks" aria-hidden="true"><img src={marks.get("SEA")} alt=""/><span>{home(featured) ? "VS" : "AT"}</span><img src={marks.get(opp(featured))} alt=""/></div>}
      <div class="main-result">
        {state === "final" && score(featured, true) !== null && score(featured, false) !== null ? <><span>{result(featured)} · Final</span><strong>{score(featured, true)}–{score(featured, false)}</strong></>
          : state === "live" ? <><span>Source status · Updated {formatPacificTime(nfl?.updatedAt)}</span><strong>{rawStatus(featured)}</strong></>
          : <><span>Countdown to kickoff</span><strong class="countdown" data-kickoff={new Date(time(featured)!).toISOString()}>Calculating…</strong></>}
      </div>
    </div>
    <div class="details"><span>{formatPacificTime(featured?.date ?? featured?.start_time ?? featured?.kickoff)}</span>{venue(featured) && <span>{venue(featured)}</span>}</div>
    <div class="actions"><a class="button primary" href={href(featured, games.indexOf(featured))}>{action} →</a><a class="button" href="/schedule">Full Schedule</a></div>
  </section> : <section class="scoreboard empty"><p class="location">Season hub</p><h1 id="featured-title">The next Seahawks game will appear here</h1><p>Schedule data is not available in this build yet.</p><a class="button primary" href="/schedule">Full Schedule</a></section>}

  {regularFinals.length > 0 && <section class="glance" aria-label="Season at a glance"><h2>Season at a glance</h2>
    <a href="/standings"><span>Record</span><strong>{recordText(record(regularFinals))}</strong></a>
    {pointDiff !== null && <a href="/team"><span>Point differential</span><strong>{pointDiff > 0 ? "+" : ""}{pointDiff}</strong></a>}
    {regularFinals.some(home) && <a href="/schedule"><span>Home</span><strong>{recordText(record(regularFinals.filter(home)))}</strong></a>}
    {regularFinals.some((g) => !home(g)) && <a href="/schedule"><span>Away</span><strong>{recordText(record(regularFinals.filter((g) => !home(g))))}</strong></a>}
    {lastResult && <a href="/schedule"><span>Streak</span><strong>{lastResult}{streakCount}</strong></a>}
  </section>}

  <section class="dashboard" aria-labelledby="dashboard-title"><h2 id="dashboard-title">Season dashboard</h2>
    {latestScored && <article class="card"><p class="label">Latest result</p><h3>{result(latestScored)} {score(latestScored, true)}–{score(latestScored, false)} <small>{home(latestScored) ? "vs." : "at"} {opp(latestScored)}</small></h3><p>{week(latestScored)} · {phase(latestScored)}</p><a href={href(latestScored, games.indexOf(latestScored))}>Read recap →</a></article>}
    {nextThree.length > 0 && <article class="card"><p class="label">Next three games</p><ol>{nextThree.map((game) => <li><a href={href(game, games.indexOf(game))}><strong>{home(game) ? "vs." : "at"} {opp(game)}</strong><span>{week(game)} · {formatPacificTime(game?.date ?? game?.start_time)}</span></a></li>)}</ol><a href="/schedule">Full schedule →</a></article>}
    {divisionRank && <article class="card standing"><p class="label">NFC West position</p><h3>{ordinal(Number(divisionRank))}</h3><p>{division}</p><a href="/standings">View standings →</a></article>}
    {leaders.length > 0 && <article class="card leaders"><p class="label">Team leaders</p><div class="leader-list">{leaders.map(([label, metric, item]: any) => <a href={playerHref(item.row)}><span>{label}</span><strong>{playerName(item.row)}</strong><small>{item.value.toLocaleString()} {metric}</small></a>)}</div><div class="stat-links"><a href="/players">All player stats →</a><a href="/team">Team stats →</a></div></article>}
    {latestRecap && <article class="card"><p class="label">Latest game recap</p><h3>{week(latestRecap)}: {home(latestRecap) ? "vs." : "at"} {opp(latestRecap)}</h3><p>{result(latestRecap)} {score(latestRecap, true)}–{score(latestRecap, false)} · Read the authored recap and available game data.</p><a href={href(latestRecap, games.indexOf(latestRecap))}>Read latest recap →</a></article>}
    {!hasDashboard && <p class="dashboard-empty">Season details will appear as schedule, standings, and statistics become available.</p>}
  </section>

  <aside class="history-teaser" aria-labelledby="history-teaser-title">
    <div class="teaser-number" aria-hidden="true">12</div>
    <div>
      <p class="label">Beyond the current season</p>
      <h2 id="history-teaser-title">History &amp; The 12s</h2>
      <p>From the Kingdome roar to championship parades: explore the eras, players and fan traditions that made Seattle football feel like Seattle.</p>
      <a href="/history">Enter the history hub →</a>
    </div>
  </aside>

  <script is:inline>(()=>{const n=document.querySelector('.countdown[data-kickoff]');if(!n)return;const k=new Date(n.getAttribute('data-kickoff')).getTime();const r=()=>{const x=k-Date.now();if(x<=0){n.textContent='Kickoff time reached';return}const d=Math.floor(x/86400000),h=Math.floor(x%86400000/3600000),m=Math.floor(x%3600000/60000);n.textContent=d?`${d}d ${h}h ${m}m`:`${h}h ${m}m`};r();setInterval(r,60000)})()</script>
  <style>
    .home-value{margin:0 0 1rem;max-width:none!important;color:var(--slate-700);font-weight:750}.scoreboard{overflow:hidden;background:var(--navy-950);color:#fff;border-top:7px solid var(--action-green);box-shadow:var(--shadow-lg)}.topline{display:flex;gap:.6rem 1.25rem;flex-wrap:wrap;padding:.75rem clamp(1rem,4vw,2rem);border-bottom:1px solid #ffffff2b;color:var(--slate-300);font:800 .72rem var(--font-display);letter-spacing:.09em;text-transform:uppercase}.state{margin-left:auto;color:var(--action-green)}.scorebody{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;align-items:center;padding:clamp(1.4rem,5vw,3rem) clamp(1rem,4vw,2rem);background:linear-gradient(120deg,#70c9341a,transparent 45%)}.location,.label{margin:0 0 .35rem!important;color:#4b711f;font:900 .72rem var(--font-display);letter-spacing:.1em;text-transform:uppercase}.scoreboard .location{color:var(--action-green)}.scoreboard h1{margin:0;color:#fff;font:900 clamp(2.25rem,7vw,5.5rem)/.88 var(--font-display);letter-spacing:-.035em;text-transform:uppercase;overflow-wrap:anywhere}.records{color:var(--slate-300)}.marks{display:flex;align-items:center;gap:.6rem}.marks img{width:clamp(48px,7vw,78px);height:clamp(48px,7vw,78px);object-fit:contain}.main-result{grid-column:1/-1;display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-top:1.25rem;border-top:1px solid #ffffff29}.main-result span{color:var(--slate-300);font-size:.76rem;text-transform:uppercase}.main-result strong{font:900 clamp(1.6rem,5vw,3.25rem) var(--font-display);font-variant-numeric:tabular-nums;text-align:right}.scoreboard--live .main-result strong{color:var(--action-green)}.details,.actions{display:flex;gap:.65rem 1.5rem;flex-wrap:wrap;padding:.85rem clamp(1rem,4vw,2rem)}.details{background:var(--navy-800);font-size:.85rem}.button{display:inline-flex;min-height:44px;align-items:center;padding:.6rem 1rem;border:2px solid var(--slate-500);color:#fff;text-decoration:none;font-weight:900}.primary{border-color:var(--action-green);background:var(--action-green);color:var(--navy-950)}.scoreboard.empty{padding:2rem}.glance{display:grid;grid-template-columns:1.35fr repeat(5,minmax(70px,1fr));margin-top:1rem;border:var(--border-crisp);background:#fff}.glance h2{margin:0;padding:1rem;display:flex;align-items:center;background:var(--navy-800);color:#fff;font-size:1rem}.glance a{display:grid;align-content:center;padding:.75rem;border-left:var(--border-crisp);color:var(--navy-900);text-decoration:none}.glance span,.leader-list span,.leader-list small{color:var(--slate-700);font-size:.66rem;text-transform:uppercase}.glance strong{font:900 1.35rem var(--font-display)}.dashboard{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2.25rem}.dashboard>h2,.leaders{grid-column:1/-1}.dashboard>h2{margin:0;padding-left:.75rem;border-left:5px solid var(--action-green)}.card{min-width:0;padding:1.2rem}.card h3{margin:.4rem 0}.card h3 small{color:var(--slate-700)}.card>p{margin:.35rem 0}.card>a,.stat-links a{display:inline-block;margin-top:.7rem;font-weight:900}.card ol{padding:0;margin:.5rem 0;list-style:none}.card li+li{border-top:var(--border-crisp)}.card li a{display:flex;justify-content:space-between;gap:.7rem;padding:.6rem 0;color:var(--navy-900);text-decoration:none}.card li span{color:var(--slate-700);font-size:.73rem;text-align:right}.leader-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem}.leader-list a{display:grid;padding:.75rem;background:var(--slate-100);color:var(--navy-900);text-decoration:none}.stat-links{display:flex;gap:1rem;flex-wrap:wrap}@media(max-width:800px){.glance{grid-template-columns:repeat(2,minmax(0,1fr))}.glance h2{grid-column:1/-1}.leader-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.scorebody,.dashboard{grid-template-columns:minmax(0,1fr)}.main-result{align-items:flex-start;flex-direction:column}.main-result strong{text-align:left}.state{margin-left:0}.actions{display:grid}.dashboard>h2,.leaders{grid-column:auto}.card li a{display:grid}.card li span{text-align:left}}@media(max-width:390px){.glance,.leader-list{grid-template-columns:minmax(0,1fr)}.glance a{border-left:0}}
    .dashboard-empty{grid-column:1/-1;margin:0;padding:1rem;border:var(--border-crisp);color:var(--slate-700)}
    .history-teaser{display:grid;grid-template-columns:auto minmax(0,1fr);gap:1.5rem;align-items:center;margin-top:2.25rem;padding:clamp(1.25rem,4vw,2rem);overflow:hidden;background:var(--navy-900);color:#fff;border-left:7px solid var(--action-green);box-shadow:var(--shadow-lg)}.history-teaser .teaser-number{font:900 clamp(4.5rem,12vw,8rem)/.75 var(--font-display);color:var(--action-green);letter-spacing:-.08em}.history-teaser h2{margin:.1rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.7rem)}.history-teaser p{margin:.4rem 0;color:var(--slate-100)}.history-teaser .label{color:var(--action-green)}.history-teaser a{display:inline-block;margin-top:.55rem;color:#fff;font-weight:900}
    @media(max-width:600px){.dashboard-empty{grid-column:auto}}
    @media(max-width:520px){.history-teaser{grid-template-columns:1fr}.history-teaser .teaser-number{font-size:4.5rem}}
  </style>
</SeahawksLayout>
