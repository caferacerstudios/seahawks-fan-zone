---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Seahawks Fan Zone";
const description = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: news, stats, highlights, and the weekly emotional rollercoaster we all signed up for.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;

const navPages = [
  { href: "/", label: "Home" },
  { href: "/players", label: "Players" },
  { href: "/team", label: "Team Stats" },
  { href: "/schedule", label: "Schedule" },
  { href: "/about", label: "About" },
];

const featured = [
  { title: "Team Dashboard", desc: "Offense/defense splits, trends, and season totals.", href: "/team" },
  { title: "Player Stats", desc: "Passing, rushing, receiving, defense, special teams.", href: "/players" },
  { title: "Game Logs", desc: "Per-game breakdowns with filters and comparisons.", href: "/games" },
];

const quickLinks = [
  { href: "/players/qb", label: "QB" },
  { href: "/players/rb", label: "RB" },
  { href: "/players/wr", label: "WR" },
  { href: "/players/te", label: "TE" },
  { href: "/players/ol", label: "OL" },
  { href: "/players/defense", label: "Defense" },
  { href: "/players/st", label: "Special Teams" },
];

const introText = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: news, stats, highlights, and the weekly emotional rollercoaster we all signed up for.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;
---

<BaseLayout {title} {description}>
  <!-- Top header banner -->
  <header class="lr-header seahawks-header">
    <div class="lr-header-bg seahawks-header-bg" aria-hidden="true"></div>

    <div class="lr-header-inner">
      <h1 class="lr-site-title">Seahawks Fan Zone</h1>
      <p class="lr-site-tagline">Home of the 12s</p>

      <nav class="top-nav" aria-label="Primary">
        {navPages.map((p) => (
          <a class="top-nav-link" href={p.href} aria-current={p.href === "/" ? "page" : undefined}>
            {p.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Middle 3-column layout -->
  <div class="lr-middle">
    <!-- LEFT SIDEBAR -->
    <aside class="lr-sidebar lr-sidebar-left">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Quick links</h3>
        <ul class="lr-nav lr-subnav">
          {quickLinks.map((x) => (
            <li><a href={x.href}>{x.label}</a></li>
          ))}
        </ul>
      </section>

      <section class="lr-panel">
        <h3 class="lr-panel-title">Site</h3>
        <ul class="lr-nav">
          <li><a href="/methodology">Methodology</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </section>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="lr-main">
      <article class="lr-paper seahawks-paper">
        <header class="lr-post-header">
          <h2 class="lr-post-title">Welcome</h2>

          <div class="lr-tags">
            <span class="lr-tag-label">Focus:</span>
            <a class="lr-tag" href="/players">Player stats</a>
            <a class="lr-tag" href="/team">Team stats</a>
            <a class="lr-tag" href="/games">Game logs</a>
          </div>
        </header>

        <div class="lr-post-content">
          <p class="seahawks-intro">{introText}</p>

          <!-- Featured -->
          <h3>Start here</h3>
          <div class="feature-grid">
            {featured.map((f) => (
              <a class="feature-card" href={f.href}>
                <div class="feature-title">{f.title}</div>
                <div class="feature-desc">{f.desc}</div>
                <div class="feature-cta">Open →</div>
              </a>
            ))}
          </div>

          <!-- “This week” placeholder block -->
          <h3>Snapshot</h3>
          <div class="snapshot-grid" role="list">
            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Team</div>
              <div class="snapshot-v">Seattle Seahawks</div>
              <div class="snapshot-note">Dashboards update automatically</div>
            </div>
            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Season</div>
              <div class="snapshot-v">2025</div>
              <div class="snapshot-note">Filters for week / home / away</div>
            </div>
            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Goal</div>
              <div class="snapshot-v">Accurate stats</div>
              <div class="snapshot-note">With sources + methodology</div>
            </div>
          </div>

          <p class="lr-cta">
            <a class="lr-btn seahawks-btn" href="/team">Open Team Dashboard →</a>
            <a class="lr-btn seahawks-btn seahawks-btn--ghost" style="margin-left: 0.5rem;" href="/players">
              Browse Players →
            </a>
          </p>

          <!-- Footer note -->
          <div class="note-box">
            <strong>Note:</strong> If you’re adding data next, a clean first milestone is:
            <em>team totals + per-game logs</em>, then player splits by position.
          </div>
        </div>
      </article>

      <footer class="lr-footer">
        <a href="/about">About</a> · <a href="/privacy-policy">Privacy Policy</a> · <a href="/methodology">Methodology</a>
        <div class="lr-copyright">
          &copy; {new Date().getFullYear()} seahawks-stats
        </div>
      </footer>
    </main>

    <!-- RIGHT SIDEBAR (optional, but fills the 3-col layout nicely) -->
    <aside class="lr-sidebar lr-sidebar-right">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Popular</h3>
        <ul class="lr-nav">
          <li><a href="/players/qb">QB room</a></li>
          <li><a href="/players/defense">Defense leaders</a></li>
          <li><a href="/team/redzone">Red zone</a></li>
          <li><a href="/team/3rd-down">3rd down</a></li>
        </ul>
      </section>

      <section class="lr-panel">
        <h3 class="lr-panel-title">Build next</h3>
        <ul class="lr-nav">
          <li><a href="/roadmap">Roadmap</a></li>
          <li><a href="/sources">Sources</a></li>
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>

