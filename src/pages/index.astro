---
import BaseLayout from "../layouts/BaseLayout.astro";

// Try to load build-time NFL data (generated by scripts/fetch-nfl.mjs).
// Fallbacks keep the homepage working even before the first successful build.
let nfl = null;
try {
  nfl = (await import("../data/nfl/seahawks.json")).default;
} catch (e) {
  nfl = null;
}

const season = nfl?.season ?? new Date().getFullYear();
const updatedAt = nfl?.updatedAt ? new Date(nfl.updatedAt).toLocaleString() : null;

const title = "Seahawks Fan Zone";
const description = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: schedule, team stats, and player stats.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;

const navPages = [
  { href: "/", label: "Home" },
  { href: "/schedule", label: "Schedule" },
  { href: "/team", label: "Team Stats" },
  { href: "/players", label: "Players" },
  { href: "/about", label: "About" },
];

const featured = [
  { title: "Schedule", desc: "Every game, week-by-week, with scores as they go final.", href: "/schedule" },
  { title: "Team Stats", desc: "Season totals + per-game splits for offense/defense.", href: "/team" },
  { title: "Player Stats", desc: "Season stats by player (QB/RB/WR/TE and more).", href: "/players" },
];

// ✅ Basic position filters only (no placeholders, no ST/DEF for now)
const quickLinks = [
  { href: "/players", label: "All Players" },
  { href: "/players?pos=QB", label: "QB" },
  { href: "/players?pos=RB", label: "RB" },
  { href: "/players?pos=WR", label: "WR" },
  { href: "/players?pos=TE", label: "TE" },
];

const introText = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: schedule, team stats, and player stats.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;
---

<BaseLayout {title} {description}>
  <!-- Top header banner -->
  <header class="lr-header seahawks-header">
    <div class="lr-header-bg seahawks-header-bg" aria-hidden="true"></div>

    <div class="lr-header-inner">
      <h1 class="lr-site-title">Seahawks Fan Zone</h1>
      <p class="lr-site-tagline">Home of the 12s</p>

      <nav class="top-nav" aria-label="Primary">
        {navPages.map((p) => (
          <a class="top-nav-link" href={p.href} aria-current={p.href === "/" ? "page" : undefined}>
            {p.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Middle 3-column layout -->
  <div class="lr-middle">
    <!-- LEFT SIDEBAR -->
    <aside class="lr-sidebar lr-sidebar-left">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Quick links</h3>
        <ul class="lr-nav lr-subnav">
          {quickLinks.map((x) => (
            <li><a href={x.href}>{x.label}</a></li>
          ))}
        </ul>
      </section>

      <section class="lr-panel">
        <h3 class="lr-panel-title">Site</h3>
        <ul class="lr-nav">
          <li><a href="/methodology">Methodology</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </section>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="lr-main">
      <article class="lr-paper seahawks-paper">
        <header class="lr-post-header">
          <h2 class="lr-post-title">Welcome</h2>

          <div class="lr-tags">
            <span class="lr-tag-label">Explore:</span>
            <a class="lr-tag" href="/schedule">Schedule</a>
            <a class="lr-tag" href="/team">Team stats</a>
            <a class="lr-tag" href="/players">Player stats</a>
          </div>
        </header>

        <div class="lr-post-content">
          <p class="seahawks-intro">{introText}</p>

          <!-- Featured -->
          <h3>Start here</h3>
          <div class="feature-grid">
            {featured.map((f) => (
              <a class="feature-card" href={f.href}>
                <div class="feature-title">{f.title}</div>
                <div class="feature-desc">{f.desc}</div>
                <div class="feature-cta">Open →</div>
              </a>
            ))}
          </div>

          <!-- Snapshot -->
          <h3>Snapshot</h3>
          <div class="snapshot-grid" role="list">
            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Team</div>
              <div class="snapshot-v">{nfl?.team?.full_name ?? "Seattle Seahawks"}</div>
              <div class="snapshot-note">Dashboards update automatically</div>
            </div>

            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Season</div>
              <div class="snapshot-v">{season}</div>
              <div class="snapshot-note">Schedule + stats pages</div>
            </div>

            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Last update</div>
              <div class="snapshot-v">{updatedAt ?? "Not fetched yet"}</div>
              <div class="snapshot-note">Build-time pull from BALLDONTLIE</div>
            </div>
          </div>

          <p class="lr-cta">
            <a class="lr-btn seahawks-btn" href="/schedule">Open Schedule →</a>
            <a class="lr-btn seahawks-btn seahawks-btn--ghost" style="margin-left: 0.5rem;" href="/players">
              Browse Players →
            </a>
          </p>

          <!-- Footer note -->
          <div class="note-box">
            <strong>Next milestone:</strong> add a simple “last game / next game” card on the homepage.
          </div>
        </div>
      </article>

      <footer class="lr-footer">
        <a href="/about">About</a> · <a href="/privacy-policy">Privacy Policy</a> · <a href="/methodology">Methodology</a>
        <div class="lr-footer-note">
          Seahawks Fan Zone is an independent fan site and is not affiliated with the NFL or the Seattle Seahawks.
        </div>
        <div class="lr-copyright">
          &copy; {new Date().getFullYear()} seahawksfanzone
        </div>
      </footer>
    </main>

    <!-- RIGHT SIDEBAR -->
    <aside class="lr-sidebar lr-sidebar-right">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Popular</h3>
        <ul class="lr-nav">
          <li><a href="/schedule">Schedule</a></li>
          <li><a href="/players">Player stats</a></li>
          <li><a href="/team">Team totals</a></li>
        </ul>
      </section>

      <!-- ✅ Removed “Build next” section (avoid dead links during ad review) -->
    </aside>
  </div>
</BaseLayout>

