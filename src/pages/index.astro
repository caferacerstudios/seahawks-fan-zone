---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";

// Try to load build-time NFL data (generated by scripts/fetch-nfl.mjs).
// Fallbacks keep the homepage working even before the first successful build.
let nfl = null;
try {
  nfl = (await import("../data/nfl/seahawks.json")).default;
} catch (e) {
  nfl = null;
}

const season = nfl?.season ?? new Date().getFullYear();
const updatedAt = nfl?.updatedAt ? new Date(nfl.updatedAt).toLocaleString() : null;

const title = "Seahawks Fan Zone";
const description = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: schedule, team stats, and player stats.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;

const featured = [
  { title: "Schedule", desc: "Every game, week-by-week, with scores as they go final.", href: "/schedule" },
  { title: "Team Stats", desc: "Season totals + per-game splits for offense/defense.", href: "/team" },
  { title: "Player Stats", desc: "Season stats by player (QB/RB/WR/TE and more).", href: "/players" },
];

// ✅ Basic position filters only
const quickLinks = [
  { href: "/players", label: "All Players" },
  { href: "/players?pos=QB", label: "QB" },
  { href: "/players?pos=RB", label: "RB" },
  { href: "/players?pos=WR", label: "WR" },
  { href: "/players?pos=TE", label: "TE" },
];

const introText = `Welcome, 12s — you made it.

This is our little corner of the internet where Seahawks talk lives: schedule, team stats, and player stats.

If you’re here to keep up with the season, dig into the numbers, or just soak up the fan energy, you’re in the right place.

We’ll also be sharing fan gear and Seahawks-themed finds along the way. Stick around, check back often, and let’s ride the season together.

Go Hawks!`;
---

<SeahawksLayout {title} {description} pageTitle="Welcome to the Fan Zone" pageTagline="Scores, schedules, recaps, and the numbers behind Seattle football." activePath="/" {quickLinks}>
          <p class="seahawks-intro">{introText}</p>

          <!-- Featured -->
          <h3>Start here</h3>
          <div class="feature-grid">
            {featured.map((f) => (
              <a class="feature-card" href={f.href}>
                <div class="feature-title">{f.title}</div>
                <div class="feature-desc">{f.desc}</div>
                <div class="feature-cta">Open →</div>
              </a>
            ))}
          </div>

          <!-- Snapshot -->
          <h3>Snapshot</h3>
          <div class="snapshot-grid" role="list">
            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Team</div>
              <div class="snapshot-v">{nfl?.team?.full_name ?? "Seattle Seahawks"}</div>
              <div class="snapshot-note">Dashboards update automatically</div>
            </div>

            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Season</div>
              <div class="snapshot-v">{season}</div>
              <div class="snapshot-note">Schedule + stats pages</div>
            </div>

            <div class="snapshot" role="listitem">
              <div class="snapshot-k">Last update</div>
              <div class="snapshot-v">{updatedAt ?? "Latest data not available yet"}</div>
              <div class="snapshot-note">Updated during site builds</div>
            </div>
          </div>

          <p class="lr-cta">
            <a class="lr-btn seahawks-btn" href="/schedule">Open Schedule →</a>
            <a class="lr-btn seahawks-btn seahawks-btn--ghost" style="margin-left: 0.5rem;" href="/players">
              Browse Players →
            </a>
          </p>

</SeahawksLayout>

