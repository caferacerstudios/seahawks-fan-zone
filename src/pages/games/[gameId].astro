---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import SeasonContextView from "../../components/SeasonContext.astro";
import GameCenter from "../../components/GameCenter.astro";
import { getAvailableSeasonContexts, getSeasonContext } from "../../lib/season-context";
import scheduleData from "../../data/nfl/seahawks.json";
import gameRecaps from "../../data/nfl/gameRecaps.json";
import rosterData from "../../data/nfl/players.json";

let standingsData = null;
try {
  standingsData = (await import("../../data/nfl/standings.json")).default;
} catch {}

/* =======================
   Helpers for page render
   ======================= */

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function teamLogo(abbr) {
  return `/images/nfl/teams/${abbr}.png`;
}

function seaIsHome(game) {
  return teamAbbr(game?.home_team) === "SEA";
}

function oppAbbr(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  return home === "SEA" ? away : home;
}

function isPlayoffGame(g) {
  const st = String(g?.seasonType ?? g?.season_type ?? "").toLowerCase();
  if (st.includes("post") || st.includes("playoff")) return true;
  if (g?.postseason === true) return true;
  if (g?.is_postseason === true) return true;
  return false;
}

function fmtPT(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  try {
    return d.toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "short",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }) + " PT";
  } catch {
    return d.toISOString();
  }
}

function statusText(game) {
  const s = String(game?.status || "").toLowerCase();
  if (s.includes("final")) return "Final";
  if (s.includes("in progress")) return "Live";
  if (s.includes("scheduled")) return "Scheduled";
  return game?.status || "";
}

function isFinal(game) {
  return /final|finished|complete/i.test(String(game?.status || ""));
}

function teamName(team, fallback) {
  return String(team?.full_name ?? team?.fullName ?? team?.name ?? fallback);
}

function venueName(game) {
  return game?.venue?.name ?? game?.venue ?? game?.stadium?.name ?? game?.stadium ?? null;
}

function recordBefore(target, abbreviation) {
  const targetTime = new Date(target?.date ?? 0).getTime();
  return ordered.reduce((record, row) => {
    if (!isFinal(row) || new Date(row?.date ?? 0).getTime() >= targetTime) return record;
    const home = teamAbbr(row?.home_team);
    const away = teamAbbr(row?.visitor_team);
    if (home !== abbreviation && away !== abbreviation) return record;
    const own = Number(home === abbreviation ? row?.home_team_score : row?.visitor_team_score);
    const other = Number(home === abbreviation ? row?.visitor_team_score : row?.home_team_score);
    if (!Number.isFinite(own) || !Number.isFinite(other)) return record;
    if (own === other) record.t += 1;
    else if (own > other) record.w += 1;
    else record.l += 1;
    return record;
  }, { w: 0, l: 0, t: 0 });
}

function recordText(record) {
  return `${record.w}-${record.l}${record.t ? `-${record.t}` : ""}`;
}

function standingsRows() {
  return Array.isArray(standingsData?.data) ? standingsData.data : Array.isArray(standingsData?.teams) ? standingsData.teams : [];
}

function standingFor(abbreviation) {
  return standingsRows().find((row) => teamAbbr(row?.team ?? row) === abbreviation) ?? null;
}

function standingRecord(row) {
  if (!row) return null;
  if (row?.record) return String(row.record);
  const wins = row?.wins ?? row?.win;
  const losses = row?.losses ?? row?.loss;
  return wins != null && losses != null ? `${wins}-${losses}${row?.ties ? `-${row.ties}` : ""}` : null;
}

function recentForm(target, abbreviation) {
  const targetTime = new Date(target?.date ?? 0).getTime();
  return ordered.filter((row) => {
    const teams = [teamAbbr(row?.home_team), teamAbbr(row?.visitor_team)];
    return isFinal(row) && new Date(row?.date ?? 0).getTime() < targetTime && teams.includes(abbreviation);
  }).slice(-5).map((row) => {
    const home = teamAbbr(row?.home_team);
    const own = Number(home === abbreviation ? row?.home_team_score : row?.visitor_team_score);
    const other = Number(home === abbreviation ? row?.visitor_team_score : row?.home_team_score);
    return own === other ? "T" : own > other ? "W" : "L";
  });
}

function quarterScores(game) {
  const raw = game?.quarter_scores ?? game?.quarterScores ?? game?.line_score ?? game?.lineScore;
  if (Array.isArray(raw)) return raw.map((row, index) => ({ label: row?.label ?? row?.quarter ?? `Q${index + 1}`, home: row?.home ?? row?.home_score, away: row?.away ?? row?.visitor ?? row?.away_score }));
  if (!raw || typeof raw !== "object") return [];
  return Object.entries(raw).map(([label, row]) => ({ label, home: row?.home ?? row?.home_score, away: row?.away ?? row?.visitor ?? row?.away_score }));
}

function comparisonStats(game) {
  const raw = game?.team_stats ?? game?.teamStats ?? game?.statistics?.teams;
  if (Array.isArray(raw)) return raw.filter((row) => row?.label && (row?.home != null || row?.away != null));
  if (!raw || typeof raw !== "object") return [];
  return Object.entries(raw).map(([label, row]) => ({ label, home: row?.home, away: row?.away ?? row?.visitor })).filter((row) => row.home != null || row.away != null);
}

function officialLinks(game) {
  const raw = game?.official_links ?? game?.officialLinks ?? game?.broadcast_links ?? game?.broadcastLinks ?? game?.watch_listen ?? [];
  if (Array.isArray(raw)) return raw.filter((link) => link?.url && link?.label);
  return Object.entries(raw ?? {}).map(([label, url]) => ({ label, url })).filter((link) => typeof link.url === "string");
}

function leaders(rows, abbreviation) {
  const categories = [
    ["Passing", ["passing_yards", "passingYards", "pass_yards"], "yards"],
    ["Rushing", ["rushing_yards", "rushingYards", "rush_yards"], "yards"],
    ["Receiving", ["receiving_yards", "receivingYards", "rec_yards"], "yards"],
    ["Tackles", ["tackles", "total_tackles", "totalTackles"], "tackles"],
    ["Sacks", ["sacks"], "sacks"],
    ["Interceptions", ["interceptions", "defensive_interceptions"], "INT"],
  ];
  return categories.map(([label, keys, unit]) => {
    const ranked = (Array.isArray(rows) ? rows : []).filter((row) => {
      const team = teamAbbr(row?.team ?? row?.player?.team, row?.team_abbreviation ?? row?.teamAbbr ?? "");
      return !team || team === abbreviation;
    }).map((row) => ({ row, value: keys.map((key) => row?.[key]).find((value) => value != null && Number.isFinite(Number(value))) })).filter((item) => item.value != null).sort((a, b) => Number(b.value) - Number(a.value));
    const best = ranked[0];
    if (!best) return null;
    const player = best.row?.player ?? best.row;
    const name = player?.full_name ?? player?.fullName ?? player?.name ?? [player?.first_name, player?.last_name].filter(Boolean).join(" ");
    return name ? { label, unit, name, value: Number(best.value), id: player?.id ?? best.row?.player_id } : null;
  }).filter(Boolean);
}

function scoreText(game) {
  const hs = game?.home_team_score;
  const as = game?.visitor_team_score;

  if (hs === null || hs === undefined || as === null || as === undefined) return "TBD";

  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);

  if (home === "SEA") return `${hs} : ${as}`;
  if (away === "SEA") return `${as} : ${hs}`;
  return `${as} : ${hs}`;
}

function isSeahawksWin(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  if (game?.home_team_score == null || game?.visitor_team_score == null) return null;
  const hs = Number(game.home_team_score);
  const as = Number(game.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  const seaIsHome_ = home === "SEA";
  const seaIsAway = away === "SEA";
  if (!seaIsHome_ && !seaIsAway) return null;

  const seaScore = seaIsHome_ ? hs : as;
  const oppScore = seaIsHome_ ? as : hs;

  if (seaScore === oppScore) return null;
  return seaScore > oppScore;
}

function sortByDate(a, b) {
  const ad = a?.date ? new Date(a.date).getTime() : 0;
  const bd = b?.date ? new Date(b.date).getTime() : 0;
  if (ad !== bd) return ad - bd;
  const aw = Number(a?.week);
  const bw = Number(b?.week);
  if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
  return 0;
}

function getRawGamesLocal() {
  return Array.isArray(scheduleData?.games)
    ? scheduleData.games
    : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
      ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
      : [];
}

function gameKey(g, idx) {
  return String(g?.id ?? g?.game_id ?? idx);
}

/* =======================
   getStaticPaths (SELF-CONTAINED)
   ======================= */
export function getStaticPaths() {
  const rawGames = Array.isArray(scheduleData?.games)
    ? scheduleData.games
    : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
      ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
      : [];

  function sortByDateLocal(a, b) {
    const ad = a?.date ? new Date(a.date).getTime() : 0;
    const bd = b?.date ? new Date(b.date).getTime() : 0;
    if (ad !== bd) return ad - bd;
    const aw = Number(a?.week);
    const bw = Number(b?.week);
    if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
    return 0;
  }

  const ordered = rawGames.slice().sort(sortByDateLocal);

  return ordered.map((g, idx) => ({
    params: { gameId: String(g?.id ?? g?.game_id ?? idx) },
  }));
}

/* =======================
   Page logic
   ======================= */
const { gameId } = Astro.params;

const ordered = getRawGamesLocal().slice().sort(sortByDate);
const idx = ordered.findIndex((g, i) => gameKey(g, i) === String(gameId));
const game = idx >= 0 ? ordered[idx] : null;
const gameSeasonType = game && isPlayoffGame(game) ? "postseason" : "regular season";
const gameContext = getSeasonContext({
  ...scheduleData,
  seasonContext: { ...scheduleData?.seasonContext, seasonType: gameSeasonType },
}, gameSeasonType);
const seasonOptions = getAvailableSeasonContexts(scheduleData, gameSeasonType);

const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

const opp = game ? oppAbbr(game) : "";

const win = game ? isSeahawksWin(game) : null;
const cardClass = win === true ? "card card--win" : win === false ? "card card--loss" : "card";

const recap = gameRecaps?.recaps?.[String(gameId)] || null;

/* =======================
   Seahawks-only player linking
   ======================= */

function getRosterLocal(playersData) {
  if (Array.isArray(playersData?.data)) return playersData.data;
  if (Array.isArray(playersData?.players)) return playersData.players;
  if (Array.isArray(playersData)) return playersData;
  return [];
}

function pidLocal(p) {
  return p?.id ?? p?.player_id ?? p?.player?.id ?? null;
}

function teamLocal(p) {
  const abbr =
    p?.team?.abbreviation ??
    p?.team_abbreviation ??
    p?.teamAbbr ??
    p?.team ??
    "";
  return String(abbr || "").toUpperCase();
}

function nameLocal(p) {
  const obj = p?.player ?? p;
  const first = obj?.first_name ?? obj?.firstName ?? "";
  const last = obj?.last_name ?? obj?.lastName ?? "";
  const full = obj?.name ?? obj?.full_name ?? obj?.fullName ?? "";

  const combined = `${String(first || "").trim()} ${String(last || "").trim()}`.trim();
  const best = combined || String(full || "").trim() || "";
  return best.replace(/\s+/g, " ").trim();
}

// ✅ Build {id -> name} for Seahawks roster
const SEA_PLAYERS = (() => {
  const roster = getRosterLocal(rosterData);
  const out = [];
  for (const p of roster) {
    if (teamLocal(p) !== "SEA") continue;
    const id = pidLocal(p);
    const nm = nameLocal(p);
    if (id === null || id === undefined) continue;
    if (!nm) continue;
    out.push({ id: String(id), name: nm });
  }
  // Prefer longer names first for matching
  out.sort((a, b) => b.name.length - a.name.length);
  return out;
})();

const SEA_PLAYER_IDS = new Set(SEA_PLAYERS.map((x) => x.id));

function playerHref(id) {
  // ✅ match your routing (trailing slash)
  return `/players/${encodeURIComponent(String(id))}/`;
}

function canLinkPlayer(id) {
  const key = String(id ?? "").trim();
  if (!key) return false;
  return SEA_PLAYER_IDS.has(key);
}

/* =======================
   Safe HTML rendering (fixes token leakage + links plain names)
   ======================= */

function escapeHtml(s) {
  return String(s ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function escapeRegex(s) {
  return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// Matches model token blobs like:
// {t:'player', v:'Name', id:123, name:'Name'}
const PLAYER_TOKEN_RE =
  /\{\s*[^}]*\bt\s*:\s*['"]player['"][^}]*\bid\s*:\s*['"]?(\d+)['"]?[^}]*\b(?:name|v)\s*:\s*['"]([^'"]+)['"][^}]*\}\s*/g;

// Match ANY Seahawks full name in plain text
const SEA_NAME_TO_ID = new Map(SEA_PLAYERS.map((x) => [x.name, x.id]));
const SEA_NAMES_RE = SEA_PLAYERS.length
  ? new RegExp(`\\b(?:${SEA_PLAYERS.map((x) => escapeRegex(x.name)).join("|")})\\b`, "g")
  : null;

// Internal marker for token replacement so we can link it reliably
const M1 = "\u0001";
const M2 = "\u0002";
const M3 = "\u0003";

// Render text -> safe html:
// 1) convert embedded {t:'player'...} to either link (SEA) or plain name
// 2) convert plain Seahawks names to links (SEA only)
function renderTextWithSeahawksLinks(input) {
  const raw = String(input ?? "");
  if (!raw) return "";

  // Step 1: replace tokens with markers: \u0001id\u0002name\u0003
  const marked = raw.replace(PLAYER_TOKEN_RE, (_all, id, name) => {
    const safeId = String(id ?? "").trim();
    const safeName = String(name ?? "").trim();
    if (!safeId || !safeName) return "";
    return `${M1}${safeId}${M2}${safeName}${M3}`;
  });

  let html = "";
  let i = 0;

  while (i < marked.length) {
    // Marker-based player mention
    if (marked[i] === M1) {
      const j2 = marked.indexOf(M2, i + 1);
      const j3 = marked.indexOf(M3, j2 + 1);

      if (j2 !== -1 && j3 !== -1) {
        const id = marked.slice(i + 1, j2);
        const name = marked.slice(j2 + 1, j3);

        const safeName = escapeHtml(name);
        if (canLinkPlayer(id)) {
          html += `<a class="player-link" href="${escapeHtml(playerHref(id))}">${safeName}</a>`;
        } else {
          html += safeName;
        }

        i = j3 + 1;
        continue;
      }
      // If marker is malformed, fall through and escape it
    }

    // Name-based linking (plain text)
    if (SEA_NAMES_RE) {
      SEA_NAMES_RE.lastIndex = i;
      const m = SEA_NAMES_RE.exec(marked);

      if (m && m.index === i) {
        const name = m[0];
        const id = SEA_NAME_TO_ID.get(name);

        if (id && canLinkPlayer(id)) {
          html += `<a class="player-link" href="${escapeHtml(playerHref(id))}">${escapeHtml(name)}</a>`;
        } else {
          html += escapeHtml(name);
        }

        i += name.length;
        continue;
      }
    }

    // Default: escape single char
    html += escapeHtml(marked[i]);
    i += 1;
  }

  // Clean up the common "Name"+"word" jam case after anchors (rare but happens)
  html = html.replaceAll(/<\/a>(?=[A-Za-z])/g, "</a> ");

  return html;
}

function renderRecapHtml(recapObj) {
  const segs = Array.isArray(recapObj?.segments) ? recapObj.segments : [];
  let html = "";

  for (const seg of segs) {
    const t = String(seg?.t || "text");
    const display = seg?.name || seg?.v || "";

    if (t === "player") {
      const id = seg?.id;
      const nm = String(display ?? "").trim();
      if (canLinkPlayer(id)) {
        html += `<a class="player-link" href="${escapeHtml(playerHref(id))}">${escapeHtml(nm)}</a>`;
      } else {
        html += escapeHtml(nm);
      }
    } else {
      // ✅ text segments can contain embedded tokens or plain names
      html += renderTextWithSeahawksLinks(seg?.v || "");
    }
  }

  // ✅ In case segments are missing and recapObj is plain string-ish, still safe
  if (!html && recapObj?.text) html = renderTextWithSeahawksLinks(recapObj.text);

  return html;
}

function renderBulletHtml(b) {
  return renderTextWithSeahawksLinks(b);
}

const recapHtml = recap ? renderRecapHtml(recap) : "";
const bulletHtml = recap?.bullets?.map(renderBulletHtml) || [];
const completed = Boolean(game && isFinal(game));
const opponentTeam = game ? (seaIsHome(game) ? game?.visitor_team : game?.home_team) : null;
const opponentName = teamName(opponentTeam, opp);
const rawSeaScore = game ? (seaIsHome(game) ? game?.home_team_score : game?.visitor_team_score) : null;
const rawOpponentScore = game ? (seaIsHome(game) ? game?.visitor_team_score : game?.home_team_score) : null;
const seaScore = rawSeaScore == null ? null : Number(rawSeaScore);
const opponentScore = rawOpponentScore == null ? null : Number(rawOpponentScore);
const validSeaScore = Number.isFinite(seaScore) ? seaScore : null;
const validOpponentScore = Number.isFinite(opponentScore) ? opponentScore : null;
const weekLabel = game ? (isPlayoffGame(game) ? "Playoffs" : Number.isFinite(Number(game?.week)) ? `Week ${game.week}` : "Game") : "Game";
const pageTitle = !game ? "Game not found" : completed
  ? `Seahawks ${validSeaScore ?? "—"}, ${opponentName} ${validOpponentScore ?? "—"} — ${weekLabel} Recap`
  : `Seahawks vs ${opponentName} — ${weekLabel} Preview`;
const pageDescription = !game ? "The requested Seahawks game could not be found." : completed
  ? `Final score, recap, and available statistics for Seattle's ${weekLabel} game against ${opponentName}.`
  : `Matchup information for Seattle's ${weekLabel} game against ${opponentName}.`;
const seaStanding = standingFor("SEA");
const opponentStanding = standingFor(opp);
const seaRecord = standingRecord(seaStanding) ?? (game ? recordText(recordBefore(game, "SEA")) : "—");
const opponentRecord = standingRecord(opponentStanding) ?? "Unavailable";
const divisionRank = seaStanding?.division_rank ?? seaStanding?.divisionRank ?? seaStanding?.division_place;
const divisionContext = divisionRank ? `Seattle is ${divisionRank} in the NFC West in the latest available standings.` : null;
const rawOpponentForm = opponentStanding?.recent_form ?? opponentStanding?.recentForm;
const opponentForm = Array.isArray(rawOpponentForm) ? rawOpponentForm : [];
const quarters = game ? quarterScores(game) : [];
const comparison = game ? comparisonStats(game) : [];
const gamePlayerRows = game?.player_stats ?? game?.playerStats ?? game?.statistics?.players ?? [];
const seaLeaders = leaders(gamePlayerRows, "SEA");
const currentSeasonRows = Number(scheduleData?.playerStatsSeason ?? scheduleData?.season) === Number(scheduleData?.season) && Array.isArray(scheduleData?.playerSeasonStats) ? scheduleData.playerSeasonStats : [];
const seaSeasonLeaders = leaders(currentSeasonRows, "SEA").slice(0, 3);
const opponentLeaderRows = game?.opponent_player_season_stats ?? game?.opponentPlayerSeasonStats ?? [];
const opponentLeaders = leaders(opponentLeaderRows, opp).slice(0, 3);
const turningPoints = game?.turning_points ?? game?.turningPoints ?? game?.scoring_plays ?? game?.scoringPlays ?? recap?.turningPoints ?? [];
const recapText = recap?.text ?? (Array.isArray(recap?.segments) ? recap.segments.map((segment) => segment?.name ?? segment?.v ?? "").join("") : "");
const canonicalPath = `/games/${encodeURIComponent(String(gameId))}`;
const publishedTime = recap?.publishedAt ?? recap?.createdAt ?? gameRecaps?.updatedAt ?? null;
const modifiedTime = recap?.updatedAt ?? gameRecaps?.updatedAt ?? publishedTime;
const articleData = completed && recapText ? { publishedTime, modifiedTime } : null;
const structuredData = articleData ? {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: pageTitle,
  description: pageDescription,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  mainEntityOfPage: new URL(canonicalPath, Astro.site ?? Astro.url).toString(),
  author: { "@type": "Organization", name: "Seahawks Fan Zone" },
  publisher: { "@type": "Organization", name: "Seahawks Fan Zone" },
  about: { "@type": "SportsEvent", name: `Seattle Seahawks vs ${opponentName}`, startDate: game?.date },
} : null;
---

<SeahawksLayout title={pageTitle} description={pageDescription} pageTitle={pageTitle} pageTagline={pageDescription} activePath="" canonical={canonicalPath} article={articleData} structuredData={structuredData}>
  {!game && <div class="empty"><strong>Game unavailable.</strong> This game is not present in the current season schedule. <a href="/schedule">Return to the full schedule →</a></div>}
  {game && <GameCenter
    {game}
    context={gameContext}
    options={seasonOptions}
    previous={prev}
    {next}
    previousHref={prev ? `/games/${encodeURIComponent(gameKey(prev, idx - 1))}` : null}
    nextHref={next ? `/games/${encodeURIComponent(gameKey(next, idx + 1))}` : null}
    opponent={opponentTeam}
    opponentAbbr={opp}
    {completed}
    outcome={win === true ? "W" : win === false ? "L" : null}
    {weekLabel}
    seaScore={validSeaScore}
    opponentScore={validOpponentScore}
    {recapText}
    recapBullets={recap?.bullets ?? []}
    {quarters}
    {comparison}
    {seaLeaders}
    {seaSeasonLeaders}
    {opponentLeaders}
    {seaRecord}
    {opponentRecord}
    seaForm={recentForm(game, "SEA")}
    {opponentForm}
    {divisionContext}
    venue={venueName(game)}
    links={officialLinks(game)}
    turningPoints={Array.isArray(turningPoints) ? turningPoints : []}
    sourceLabel={completed && recap ? "Schedule results and generated recap from repository game data" : "Schedule and season data maintained in this repository"}
    updatedAt={gameRecaps?.updatedAt ?? scheduleData?.updatedAt}
  />}
  <div class="legacy-game-page">
  <SeasonContextView context={gameContext} options={seasonOptions} prefix="Data through" />
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/weekly-recap">Weekly Recap</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
  </div>

  {!game ? (
    <div class="empty">Couldn’t find that game.</div>
  ) : (
    <>
      <article class={cardClass}>
        <div class="card-top">
          <div class="week">
            {isPlayoffGame(game)
              ? (Number.isFinite(Number(game?.week)) ? `Playoffs Week ${game.week}` : "Playoffs")
              : (Number.isFinite(Number(game?.week)) ? `Week ${game.week}` : "Game")}
          </div>
          <div class="date">{fmtPT(game?.date)}</div>
        </div>

        <div class="matchup">
          <div class="team">
            <img class="logo" src={teamLogo("SEA")} alt="SEA logo" width="28" height="28" loading="lazy" decoding="async" />
            <div class="abbr">SEA</div>
            <div class="ha">{seaIsHome(game) ? "H" : "A"}</div>
          </div>

          <div class="at">@</div>

          <div class="team">
            <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} width="28" height="28" loading="lazy" decoding="async" />
            <div class="abbr">{opp}</div>
            <div class="ha">{seaIsHome(game) ? "A" : "H"}</div>
          </div>
        </div>

        <div class="card-bottom">
          <div class="status">{statusText(game)}</div>
          <div class="score">{scoreText(game)}</div>
        </div>

        <div class="links-row">
          {prev ? (
            <a class="pill pill--ghost" href={`/games/${encodeURIComponent(gameKey(prev, idx - 1))}`}>← Prev</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">← Prev</span>
          )}

          {next ? (
            <a class="pill pill--ghost" href={`/games/${encodeURIComponent(gameKey(next, idx + 1))}`}>Next →</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">Next →</span>
          )}
        </div>
      </article>

      <section class="recap">
        <h3 class="section-title">Game recap</h3>

        {!recap ? (
          <div class="empty">Recap coming soon.</div>
        ) : (
          <article class="recap-card">
            <p class="recap-text" set:html={recapHtml} />

            {Array.isArray(recap?.bullets) && recap.bullets.length > 0 && (
              <ul class="recap-bullets">
                {bulletHtml.map((h) => <li set:html={h} />)}
              </ul>
            )}
          </article>
        )}
      </section>
    </>
  )}

  </div>
  <style>
    .legacy-game-page { display: none; }
    .meta-line,
    .card,
    .card-top,
    .matchup,
    .team,
    .card-bottom,
    .week,
    .date,
    .status,
    .score,
    .links-row,
    .recap,
    .recap-card,
    .recap-text,
    .recap-bullets {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .week,
    .date,
    .status,
    .score,
    .empty,
    .section-title,
    .recap-text,
    .recap-bullets {
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .dot { opacity: .5; }

    .section-title {
      color: var(--navy);
      margin: 1.1rem 0 .7rem;
    }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card--win { border-color: rgba(105,190,40,.65); box-shadow: 0 10px 22px rgba(105,190,40,.12); }
    .card--loss { border-color: rgba(220,38,38,.45); box-shadow: 0 10px 22px rgba(220,38,38,.10); }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .6rem;
    }

    .week { font-weight: 900; color: var(--navy); }
    .date { color: rgba(15,23,32,.65); font-weight: 700; }

    .matchup {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .55rem;
      padding: .2rem 0 .65rem;
    }

    .team {
      display: flex;
      align-items: center;
      gap: .55rem;
      justify-content: center;
    }

    .logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      display: block;
      flex: 0 0 auto;
    }

    .abbr { font-weight: 900; color: var(--navy); }
    .ha { font-size: .78rem; color: rgba(15,23,32,.55); font-weight: 800; }
    .at { font-weight: 900; color: rgba(0,34,68,.55); text-align: center; }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      margin-top: .25rem;
    }

    .status { font-weight: 900; color: rgba(0,34,68,.80); }
    .score { font-weight: 900; color: rgba(0,34,68,.90); }

    .links-row{
      display:flex;
      gap:.5rem;
      margin-top:.65rem;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      text-decoration: none;
      user-select: none;
    }
    .pill:hover{ background: rgba(0,34,68,.07); }
    .pill--ghost{ background: transparent; }
    .pill--disabled{
      opacity: .5;
      pointer-events: none;
    }

    .recap { margin-top: 1.1rem; }

    .recap-card{
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.12);
      background: rgba(165,172,175,0.10);
      padding: .9rem 1rem;
      overflow: hidden;
    }

    .recap-text{
      margin: 0;
      line-height: 1.6;
      font-weight: 700;
      color: rgba(0,34,68,.92);
    }

    .recap-bullets{
      margin: .75rem 0 0;
      padding-left: 1.1rem;
    }
    .recap-bullets li{
      margin: .35rem 0;
      line-height: 1.45;
    }

    /* Seahawks players only */
    .player-link{
      font-weight: 900;
      text-decoration: underline;
      white-space: nowrap;
    }
    .player-link:hover{ opacity: .85; }
  </style>
</SeahawksLayout>
