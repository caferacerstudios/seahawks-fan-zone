---
import GameDayPage from "../../components/GameDayPage.astro";
import { gameCollection } from "../../lib/game-details.mjs";
import { EVENTSPY_COVERAGE } from "../../lib/tickets/eventspy-coverage.mjs";
import scheduleData from "../../data/nfl/seahawks.json";

export function getStaticPaths() {
  return gameCollection(scheduleData, EVENTSPY_COVERAGE).map((game, index) => ({
    params: { gameId: String(game?.id ?? game?.game_id ?? index) },
  }));
}

const { gameId } = Astro.params;
---
<GameDayPage {gameId} routeStyle="games" />
