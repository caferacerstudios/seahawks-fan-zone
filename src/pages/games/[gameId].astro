---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import scheduleData from "../../data/nfl/seahawks.json";
import gameRecaps from "../../data/nfl/gameRecaps.json";
import rosterData from "../../data/nfl/players.json";

/* =======================
   Helpers for page render
   ======================= */

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function teamLogo(abbr) {
  return `/images/nfl/teams/${abbr}.png`;
}

function seaIsHome(game) {
  return teamAbbr(game?.home_team) === "SEA";
}

function oppAbbr(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  return home === "SEA" ? away : home;
}

function isPlayoffGame(g) {
  const st = String(g?.seasonType ?? g?.season_type ?? "").toLowerCase();
  if (st.includes("post") || st.includes("playoff")) return true;
  if (g?.postseason === true) return true;
  if (g?.is_postseason === true) return true;
  return false;
}

function fmtPT(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  try {
    return d.toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "short",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  } catch {
    return d.toISOString();
  }
}

function statusText(game) {
  const s = String(game?.status || "").toLowerCase();
  if (s.includes("final")) return "Final";
  if (s.includes("in progress")) return "Live";
  if (s.includes("scheduled")) return "Scheduled";
  return game?.status || "";
}

function scoreText(game) {
  const hs = game?.home_team_score;
  const as = game?.visitor_team_score;

  if (hs === null || hs === undefined || as === null || as === undefined) return "TBD";

  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);

  if (home === "SEA") return `${hs} : ${as}`;
  if (away === "SEA") return `${as} : ${hs}`;
  return `${as} : ${hs}`;
}

function isSeahawksWin(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  const hs = Number(game?.home_team_score);
  const as = Number(game?.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  const seaIsHome_ = home === "SEA";
  const seaIsAway = away === "SEA";
  if (!seaIsHome_ && !seaIsAway) return null;

  const seaScore = seaIsHome_ ? hs : as;
  const oppScore = seaIsHome_ ? as : hs;

  if (seaScore === oppScore) return null;
  return seaScore > oppScore;
}

function sortByDate(a, b) {
  const ad = a?.date ? new Date(a.date).getTime() : 0;
  const bd = b?.date ? new Date(b.date).getTime() : 0;
  if (ad !== bd) return ad - bd;
  const aw = Number(a?.week);
  const bw = Number(b?.week);
  if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
  return 0;
}

function getRawGamesLocal() {
  return Array.isArray(scheduleData?.games)
    ? scheduleData.games
    : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
      ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
      : [];
}

function gameKey(g, idx) {
  return String(g?.id ?? g?.game_id ?? idx);
}

/* =======================
   getStaticPaths (SELF-CONTAINED)
   ======================= */
export function getStaticPaths() {
  const rawGames = Array.isArray(scheduleData?.games)
    ? scheduleData.games
    : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
      ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
      : [];

  function sortByDateLocal(a, b) {
    const ad = a?.date ? new Date(a.date).getTime() : 0;
    const bd = b?.date ? new Date(b.date).getTime() : 0;
    if (ad !== bd) return ad - bd;
    const aw = Number(a?.week);
    const bw = Number(b?.week);
    if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
    return 0;
  }

  const ordered = rawGames.slice().sort(sortByDateLocal);

  return ordered.map((g, idx) => ({
    params: { gameId: String(g?.id ?? g?.game_id ?? idx) },
  }));
}

/* =======================
   Page logic
   ======================= */
const { gameId } = Astro.params;

const ordered = getRawGamesLocal().slice().sort(sortByDate);
const idx = ordered.findIndex((g, i) => gameKey(g, i) === String(gameId));
const game = idx >= 0 ? ordered[idx] : null;

const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;

const opp = game ? oppAbbr(game) : "";

const win = game ? isSeahawksWin(game) : null;
const cardClass = win === true ? "card card--win" : win === false ? "card card--loss" : "card";

const pageTitle = game
  ? `${isPlayoffGame(game) ? "Playoffs" : (Number.isFinite(Number(game?.week)) ? `Week ${game.week}` : "Game")} — SEA vs ${opp}`
  : "Game not found";

const recap = gameRecaps?.recaps?.[String(gameId)] || null;

/* =======================
   Seahawks-only player linking
   ======================= */

function getRosterLocal(playersData) {
  if (Array.isArray(playersData?.data)) return playersData.data;
  if (Array.isArray(playersData?.players)) return playersData.players;
  if (Array.isArray(playersData)) return playersData;
  return [];
}

function pidLocal(p) {
  return p?.id ?? p?.player_id ?? p?.player?.id ?? null;
}

function teamLocal(p) {
  const abbr =
    p?.team?.abbreviation ??
    p?.team_abbreviation ??
    p?.teamAbbr ??
    p?.team ??
    "";
  return String(abbr || "").toUpperCase();
}

// ✅ Set of Seahawks player IDs we are allowed to link
const SEA_PLAYER_IDS = (() => {
  const out = new Set();
  const roster = getRosterLocal(rosterData);
  for (const p of roster) {
    if (teamLocal(p) !== "SEA") continue;
    const id = pidLocal(p);
    if (id === null || id === undefined) continue;
    out.add(String(id));
  }
  return out;
})();

function playerHref(id) {
  return `/players/${encodeURIComponent(String(id))}`;
}

function canLinkPlayer(id) {
  const key = String(id ?? "").trim();
  if (!key) return false;
  return SEA_PLAYER_IDS.has(key);
}

/* =======================
   Safe HTML rendering (fixes token leakage everywhere)
   ======================= */

function escapeHtml(s) {
  return String(s ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

// Matches model token blobs like:
// {t:'player', v:'Name', id:123, name:'Name'}
// Works even if fields are in different order, id is quoted, etc.
const PLAYER_TOKEN_RE =
  /\{\s*[^}]*\bt\s*:\s*['"]player['"][^}]*\bid\s*:\s*['"]?(\d+)['"]?[^}]*\b(?:name|v)\s*:\s*['"]([^'"]+)['"][^}]*\}\s*/g;

// Render a plain text string into SAFE html, but convert any embedded player tokens:
// - Seahawks players => link
// - everyone else => plain text (no link)
function renderTextWithSeahawksLinks(input) {
  const s = String(input ?? "");
  if (!s) return "";

  let html = "";
  let lastIdx = 0;

  for (const m of s.matchAll(PLAYER_TOKEN_RE)) {
    const start = m.index ?? 0;
    const end = start + m[0].length;

    const id = m[1];
    const name = m[2];

    // text before token
    html += escapeHtml(s.slice(lastIdx, start));

    // token replacement
    const safeName = escapeHtml(name);
    if (canLinkPlayer(id)) {
      html += `<a class="player-link" href="${escapeHtml(playerHref(id))}">${safeName}</a>`;
    } else {
      html += safeName;
    }

    lastIdx = end;
  }

  // remainder
  html += escapeHtml(s.slice(lastIdx));

  // ✅ fix common spacing issue: "Name" + "rushed" => "Name rushed"
  // Only adds a space when a letter follows a closing anchor/name without whitespace/punct.
  html = html.replaceAll(/<\/a>(?=[A-Za-z])/g, "</a> ");
  html = html.replaceAll(/([a-zA-Z])(?=[A-Za-z])/g, "$1"); // no-op, keeps safe

  return html;
}

function renderRecapHtml(recapObj) {
  const segs = Array.isArray(recapObj?.segments) ? recapObj.segments : [];
  let html = "";

  for (const seg of segs) {
    const t = String(seg?.t || "text");
    const display = seg?.name || seg?.v || "";

    if (t === "player") {
      const id = seg?.id;
      const safeName = escapeHtml(display);
      if (canLinkPlayer(id)) {
        html += `<a class="player-link" href="${escapeHtml(playerHref(id))}">${safeName}</a>`;
      } else {
        html += safeName;
      }
    } else {
      // ✅ even "text" segments may contain embedded {t:'player'...} blobs — fix them
      html += renderTextWithSeahawksLinks(seg?.v || "");
    }
  }

  return html;
}

function renderBulletHtml(b) {
  // ✅ bullet strings may contain embedded tokens anywhere
  return renderTextWithSeahawksLinks(b);
}

const recapHtml = recap ? renderRecapHtml(recap) : "";
const bulletHtml = recap?.bullets?.map(renderBulletHtml) || [];
---

<SeahawksLayout title={pageTitle} description="Single game page." activePath="">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/weekly-recap">Weekly Recap</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
  </div>

  {!game ? (
    <div class="empty">Couldn’t find that game.</div>
  ) : (
    <>
      <article class={cardClass}>
        <div class="card-top">
          <div class="week">
            {isPlayoffGame(game)
              ? (Number.isFinite(Number(game?.week)) ? `Playoffs Week ${game.week}` : "Playoffs")
              : (Number.isFinite(Number(game?.week)) ? `Week ${game.week}` : "Game")}
          </div>
          <div class="date">{fmtPT(game?.date)}</div>
        </div>

        <div class="matchup">
          <div class="team">
            <img class="logo" src={teamLogo("SEA")} alt="SEA logo" loading="lazy" />
            <div class="abbr">SEA</div>
            <div class="ha">{seaIsHome(game) ? "H" : "A"}</div>
          </div>

          <div class="at">@</div>

          <div class="team">
            <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} loading="lazy" />
            <div class="abbr">{opp}</div>
            <div class="ha">{seaIsHome(game) ? "A" : "H"}</div>
          </div>
        </div>

        <div class="card-bottom">
          <div class="status">{statusText(game)}</div>
          <div class="score">{scoreText(game)}</div>
        </div>

        <div class="links-row">
          {prev ? (
            <a class="pill pill--ghost" href={`/games/${encodeURIComponent(gameKey(prev, idx - 1))}`}>← Prev</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">← Prev</span>
          )}

          {next ? (
            <a class="pill pill--ghost" href={`/games/${encodeURIComponent(gameKey(next, idx + 1))}`}>Next →</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">Next →</span>
          )}
        </div>
      </article>

      <section class="recap">
        <h3 class="section-title">Game recap</h3>

        {!recap ? (
          <div class="empty">Recap coming soon.</div>
        ) : (
          <article class="recap-card">
            <p class="recap-text" set:html={recapHtml} />

            {Array.isArray(recap?.bullets) && recap.bullets.length > 0 && (
              <ul class="recap-bullets">
                {bulletHtml.map((h) => <li set:html={h} />)}
              </ul>
            )}
          </article>
        )}
      </section>
    </>
  )}

  <style>
    .meta-line,
    .card,
    .card-top,
    .matchup,
    .team,
    .card-bottom,
    .week,
    .date,
    .status,
    .score,
    .links-row,
    .recap,
    .recap-card,
    .recap-text,
    .recap-bullets {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .week,
    .date,
    .status,
    .score,
    .empty,
    .section-title,
    .recap-text,
    .recap-bullets {
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .dot { opacity: .5; }

    .section-title {
      color: var(--navy);
      margin: 1.1rem 0 .7rem;
    }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card--win { border-color: rgba(105,190,40,.65); box-shadow: 0 10px 22px rgba(105,190,40,.12); }
    .card--loss { border-color: rgba(220,38,38,.45); box-shadow: 0 10px 22px rgba(220,38,38,.10); }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .6rem;
    }

    .week { font-weight: 900; color: var(--navy); }
    .date { color: rgba(15,23,32,.65); font-weight: 700; }

    .matchup {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .55rem;
      padding: .2rem 0 .65rem;
    }

    .team {
      display: flex;
      align-items: center;
      gap: .55rem;
      justify-content: center;
    }

    .logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      display: block;
      flex: 0 0 auto;
    }

    .abbr { font-weight: 900; color: var(--navy); }
    .ha { font-size: .78rem; color: rgba(15,23,32,.55); font-weight: 800; }
    .at { font-weight: 900; color: rgba(0,34,68,.55); text-align: center; }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      margin-top: .25rem;
    }

    .status { font-weight: 900; color: rgba(0,34,68,.80); }
    .score { font-weight: 900; color: rgba(0,34,68,.90); }

    .links-row{
      display:flex;
      gap:.5rem;
      margin-top:.65rem;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      text-decoration: none;
      user-select: none;
    }
    .pill:hover{ background: rgba(0,34,68,.07); }
    .pill--ghost{ background: transparent; }
    .pill--disabled{
      opacity: .5;
      pointer-events: none;
    }

    .recap { margin-top: 1.1rem; }

    .recap-card{
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.12);
      background: rgba(165,172,175,0.10);
      padding: .9rem 1rem;
      overflow: hidden;
    }

    .recap-text{
      margin: 0;
      line-height: 1.6;
      font-weight: 700;
      color: rgba(0,34,68,.92);
    }

    .recap-bullets{
      margin: .75rem 0 0;
      padding-left: 1.1rem;
    }
    .recap-bullets li{
      margin: .35rem 0;
      line-height: 1.45;
    }

    /* Seahawks players only */
    .player-link{
      font-weight: 900;
      text-decoration: underline;
      white-space: nowrap;
    }
    .player-link:hover{ opacity: .85; }
  </style>
</SeahawksLayout>
