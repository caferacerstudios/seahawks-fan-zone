---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";

const pageTitle = "Privacy Policy";
const pageTagline = "How data is handled on this site";

const updated = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles",
  dateStyle: "long",
}).format(new Date());
---

<SeahawksLayout pageTitle={pageTitle} pageTagline={pageTagline} activePath="/privacy-policy">
  <section class="sfz-card">
    <p class="sfz-updated"><strong>Last updated:</strong> {updated} (Pacific Time)</p>

    <h2>Overview</h2>
    <p>
      Seahawks Fan Zone is a stats-focused fan site. We aim to collect as little personal information as possible.
      This policy explains what information may be collected automatically when you use the site, especially if advertising is enabled.
    </p>

    <h2>Information we may collect</h2>
    <ul class="sfz-list">
      <li>
        <strong>Basic usage data:</strong> like pages viewed and approximate device information, typically collected via server logs or analytics.
      </li>
      <li>
        <strong>IP address:</strong> may appear in server logs for security, abuse prevention, and basic diagnostics.
      </li>
      <li>
        <strong>Cookies and similar technologies:</strong> used for site functionality and, if enabled, advertising and analytics.
      </li>
    </ul>

    <h2>Advertising</h2>
    <p>
      This site may show ads provided by third-party ad networks (for example, Google AdSense).
      Ad networks may use cookies or similar technologies to:
    </p>
    <ul class="sfz-list">
      <li>deliver and measure advertisements</li>
      <li>limit repeated ads</li>
      <li>report aggregated performance metrics</li>
      <li>in some cases, personalize ads based on your interests</li>
    </ul>

    <p>
      If you prefer fewer personalized ads, you can adjust ad personalization settings in your Google account (if applicable)
      and use browser controls to limit cookies. Some ad features may not work correctly if cookies are disabled.
    </p>

    <h2>Analytics</h2>
    <p>
      This site may use analytics to understand what pages are useful and to improve performance.
      Analytics tools typically collect aggregated usage information, not sensitive personal details.
    </p>

    <h2>Cookies</h2>
    <p>
      Cookies are small text files stored by your browser. This site may use cookies for:
      site functionality, basic preferences, measuring traffic, and ad delivery if ads are enabled.
    </p>

    <h2>Sharing</h2>
    <p>
      We do not sell your personal information. Data may be shared with service providers only as needed to operate the site,
      such as hosting, analytics, and advertising providers.
    </p>

    <h2>External links</h2>
    <p>
      This site may link to external sites. We are not responsible for the privacy practices of those sites.
    </p>

    <h2>Children</h2>
    <p>
      This site is not intended for children under 13. If you believe a child has provided personal information, contact us and we will address it.
    </p>

    <h2>Contact</h2>
    <p>
      If you have privacy questions, contact: <a href="mailto:laura@caferacerstudios.com">laura@caferacerstudios.com</a>
    </p>
  </section>

  <style>
    .sfz-card {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      padding: 1rem 1.05rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      margin-bottom: 0.95rem;
    }

    .sfz-updated {
      margin: 0 0 0.9rem;
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
    }

    .sfz-card h2 {
      margin: 0.9rem 0 0.55rem;
      color: var(--navy);
      font-weight: 900;
    }

    .sfz-card p {
      margin: 0 0 0.75rem;
      color: rgba(15, 23, 32, 0.78);
      line-height: 1.6;
      font-weight: 650;
    }

    .sfz-list {
      margin: 0 0 0.75rem;
      padding-left: 1.2rem;
      color: rgba(15, 23, 32, 0.75);
      line-height: 1.55;
      font-weight: 650;
    }

    .sfz-list li {
      margin: 0.3rem 0;
    }

    .sfz-muted {
      color: rgba(15, 23, 32, 0.6);
      font-weight: 650;
      font-size: 0.95rem;
    }
  </style>
</SeahawksLayout>
