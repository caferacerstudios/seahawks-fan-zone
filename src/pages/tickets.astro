---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import {TICKET_FEATURE} from "../lib/tickets/config";
---
<SeahawksLayout title="Seahawks vs. Patriots Tickets" description="EventSpy price history for Seattle Seahawks vs. New England Patriots." seo={{title:"Seahawks vs. Patriots Tickets | Seahawks Fan Zone",description:"Week 1 ticket price comparison.",canonicalPath:TICKET_FEATURE.canonical?"/tickets":null,robots:TICKET_FEATURE.robots}} activePath="/tickets" pageType="tickets" monetizationEligible={false} showPageHeader={false}>
<section id="eventspy-mirror" aria-live="polite"><div class="loading" role="status"><p>Loading event prices…</p></div></section>
</SeahawksLayout>
<style is:global>
body:has(#eventspy-mirror) .lr-middle{max-width:none}body:has(#eventspy-mirror) .lr-main,body:has(#eventspy-mirror) .lr-paper{width:100%;max-width:none;margin:0;padding:0;background:#f4f6f8;box-shadow:none}body:has(#eventspy-mirror) .seo-breadcrumbs{display:none}#eventspy-mirror{width:min(1180px,calc(100% - 2rem));margin:1.5rem auto 3rem;color:#0b1f35}.loading{min-height:36rem;display:grid;place-content:center}.event-head{background:#002244;color:#fff;padding:clamp(1.4rem,4vw,3rem);border-bottom:6px solid #69be28}.event-head h1{color:#fff;font-size:clamp(2rem,5vw,3.5rem);margin:0 0 .8rem}.event-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-weight:700}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:1.25rem 0}.card{background:#fff;border:1px solid #d6dde3;border-top:5px solid #69be28;padding:1.25rem;text-align:center}.card h2{font-size:.85rem;text-transform:uppercase}.price,.days{font:900 clamp(2rem,4vw,3rem)/1 var(--font-display);margin:.7rem 0;color:#002244}.price.current{color:#228b22}.age,.disclosure{font-size:.82rem;color:#536171}.low-badge{background:#e5f6da;color:#225d0a;padding:.25rem .6rem;border-radius:999px;font-weight:900}.starting,.providers-title{text-align:center}.providers{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap;margin:1rem auto 1.5rem}.providers a{min-height:46px;display:inline-flex;align-items:center;padding:.65rem 1rem;background:#fff;border:2px solid #002244;font-weight:900;text-decoration:none}.track{display:flex;width:max-content;margin:0 auto 2.5rem;padding:.8rem 1.25rem;background:#69be28;color:#002244;font-weight:900;text-decoration:none}.history-panel,.faq{background:#fff;padding:clamp(1rem,3vw,2rem);border:1px solid #d6dde3}.history-top{display:flex;justify-content:space-between;gap:1rem;align-items:end;flex-wrap:wrap}.history-top h2{margin:.2rem 0}.subtitle{color:#536171}.controls,.filters,.legend{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center}.controls button,.controls select{min-height:44px;border:2px solid #002244;background:#fff;padding:.5rem .8rem;font-weight:800}.controls button[aria-pressed=true]{background:#002244;color:#fff}.filters{padding:.8rem 0}.legend span::before{content:"";display:inline-block;width:1.2rem;border-top:4px solid var(--c);margin-right:.35rem}.chart-wrap{position:relative;overflow:auto}.chart{display:block;width:100%;min-width:650px;border:1px solid #d6dde3}.grid{stroke:#d9dee4}.axis{fill:#536171;font-size:12px}.series{fill:none;stroke-width:3}.endpoint{stroke:#fff;stroke-width:2}.point-hit{fill:transparent}.tooltip{position:absolute;background:#002244;color:#fff;padding:.55rem;font-size:.8rem;white-space:pre-line;pointer-events:none}.table-wrap{overflow:auto;margin-top:1rem}table{width:100%;border-collapse:collapse}th,td{padding:.55rem;border:1px solid #d6dde3;white-space:nowrap}.faq{margin-top:1.5rem}.faq article+article{border-top:1px solid #d6dde3}.disclosure{margin:1.5rem 0}.error{min-height:25rem;padding:2rem;background:#fff;border-left:5px solid #c33}.stale{background:#fff1c7;padding:.5rem;text-align:center;font-weight:800}:is(a,button,select,input):focus-visible,.point-hit:focus{outline:3px solid #69be28;outline-offset:3px}@media(max-width:650px){#eventspy-mirror{width:calc(100% - 1rem)}.cards{grid-template-columns:1fr}.event-meta{display:grid}}@media(prefers-reduced-motion:reduce){#eventspy-mirror *{animation:none!important;transition:none!important}}
</style>
<script>
import {validateEventSpyMirror,MIRROR_MARKETS} from "../lib/tickets/eventspy-mirror-schema.mjs";
const DATA_URL="/data/eventspy-mirror/1392216.json",names={vividseats:"VividSeats",stubhub:"StubHub",ticketmaster:"Ticketmaster",seatgeek:"SeatGeek"},order=["vividseats","stubhub","ticketmaster","seatgeek"],colors={vividseats:"#e83e9f",stubhub:"#5f2bd6",ticketmaster:"#165dff",seatgeek:"#ff5945"},root=document.querySelector("#eventspy-mirror"),money=c=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(c/100),esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),date=s=>new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",year:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(s));
function content(v){const stale=Date.now()-Date.parse(v.collectedAt)>26*3600e3;return `${stale?`<p class="stale" role="status">Last updated ${date(v.collectedAt)} — stored prices may be stale.</p>`:""}<header class="event-head"><h1 data-event-title>${esc(v.event.title)}</h1><div class="event-meta"><span data-event-venue>${esc(v.event.venue)}</span><span data-event-location>${esc(v.event.location)}</span><span data-event-datetime>${esc(v.event.localDate)} · ${esc(v.event.localTimeLabel)}</span></div></header><div class="cards"><article class="card"><h2>Days Until Event</h2><p class="days" data-days-until>${v.summary.daysUntilEvent}</p></article><article class="card"><h2>Current Lowest</h2><p class="price current" data-current-lowest>${money(v.summary.currentLowestCents)}</p><p class="age">${esc(v.summary.currentLowestAgeLabel)}</p>${v.summary.atSevenDayLow?'<span class="low-badge">At 7-day low</span>':""}</article><article class="card"><h2>7-Day Lowest</h2><p class="price" data-seven-day-lowest>${money(v.summary.sevenDayLowestCents)}</p><p class="age">${esc(v.summary.sevenDayLowestAgeLabel)}</p></article></div><p class="starting">Tickets currently start at <strong>${money(v.summary.currentLowestCents)}</strong>.</p><h2 class="providers-title">View Tickets</h2><div class="providers">${MIRROR_MARKETS.map(m=>`<a data-provider="${m}" href="${esc(v.providerLinks[m])}" target="_blank" rel="sponsored nofollow noopener">${names[m]} ↗</a>`).join("")}</div><a class="track" href="${v.trackingUrl}" target="_blank" rel="nofollow noopener">Track prices on EventSpy</a><section class="history-panel"><div class="history-top"><div><h2>Lowest Ticket Price History</h2><p class="subtitle">Compare displayed lowest prices across four marketplaces.</p></div><div class="controls"><button data-range="30" aria-pressed="true">30d</button><button data-range="14" aria-pressed="false">14d</button><button data-range="7" aria-pressed="false">7d</button><button data-show-filters aria-expanded="false">Show Filters</button><label>View <select data-market-selector><option value="combined">Combined</option>${order.map(m=>`<option value="${m}">${names[m]}</option>`).join("")}</select></label></div></div><div class="filters" hidden>${order.map(m=>`<label><input type="checkbox" data-filter="${m}" checked> ${names[m]}</label>`).join("")}</div><p class="legend">${order.map(m=>`<span style="--c:${colors[m]}">${names[m]}</span>`).join("")}</p><div class="chart-wrap"><svg class="chart" viewBox="0 0 1000 390" role="img" aria-label="Lowest ticket price history" data-history-chart></svg><div class="tooltip" hidden></div></div><details><summary>Accessible price history table</summary><div class="table-wrap"><table><caption>EventSpy displayed price history in USD</caption><thead><tr><th>Date</th>${order.map(m=>`<th>${names[m]}</th>`).join("")}</tr></thead><tbody></tbody></table></div></details></section><section class="faq"><h2>Frequently Asked Questions</h2><article><h3>What is the current starting price?</h3><p>The displayed current starting price is ${money(v.summary.currentLowestCents)}.</p></article><article><h3>What is the recent low?</h3><p>The displayed 7-day low is ${money(v.summary.sevenDayLowestCents)}.</p></article><article><h3>Which marketplace is currently cheapest?</h3><p>${v.summary.currentLowestMarketplace?`${names[v.summary.currentLowestMarketplace]} is lowest in the latest chart point.`:"The latest chart point does not identify one unambiguous cheapest marketplace."}</p></article></section><p class="disclosure"><strong>Affiliate and source disclosure:</strong> Prices and outbound links are attributed to the authorized EventSpy page and can change. Seahawks Fan Zone may earn a commission. Verify availability, fees, and checkout totals.</p>`}
function renderChart(v,days=30,selected="combined"){const svg=root.querySelector("[data-history-chart]"),end=Date.parse(v.history.at(-1).observedAt),points=v.history.filter(p=>Date.parse(p.observedAt)>=end-days*864e5),shown=selected==="combined"?order.filter(m=>root.querySelector(`[data-filter="${m}"]`).checked):[selected],values=points.flatMap(p=>shown.map(m=>p[`${m}Cents`])).filter(Number.isSafeInteger),lo=Math.min(...values),hi=Math.max(...values),W=1000,H=390,L=85,R=25,T=20,B=45,x=i=>points.length<2?L:L+i/(points.length-1)*(W-L-R),y=n=>T+(hi-n)/Math.max(1,hi-lo)*(H-T-B),ns="http://www.w3.org/2000/svg";svg.replaceChildren();for(let i=0;i<5;i++){const yy=T+i*(H-T-B)/4,line=document.createElementNS(ns,"line"),label=document.createElementNS(ns,"text"),val=Math.round(hi-i*(hi-lo)/4);for(const[k,z]of Object.entries({x1:L,x2:W-R,y1:yy,y2:yy}))line.setAttribute(k,z);line.setAttribute("class","grid");label.setAttribute("x","4");label.setAttribute("y",yy+4);label.setAttribute("class","axis");label.textContent=money(val);svg.append(line,label)}for(const m of order){const g=document.createElementNS(ns,"g");g.dataset.historySeries=m;g.style.display=shown.includes(m)?"":"none";let d="",open=false,last;points.forEach((p,i)=>{const n=p[`${m}Cents`];if(!Number.isSafeInteger(n)){open=false;return}d+=`${open?"L":"M"}${x(i)},${y(n)} `;open=true;last={i,n}});const path=document.createElementNS(ns,"path");path.setAttribute("d",d);path.setAttribute("stroke",colors[m]);path.setAttribute("class","series");g.append(path);if(last){const c=document.createElementNS(ns,"circle");for(const[k,z]of Object.entries({cx:x(last.i),cy:y(last.n),r:6,fill:colors[m]}))c.setAttribute(k,z);c.setAttribute("class","endpoint");g.append(c)}svg.append(g)}points.forEach((p,i)=>{const hit=document.createElementNS(ns,"circle");for(const[k,z]of Object.entries({cx:x(i),cy:(H-B)/2,r:18,tabindex:0,role:"button"}))hit.setAttribute(k,z);hit.setAttribute("class","point-hit");hit.setAttribute("aria-label",`${date(p.observedAt)}; ${order.map(m=>`${names[m]} ${p[`${m}Cents`]===null?"not available":money(p[`${m}Cents`])}`).join("; ")}`);hit.onfocus=hit.onmouseenter=()=>showTip(hit,p);hit.onmouseleave=()=>root.querySelector(".tooltip").hidden=true;svg.append(hit)});root.querySelector("tbody").innerHTML=points.map(p=>`<tr><th>${date(p.observedAt)}</th>${order.map(m=>`<td>${p[`${m}Cents`]===null?"—":money(p[`${m}Cents`])}</td>`).join("")}</tr>`).join("");svg.dataset.visiblePoints=String(points.length)}
function showTip(node,p){const tip=root.querySelector(".tooltip"),b=node.getBoundingClientRect(),w=root.querySelector(".chart-wrap").getBoundingClientRect();tip.textContent=`${date(p.observedAt)}\n${order.map(m=>`${names[m]}: ${p[`${m}Cents`]===null?"—":money(p[`${m}Cents`])}`).join("\n")}`;tip.style.left=`${b.left-w.left+20}px`;tip.style.top=`${b.top-w.top}px`;tip.hidden=false}
function activate(v){let days=30,selected="combined";root.querySelectorAll("[data-range]").forEach(b=>b.onclick=()=>{days=Number(b.dataset.range);root.querySelectorAll("[data-range]").forEach(x=>x.setAttribute("aria-pressed",String(x===b)));renderChart(v,days,selected)});const filters=root.querySelector(".filters"),show=root.querySelector("[data-show-filters]");show.onclick=()=>{filters.hidden=!filters.hidden;show.setAttribute("aria-expanded",String(!filters.hidden))};filters.onchange=()=>renderChart(v,days,selected);root.querySelector("[data-market-selector]").onchange=e=>{selected=e.target.value;renderChart(v,days,selected)};renderChart(v);Object.assign(root.dataset,{eventspyMirrorReady:"true",gameId:v.gameId,historyPoints:String(v.history.length),providerLinks:"4",currentLowestCents:String(v.summary.currentLowestCents),sevenDayLowestCents:String(v.summary.sevenDayLowestCents),collectedAt:v.collectedAt})}
async function load(){const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);try{const game=new URLSearchParams(location.search).get("game");if(game&&game!=="1392216")throw Error();const response=await fetch(DATA_URL,{cache:"no-store",headers:{accept:"application/json"},signal:controller.signal});if(!response.ok)throw Error();const value=validateEventSpyMirror(await response.json());root.innerHTML=content(value);activate(value)}catch{root.innerHTML='<div class="error" role="alert"><h1>Event prices unavailable</h1><p>The validated EventSpy snapshot could not be loaded.</p></div>'}finally{clearTimeout(timer)}}load();
</script>
