---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import {TICKET_FEATURE} from "../lib/tickets/config";
---
<SeahawksLayout title="Seahawks Tickets" description="Ticket price history for Seattle Seahawks games." seo={{title:"Seahawks Tickets | Seahawks Fan Zone",description:"Season-wide Seahawks ticket price history.",canonicalPath:TICKET_FEATURE.canonical?"/tickets":null,robots: TICKET_FEATURE.robots}} activePath="/tickets" pageType="tickets" monetizationEligible={false} showPageHeader={false}>
<section id="ticket-price-explorer" aria-live="polite" aria-busy="true"><div class="loading" role="status"><p>Loading ticket prices…</p></div></section>
</SeahawksLayout>
<style is:global>
body:has(#ticket-price-explorer) .lr-middle{max-width:none}body:has(#ticket-price-explorer) .lr-main,body:has(#ticket-price-explorer) .lr-paper{width:100%;max-width:none;margin:0;padding:0;background:#f3f5f7;box-shadow:none}body:has(#ticket-price-explorer) .seo-breadcrumbs{display:none}.skip-link{position:fixed;left:.75rem;top:.75rem;transform:translateY(-200%);z-index:1000}.skip-link:focus{transform:none}#ticket-price-explorer{--navy:#002244;--green:#69be28;--ink:#0b1f35;--muted:#536171;--line:#d7dfe6;--surface:#fff;--soft:#f7f9fa;--shadow:0 8px 24px rgba(0,34,68,.08);width:min(1160px,calc(100% - 3rem));margin:clamp(1.25rem,3vw,2rem) auto 3.5rem;color:var(--ink)}.loading{min-height:28rem;display:grid;place-content:center}.game-picker{display:grid;grid-template-columns:minmax(12rem,auto) minmax(0,1fr);gap:.55rem 1.25rem;align-items:center;margin:0 0 1.25rem;padding:1rem 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:.75rem;box-shadow:0 2px 10px rgba(0,34,68,.05)}.game-picker label{font-size:1rem;font-weight:800}.game-picker select{width:100%;min-width:0;min-height:48px;border:1px solid #8c9aa7;border-radius:.45rem;padding:.65rem 2.5rem .65rem .85rem;background:#fff;color:var(--ink);font:700 1rem/1.3 inherit}.event-head{position:relative;overflow:hidden;background:var(--navy);color:#fff;padding:clamp(1.5rem,3.5vw,2.5rem);border-radius:1rem;border-bottom:6px solid var(--green);box-shadow:var(--shadow)}.event-head:after{content:"";position:absolute;inset:0 0 0 auto;width:28%;background:linear-gradient(135deg,transparent,rgba(105,190,40,.1));pointer-events:none}.eyebrow{position:relative;z-index:1;margin:0 0 .45rem;color:#c9e7b5;font-size:.85rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.event-head h1{position:relative;z-index:1;max-width:900px;color:#fff;font-size:clamp(2rem,4.5vw,3.35rem);line-height:1.05;margin:0 0 1.15rem;text-wrap:balance}.event-meta{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,max-content);gap:.35rem 1.75rem;font-size:.98rem;font-weight:700}.event-meta span{display:flex;align-items:center}.event-meta span+span:before{content:"";width:4px;height:4px;margin-right:1.75rem;border-radius:50%;background:var(--green)}.last-checked{position:relative;z-index:1;display:inline-flex;margin:1rem 0 0;padding:.4rem .65rem;border:1px solid rgba(255,255,255,.26);border-radius:.4rem;background:rgba(255,255,255,.08);font-size:.9rem;font-weight:800}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.25rem 0;align-items:stretch}.card{display:flex;min-height:11rem;flex-direction:column;align-items:center;justify-content:center;background:var(--surface);border:1px solid var(--line);border-radius:.8rem;padding:1.25rem;text-align:center;box-shadow:0 4px 16px rgba(0,34,68,.06)}.card.current-lowest{border-color:#9bcf77;box-shadow:inset 0 4px 0 var(--green),0 6px 18px rgba(45,111,19,.1)}.card h2{margin:0;color:var(--muted);font-size:.95rem;letter-spacing:.035em;text-transform:uppercase}.price,.days{font:900 clamp(2.15rem,4vw,3rem)/1 var(--font-display);margin:.7rem 0;color:var(--navy)}.price.current{color:#245f12}.age,.disclosure{font-size:.9rem;line-height:1.55;color:var(--muted)}.age{margin:0}.low-badge{display:inline-flex;align-items:center;min-height:28px;background:#e6f4dc;color:#225d0a;border:1px solid #acd18e;padding:.2rem .65rem;border-radius:999px;font-size:.82rem;font-weight:900}.card .low-badge{margin-top:.65rem}.starting{margin:1.5rem 0 .25rem;text-align:center;color:var(--muted)}.starting strong{color:var(--ink)}.providers-title{margin:.3rem 0 0;text-align:center;font-size:clamp(1.55rem,3vw,2rem)}.providers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1rem auto 2rem}.provider-card{position:relative;min-width:0;min-height:12rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:1.25rem;background:var(--surface);border:1px solid #bdc8d1;border-radius:.8rem;color:var(--ink);text-decoration:none;box-shadow:0 3px 12px rgba(0,34,68,.06);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.provider-card:hover{transform:translateY(-2px);border-color:var(--navy);box-shadow:var(--shadow)}.provider-card[data-lowest-price="true"]{border:2px solid #4f981f;background:linear-gradient(180deg,#f5fbf1 0,#fff 45%);box-shadow:inset 0 4px 0 var(--green),0 6px 20px rgba(45,111,19,.12)}.provider-name{padding-right:1.5rem;font-size:1.1rem;font-weight:900}.provider-label,.provider-age{font-size:.88rem;color:var(--muted)}.provider-price{max-width:100%;font:900 clamp(1.65rem,3vw,2.15rem)/1 var(--font-display);margin:.55rem 0;color:var(--navy);overflow-wrap:anywhere}.provider-external{position:absolute;right:1rem;top:.9rem;color:#245f12;font-size:1.15rem;font-weight:900}.provider-card .low-badge{margin-top:.75rem}.history-panel{background:var(--surface);padding:clamp(1.1rem,3vw,2rem);border:1px solid var(--line);border-radius:1rem;box-shadow:var(--shadow)}.history-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;align-items:end}.history-top h2{margin:0 0 .35rem;font-size:clamp(1.55rem,3vw,2rem)}.subtitle{max-width:38rem;margin:0;color:var(--muted);line-height:1.5}.controls{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;justify-content:flex-end}.controls button,.controls select{min-height:44px;border:1px solid #8c9aa7;border-radius:.4rem;background:#fff;padding:.55rem .8rem;color:var(--ink);font-weight:800}.controls button:hover{border-color:var(--navy);background:#eef2f5}.controls button[aria-pressed=true]{border-color:var(--navy);background:var(--navy);color:#fff}.controls label{margin-left:.35rem;font-size:.9rem;font-weight:800}.legend{display:flex;gap:.7rem 1.25rem;flex-wrap:wrap;align-items:center;margin:1.25rem 0 .75rem;padding:0;list-style:none}.legend li{display:flex;align-items:center;font-size:.9rem;font-weight:700}.legend-swatch{display:inline-block;width:1.35rem;border-top:4px solid var(--c);margin-right:.4rem}.chart-wrap{position:relative;width:100%;overflow:hidden;border:1px solid var(--line);border-radius:.55rem;background:var(--soft)}.chart{display:block;width:100%;height:auto;min-height:250px}.chart:empty{display:none}.grid{stroke:#d9e0e5;stroke-width:1}.axis{fill:#4b5967;font-size:14px;font-weight:600}.axis.date{text-anchor:middle}.series{fill:none;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.endpoint{stroke:#fff;stroke-width:2}.history-panel details{margin-top:1rem;border-top:1px solid var(--line);padding-top:.35rem}.history-panel summary{display:flex;min-height:44px;align-items:center;width:max-content;max-width:100%;cursor:pointer;color:var(--navy);font-weight:850}.table-wrap{max-width:100%;overflow:auto;margin-top:.5rem;border-radius:.4rem}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{padding:.65rem;border:1px solid var(--line);white-space:nowrap}thead th{background:#eef2f5;color:var(--navy)}.disclosure{margin:1rem .25rem 0}.error,.unavailable{min-height:18rem;padding:2rem;background:#fff;border-left:5px solid #c33;border-radius:.5rem}.unavailable{border-color:var(--green)}.stale{background:#fff1c7;padding:.65rem;text-align:center;font-weight:800;border-radius:.4rem}:is(a,button,select,input,summary):focus-visible{outline:3px solid var(--green,#69be28);outline-offset:3px}@media(max-width:900px){.providers{grid-template-columns:repeat(2,minmax(0,1fr))}.history-top{grid-template-columns:1fr}.controls{justify-content:flex-start}.event-meta{grid-template-columns:1fr}.event-meta span+span:before{display:none}}@media(max-width:600px){#ticket-price-explorer{width:calc(100% - 1.5rem);margin-top:.75rem}.game-picker{grid-template-columns:1fr;padding:.9rem}.event-head{padding:1.35rem 1.1rem}.event-head h1{font-size:clamp(1.8rem,9vw,2.5rem);margin-bottom:1rem}.event-meta{font-size:.92rem}.last-checked{display:flex;font-size:.85rem;line-height:1.45}.cards,.providers{grid-template-columns:1fr}.card{min-height:9rem}.provider-card{min-height:10.5rem}.controls{display:grid;grid-template-columns:repeat(3,1fr)}.controls button{width:100%}.controls label,.controls select{grid-column:1/-1;margin-left:0}.chart-wrap{overflow-x:auto}.chart{width:680px;min-height:265px}.disclosure{font-size:.85rem}}@media(max-width:380px){#ticket-price-explorer{width:calc(100% - 1rem)}.history-panel{padding:.85rem}.controls{gap:.4rem}.provider-price{font-size:1.7rem}}@media print{.game-picker,.controls{display:none!important}}@media(prefers-reduced-motion:reduce){#ticket-price-explorer *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.chart-note{margin:0 0 .75rem;color:var(--muted);font-size:.85rem;line-height:1.45}
</style>
<script>
import {EVENTSPY_COVERAGE,eventSpyCoverageForGame} from "../lib/tickets/eventspy-coverage.mjs";
import {validateEventSpyMirror,MIRROR_MARKETS} from "../lib/tickets/eventspy-mirror-schema.mjs";
import {chartPath,providerChartPoints} from "../lib/tickets/chart-path.mjs";
import {currentProviderQuotes} from "../lib/tickets/provider-quotes.mjs";
const names={vividseats:"Vivid Seats",stubhub:"StubHub",ticketmaster:"Ticketmaster",seatgeek:"SeatGeek"},order=["ticketmaster","stubhub","vividseats","seatgeek"],colors={ticketmaster:"#165dff",stubhub:"#6f2dbd",vividseats:"#d81b70",seatgeek:"#d6472f"},root=document.querySelector("#ticket-price-explorer"),money=c=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(c/100),esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),date=s=>new Intl.DateTimeFormat("en-US",{weekday:"short",month:"short",day:"numeric",year:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(`${s}T12:00:00-07:00`)),seen=s=>new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(s)),checked=s=>{const parts=Object.fromEntries(new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",year:"numeric",hour:"numeric",minute:"2-digit",timeZone:"America/Los_Angeles",timeZoneName:"short"}).formatToParts(new Date(s)).map(({type,value})=>[type,value]));return`${parts.month} ${parts.day}, ${parts.year} at ${parts.hour}:${parts.minute} ${parts.dayPeriod} ${parts.timeZoneName}`},checkedTime=s=>`<time data-last-checked datetime="${esc(s)}">${esc(checked(s))}</time>`;
const picker=gameId=>`<div class="game-picker"><label for="seahawks-game">Choose a Seahawks game</label><select id="seahawks-game" data-game-selector>${EVENTSPY_COVERAGE.map(row=>`<option value="${row.gameId}"${row.gameId===gameId?" selected":""}>${row.homeAway==="home"?"vs.":"at"} ${esc(row.opponent)} — ${row.localDate?date(row.localDate):"Week 18 · date TBD"}</option>`).join("")}</select></div>`;
function unavailable(row){return`${picker(row.gameId)}<div class="unavailable" role="status"><h1>Seattle Seahawks ${row.homeAway==="home"?"vs.":"at"} ${esc(row.opponent)}</h1><p>Ticket tracking is not available for this game yet. Select another Seahawks game to view prices.</p></div>`}
function providerCards(v){return currentProviderQuotes(v.history).map(quote=>`<a class="provider-card" data-provider="${quote.provider}" data-provider-price="${quote.priceCents??"unavailable"}" data-provider-rank="${quote.rank}" data-provider-observed-at="${quote.observedAt??""}" data-lowest-price="${quote.isLowest}" href="${esc(v.providerLinks[quote.provider])}" target="_blank" rel="nofollow noopener"><span class="provider-external" aria-hidden="true">↗</span><span class="provider-name">${names[quote.provider]}</span><span class="provider-label">Current lowest</span><span class="provider-price">${quote.priceCents===null?"Price unavailable":money(quote.priceCents)}</span>${quote.observedAt?`<span class="provider-age">Observed ${seen(quote.observedAt)}</span>`:""}${quote.isLowest?`<span class="low-badge">${quote.isTiedLowest?"Tied for lowest price":"Lowest price"}</span>`:""}</a>`).join("")}
function content(v){const stale=Date.now()-Date.parse(v.collectedAt)>26*3600e3,time=v.event.localTimeLabel.replace(/(AM|PM)(P[DS]T)$/,"$1 $2").replace(/(\d)(AM|PM)/,"$1 $2");return`${picker(v.gameId)}${stale?`<p class="stale" role="status">Prices have not been refreshed recently. Last checked ${checkedTime(v.collectedAt)}.</p>`:""}<header class="event-head"><p class="eyebrow">2026 Seahawks ticket tracker</p><h1 data-event-title>${esc(v.event.title)}</h1><div class="event-meta"><span data-event-venue>${esc(v.event.venue)}</span><span data-event-location>${esc(v.event.location)}</span><span data-event-datetime>${date(v.event.localDate)} · ${esc(time)}</span></div><p class="last-checked">Last checked ${checkedTime(v.collectedAt)}</p></header><div class="cards"><article class="card"><h2>Days Until Event</h2><p class="days" data-days-until>${v.summary.daysUntilEvent}</p></article><article class="card current-lowest"><h2>Current Lowest</h2><p class="price current" data-current-lowest>${money(v.summary.currentLowestCents)}</p><p class="age">${esc(v.summary.currentLowestAgeLabel)}</p>${v.summary.atSevenDayLow?'<span class="low-badge">At 7-day low</span>':""}</article><article class="card"><h2>7-Day Lowest</h2><p class="price" data-seven-day-lowest>${money(v.summary.sevenDayLowestCents)}</p><p class="age">${esc(v.summary.sevenDayLowestAgeLabel)}</p></article></div><p class="starting">Tickets currently start at <strong>${money(v.summary.currentLowestCents)}</strong>.</p><h2 class="providers-title">Compare Ticket Providers</h2><div class="providers">${providerCards(v)}</div><section class="history-panel"><div class="history-top"><div><h2>Lowest Ticket Price History</h2><p class="subtitle">Compare displayed lowest prices across four marketplaces.</p></div><div class="controls" aria-label="Price history controls"><button type="button" data-range="30" aria-label="Show 30 days" aria-pressed="true">30d</button><button type="button" data-range="14" aria-label="Show 14 days" aria-pressed="false">14d</button><button type="button" data-range="7" aria-label="Show 7 days" aria-pressed="false">7d</button><label for="market-view">Marketplace view</label><select id="market-view" data-market-selector><option value="combined">Combined</option>${order.map(m=>`<option value="${m}">${names[m]}</option>`).join("")}</select></div></div><ul class="legend" aria-label="Marketplace line colors">${order.map(m=>`<li><span class="legend-swatch" style="--c:${colors[m]}" aria-hidden="true"></span>${names[m]}</li>`).join("")}</ul><p class="chart-note" id="price-history-note">Lines connect the nearest available price observations. Missing provider updates remain blank in the data table.</p><div class="chart-wrap"><svg class="chart" viewBox="0 0 1000 390" role="img" aria-label="Lowest ticket price history" aria-describedby="price-history-note" data-history-chart></svg></div><details><summary>Accessible price history table</summary><div class="table-wrap"><table><caption>Displayed ticket price history in USD</caption><thead><tr><th>Date</th>${order.map(m=>`<th>${names[m]}</th>`).join("")}</tr></thead><tbody></tbody></table></div></details></section><p class="disclosure">Price snapshots can change at any time and may not include taxes or fees. Confirm availability and the final checkout total with the ticket provider.</p>`}
function renderChart(v,days=30,selected="combined"){const svg=root.querySelector("[data-history-chart]"),end=Date.parse(v.history.at(-1).observedAt),points=v.history.filter(p=>Date.parse(p.observedAt)>=end-days*864e5),shown=selected==="combined"?order:[selected],values=points.flatMap(p=>shown.map(m=>p[`${m}Cents`])).filter(Number.isSafeInteger);svg.setAttribute("aria-label",`Lowest ticket price history for the last ${days} days, ${selected==="combined"?"combined marketplace view":`${names[selected]} view`}`);if(!values.length){svg.replaceChildren();return}const lo=Math.min(...values),hi=Math.max(...values),W=1000,H=390,L=85,R=25,T=20,B=45,x=i=>points.length<2?(W+L-R)/2:L+i/(points.length-1)*(W-L-R),y=n=>T+(hi-n)/Math.max(1,hi-lo)*(H-T-B),ns="http://www.w3.org/2000/svg";svg.replaceChildren();for(let i=0;i<5;i++){const yy=T+i*(H-T-B)/4,line=document.createElementNS(ns,"line"),label=document.createElementNS(ns,"text"),val=Math.round(hi-i*(hi-lo)/4);for(const[k,z]of Object.entries({x1:L,x2:W-R,y1:yy,y2:yy}))line.setAttribute(k,z);line.setAttribute("class","grid");label.setAttribute("x","4");label.setAttribute("y",yy+4);label.setAttribute("class","axis");label.textContent=money(val);svg.append(line,label)}const dateIndexes=[0,Math.floor((points.length-1)/2),points.length-1].filter((index,pos,list)=>index>=0&&list.indexOf(index)===pos);for(const index of dateIndexes){const label=document.createElementNS(ns,"text");label.setAttribute("x",x(index));label.setAttribute("y",H-13);label.setAttribute("class","axis date");label.textContent=seen(points[index].observedAt);svg.append(label)}for(const m of order){const group=document.createElementNS(ns,"g");group.dataset.historySeries=m;group.style.display=shown.includes(m)?"":"none";const providerPoints=providerChartPoints(points,m,x,y),last=providerPoints.at(-1);if(providerPoints.length>=2){const path=document.createElementNS(ns,"path");path.setAttribute("d",chartPath(providerPoints));path.setAttribute("stroke",colors[m]);path.setAttribute("class","series");group.append(path)}if(last){const circle=document.createElementNS(ns,"circle");for(const[k,z]of Object.entries({cx:last.x,cy:last.y,r:6,fill:colors[m]}))circle.setAttribute(k,z);circle.setAttribute("class","endpoint");group.append(circle)}svg.append(group)}root.querySelector("tbody").innerHTML=points.map(p=>`<tr><th>${seen(p.observedAt)}</th>${order.map(m=>`<td>${p[`${m}Cents`]===null?"—":money(p[`${m}Cents`])}</td>`).join("")}</tr>`).join("");svg.dataset.visiblePoints=String(points.length)}
function bindPicker(){root.querySelector("[data-game-selector]").onchange=event=>{const url=new URL(location.href);url.searchParams.set("game",event.target.value);history.pushState({},"",url);load(event.target.value)}}
function activate(v){bindPicker();let days=30,selected="combined";root.querySelectorAll("[data-range]").forEach(button=>button.onclick=()=>{days=Number(button.dataset.range);root.querySelectorAll("[data-range]").forEach(other=>other.setAttribute("aria-pressed",String(other===button)));renderChart(v,days,selected)});root.querySelector("[data-market-selector]").onchange=event=>{selected=event.target.value;renderChart(v,days,selected)};renderChart(v);Object.assign(root.dataset,{ticketPageReady:"true",gameId:v.gameId,historyPoints:String(v.history.length),providerLinks:"4",currentLowestCents:String(v.summary.currentLowestCents),sevenDayLowestCents:String(v.summary.sevenDayLowestCents),collectedAt:v.collectedAt})}
async function load(requested){root.setAttribute("aria-busy","true");const row=eventSpyCoverageForGame(requested??new URLSearchParams(location.search).get("game")??EVENTSPY_COVERAGE[0].gameId);if(!row){root.innerHTML='<div class="error" role="alert"><h1>Ticket prices unavailable</h1><p>The requested Seahawks game is not in the reviewed schedule.</p></div>';root.setAttribute("aria-busy","false");return}const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);try{const response=await fetch(`/data/eventspy-mirror/${row.gameId}.json`,{cache:"no-store",headers:{accept:"application/json"},signal:controller.signal});if(!response.ok)throw Error();const value=validateEventSpyMirror(await response.json());if(value.state==="unavailable"){root.innerHTML=unavailable(row);bindPicker()}else{root.innerHTML=content(value);activate(value)}}catch{root.innerHTML=`${picker(row.gameId)}<div class="error" role="alert"><h1>Ticket prices unavailable</h1><p>The latest validated ticket-price snapshot could not be loaded.</p></div>`;bindPicker()}finally{clearTimeout(timer);root.setAttribute("aria-busy","false")}}
addEventListener("popstate",()=>load());load();
</script>
