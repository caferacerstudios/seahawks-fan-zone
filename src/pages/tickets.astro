---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import { TICKET_FEATURE, TICKET_FINDER_STATE } from "../lib/tickets/config";
import { selectScheduleSeason } from "../lib/schedule.mjs";
import { scheduleRow } from "../lib/schedule-display.mjs";
import rawSchedule from "../data/nfl/seahawks.json";
const schedule=selectScheduleSeason(rawSchedule,rawSchedule.season);
const games=schedule.games.filter(g=>!["bye","completed"].includes(g.state)).map((game,index)=>({game,row:scheduleRow(game,{index})}));
const gameMeta=games.map(({game,row})=>({id:String(game.id),venue:game.venue,city:game.isHome?"Seattle, WA":"Location TBD",week:row.week,homeAwayLabel:row.homeAwayLabel,opponentName:row.opponentName,date:row.date,kickoff:row.kickoff,startsAt:game.date??"",matchup:game.isHome?`Seattle Seahawks vs. ${row.opponentName}`:`Seattle Seahawks at ${row.opponentName}`}));
const initialGame=gameMeta[0], beta=TICKET_FINDER_STATE==="beta";
---
<SeahawksLayout title={beta?"Seahawks Ticket Dashboard Beta":"Seahawks Ticket Dashboard"} pageTitle="Seahawks Ticket Dashboard" pageTagline="Direct event information and twice-daily marketplace observations." description="Seahawks ticket event information and observed get-in price history." seo={{title:"Seahawks Ticket Dashboard | Seahawks Fan Zone",description:"Seahawks ticket event information and observed price history.",canonicalPath:TICKET_FEATURE.canonical?"/tickets":null,robots: TICKET_FEATURE.robots}} activePath="/tickets" pageType="tickets" monetizationEligible={false}>
{TICKET_FINDER_STATE==="disabled"?<section class="empty"><h2>Ticket dashboard unavailable</h2><p>View the <a href="/schedule">Seahawks schedule</a>.</p></section>:<main id="ticket-finder" class="dashboard">
{initialGame&&<section class="hero" data-selected-game-summary><div><p class="badge" data-game-week>{initialGame.week} · {initialGame.homeAwayLabel}</p><h2 data-game-matchup>{initialGame.matchup}</h2><p><span data-game-venue>{initialGame.venue??"Venue TBD"}</span> · <span data-game-city>{initialGame.city}</span></p><p><span data-game-date>{initialGame.date}</span> · <span data-game-kickoff>{initialGame.kickoff}</span></p></div><form id="runtime-game-controls"><label for="runtime-game-select">Choose another game</label><select id="runtime-game-select" name="game">{gameMeta.map(g=><option value={g.id} data-week={g.week} data-home-away-label={g.homeAwayLabel} data-matchup={g.matchup} data-date={g.date} data-kickoff={g.kickoff} data-starts-at={g.startsAt} data-city={g.city} data-venue={g.venue??"Venue TBD"}>{g.week}: {g.matchup}</option>)}</select></form></section>}
<section aria-labelledby="metrics-heading"><div class="heading"><div><p class="eyebrow">Selected game</p><h2 id="metrics-heading">Ticket outlook</h2></div><p id="result-count" role="status" aria-live="polite">Checking stored data…</p></div><div class="metrics" id="runtime-metrics"></div></section>
<section aria-labelledby="market-heading"><div class="heading"><div><p class="eyebrow">Marketplace overview</p><h2 id="market-heading">Observed lowest prices</h2></div></div><div class="markets" id="runtime-markets" aria-live="polite" aria-busy="true"></div><p class="qualifier">Prices are twice-daily observations and can change. EventSpy values are displayed lowest-price observations—not direct marketplace feeds, listings, or guaranteed inventory.</p></section>
<section aria-labelledby="direct-heading"><h2 id="direct-heading">Direct ticket source</h2><div id="runtime-providers" class="providers" aria-live="polite"></div></section>
<section id="runtime-history" aria-labelledby="history-heading" hidden><div class="heading"><div><p class="eyebrow">Seahawks Fan Zone history</p><h2 id="history-heading">Historical observed lowest price</h2></div><div class="ranges" role="group" aria-label="History period"><button type="button" data-days="7">7 days</button><button type="button" data-days="14">14 days</button><button type="button" data-days="30">30 days</button></div></div><p>Actual twice-daily observations are shown; missing values remain gaps. Collected time can differ from EventSpy’s source observation time.</p><p class="legend"><span class="tm">Ticketmaster</span><span class="sh">StubHub</span><span class="vv">VividSeats</span><span class="sg">SeatGeek</span></p><p class="sr-only" id="history-summary"></p><div class="chart" id="history-chart" role="img" aria-labelledby="history-heading history-summary"></div><details open><summary>Accessible price history table</summary><div class="table-scroll"><table><caption>Marketplace observations in USD</caption><thead><tr><th scope="col">Observed</th><th scope="col">Collected</th><th scope="col">Ticketmaster</th><th scope="col">StubHub</th><th scope="col">VividSeats</th><th scope="col">SeatGeek</th></tr></thead><tbody id="history-table-body"></tbody></table></div></details></section>
<section class="empty" id="runtime-history-empty"><h2>Historical observed lowest price</h2><p data-history-empty-copy>No collection has occurred for this game. Direct Ticketmaster information may still be available.</p></section>
<section class="empty" id="runtime-unavailable" hidden><h2>Ticket information unavailable</h2><p>The stored ticket snapshot could not be validated.</p></section>
<details id="runtime-diagnostics" hidden><summary>Data diagnostics</summary><p data-runtime-checked></p><ul data-runtime-coverage-list></ul></details>
<p class="official">Need another option? <a href="https://www.seahawks.com/tickets/" rel="noopener">Visit the official Seahawks ticket page</a>.</p>
<p class="disclosure"><strong>Affiliate and source disclosure:</strong> Seahawks Fan Zone is an independent fan site, not the Seahawks, NFL, Ticketmaster, EventSpy, or a ticket seller. We may earn a commission from approved outbound links; commission does not influence presentation. Ticketmaster Discovery summaries are direct event data. Marketplace observations are attributed to the <a href="https://www.event-spy.com/event/seattle-seahawks-seattle-sep-09-2026/374440" rel="nofollow noopener">authorized EventSpy event page</a>. StubHub, VividSeats, and SeatGeek direct provider integrations are not enabled. Verify availability and checkout totals. <a href="/disclosure">Full disclosure</a>.</p>
</main>}
</SeahawksLayout>
<style>
.dashboard{width:min(100%,1120px);margin:auto}.hero{display:grid;grid-template-columns:1.5fr minmax(16rem,.7fr);gap:1.5rem;align-items:end;padding:clamp(1rem,3vw,2rem);background:var(--navy-900);border-top:5px solid var(--action-green);color:#fff}.hero h2{margin:.25rem 0;color:#fff;font-size:clamp(1.7rem,4vw,2.8rem)}.badge,.eyebrow{font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.badge{color:var(--action-green)}form{display:grid;gap:.4rem}select,button{min-height:44px;border:2px solid var(--navy-900);background:#fff;padding:.55rem;font-weight:800}.hero select{border-color:#fff;width:100%}.dashboard>section{margin-top:1.75rem}.heading{display:flex;justify-content:space-between;align-items:end;gap:1rem}.heading h2{margin:.15rem 0 .7rem}.eyebrow{margin:0;color:#4b711f}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.metric,.market,.provider{padding:1rem;border:var(--border-crisp);border-top:5px solid var(--action-green);background:#fff}.metric p,.market p{margin:.25rem 0}.value{font:900 clamp(1.5rem,4vw,2.2rem)/1 var(--font-display);color:var(--navy-900)}.markets{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem}.market{border-top-color:var(--navy-800)}.market h3{margin:0}.meta,.qualifier,#result-count,.disclosure,.official{font-size:.8rem;color:var(--slate-700)}.providers{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.provider a{display:inline-flex;min-height:44px;align-items:center;margin-top:.5rem;padding:0 .7rem;background:var(--navy-900);color:#fff;font-weight:900}.ranges,.legend{display:flex;gap:.5rem;flex-wrap:wrap}.ranges button[aria-pressed=true]{background:var(--navy-900);color:#fff}.legend span::before{content:"";display:inline-block;width:1rem;border-top:4px solid;margin-right:.3rem}.tm::before{color:#006778}.sh::before{color:#6b3fa0}.vv::before{color:#b24c00}.sg::before{color:#246b35}.chart{max-width:100%;overflow:hidden;border:var(--border-crisp);padding:.5rem}.chart svg{display:block;width:100%;height:auto}.grid{stroke:#ccd2d8}.axis{font-size:12px;fill:#374151}.line{fill:none;stroke-width:4}.point{stroke:#fff;stroke-width:2}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:.55rem;border:1px solid var(--slate-300);text-align:left;white-space:nowrap}summary{min-height:44px;padding:.7rem 0;font-weight:900;cursor:pointer}.empty{padding:1rem;border:var(--border-crisp);border-left:5px solid var(--action-green);background:var(--slate-100)}.disclosure{border-top:1px solid var(--slate-300);padding-top:1rem}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0)}:is(a,button,select,summary):focus-visible{outline:3px solid var(--action-green);outline-offset:3px}@media(max-width:800px){.hero{grid-template-columns:1fr}.markets{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.metrics,.markets,.providers{grid-template-columns:1fr}.heading{display:block}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}@media print{form,.ranges,.official,details#runtime-diagnostics,[class*=skip]{display:none!important}.dashboard>section,.market,.metric,.provider{break-inside:avoid}.chart{max-height:18rem}.disclosure{break-before:avoid}}
</style>
<script>
import {eventSpyObservationModel,providerEventSummaryModel,runtimeEventUrl,runtimeProviderCoverage,runtimeTicketView,selectRuntimeEvent,validateRuntimeEvent,validateRuntimeIndex,validateRuntimeStatus} from "../lib/tickets/runtime-view.mjs";
const root=document.getElementById("ticket-finder");if(root)(async()=>{const $=s=>document.querySelector(s),mk=(tag,value,cls)=>{const n=document.createElement(tag);n.textContent=value;if(cls)n.className=cls;return n},money=c=>Number.isSafeInteger(c)?new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",minimumFractionDigits:c%100?2:0}).format(c/100):"Unavailable",dt=v=>new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",hour:"numeric",minute:"2-digit",timeZone:"America/Los_Angeles",timeZoneName:"short"}).format(new Date(v)),json=async u=>{const r=await fetch(u,{headers:{accept:"application/json"}});if(!r.ok)throw Error();return r.json()},metrics=$("#runtime-metrics"),markets=$("#runtime-markets"),providers=$("#runtime-providers"),empty=$("#runtime-history-empty"),select=$("#runtime-game-select"),allowed=[...select.options].map(o=>o.value),names={ticketmaster:"Ticketmaster",stubhub:"StubHub",vividseats:"VividSeats",seatgeek:"SeatGeek"},colors={ticketmaster:"#006778",stubhub:"#6b3fa0",vividseats:"#b24c00",seatgeek:"#246b35"};
const metric=(label,value,meta)=>{const n=document.createElement("article");n.className="metric";n.append(mk("strong",label),mk("p",value,"value"),mk("p",meta,"meta"));metrics.append(n)};
const updateHero=id=>{const o=[...select.options].find(x=>x.value===id)||select.options[0];select.value=o.value;for(const [q,v] of [["[data-game-week]",`${o.dataset.week} · ${o.dataset.homeAwayLabel}`],["[data-game-matchup]",o.dataset.matchup],["[data-game-date]",o.dataset.date],["[data-game-kickoff]",o.dataset.kickoff],["[data-game-venue]",o.dataset.venue],["[data-game-city]",o.dataset.city]])$(q).textContent=v;return o};
const marketCard=m=>{const n=document.createElement("article");n.className="market";const latest=m.latest,range=m.lowCents!==null&&m.highCents!==null&&m.lowCents!==m.highCents?`${money(m.lowCents)}–${money(m.highCents)}`:"Not enough data";n.append(mk("h3",names[m.marketplace]),mk("p",money(latest?.lowestPriceCents),"value"),mk("p",latest?`Last observed ${dt(latest.observedAt)}`:"Marketplace observation unavailable","meta"),mk("p",latest?.sectionLabel||"Section unavailable","meta"),mk("p",`Observed range: ${range}`,"meta"),mk("p","EventSpy market observation · direct provider integration not enabled","meta"));return n};
const providerCard=s=>{const n=document.createElement("article");n.className="provider";n.append(mk("h3",s.provider),mk("p",s.priceCopy,"value"),mk("p",`${s.source} · checked ${dt(s.checkedAt)}`,"meta"),mk("p",s.disclosure,"meta"));if(s.href){const a=mk("a",`Check availability on ${s.provider}`);Object.assign(a,{href:s.href,target:"_blank",rel:"nofollow noopener"});Object.assign(a.dataset,{ticketOutbound:"",provider:s.provider.toLowerCase(),sourceKind:"official-primary",linkPlacement:"event-summary"});n.append(a)}return n};
function renderHistory(model,days=14){const end=Date.parse(model.latest.seriesPoint.observedAt),start=end-days*86400_000,points=model.observations.filter(o=>Date.parse(o.seriesPoint.observedAt)>=start);for(const b of document.querySelectorAll("[data-days]")){b.ariaPressed=String(Number(b.dataset.days)===days);b.onclick=()=>renderHistory(model,Number(b.dataset.days))}$("#runtime-history").hidden=false;empty.hidden=true;const vals=points.flatMap(o=>o.seriesPoint.marketplaces.map(m=>m.lowestPriceCents)).filter(Number.isSafeInteger),min=Math.min(...vals),max=Math.max(...vals),W=900,H=300,L=70,R=20,T=20,B=35,span=Math.max(1,max-min),x=o=>L+(Date.parse(o.seriesPoint.observedAt)-start)/Math.max(1,end-start)*(W-L-R),y=v=>T+(max-v)/span*(H-T-B),ns="http://www.w3.org/2000/svg",svg=document.createElementNS(ns,"svg");svg.setAttribute("viewBox",`0 0 ${W} ${H}`);for(const v of [max,(max+min)/2,min]){const l=document.createElementNS(ns,"line"),t=document.createElementNS(ns,"text");for(const [k,z] of [["x1",L],["x2",W-R],["y1",y(v)],["y2",y(v)]])l.setAttribute(k,String(z));l.setAttribute("class","grid");t.setAttribute("x","2");t.setAttribute("y",String(y(v)+4));t.setAttribute("class","axis");t.textContent=money(Math.round(v));svg.append(l,t)}for(const id of Object.keys(names)){let d="",open=false;for(const o of points){const v=o.seriesPoint.marketplaces.find(m=>m.marketplace===id)?.lowestPriceCents;if(!Number.isSafeInteger(v)){open=false;continue}d+=`${open?"L":"M"}${x(o)},${y(v)} `;open=true}const path=document.createElementNS(ns,"path");path.setAttribute("d",d);path.setAttribute("class","line");path.setAttribute("stroke",colors[id]);svg.append(path)}$("#history-chart").replaceChildren(svg);$("#history-summary").textContent=`${points.length} observations from the selected ${days}-day window, across four marketplaces.`;$("#history-table-body").replaceChildren(...points.slice().reverse().map(o=>{const r=document.createElement("tr"),values=[dt(o.seriesPoint.observedAt),dt(o.collectedAt),...Object.keys(names).map(id=>money(o.seriesPoint.marketplaces.find(m=>m.marketplace===id)?.lowestPriceCents))];for(const v of values)r.append(mk("td",v));return r}))}
async function load(id){metrics.replaceChildren();markets.replaceChildren();markets.ariaBusy="true";providers.replaceChildren();$("#runtime-unavailable").hidden=true;$("#runtime-history").hidden=true;empty.hidden=false;const option=updateHero(id),now=Date.now(),kickoff=Date.parse(option.dataset.startsAt);metric("Days until kickoff",Number.isFinite(kickoff)&&kickoff>now?String(Math.ceil((kickoff-now)/86400_000)):"Unavailable",`${option.dataset.date} · ${option.dataset.kickoff}`);try{const [status,index]=await Promise.all([json("/data/tickets/status.json").then(v=>validateRuntimeStatus(v,now)),json("/data/tickets/index.json").then(v=>validateRuntimeIndex(v,now))]),selected=selectRuntimeEvent(index,id,allowed);if(!selected.row)throw Error();const event=validateRuntimeEvent(await json(runtimeEventUrl(selected.row)),selected.row,now),view=runtimeTicketView(event),obs=eventSpyObservationModel(event,now);for(const ref of view.summaries)providers.append(providerCard(providerEventSummaryModel(ref)));if(obs.latest){metric("Current observed lowest price",money(obs.latest.summary.currentLowestPriceCents),`${names[obs.latest.summary.currentLowestMarketplace]||"Marketplace unavailable"} · ${obs.stale?"Stale · ":""}${dt(obs.latest.summary.currentLowestSeenAt)}`);metric("Seven-day observed lowest price",money(obs.sevenDayLowCents),`Last observed ${dt(obs.latest.summary.sevenDayLowestSeenAt)}`);markets.replaceChildren(...obs.marketplaces.map(marketCard));if(obs.observations.length>1)renderHistory(obs,14);else empty.querySelector("[data-history-empty-copy]").textContent=`One observation was collected at ${dt(obs.latest.collectedAt)}. A chart will appear after another valid observation.`}else{metric("Current observed lowest price","Unavailable","No EventSpy collection has occurred");metric("Seven-day observed lowest price","Unavailable","History is still accumulating");markets.replaceChildren(...Object.keys(names).map(id=>marketCard({marketplace:id,latest:null,lowCents:null,highCents:null})));empty.querySelector("[data-history-empty-copy]").textContent="No collection has occurred for this game. Direct Ticketmaster information may still be available."}markets.ariaBusy="false";$("#result-count").textContent=obs.stale?"Stored marketplace observations are stale; the last valid history is retained.":"Validated stored ticket data.";const coverage=runtimeProviderCoverage(status,event),diagnostics=$("#runtime-diagnostics");diagnostics.querySelector("[data-runtime-checked]").textContent=`Snapshot checked ${dt(status.generatedAt)}.`;diagnostics.querySelector("ul").replaceChildren(...coverage.map(p=>mk("li",`${p.provider}: ${p.state}`)));diagnostics.hidden=!coverage.length}catch{markets.ariaBusy="false";$("#runtime-unavailable").hidden=false;$("#result-count").textContent="Stored ticket information could not be loaded."}}
const requested=new URLSearchParams(location.search).get("game"),initial=allowed.includes(requested)?requested:allowed[0];await load(initial);select.addEventListener("change",()=>{const p=new URLSearchParams(location.search);p.set("game",select.value);history.pushState(null,"",`${location.pathname}?${p}`);load(select.value)});addEventListener("popstate",()=>load(new URLSearchParams(location.search).get("game")))})();
</script>
<script>import {ticketClickEvent} from "../lib/tickets/analytics.mjs";document.addEventListener("click",event=>{const link=event.target?.closest?.("[data-ticket-outbound]");if(!link)return;const detail=ticketClickEvent(window.sfzPrivacy?.getState?.(),{selectedGame:document.querySelector("#runtime-game-controls")?.elements?.game?.value,provider:link.dataset.provider,sourceKind:link.dataset.sourceKind,linkPlacement:link.dataset.linkPlacement});if(detail){window.dataLayer=window.dataLayer||[];window.dataLayer.push(detail)}});</script>
