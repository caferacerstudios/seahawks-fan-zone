---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import { TICKET_FEATURE, TICKET_FINDER_STATE } from "../lib/tickets/config";
import { selectScheduleSeason } from "../lib/schedule.mjs";
import { scheduleRow } from "../lib/schedule-display.mjs";
import rawSchedule from "../data/nfl/seahawks.json";

const schedule = selectScheduleSeason(rawSchedule, rawSchedule.season);
const games = schedule.games
  .filter((game) => !["bye", "completed"].includes(game.state))
  .map((game, index) => ({ game, row: scheduleRow(game, { index }) }));
const beta = TICKET_FINDER_STATE === "beta";
const runtime = TICKET_FEATURE.runtime;
const gameMeta = games.map(({ game, row }) => ({ id: String(game.id), isHome: game.isHome, venue: game.venue, state: game.state, week: row.week, homeAwayLabel: row.homeAwayLabel, homeAway: row.homeAway, opponentName: row.opponentName, date: row.date, kickoff: row.kickoff, href: row.href, traits: [row.division ? "NFC West division game" : "Non-division game", row.primeTime ? "Prime-time game" : "Standard broadcast window", `Status: ${row.stateLabel}`] }));
const initialGame = gameMeta[0];
---

<SeahawksLayout
  title={beta ? "Seahawks Ticket Finder Beta" : "Seahawks Ticket Comparison"}
  pageTitle="Seahawks Ticket Finder"
  pageTagline={beta ? "Check official provider event availability for upcoming Seahawks games." : "Compare ticket details from connected official and resale partners for upcoming Seahawks games."}
  description="Check validated provider event summaries for upcoming Seahawks games."
  seo={{ title: beta ? "Seahawks Ticket Finder Beta | Seahawks Fan Zone" : "Seahawks Ticket Finder | Seahawks Fan Zone", description: runtime ? "Check official provider ticket availability for upcoming Seahawks games." : "Preview Seahawks ticket-finder functionality.", canonicalPath: TICKET_FEATURE.canonical ? "/tickets" : null, robots: TICKET_FEATURE.robots }}
  activePath="/tickets"
  pageType="tickets"
  monetizationEligible={false}
>
  {TICKET_FINDER_STATE === "disabled" ? (
    <section class="ticket-empty" aria-labelledby="tickets-disabled"><h2 id="tickets-disabled">Ticket Finder unavailable</h2><p>This preview is currently disabled. Upcoming games remain available on the <a href="/schedule">Seahawks schedule</a>.</p></section>
  ) : (
    <div id="ticket-finder">
      <section class="trust-panel" aria-label="Beta and ticket information">
        <p><strong>{beta ? "Live beta:" : "Independent ticket information:"}</strong> Seahawks Fan Zone is an independent fan site, not the Seahawks, NFL, or a ticket seller. Provider coverage, prices, and availability can change; confirm final details and fees on the provider site.</p>
      </section>

      <noscript><div class="ticket-empty"><h2>JavaScript is off</h2><p>Ticket data requires JavaScript. Upcoming games and the official Seahawks ticket link remain available.</p></div></noscript>

      <form class="ticket-controls" id="runtime-game-controls" method="get" aria-labelledby="runtime-game-heading">
        <div class="controls-heading"><div><p class="control-kicker">Upcoming games</p><h2 id="runtime-game-heading">Choose a game</h2></div></div>
        <div class="filter-fields"><label class="wide" for="runtime-game-select">Upcoming Seahawks game<select id="runtime-game-select" name="game">{gameMeta.map((game) => <option value={game.id} data-week={game.week} data-home-away-label={game.homeAwayLabel} data-home-away={game.homeAway} data-opponent={game.opponentName} data-date={game.date} data-kickoff={game.kickoff} data-venue={game.venue ?? "Venue TBD"} data-preview={game.href} data-traits={JSON.stringify(game.traits)}>{game.week}: {game.homeAwayLabel} {game.homeAway} {game.opponentName} — {game.date}, {game.kickoff}</option>)}</select></label></div>
      </form>

      <p class="inline-disclosure"><strong>Before visiting a provider:</strong> We may earn a commission if you purchase tickets through some links on this page. Commission arrangements do not affect provider order. Ticketmaster event summaries are not price ranked.</p>

      <section class="selected-game" aria-labelledby="selected-game-heading">
        <div><p class="control-kicker">Selected matchup</p><h2 id="selected-game-heading">Upcoming Seahawks game</h2></div>
        {initialGame && <article data-selected-game-summary data-game-id={initialGame.id}>
          <div><strong data-game-week>{initialGame.week} · {initialGame.homeAwayLabel}</strong><h3 data-game-opponent>{initialGame.homeAway} {initialGame.opponentName}</h3><p><span data-game-date>{initialGame.date}</span> · <span data-game-kickoff>{initialGame.kickoff}</span> · <span data-game-venue>{initialGame.venue ?? "Venue TBD"}</span></p></div>
          <ul aria-label="Game details" data-game-traits>{initialGame.traits.map((trait) => <li>{trait}</li>)}</ul>
          <div class="game-links"><a href={initialGame.href} data-game-preview>Game preview</a><a href="/schedule">Full schedule</a></div>
        </article>}
      </section>

      <section class="results-section" aria-labelledby="results-heading">
        <div class="results-heading"><div><p class="control-kicker">Selected-game providers</p><h2 id="results-heading">Provider availability</h2></div><p id="result-count" role="status" aria-live="polite" aria-atomic="true">Checking provider availability…</p></div>
        <p class="comparison-note">Ticketmaster event summaries are not individual listings, quantity-specific offers, or cheapest-price comparisons. Confirm current availability on Ticketmaster.</p>
        <div class="ticket-results" id="runtime-providers" aria-live="polite" aria-busy="true"></div>
        <div class="ticket-empty" id="runtime-unmatched" hidden><h3>No verified provider match for this game</h3><p>The connected provider has not supplied a verified event match for the selected game. Check the official Seahawks ticket page below or try again later.</p></div>
        <div class="ticket-empty" id="runtime-unavailable" hidden><h3>Provider information is temporarily unavailable</h3><p>We could not verify current provider data for this game. Use the official Seahawks ticket page below while the feed recovers.</p></div>
      </section>

      <section class="official-fallback" aria-labelledby="official-heading">
        <div><h2 id="official-heading">Official Seahawks tickets</h2><p>For team ticket information and any options not covered above, use the official Seahawks ticket page.</p></div>
        <a class="provider-button" href="https://www.seahawks.com/tickets/" rel="noopener">Visit official ticket page</a>
      </section>
      <p class="mobile-entry-link">Using mobile tickets? <a href="https://www.seahawks.com/tickets/mobile-ticket-guide" rel="noopener">Read the official mobile-entry guide</a>.</p>

      <details class="coverage" id="runtime-diagnostics" hidden><summary>Technical and source details</summary><p data-runtime-checked></p><ul class="coverage-list" data-runtime-coverage-list></ul></details>

      <p class="final-disclosure">We may earn a commission from some provider links. Commission never influences provider order. Prices, availability, and fees can change; verify the checkout total before purchase. <a href="/disclosure">Affiliate disclosure</a>.</p>

    </div>
  )}
</SeahawksLayout>

<style>
  .inline-disclosure{margin:0 0 1.5rem;padding:.8rem 1rem;border:var(--border-crisp);border-top:0;background:#fff}
  .trust-panel,.ticket-empty{padding:1rem;border:var(--border-crisp);border-left:5px solid var(--action-green);background:var(--slate-100)}
  .trust-panel{margin-bottom:1.25rem}.trust-panel p{margin:0}
  .ticket-controls{margin:1.5rem 0 0;padding:1rem;border:var(--border-crisp);border-top:5px solid var(--action-green);background:var(--slate-100)}
  .controls-heading,.results-heading{display:flex;align-items:start;justify-content:space-between;gap:1rem}
  .controls-heading h2,.results-heading h2{margin:.1rem 0 .75rem}
  .control-kicker{margin:0;color:#4b711f;font-size:.7rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .filter-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem}
  .filter-fields>label{display:grid;gap:.25rem;color:var(--slate-700);font-size:.72rem;font-weight:900;text-transform:uppercase}
  .filter-fields .wide{grid-column:span 2}.filter-fields select{width:100%;padding:.45rem .55rem}
  .selected-game{margin:1.5rem 0}.selected-game>article{display:grid;grid-template-columns:1.5fr 1fr auto;gap:1rem;align-items:center;padding:1rem;border:var(--border-crisp);background:#fff}
  .selected-game h3{margin:.15rem 0}.selected-game p{margin:.2rem 0}.selected-game ul{margin:0;padding-left:1.1rem}.game-links{display:grid;gap:.35rem}
  .results-section,.coverage{margin-top:1.5rem}.ticket-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .ticket-card{display:flex;flex-direction:column;gap:.75rem;padding:1rem;border:var(--border-crisp);border-top:5px solid var(--navy-800);background:#fff}
  .group-price{margin:.15rem 0;font:900 clamp(1.6rem,4vw,2.25rem)/1.1 var(--font-display);color:var(--navy-900)}
  .provider-line{display:flex;justify-content:space-between;gap:.5rem}.health{display:inline-flex;align-items:center;padding:.2rem .45rem;border:1px solid currentColor;font-size:.68rem;font-weight:900;text-transform:uppercase}
  .ticket-card dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin:0}.ticket-card dl div{padding:.45rem;background:var(--slate-100)}
  .ticket-card dt{font-size:.65rem;font-weight:900;text-transform:uppercase}.ticket-card dd{margin:0}.freshness{margin:auto 0 0;color:var(--slate-700);font-size:.72rem}
  .provider-button{display:inline-flex;width:100%;min-height:44px;align-items:center;justify-content:center;padding:.6rem .85rem;border:2px solid var(--navy-900);background:var(--navy-900);color:#fff;font-weight:900;text-decoration:none}
  .comparison-note{color:var(--slate-700);font-size:.8rem}.ticket-empty{margin:1rem 0}.ticket-empty h2,.ticket-empty h3{margin-top:0}
  .official-fallback{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-top:1.25rem;padding:1rem;border:var(--border-crisp);background:var(--slate-100)}
  .official-fallback h2,.official-fallback p{margin:.15rem 0}.official-fallback .provider-button{width:auto;white-space:nowrap}
  .mobile-entry-link,.final-disclosure{font-size:.8rem}.final-disclosure{padding-top:1rem;border-top:1px solid var(--slate-300)}
  .coverage{padding:.8rem;border:var(--border-crisp)}.coverage summary{font-weight:900;cursor:pointer}
  .coverage-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;padding:0;list-style:none}
  .coverage-list li{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.7rem;border:1px solid var(--slate-300)}
  .coverage-list small{display:block;color:var(--slate-700)}.health--stale,.health--error{font-weight:900}.health--stale::before{content:"Warning: "}.health--error::before{content:"Error: "}
  @media(max-width:800px){.filter-fields{grid-template-columns:repeat(2,minmax(0,1fr))}.selected-game>article{grid-template-columns:1fr 1fr}.game-links{grid-column:1/-1;display:flex}.ticket-results{grid-template-columns:1fr}}
  @media(max-width:600px){.filter-fields{grid-template-columns:1fr}.filter-fields .wide{grid-column:auto}.selected-game>article{grid-template-columns:1fr}.game-links{grid-column:auto}.results-heading,.official-fallback{display:block}.official-fallback .provider-button{width:100%;margin-top:.75rem}.coverage-list,.ticket-card dl{grid-template-columns:1fr}.ticket-card{padding:.85rem}}
  :is(.ticket-controls select,.provider-button,.game-links a,.official-fallback a,.mobile-entry-link a,details summary):focus-visible{outline:3px solid var(--action-green);outline-offset:3px}
  @media print{.ticket-controls,.provider-button,.mobile-entry-link,.coverage,.game-links a:last-child{display:none!important}.ticket-card,.selected-game>article,.official-fallback{break-inside:avoid}.ticket-results{display:block}.ticket-card{margin-bottom:1rem}}
</style>

<script>
  import { providerEventSummaryModel, runtimeEventUrl, runtimeProviderCoverage, runtimeTicketView, selectRuntimeEvent, validateRuntimeEvent, validateRuntimeIndex, validateRuntimeStatus } from "../lib/tickets/runtime-view.mjs";
  if (document.getElementById('ticket-finder')) (async () => {
    const results = document.getElementById('runtime-providers');
    const unavailable = document.getElementById('runtime-unavailable');
    const unmatched = document.getElementById('runtime-unmatched');
    const diagnostics = document.getElementById('runtime-diagnostics');
    const count = document.getElementById('result-count');
    const controls = document.getElementById('runtime-game-controls');
    const gameSelect = controls?.elements?.game;
    const allowedGames = [...(gameSelect?.options || [])].map((option) => option.value);
    const text = (tag, value, className) => { const node = document.createElement(tag); node.textContent = value; if (className) node.className = className; return node; };
    const providerName = (value) => String(value).replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const dateTime = (value) => new Intl.DateTimeFormat('en-US', { month:'short', day:'numeric', hour:'numeric', minute:'2-digit', timeZone:'America/Los_Angeles', timeZoneName:'short' }).format(new Date(value));
    const json = async (url) => { const response = await fetch(url, { headers: { accept: 'application/json' } }); if (!response.ok) throw new Error('runtime unavailable'); return response.json(); };
    const clearRuntime = () => { results.replaceChildren(); results.setAttribute('aria-busy', 'true'); unavailable.hidden = true; unmatched.hidden = true; diagnostics.hidden = true; };
    const showFailure = () => { clearRuntime(); results.setAttribute('aria-busy', 'false'); unavailable.hidden = false; count.textContent = 'Provider information could not be loaded.'; };
    const updateGame = (gameId) => {
      const option = [...gameSelect.options].find((candidate) => candidate.value === gameId) ?? gameSelect.options[0];
      if (!option) return;
      gameSelect.value = option.value;
      const summary = document.querySelector('[data-selected-game-summary]'); summary.dataset.gameId = option.value;
      summary.querySelector('[data-game-week]').textContent = `${option.dataset.week} · ${option.dataset.homeAwayLabel}`;
      summary.querySelector('[data-game-opponent]').textContent = `${option.dataset.homeAway} ${option.dataset.opponent}`;
      summary.querySelector('[data-game-date]').textContent = option.dataset.date;
      summary.querySelector('[data-game-kickoff]').textContent = option.dataset.kickoff;
      summary.querySelector('[data-game-venue]').textContent = option.dataset.venue;
      summary.querySelector('[data-game-preview]').href = option.dataset.preview;
      summary.querySelector('[data-game-traits]').replaceChildren(...JSON.parse(option.dataset.traits).map((trait) => text('li', trait)));
    };
    const providerCard = (summary, reference) => {
      const card = document.createElement('article'); card.className = 'ticket-card event-summary-card'; card.dataset.referenceGame = String(reference.gameId ?? '');
      const line = document.createElement('div'); line.className = 'provider-line'; line.append(text('strong', summary.provider), text('span', summary.stale ? 'Stale match' : 'Matched', `health health--${summary.stale ? 'stale' : 'success'}`)); card.append(line);
      card.append(text('p', summary.priceCopy, 'group-price'));
      for (const price of summary.prices.slice(1)) card.append(text('p', price.copy, 'comparison-note'));
      const details = document.createElement('dl');
      for (const [term, value] of [['Coverage', summary.status], ['Data type', 'Event summary'], ['Last checked', dateTime(summary.checkedAt)]]) { const row = document.createElement('div'); row.append(text('dt', term), text('dd', value)); details.append(row); }
      card.append(details);
      if (summary.stale) card.append(text('p', 'This is the last successful provider response and may be out of date.', 'comparison-note'));
      card.append(text('p', summary.disclosure, 'comparison-note'));
      if (summary.href) { const link = text('a', `View tickets on ${summary.provider}`, 'provider-button'); link.href = summary.href; link.target = '_blank'; link.rel = 'nofollow noopener'; link.dataset.ticketOutbound = ''; link.dataset.provider = reference.provider; link.dataset.sourceKind = 'official-primary'; link.dataset.linkPlacement = 'event-summary'; card.append(link); }
      return card;
    };
    const initialRequest = new URLSearchParams(location.search).get('game');
    updateGame(allowedGames.includes(initialRequest) ? initialRequest : allowedGames[0]);
    try {
      const now = Date.now();
      const [status, index] = await Promise.all([
        json('/data/tickets/status.json').then((value) => validateRuntimeStatus(value, now)),
        json('/data/tickets/index.json').then((value) => validateRuntimeIndex(value, now)),
      ]);
      if (status.generatedAt !== index.generatedAt) throw new Error('incompatible runtime snapshot');
      const loadSelected = async (requested) => {
        clearRuntime(); count.textContent = 'Checking provider availability…';
        const selected = selectRuntimeEvent(index, requested, allowedGames);
        updateGame(selected.gameId);
        if (!selected.row) { results.setAttribute('aria-busy', 'false'); unmatched.hidden = false; count.textContent = 'No verified provider match for this game.'; return; }
        try {
          const event = validateRuntimeEvent(await json(runtimeEventUrl(selected.row)), selected.row, Date.now());
          if (event.generatedAt !== status.generatedAt) throw new Error('incompatible runtime event');
          const view = runtimeTicketView(event); const visibleProviders = new Set();
          for (const reference of view.summaries) { const summary = providerEventSummaryModel(reference); results.append(providerCard(summary, { ...reference, gameId: event.event.gameId })); visibleProviders.add(reference.provider); }
          for (const provider of status.providers.filter((item) => item.state === 'error' && !visibleProviders.has(item.provider))) { const card = document.createElement('article'); card.className = 'ticket-card provider-failure'; const line = document.createElement('div'); line.className = 'provider-line'; line.append(text('strong', providerName(provider.provider)), text('span', 'Unavailable', 'health health--error')); card.append(line, text('p', 'Provider check failed. No current event information is available.', 'comparison-note'), text('p', `Data type: ${provider.mode === 'event-summary' ? 'Event summary' : providerName(provider.mode)}`, 'freshness'), text('p', provider.lastSuccess ? `Last successful check ${dateTime(provider.lastSuccess)}` : 'No successful check is available.', 'freshness')); results.append(card); }
          results.setAttribute('aria-busy', 'false');
          if (!results.children.length) { unmatched.hidden = false; count.textContent = 'No verified provider match for this game.'; } else count.textContent = view.summaries.length ? 'Provider information available for this game.' : 'A provider check failed for this game.';
          const coverage = runtimeProviderCoverage(status, event).filter((provider) => !['disabled','pending'].includes(provider.state)); const list = diagnostics.querySelector('[data-runtime-coverage-list]'); list.replaceChildren();
          for (const provider of coverage) { const item = document.createElement('li'); item.append(text('strong', provider.provider), text('small', `${provider.mode} · ${provider.state} · Rejected ${provider.rejectedEvents} · Unmatched ${provider.unmatchedEvents}`)); list.append(item); }
          diagnostics.querySelector('[data-runtime-checked]').textContent = `Snapshot checked ${dateTime(status.generatedAt)}. Counts below are feed diagnostics, not selected-game availability.`; diagnostics.hidden = coverage.length === 0;
        } catch { showFailure(); }
      };
      await loadSelected(initialRequest);
      if (initialRequest && initialRequest !== gameSelect.value) { const params = new URLSearchParams(location.search); params.set('game', gameSelect.value); history.replaceState(null, '', `${location.pathname}?${params}`); }
      controls?.addEventListener('submit', (event) => event.preventDefault());
      gameSelect?.addEventListener('change', async () => { const params = new URLSearchParams(location.search); params.set('game', gameSelect.value); history.pushState(null, '', `${location.pathname}?${params}`); await loadSelected(gameSelect.value); });
      addEventListener('popstate', () => loadSelected(new URLSearchParams(location.search).get('game')));
    } catch { showFailure(); }
  })();
</script>

<script>
  import { ticketClickEvent } from "../lib/tickets/analytics.mjs";

  document.addEventListener("click", (event) => {
    const link = event.target?.closest?.("[data-ticket-outbound]");
    if (!link) return;
    const detail = ticketClickEvent(window.sfzPrivacy?.getState?.(), {
      selectedGame: document.querySelector("#runtime-game-controls")?.elements?.game?.value,
      provider: link.dataset.provider,
      sourceKind: link.dataset.sourceKind,
      linkPlacement: link.dataset.linkPlacement,
    });
    if (!detail) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(detail);
    window.dispatchEvent(new CustomEvent("sfz:analytics", { detail }));
  });
</script>
