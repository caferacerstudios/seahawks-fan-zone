<script>
  import { providerEventSummaryModel, runtimeEventUrl, runtimeProviderCoverage, runtimeTicketView, selectRuntimeEvent, validateRuntimeEvent, validateRuntimeIndex, validateRuntimeStatus } from "../lib/tickets/runtime-view.mjs";
  if (document.getElementById('ticket-finder')?.dataset.runtime === 'true') (async () => {
    const results = document.getElementById('runtime-providers');
    const unavailable = document.getElementById('runtime-unavailable');
    const unmatched = document.getElementById('runtime-unmatched');
    const diagnostics = document.getElementById('runtime-diagnostics');
    const count = document.getElementById('result-count');
    const controls = document.getElementById('runtime-game-controls');
    const gameSelect = controls?.elements?.game;
    const allowedGames = [...(gameSelect?.options || [])].map((option) => option.value);
    const text = (tag, value, className) => { const node = document.createElement(tag); node.textContent = value; if (className) node.className = className; return node; };
    const providerName = (value) => String(value).replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const dateTime = (value) => new Intl.DateTimeFormat('en-US', { month:'short', day:'numeric', hour:'numeric', minute:'2-digit', timeZone:'America/Los_Angeles', timeZoneName:'short' }).format(new Date(value));
    const json = async (url) => { const response = await fetch(url, { headers: { accept: 'application/json' } }); if (!response.ok) throw new Error('runtime unavailable'); return response.json(); };
    const clearRuntime = () => { results.replaceChildren(); results.setAttribute('aria-busy', 'true'); unavailable.hidden = true; unmatched.hidden = true; diagnostics.hidden = true; };
    const showFailure = () => { clearRuntime(); results.setAttribute('aria-busy', 'false'); unavailable.hidden = false; count.textContent = 'Provider information could not be loaded.'; };
    const updateGame = (gameId) => {
      const option = [...gameSelect.options].find((candidate) => candidate.value === gameId) ?? gameSelect.options[0];
      if (!option) return;
      gameSelect.value = option.value;
      const summary = document.querySelector('[data-selected-game-summary]'); summary.dataset.gameId = option.value;
      summary.querySelector('[data-game-week]').textContent = `${option.dataset.week} · ${option.dataset.homeAwayLabel}`;
      summary.querySelector('[data-game-opponent]').textContent = `${option.dataset.homeAway} ${option.dataset.opponent}`;
      summary.querySelector('[data-game-date]').textContent = option.dataset.date;
      summary.querySelector('[data-game-kickoff]').textContent = option.dataset.kickoff;
      summary.querySelector('[data-game-venue]').textContent = option.dataset.venue;
      summary.querySelector('[data-game-preview]').href = option.dataset.preview;
      summary.querySelector('[data-game-traits]').replaceChildren(...JSON.parse(option.dataset.traits).map((trait) => text('li', trait)));
    };
    const providerCard = (summary, reference) => {
      const card = document.createElement('article'); card.className = 'ticket-card event-summary-card'; card.dataset.referenceGame = String(reference.gameId ?? '');
      const line = document.createElement('div'); line.className = 'provider-line'; line.append(text('strong', summary.provider), text('span', summary.stale ? 'Stale match' : 'Matched', `health health--${summary.stale ? 'stale' : 'success'}`)); card.append(line);
      card.append(text('p', summary.priceCopy, 'group-price'));
      for (const price of summary.prices.slice(1)) card.append(text('p', price.copy, 'comparison-note'));
      const details = document.createElement('dl');
      for (const [term, value] of [['Coverage', summary.status], ['Data type', 'Event summary'], ['Last checked', dateTime(summary.checkedAt)]]) { const row = document.createElement('div'); row.append(text('dt', term), text('dd', value)); details.append(row); }
      card.append(details);
      if (summary.stale) card.append(text('p', 'This is the last successful provider response and may be out of date.', 'comparison-note'));
      card.append(text('p', summary.disclosure, 'comparison-note'));
      if (summary.href) { const link = text('a', `View tickets on ${summary.provider}`, 'provider-button'); link.href = summary.href; link.target = '_blank'; link.rel = 'nofollow noopener'; link.dataset.ticketOutbound = ''; link.dataset.provider = reference.provider; link.dataset.sourceKind = 'official-primary'; link.dataset.linkPlacement = 'event-summary'; card.append(link); }
      return card;
    };
    const initialRequest = new URLSearchParams(location.search).get('game');
    updateGame(allowedGames.includes(initialRequest) ? initialRequest : allowedGames[0]);
    try {
      const now = Date.now();
      const [status, index] = await Promise.all([
        json('/data/tickets/status.json').then((value) => validateRuntimeStatus(value, now)),
        json('/data/tickets/index.json').then((value) => validateRuntimeIndex(value, now)),
      ]);
      if (status.generatedAt !== index.generatedAt) throw new Error('incompatible runtime snapshot');
      const loadSelected = async (requested) => {
        clearRuntime(); count.textContent = 'Checking provider availability…';
        const selected = selectRuntimeEvent(index, requested, allowedGames);
        updateGame(selected.gameId);
        if (!selected.row) { results.setAttribute('aria-busy', 'false'); unmatched.hidden = false; count.textContent = 'No verified provider match for this game.'; return; }
        try {
          const event = validateRuntimeEvent(await json(runtimeEventUrl(selected.row)), selected.row, Date.now());
          if (event.generatedAt !== status.generatedAt) throw new Error('incompatible runtime event');
          const view = runtimeTicketView(event); const visibleProviders = new Set();
          for (const reference of view.summaries) { const summary = providerEventSummaryModel(reference); results.append(providerCard(summary, { ...reference, gameId: event.event.gameId })); visibleProviders.add(reference.provider); }
          for (const provider of status.providers.filter((item) => item.state === 'error' && !visibleProviders.has(item.provider))) { const card = document.createElement('article'); card.className = 'ticket-card provider-failure'; const line = document.createElement('div'); line.className = 'provider-line'; line.append(text('strong', providerName(provider.provider)), text('span', 'Unavailable', 'health health--error')); card.append(line, text('p', 'Provider check failed. No current event information is available.', 'comparison-note'), text('p', `Data type: ${provider.mode === 'event-summary' ? 'Event summary' : providerName(provider.mode)}`, 'freshness'), text('p', provider.lastSuccess ? `Last successful check ${dateTime(provider.lastSuccess)}` : 'No successful check is available.', 'freshness')); results.append(card); }
          results.setAttribute('aria-busy', 'false');
          if (!results.children.length) { unmatched.hidden = false; count.textContent = 'No verified provider match for this game.'; } else count.textContent = view.summaries.length ? 'Provider information available for this game.' : 'A provider check failed for this game.';
          const coverage = runtimeProviderCoverage(status, event).filter((provider) => !['disabled','pending'].includes(provider.state)); const list = diagnostics.querySelector('[data-runtime-coverage-list]'); list.replaceChildren();
          for (const provider of coverage) { const item = document.createElement('li'); item.append(text('strong', provider.provider), text('small', `${provider.mode} · ${provider.state} · Rejected ${provider.rejectedEvents} · Unmatched ${provider.unmatchedEvents}`)); list.append(item); }
          diagnostics.querySelector('[data-runtime-checked]').textContent = `Snapshot checked ${dateTime(status.generatedAt)}. Counts below are feed diagnostics, not selected-game availability.`; diagnostics.hidden = coverage.length === 0;
        } catch { showFailure(); }
      };
      await loadSelected(initialRequest);
      if (initialRequest && initialRequest !== gameSelect.value) { const params = new URLSearchParams(location.search); params.set('game', gameSelect.value); history.replaceState(null, '', `${location.pathname}?${params}`); }
      controls?.addEventListener('submit', (event) => event.preventDefault());
      gameSelect?.addEventListener('change', async () => { const params = new URLSearchParams(location.search); params.set('game', gameSelect.value); history.pushState(null, '', `${location.pathname}?${params}`); await loadSelected(gameSelect.value); });
      addEventListener('popstate', () => loadSelected(new URLSearchParams(location.search).get('game')));
    } catch { showFailure(); }
  })();
</script>

<script define:vars={{ clientData }}>
  (() => {
    const form = document.querySelector('#ticket-controls');
    if (!form) return;
    const fields = document.querySelector('#filter-fields');
    const toggle = form.querySelector('.compact-toggle');
    const cards = [...document.querySelectorAll('[data-listing]')];
    const summary = document.querySelector('[data-selected-game-summary]');
    const referenceGroups = [...document.querySelectorAll('[data-reference-game]')];
    const count = document.querySelector('#result-count');
    const noResults = document.querySelector('#no-results');
    const noFees = document.querySelector('#no-fee-results');
    const unmatched = document.querySelector('#game-unmatched');
    const valid = (value, values, fallback = 'all') => values.includes(value) ? value : fallback;
    const read = () => {
      const params = new URLSearchParams(location.search);
      const number = (name, min, max, fallback) => { const value = params.get(name); return /^\d+$/.test(value || '') && +value >= min && +value <= max ? +value : fallback; };
      return { game: valid(params.get('game'), clientData.games, clientData.games[0] || ''), quantity:number('quantity',1,8,2), maxTotal:params.has('maxTotal')?number('maxTotal',1,1000000,null):null, homeAway:valid(params.get('homeAway'),['all','home','away']), opponent:valid(params.get('opponent'),['all',...clientData.opponents]), zone:valid(params.get('zone'),['all',...clientData.zones]), source:valid(params.get('source'),['both','official','resale'],'both'), allInOnly:params.get('allInOnly')!=='false', provider:valid(params.get('provider'),['all',...clientData.providers]), sort:valid(params.get('sort'),['lowest_total','lowest_per_ticket','best_zone_within_budget','official_first','most_recent'],'lowest_total'), accessible:params.get('accessible')==='true', delivery:valid(params.get('delivery'),['all',...clientData.deliveries]), mode:valid(params.get('mode'),['admission','parking'],'admission') };
    };
    const fromForm = () => { const data=new FormData(form); return { game:String(data.get('game')||''),quantity:+data.get('quantity'),maxTotal:data.get('maxTotal')?+data.get('maxTotal'):null,homeAway:String(data.get('homeAway')||'all'),opponent:String(data.get('opponent')||'all'),zone:String(data.get('zone')||'all'),source:String(data.get('source')||'both'),allInOnly:data.get('allInOnly')==='true',provider:String(data.get('provider')||'all'),sort:String(data.get('sort')||'lowest_total'),accessible:data.get('accessible')==='true',delivery:String(data.get('delivery')||'all'),mode:String(data.get('mode')||'admission')}; };
    const writeForm = (state) => { Object.entries(state).forEach(([name,value]) => { const controls=[...form.elements].filter((item)=>item.name===name); controls.forEach((control)=>{ if(control.type==='checkbox'||control.type==='radio') control.checked=String(control.value)===String(value); else control.value=value??''; }); }); };
    const total = (listing, quantity) => { if(!listing.allowedQuantities.includes(quantity)) return null; if(listing.allowedQuantities.length===1&&listing.allInGroupTotalCents!==null) return listing.allInGroupTotalCents; if(listing.feeCompleteness==='all_in'&&listing.allInPerTicketCents!==null&&listing.mandatoryFeesCents!==null) return listing.allInPerTicketCents*quantity; return null; };
    const currency = (cents, code) => new Intl.NumberFormat('en-US',{style:'currency',currency:code,maximumFractionDigits:0}).format(cents/100);
    const updateGame = (gameId) => { const game=clientData.gameMeta.find((item)=>item.id===gameId); if(!game||!summary)return; summary.dataset.gameId=game.id; summary.querySelector('[data-game-week]').textContent=`${game.week} · ${game.homeAwayLabel}`; summary.querySelector('[data-game-opponent]').textContent=`${game.homeAway} ${game.opponentName}`; summary.querySelector('[data-game-date]').textContent=game.date; summary.querySelector('[data-game-kickoff]').textContent=game.kickoff; summary.querySelector('[data-game-venue]').textContent=game.venue??'Venue TBD'; summary.querySelector('[data-game-preview]').href=game.href; summary.querySelector('[data-game-traits]').replaceChildren(...game.traits.map((trait)=>{const item=document.createElement('li');item.textContent=trait;return item;})); };
    const apply = (state, push=false) => {
      writeForm(state); updateGame(state.game); referenceGroups.forEach((item)=>item.hidden=item.dataset.referenceGame!==state.game);
      const matchedEvent=clientData.listings.some((listing)=>listing.sfzGameId===state.game); unmatched.hidden=matchedEvent;
      const candidates=[]; let incomplete=0;
      clientData.listings.forEach((listing,index)=>{ const card=cards[index]; const price=total(listing,state.quantity); const official=listing.sourceKind==='official-primary'; const base=listing.sfzGameId===state.game&&(state.homeAway==='all'||listing.homeAway===state.homeAway); const matches=base&&(state.opponent==='all'||listing.opponent===state.opponent)&&(state.zone==='all'||listing.sectionNormalized===state.zone)&&(state.provider==='all'||listing.provider===state.provider)&&(state.source==='both'||(state.source==='official'&&official)||(state.source==='resale'&&!official))&&(state.delivery==='all'||listing.deliveryType===state.delivery)&&(!state.accessible||listing.accessibleStatus==='accessible')&&listing.productType===state.mode&&listing.allowedQuantities.includes(state.quantity);
        const feeMatch=price!==null; if(matches&&!feeMatch) incomplete++; const visible=matches&&(!state.allInOnly||feeMatch)&&(state.maxTotal===null||price!==null&&price<=state.maxTotal*100); card.hidden=!visible; if(visible){ card.querySelector('[data-group-price]').textContent=price===null?'Total unavailable':currency(price,listing.currency); card.querySelector('[data-per-price]').textContent=price===null?'Fee-complete group total not supplied':`${currency(price/state.quantity,listing.currency)} per ticket, all-in`; candidates.push({card,listing,price}); }
      });
      candidates.sort((a,b)=>{ if(state.sort==='official_first'){const delta=Number(b.listing.sourceKind==='official-primary')-Number(a.listing.sourceKind==='official-primary');if(delta)return delta;} if(state.sort==='most_recent')return Date.parse(b.listing.fetchedAt)-Date.parse(a.listing.fetchedAt); if(state.sort==='best_zone_within_budget'){const budget=state.maxTotal===null?Infinity:state.maxTotal*100;const delta=Number((b.price??Infinity)<=budget)-Number((a.price??Infinity)<=budget);if(delta)return delta;} return (a.price??Infinity)-(b.price??Infinity); }); candidates.forEach(({card})=>document.querySelector('#ticket-results').append(card));
      const feeEmpty=matchedEvent&&candidates.length===0&&incomplete>0&&state.allInOnly; noFees.hidden=!feeEmpty; noResults.hidden=!matchedEvent||candidates.length>0||feeEmpty; count.textContent=`${candidates.length} ${candidates.length===1?'offer':'offers'} shown for ${state.quantity} ${state.quantity===1?'ticket':'tickets'}`;
      const value=document.querySelector('[data-value-ticket]'); const selected=clientData.gameMeta.find((game)=>game.id===state.game); value.hidden=!(selected?.isHome&&selected.venue==='Lumen Field'&&!["canceled","postponed"].includes(selected.state)&&state.quantity<=4);
      if(push){const params=new URLSearchParams(); params.set('game',state.game); if(state.quantity!==2)params.set('quantity',state.quantity); if(state.maxTotal!==null)params.set('maxTotal',state.maxTotal); for(const key of ['homeAway','opponent','zone','provider','sort','delivery'])if(state[key]&&!['all','lowest_total'].includes(state[key]))params.set(key,state[key]); if(state.source!=='both')params.set('source',state.source); if(!state.allInOnly)params.set('allInOnly','false'); if(state.accessible)params.set('accessible','true'); if(state.mode!=='admission')params.set('mode',state.mode); history.pushState(null,'',`${location.pathname}?${params}`); }
    };
    toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));fields.classList.toggle('is-open',!open);});
    form.addEventListener('submit',(event)=>{event.preventDefault();apply(fromForm(),true);});
    form.querySelector('[data-clear]')?.addEventListener('click',(event)=>{event.preventDefault();history.pushState(null,'',location.pathname);apply(read());});
    addEventListener('popstate',()=>apply(read())); apply(read());
  })();
</script>

<script>
  import { ticketClickEvent } from "../lib/tickets/analytics.mjs";
  import { readWatchlist, resetWatchlist, writeWatchlist } from "../lib/tickets/watchlist.mjs";

  const watchForm = document.querySelector("#ticket-controls");
  const watchStatus = watchForm?.querySelector("[data-watch-status]");
  const watchOptions = { games: [...(watchForm?.elements?.game?.options || [])].map((option) => option.value), zones: [...(watchForm?.elements?.zone?.options || [])].map((option) => option.value).filter((value) => value !== "all") };
  const savedWatch = readWatchlist(localStorage, watchOptions);
  if (savedWatch && watchForm) {
    watchForm.elements.game.value = savedWatch.game; watchForm.elements.quantity.value = String(savedWatch.quantity); watchForm.elements.maxTotal.value = String(savedWatch.budget); watchForm.elements.zone.value = savedWatch.zone;
    if (watchStatus) watchStatus.textContent = "Saved browser watch loaded. Apply comparison to use it.";
  }
  watchForm?.querySelector("[data-watch-save]")?.addEventListener("click", () => {
    const saved = writeWatchlist(localStorage, { game: watchForm.elements.game.value, quantity: Number(watchForm.elements.quantity.value), budget: Number(watchForm.elements.maxTotal.value), zone: watchForm.elements.zone.value }, watchOptions);
    if (watchStatus) watchStatus.textContent = saved ? "Watch saved only in this browser." : "Enter a budget before saving this watch.";
  });
  watchForm?.querySelector("[data-watch-reset]")?.addEventListener("click", () => {
    resetWatchlist(localStorage); if (watchStatus) watchStatus.textContent = "Saved browser watch reset.";
  });

  document.addEventListener("click", (event) => {
    const link = event.target?.closest?.("[data-ticket-outbound]");
    if (!link) return;
    const form = document.querySelector("#ticket-controls");
    const detail = ticketClickEvent(window.sfzPrivacy?.getState?.(), {
      selectedGame: form?.elements?.game?.value ?? document.querySelector("#runtime-game-controls")?.elements?.game?.value,
      provider: link.dataset.provider,
      sourceKind: link.dataset.sourceKind,
      linkPlacement: link.dataset.linkPlacement,
      sortMode: form?.elements?.sort?.value,
      quantity: form ? Number(form.elements.quantity?.value) : undefined,
    });
    if (!detail) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(detail);
    window.dispatchEvent(new CustomEvent("sfz:analytics", { detail }));
  });
</script>
