---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import {TICKET_FEATURE} from "../lib/tickets/config";
---
<SeahawksLayout title="Seahawks Tickets" description="EventSpy price history for Seattle Seahawks games." seo={{title:"Seahawks Tickets | Seahawks Fan Zone",description:"Season-wide Seahawks ticket price history.",canonicalPath:TICKET_FEATURE.canonical?"/tickets":null,robots: TICKET_FEATURE.robots}} activePath="/tickets" pageType="tickets" monetizationEligible={false} showPageHeader={false}>
<section id="eventspy-mirror" aria-live="polite" aria-busy="true"><div class="loading" role="status"><p>Loading event prices…</p></div></section>
</SeahawksLayout>
<style is:global>
body:has(#eventspy-mirror) .lr-middle{max-width:none}body:has(#eventspy-mirror) .lr-main,body:has(#eventspy-mirror) .lr-paper{width:100%;max-width:none;margin:0;padding:0;background:#f4f6f8;box-shadow:none}body:has(#eventspy-mirror) .seo-breadcrumbs{display:none}.skip-link{position:fixed;left:.75rem;top:.75rem;transform:translateY(-200%);z-index:1000}.skip-link:focus{transform:none}#eventspy-mirror{width:min(1180px,calc(100% - 2rem));margin:1.5rem auto 3rem;color:#0b1f35}.loading{min-height:28rem;display:grid;place-content:center}.game-picker{display:flex;gap:.75rem;align-items:center;margin:0 0 1rem;padding:.8rem 1rem;background:#fff;border:1px solid #d6dde3}.game-picker label{font-weight:900}.game-picker select{flex:1;min-height:44px;border:2px solid #002244;padding:.45rem;background:#fff}.event-head{background:#002244;color:#fff;padding:clamp(1.4rem,4vw,3rem);border-bottom:6px solid #69be28}.event-head h1{color:#fff;font-size:clamp(2rem,5vw,3.5rem);margin:0 0 .8rem}.event-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-weight:700}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.25rem 0;align-items:stretch}.card{background:#fff;border:1px solid #d6dde3;border-top:5px solid #69be28;padding:1.25rem;text-align:center}.card h2{font-size:.85rem;text-transform:uppercase}.price,.days{font:900 clamp(2rem,4vw,3rem)/1 var(--font-display);margin:.7rem 0;color:#002244}.price.current{color:#227414}.age,.disclosure{font-size:.82rem;color:#536171}.low-badge{background:#e5f6da;color:#225d0a;padding:.25rem .6rem;border-radius:999px;font-weight:900}.starting,.providers-title{text-align:center}.providers{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap;margin:1rem auto 1.5rem}.providers a{min-height:46px;display:inline-flex;align-items:center;justify-content:center;flex:1 1 150px;max-width:230px;padding:.65rem 1rem;background:#fff;border:2px solid #002244;font-weight:900;text-decoration:none}.track{display:flex;width:max-content;max-width:100%;margin:0 auto 2.5rem;padding:.8rem 1.25rem;background:#69be28;color:#002244;font-weight:900;text-decoration:none}.history-panel,.faq{background:#fff;padding:clamp(1rem,3vw,2rem);border:1px solid #d6dde3}.history-top{display:flex;justify-content:space-between;gap:1rem;align-items:end;flex-wrap:wrap}.history-top h2{margin:.2rem 0}.subtitle{color:#536171}.controls,.filters{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center}.controls button,.controls select{min-height:44px;border:2px solid #002244;background:#fff;padding:.5rem .8rem;font-weight:800}.controls button[aria-pressed=true]{background:#002244;color:#fff}.filters{padding:.8rem 0}.filter-swatch{display:inline-block;width:1rem;border-top:4px solid var(--c);margin-right:.25rem}.chart-wrap{position:relative;width:100%}.chart{display:block;width:100%;height:auto;border:1px solid #d6dde3}.grid{stroke:#d9dee4}.axis{fill:#536171;font-size:12px}.series{fill:none;stroke-width:3}.endpoint{stroke:#fff;stroke-width:2}.table-wrap{overflow:auto;margin-top:1rem}table{width:100%;border-collapse:collapse}th,td{padding:.55rem;border:1px solid #d6dde3;white-space:nowrap}.faq{margin-top:1.5rem}.faq article+article{border-top:1px solid #d6dde3}.disclosure{margin:1.5rem 0}.error,.unavailable{min-height:18rem;padding:2rem;background:#fff;border-left:5px solid #c33}.unavailable{border-color:#69be28}.stale{background:#fff1c7;padding:.5rem;text-align:center;font-weight:800}:is(a,button,select,input):focus-visible{outline:3px solid #69be28;outline-offset:3px}@media(max-width:650px){#eventspy-mirror{width:calc(100% - 1rem)}.cards{grid-template-columns:1fr}.event-meta,.game-picker{display:grid}.providers a{max-width:none}}@media print{.game-picker,.controls,.filters{display:none!important}}@media(prefers-reduced-motion:reduce){#eventspy-mirror *{animation:none!important;transition:none!important}}
</style>
<script>
import {EVENTSPY_COVERAGE,eventSpyCoverageForGame} from "../lib/tickets/eventspy-coverage.mjs";
import {validateEventSpyMirror,MIRROR_MARKETS} from "../lib/tickets/eventspy-mirror-schema.mjs";
const names={vividseats:"VividSeats",stubhub:"StubHub",ticketmaster:"Ticketmaster",seatgeek:"SeatGeek"},order=["ticketmaster","stubhub","vividseats","seatgeek"],colors={ticketmaster:"#165dff",stubhub:"#6f2dbd",vividseats:"#d81b70",seatgeek:"#d6472f"},root=document.querySelector("#eventspy-mirror"),money=c=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(c/100),esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),date=s=>new Intl.DateTimeFormat("en-US",{weekday:"short",month:"short",day:"numeric",year:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(`${s}T12:00:00-07:00`)),seen=s=>new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(s));
const picker=gameId=>`<div class="game-picker"><label for="seahawks-game">Seahawks game</label><select id="seahawks-game" data-game-selector>${EVENTSPY_COVERAGE.map(row=>`<option value="${row.gameId}"${row.gameId===gameId?" selected":""}>${row.homeAway==="home"?"vs.":"at"} ${esc(row.opponent)} — ${row.localDate?date(row.localDate):"Week 18 · date TBD"}</option>`).join("")}</select></div>`;
function unavailable(row){return`${picker(row.gameId)}<div class="unavailable" role="status"><h1>Seattle Seahawks ${row.homeAway==="home"?"vs.":"at"} ${esc(row.opponent)}</h1><p>EventSpy ticket tracking is not available for this Week 18 game yet. Select another Seahawks game to view prices.</p></div>`}
function content(v){const stale=Date.now()-Date.parse(v.collectedAt)>26*3600e3,time=v.event.localTimeLabel.replace(/(AM|PM)(P[DS]T)$/,"$1 $2").replace(/(\d)(AM|PM)/,"$1 $2");return`${picker(v.gameId)}${stale?'<p class="stale" role="status">Stored EventSpy prices may be stale.</p>':""}<header class="event-head"><h1 data-event-title>${esc(v.event.title)}</h1><div class="event-meta"><span data-event-venue>${esc(v.event.venue)}</span><span data-event-location>${esc(v.event.location)}</span><span data-event-datetime>${date(v.event.localDate)} · ${esc(time)}</span></div></header><div class="cards"><article class="card"><h2>Days Until Event</h2><p class="days" data-days-until>${v.summary.daysUntilEvent}</p></article><article class="card"><h2>Current Lowest</h2><p class="price current" data-current-lowest>${money(v.summary.currentLowestCents)}</p><p class="age">${esc(v.summary.currentLowestAgeLabel)}</p>${v.summary.atSevenDayLow?'<span class="low-badge">At 7-day low</span>':""}</article><article class="card"><h2>7-Day Lowest</h2><p class="price" data-seven-day-lowest>${money(v.summary.sevenDayLowestCents)}</p><p class="age">${esc(v.summary.sevenDayLowestAgeLabel)}</p></article></div><p class="starting">Tickets currently start at <strong>${money(v.summary.currentLowestCents)}</strong>.</p><h2 class="providers-title">View Tickets</h2><div class="providers">${MIRROR_MARKETS.map(m=>`<a data-provider="${m}" href="${esc(v.providerLinks[m])}" target="_blank" rel="sponsored nofollow noopener">${names[m]} ↗</a>`).join("")}</div><a class="track" href="${esc(v.trackingUrl)}" target="_blank" rel="nofollow noopener">Track prices on EventSpy</a><section class="history-panel"><div class="history-top"><div><h2>Lowest Ticket Price History</h2><p class="subtitle">Compare displayed lowest prices across four marketplaces.</p></div><div class="controls" aria-label="Price history controls"><button data-range="30" aria-label="Show 30 days" aria-pressed="true">30d</button><button data-range="14" aria-label="Show 14 days" aria-pressed="false">14d</button><button data-range="7" aria-label="Show 7 days" aria-pressed="false">7d</button><button data-show-filters aria-expanded="false" aria-controls="market-filters">Show Filters</button><label for="market-view">Marketplace view</label><select id="market-view" data-market-selector><option value="combined">Combined</option>${order.map(m=>`<option value="${m}">${names[m]}</option>`).join("")}</select></div></div><div class="filters" id="market-filters" hidden>${order.map(m=>`<label><input type="checkbox" data-filter="${m}" checked> <span class="filter-swatch" style="--c:${colors[m]}"></span>${names[m]}</label>`).join("")}</div><div class="chart-wrap"><svg class="chart" viewBox="0 0 1000 390" role="img" aria-label="Lowest ticket price history" data-history-chart></svg></div><details><summary>Accessible price history table</summary><div class="table-wrap"><table><caption>EventSpy displayed price history in USD</caption><thead><tr><th>Date</th>${order.map(m=>`<th>${names[m]}</th>`).join("")}</tr></thead><tbody></tbody></table></div></details></section><section class="faq"><h2>Frequently Asked Questions</h2><article><h3>What is the current starting price?</h3><p>The displayed current starting price is ${money(v.summary.currentLowestCents)}.</p></article><article><h3>What is the recent low?</h3><p>The displayed 7-day low is ${money(v.summary.sevenDayLowestCents)}.</p></article><article><h3>Which marketplace is currently cheapest?</h3><p>${v.summary.currentLowestMarketplace?`${names[v.summary.currentLowestMarketplace]} is lowest in the latest EventSpy observation.`:"The latest observation does not identify one unambiguous cheapest marketplace."}</p></article></section><p class="disclosure"><strong>Affiliate and source disclosure:</strong> Prices and outbound links are attributed to the authorized EventSpy page and can change. Seahawks Fan Zone may earn a commission. Verify availability, fees, and checkout totals.</p>`}
function renderChart(v,days=30,selected="combined"){const svg=root.querySelector("[data-history-chart]"),end=Date.parse(v.history.at(-1).observedAt),points=v.history.filter(p=>Date.parse(p.observedAt)>=end-days*864e5),shown=selected==="combined"?order.filter(m=>root.querySelector(`[data-filter="${m}"]`).checked):[selected],values=points.flatMap(p=>shown.map(m=>p[`${m}Cents`])).filter(Number.isSafeInteger);if(!values.length){svg.replaceChildren();return}const lo=Math.min(...values),hi=Math.max(...values),W=1000,H=390,L=85,R=25,T=20,B=45,x=i=>points.length<2?(W+L-R)/2:L+i/(points.length-1)*(W-L-R),y=n=>T+(hi-n)/Math.max(1,hi-lo)*(H-T-B),ns="http://www.w3.org/2000/svg";svg.replaceChildren();for(let i=0;i<5;i++){const yy=T+i*(H-T-B)/4,line=document.createElementNS(ns,"line"),label=document.createElementNS(ns,"text"),val=Math.round(hi-i*(hi-lo)/4);for(const[k,z]of Object.entries({x1:L,x2:W-R,y1:yy,y2:yy}))line.setAttribute(k,z);line.setAttribute("class","grid");label.setAttribute("x","4");label.setAttribute("y",yy+4);label.setAttribute("class","axis");label.textContent=money(val);svg.append(line,label)}for(const m of order){const group=document.createElementNS(ns,"g");group.dataset.historySeries=m;group.style.display=shown.includes(m)?"":"none";let d="",open=false,last;points.forEach((p,i)=>{const n=p[`${m}Cents`];if(!Number.isSafeInteger(n)){open=false;return}d+=`${open?"L":"M"}${x(i)},${y(n)} `;open=true;last={i,n}});const path=document.createElementNS(ns,"path");path.setAttribute("d",d);path.setAttribute("stroke",colors[m]);path.setAttribute("class","series");group.append(path);if(last){const circle=document.createElementNS(ns,"circle");for(const[k,z]of Object.entries({cx:x(last.i),cy:y(last.n),r:6,fill:colors[m]}))circle.setAttribute(k,z);circle.setAttribute("class","endpoint");group.append(circle)}svg.append(group)}root.querySelector("tbody").innerHTML=points.map(p=>`<tr><th>${seen(p.observedAt)}</th>${order.map(m=>`<td>${p[`${m}Cents`]===null?"—":money(p[`${m}Cents`])}</td>`).join("")}</tr>`).join("");svg.dataset.visiblePoints=String(points.length)}
function bindPicker(){root.querySelector("[data-game-selector]").onchange=event=>{const url=new URL(location.href);url.searchParams.set("game",event.target.value);history.pushState({},"",url);load(event.target.value)}}
function activate(v){bindPicker();let days=30,selected="combined";root.querySelectorAll("[data-range]").forEach(button=>button.onclick=()=>{days=Number(button.dataset.range);root.querySelectorAll("[data-range]").forEach(other=>other.setAttribute("aria-pressed",String(other===button)));renderChart(v,days,selected)});const filters=root.querySelector(".filters"),show=root.querySelector("[data-show-filters]");show.onclick=()=>{filters.hidden=!filters.hidden;show.setAttribute("aria-expanded",String(!filters.hidden))};filters.onchange=()=>renderChart(v,days,selected);root.querySelector("[data-market-selector]").onchange=event=>{selected=event.target.value;renderChart(v,days,selected)};renderChart(v);Object.assign(root.dataset,{eventspyMirrorReady:"true",gameId:v.gameId,historyPoints:String(v.history.length),providerLinks:"4",currentLowestCents:String(v.summary.currentLowestCents),sevenDayLowestCents:String(v.summary.sevenDayLowestCents),collectedAt:v.collectedAt})}
async function load(requested){root.setAttribute("aria-busy","true");const row=eventSpyCoverageForGame(requested??new URLSearchParams(location.search).get("game")??EVENTSPY_COVERAGE[0].gameId);if(!row){root.innerHTML='<div class="error" role="alert"><h1>Event prices unavailable</h1><p>The requested Seahawks game is not in the reviewed schedule.</p></div>';root.setAttribute("aria-busy","false");return}const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);try{const response=await fetch(`/data/eventspy-mirror/${row.gameId}.json`,{cache:"no-store",headers:{accept:"application/json"},signal:controller.signal});if(!response.ok)throw Error();const value=validateEventSpyMirror(await response.json());if(value.state==="unavailable"){root.innerHTML=unavailable(row);bindPicker()}else{root.innerHTML=content(value);activate(value)}}catch{root.innerHTML=`${picker(row.gameId)}<div class="error" role="alert"><h1>Event prices unavailable</h1><p>The validated EventSpy snapshot could not be loaded.</p></div>`;bindPicker()}finally{clearTimeout(timer);root.setAttribute("aria-busy","false")}}
addEventListener("popstate",()=>load());load();
</script>
