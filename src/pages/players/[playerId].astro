---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import playersData from "../../data/nfl/players.json";
import profilesData from "../../data/nfl/playerProfiles.json";
import injuriesData from "../../data/nfl/injuries.json";

/* =======================
   Helpers (safe + local)
   ======================= */

function getRoster(playersJson) {
  if (Array.isArray(playersJson?.data)) return playersJson.data;
  if (Array.isArray(playersJson?.players)) return playersJson.players;
  if (Array.isArray(playersJson)) return playersJson;
  return [];
}

function playerIdOf(p) {
  return p?.id ?? p?.player_id ?? null;
}

function playerName(p) {
  if (!p) return "Unknown";
  const full = `${p.first_name || ""} ${p.last_name || ""}`.trim();
  return full || p.full_name || "Unknown";
}

function pos(p) {
  return String(p?.position_abbreviation || p?.position || "").toUpperCase() || "-";
}

function nOrDash(v) {
  return typeof v === "number" ? String(v) : "-";
}

function fmtPT(dateStr) {
  if (!dateStr) return "—";
  const d = new Date(dateStr);
  try {
    return d.toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      dateStyle: "medium",
      timeStyle: "short",
    });
  } catch {
    return d.toISOString();
  }
}

/* =========================================
   getStaticPaths (SELF-CONTAINED, no roster)
   ========================================= */
export function getStaticPaths() {
  const roster = getRoster(playersData);

  // Only build pages for players with IDs
  const ids = roster
    .map((p) => playerIdOf(p))
    .filter((id) => id !== null && id !== undefined)
    .map((id) => String(id));

  // de-dupe
  const seen = new Set();
  const unique = [];
  for (const id of ids) {
    if (seen.has(id)) continue;
    seen.add(id);
    unique.push(id);
  }

  return unique.map((id) => ({
    params: { playerId: id },
  }));
}

/* =======================
   Page logic
   ======================= */
const { playerId } = Astro.params;

const roster = getRoster(playersData);
const player =
  roster.find((p) => String(playerIdOf(p)) === String(playerId)) || null;

const profiles = profilesData?.profiles && typeof profilesData.profiles === "object"
  ? profilesData.profiles
  : {};

const profile = profiles?.[String(playerId)] || null;

// injuries.json is { injuries: [...] } with items containing playerId
const injuriesArr = Array.isArray(injuriesData?.injuries) ? injuriesData.injuries : [];
const injury =
  injuriesArr.find((x) => String(x?.playerId) === String(playerId)) || null;

const title = player ? `${playerName(player)} — Player` : "Player not found";
---

<SeahawksLayout title={title} description="Player page." activePath="/players">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/players">Players</a></span>
  </div>

  {player ? (
    <>
      <article class="card">
        <div class="card-top">
          <div class="week">{playerName(player)}</div>
          <div class="date">Pos: {pos(player)}</div>
        </div>

        <div class="player-grid">
          <div class="kv">
            <div class="k">Jersey</div>
            <div class="v">{player?.jersey_number ?? player?.jersey ?? "-"}</div>
          </div>
          <div class="kv">
            <div class="k">Height</div>
            <div class="v">{player?.height ?? "-"}</div>
          </div>
          <div class="kv">
            <div class="k">Weight</div>
            <div class="v">{player?.weight ?? "-"}</div>
          </div>
          <div class="kv">
            <div class="k">College</div>
            <div class="v">{player?.college ?? "-"}</div>
          </div>
          <div class="kv">
            <div class="k">Experience</div>
            <div class="v">{player?.experience ?? player?.years_pro ?? "-"}</div>
          </div>
        </div>
      </article>

      <section class="recap">
        <h3 class="recap-title">Bio</h3>

        {!profile?.bio ? (
          <div class="empty">Bio coming soon.</div>
        ) : (
          <p class="recap-text">{profile.bio}</p>
        )}
      </section>

      <section class="recap">
        <h3 class="recap-title">Gameplay recap</h3>

        {!profile?.recap?.paragraph ? (
          <div class="empty">Recap coming soon.</div>
        ) : (
          <>
            <p class="recap-text">{profile.recap.paragraph}</p>

            {Array.isArray(profile?.recap?.bullets) && profile.recap.bullets.length > 0 ? (
              <ul class="recap-bullets">
                {profile.recap.bullets.map((b) => <li>{b}</li>)}
              </ul>
            ) : null}
          </>
        )}
      </section>

      <section class="recap">
        <h3 class="recap-title">Injury report</h3>

        {!injury ? (
          <div class="empty">No injury listed.</div>
        ) : (
          <div class="injury-card">
            <div class="inj-row">
              <div class="inj-k">Status</div>
              <div class="inj-v">{injury?.status ?? "-"}</div>
            </div>
            <div class="inj-row">
              <div class="inj-k">Details</div>
              <div class="inj-v">{injury?.description ?? "-"}</div>
            </div>
            <div class="inj-row">
              <div class="inj-k">Report date</div>
              <div class="inj-v">{fmtPT(injury?.reportDate ?? injury?.report_date ?? injury?.date)}</div>
            </div>
          </div>
        )}
      </section>
    </>
  ) : (
    <div class="empty">Couldn’t find that player.</div>
  )}

  <style>
    .meta-line,
    .card,
    .card-top,
    .week,
    .date,
    .recap,
    .recap-text,
    .recap-bullets,
    .player-grid,
    .injury-card {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .week,
    .date,
    .empty,
    .recap-text,
    .recap-bullets {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .6rem;
      align-items: baseline;
    }

    .week { font-weight: 900; color: var(--navy); font-size: 1.1rem; }
    .date { color: rgba(15,23,32,.65); font-weight: 800; }

    .player-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .7rem;
      margin-top: .25rem;
    }

    @media (max-width: 700px) {
      .player-grid { grid-template-columns: 1fr; }
    }

    .kv {
      border: 1px solid rgba(0,34,68,.12);
      border-radius: 12px;
      padding: .6rem .7rem;
      background: rgba(0,34,68,.03);
    }

    .k { font-weight: 900; color: rgba(0,34,68,.72); font-size: .85rem; }
    .v { font-weight: 900; color: rgba(0,34,68,.92); margin-top: .15rem; }

    .recap { margin-top: 1.05rem; }
    .recap-title { margin: 0 0 .5rem; color: var(--navy); }
    .recap-text { line-height: 1.55; font-weight: 700; color: rgba(0,34,68,.92); }

    .recap-bullets { margin: .6rem 0 0; padding-left: 1.1rem; }
    .recap-bullets li { margin: .35rem 0; }

    .injury-card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: #fff;
      box-shadow: 0 10px 22px rgba(0,0,0,.06);
      padding: .75rem .85rem;
    }

    .inj-row {
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      gap: .65rem;
      padding: .45rem 0;
      border-bottom: 1px solid rgba(0,34,68,.08);
    }
    .inj-row:last-child { border-bottom: 0; }

    .inj-k { font-weight: 900; color: rgba(0,34,68,.75); }
    .inj-v { font-weight: 800; color: rgba(0,34,68,.92); }
  </style>
</SeahawksLayout>
