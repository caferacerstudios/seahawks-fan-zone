---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import rosterData from "../../data/nfl/players.json";
import seahawksData from "../../data/nfl/seahawks.json";
import playerProfiles from "../../data/nfl/playerProfiles.json";
import injuriesData from "../../data/nfl/injuries.json";

/* =======================
   Helpers
   ======================= */
function getRosterLocal(playersJson) {
  if (Array.isArray(playersJson?.data)) return playersJson.data;
  if (Array.isArray(playersJson?.players)) return playersJson.players;
  if (Array.isArray(playersJson)) return playersJson;
  return [];
}

function pidFromRoster(p) {
  return p?.id ?? p?.player_id ?? null;
}

function fullNameFromRoster(p) {
  const full = `${p?.first_name || ""} ${p?.last_name || ""}`.trim();
  return full || p?.full_name || "Unknown";
}

function posFromRoster(p) {
  return String(p?.position_abbreviation || p?.position || "").toUpperCase() || "-";
}

function fmtUpdatedPT(iso) {
  if (!iso) return "—";
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));
}

function n(v) {
  return typeof v === "number" ? v : 0;
}
function dashIfNull(v) {
  return typeof v === "number" ? v : "-";
}
function tdTriplet(r) {
  return `${n(r.passing_touchdowns)}/${n(r.rushing_touchdowns)}/${n(r.receiving_touchdowns)}`;
}
function totalYards(r) {
  return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
}

function normalizeStatus(s) {
  const t = String(s || "").toLowerCase();
  if (!t) return "";
  if (t.includes("out")) return "Out";
  if (t.includes("doubt")) return "Doubtful";
  if (t.includes("question")) return "Questionable";
  if (t.includes("prob")) return "Probable";
  return String(s);
}

function safeStr(v) {
  return v === null || v === undefined ? "" : String(v);
}

/* =======================
   getStaticPaths (SELF-CONTAINED)
   ======================= */
export function getStaticPaths() {
  // NOTE: this must be self-contained (no outer helpers referenced)
  function getRoster(playersJson) {
    if (Array.isArray(playersJson?.data)) return playersJson.data;
    if (Array.isArray(playersJson?.players)) return playersJson.players;
    if (Array.isArray(playersJson)) return playersJson;
    return [];
  }
  function pid(p) {
    return p?.id ?? p?.player_id ?? null;
  }

  const roster = getRoster(rosterData);
  const profileMap = playerProfiles?.profiles || {};

  // Only build pages for players that have a generated profile (prevents 404s)
  const seen = new Set();
  const paths = [];

  for (const p of roster) {
    const id = pid(p);
    if (id === null || id === undefined) continue;
    const key = String(id);
    if (seen.has(key)) continue;
    seen.add(key);

    if (!profileMap[key]) continue;
    paths.push({ params: { playerId: key } });
  }

  return paths;
}

/* =======================
   Page logic
   ======================= */
const { playerId } = Astro.params;

const roster = getRosterLocal(rosterData);
const player = roster.find((p) => String(pidFromRoster(p)) === String(playerId)) || null;

const profileMap = playerProfiles?.profiles || {};
const profile = profileMap[String(playerId)] || null;

const seasonStatsRows = Array.isArray(seahawksData?.playerSeasonStats) ? seahawksData.playerSeasonStats : [];
const statRowCandidates = seasonStatsRows.filter((r) => String(r?.player?.id ?? r?.player_id ?? "") === String(playerId));
const statRow =
  statRowCandidates.length > 0
    ? statRowCandidates.slice().sort((a, b) => totalYards(b) - totalYards(a))[0]
    : null;

const allInjuries = Array.isArray(injuriesData?.injuries) ? injuriesData.injuries : [];
const playerInjuries = allInjuries.filter((row) => {
  const rid = row?.player_id ?? row?.player?.id ?? null;
  if (rid !== null && rid !== undefined) return String(rid) === String(playerId);

  // fallback: name match if API didn’t include ids
  const nm = safeStr(row?.player_name || row?.player?.full_name || "");
  const target = player ? fullNameFromRoster(player) : "";
  return nm && target && nm.toLowerCase() === target.toLowerCase();
});

const pageName = player ? fullNameFromRoster(player) : (profile?.name || "Player");
const pagePos = player ? posFromRoster(player) : (profile?.position || "-");
const pageTitle = `${pageName} — ${pagePos}`;

const updatedLine = seahawksData?.updatedAt ? fmtUpdatedPT(seahawksData.updatedAt) + " PT" : "—";
---

<SeahawksLayout title={pageTitle} description="Seahawks player profile." activePath="">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/players">Players</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
    <span class="dot">•</span>
    <span><strong>Updated:</strong> {updatedLine}</span>
  </div>

  {!player && !profile ? (
    <div class="empty">Couldn’t find that player.</div>
  ) : (
    <>
      <article class="card">
        <div class="card-top">
          <div class="who">
            <div class="name">{pageName}</div>
            <div class="sub">{pagePos}</div>
          </div>
          <div class="right">
            {statRow ? (
              <div class="pill">GP: {dashIfNull(statRow.games_played)}</div>
            ) : (
              <div class="pill pill--ghost">No season stats</div>
            )}
          </div>
        </div>

        {profile?.bio ? (
          <div class="bio">
            <h3 class="h3">Bio</h3>
            <p class="p">{profile.bio}</p>
          </div>
        ) : (
          <div class="empty" style="margin-top:.75rem;">Bio coming soon.</div>
        )}

        {profile?.recap?.paragraph ? (
          <div class="recap">
            <h3 class="h3">Gameplay recap</h3>
            <p class="p">{profile.recap.paragraph}</p>

            {Array.isArray(profile?.recap?.bullets) && profile.recap.bullets.length > 0 && (
              <ul class="bullets">
                {profile.recap.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ) : (
          <div class="empty" style="margin-top:.75rem;">Gameplay recap coming soon.</div>
        )}
      </article>

      <section class="two-col">
        <div class="panel">
          <h3 class="h3">Season stats</h3>
          {!statRow ? (
            <div class="empty">No season stat line found for this player.</div>
          ) : (
            <div class="stats-grid">
              <div class="k">Pass Yds</div><div class="v">{dashIfNull(statRow.passing_yards)}</div>
              <div class="k">Rush Yds</div><div class="v">{dashIfNull(statRow.rushing_yards)}</div>
              <div class="k">Rec Yds</div><div class="v">{dashIfNull(statRow.receiving_yards)}</div>
              <div class="k">TD P/R/Rec</div><div class="v">{tdTriplet(statRow)}</div>
            </div>
          )}
        </div>

        <div class="panel">
          <h3 class="h3">Injury report</h3>

          {playerInjuries.length === 0 ? (
            <div class="empty">No injury entries found for this player.</div>
          ) : (
            <div class="inj-list">
              {playerInjuries.slice(0, 8).map((inj) => (
                <div class="inj">
                  <div class="inj-top">
                    <div class="inj-status">{normalizeStatus(inj?.status || inj?.injury_status || "") || "Status"}</div>
                    <div class="inj-date">{safeStr(inj?.date || inj?.report_date || inj?.updated_at || "")}</div>
                  </div>
                  <div class="inj-body">
                    {safeStr(inj?.description || inj?.injury || inj?.note || inj?.details || "") || "—"}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    </>
  )}

  <style>
    .meta-line,
    .card,
    .card-top,
    .two-col,
    .panel,
    .stats-grid,
    .inj-list {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }
    .dot { opacity: .5; }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .75rem;
      align-items: flex-start;
    }

    .who { min-width: 0; }
    .name { font-weight: 1000; color: var(--navy); font-size: 1.35rem; line-height: 1.15; }
    .sub { color: rgba(15,23,32,.65); font-weight: 900; margin-top: .15rem; }

    .right { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: flex-end; }
    .pill{
      display:inline-flex;
      align-items:center;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      white-space: nowrap;
    }
    .pill--ghost{ background: transparent; }

    .h3 { margin: .2rem 0 .45rem; color: var(--navy); }
    .p { line-height: 1.55; font-weight: 750; color: rgba(0,34,68,.92); overflow-wrap:anywhere; }

    .bio { margin-top: .35rem; }
    .recap { margin-top: .9rem; }
    .bullets { margin: .55rem 0 0; padding-left: 1.1rem; }
    .bullets li { margin: .35rem 0; }

    .two-col {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .85rem;
      margin-top: .85rem;
    }
    @media (max-width: 820px) {
      .two-col { grid-template-columns: 1fr; }
    }

    .panel {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.06);
      overflow: hidden;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .45rem .75rem;
      margin-top: .25rem;
    }
    .k { color: rgba(15,23,32,.65); font-weight: 900; }
    .v { color: rgba(0,34,68,.92); font-weight: 1000; text-align: right; }

    .inj-list { display: grid; gap: .6rem; margin-top: .25rem; }
    .inj {
      border-radius: 12px;
      border: 1px solid rgba(0,34,68,0.12);
      background: rgba(0,34,68,0.03);
      padding: .65rem .7rem;
      overflow: hidden;
    }
    .inj-top {
      display: flex;
      justify-content: space-between;
      gap: .6rem;
      align-items: baseline;
      margin-bottom: .35rem;
    }
    .inj-status { font-weight: 1000; color: rgba(0,34,68,.90); }
    .inj-date { color: rgba(15,23,32,.55); font-weight: 900; overflow-wrap:anywhere; }
    .inj-body { color: rgba(0,34,68,.90); font-weight: 750; line-height: 1.45; overflow-wrap:anywhere; }
  </style>
</SeahawksLayout>

