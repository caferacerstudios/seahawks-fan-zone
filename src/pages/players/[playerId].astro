---
import fs from "node:fs";
import path from "node:path";

import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import rosterData from "../../data/nfl/players.json";
import seasonData from "../../data/nfl/seahawks.json";
import playerProfilesData from "../../data/nfl/playerProfiles.json";
import injuriesData from "../../data/nfl/injuries.json";

/* =======================
   getStaticPaths (SELF-CONTAINED)
   ======================= */
export function getStaticPaths() {
  function getRosterLocal(playersData) {
    if (Array.isArray(playersData?.data)) return playersData.data;
    if (Array.isArray(playersData?.players)) return playersData.players;
    if (Array.isArray(playersData)) return playersData;
    return [];
  }

  function pidLocal(p) {
    return p?.id ?? p?.player_id ?? p?.player?.id ?? null;
  }

  const roster = getRosterLocal(rosterData);
  const seen = new Set();
  const out = [];

  for (const p of roster) {
    const id = pidLocal(p);
    if (id === null || id === undefined) continue;
    const key = String(id);
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ params: { playerId: key } });
  }

  const statRows = Array.isArray(seasonData?.playerSeasonStats) ? seasonData.playerSeasonStats : [];
  for (const r of statRows) {
    const id = r?.player?.id ?? r?.player_id ?? null;
    if (id === null || id === undefined) continue;
    const key = String(id);
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ params: { playerId: key } });
  }

  return out;
}

/* =======================
   Helpers (page render)
   ======================= */
const { playerId } = Astro.params;

function getRoster(playersData) {
  if (Array.isArray(playersData?.data)) return playersData.data;
  if (Array.isArray(playersData?.players)) return playersData.players;
  if (Array.isArray(playersData)) return playersData;
  return [];
}

function pid(p) {
  return p?.id ?? p?.player_id ?? p?.player?.id ?? null;
}

function playerNameFromAny(obj) {
  const p = obj?.player ?? obj;
  if (!p) return "Unknown";
  const full = p?.full_name || `${p?.first_name || ""} ${p?.last_name || ""}`.trim();
  return full || "Unknown";
}

function findRosterPlayer(id) {
  const roster = getRoster(rosterData);
  const key = String(id);
  return roster.find((p) => String(pid(p)) === key) || null;
}

function bestStatRowForPlayer(id) {
  const rows = Array.isArray(seasonData?.playerSeasonStats) ? seasonData.playerSeasonStats : [];
  const key = String(id);

  function n(v) {
    return typeof v === "number" ? v : 0;
  }
  function totalYards(r) {
    return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
  }

  let best = null;
  for (const r of rows) {
    const rid = r?.player?.id ?? r?.player_id ?? null;
    if (rid === null || rid === undefined) continue;
    if (String(rid) !== key) continue;
    if (!best || totalYards(r) > totalYards(best)) best = r;
  }
  return best;
}

function dash(v) {
  return typeof v === "number" ? v : "—";
}

function fmtUpdatedPT(iso) {
  if (!iso) return "—";
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));
}

/* =======================
   Profiles: support multiple shapes
   ======================= */
function getProfileFor(id) {
  const key = String(id);
  const root = playerProfilesData || {};

  const map1 = root?.profiles && typeof root.profiles === "object" ? root.profiles : null;
  const map2 = root?.byId && typeof root.byId === "object" ? root.byId : null;
  if (map1 && map1[key]) return map1[key];
  if (map2 && map2[key]) return map2[key];

  if (root?.data && typeof root.data === "object" && !Array.isArray(root.data) && root.data[key]) {
    return root.data[key];
  }

  if (Array.isArray(root?.data)) {
    const hit = root.data.find((x) => String(x?.player_id ?? x?.id ?? x?.player?.id ?? "") === key);
    if (hit) return hit;
  }

  if (root && typeof root === "object" && root[key]) return root[key];

  return null;
}

function normalizeProfile(p) {
  if (!p || typeof p !== "object") return { bio: null, recap: null, name: null };

  if (typeof p?.bio === "string" && p?.recap && typeof p.recap === "object") {
    return {
      name: p?.name ?? p?.full_name ?? null,
      bio: p.bio,
      recap: {
        paragraph: typeof p.recap?.paragraph === "string" ? p.recap.paragraph : null,
        bullets: Array.isArray(p.recap?.bullets) ? p.recap.bullets : [],
      },
    };
  }

  const paragraph = p?.recap_paragraph ?? p?.paragraph ?? p?.gameplay_paragraph ?? null;

  const bullets =
    Array.isArray(p?.recap_bullets) ? p.recap_bullets :
    Array.isArray(p?.bullets) ? p.bullets :
    Array.isArray(p?.gameplay_bullets) ? p.gameplay_bullets :
    [];

  return {
    name: p?.name ?? p?.full_name ?? null,
    bio: typeof p?.bio === "string" ? p.bio : null,
    recap: paragraph ? { paragraph: String(paragraph), bullets: bullets.map(String) } : null,
  };
}

/* =======================
   Injuries: support multiple shapes
   ======================= */
function getInjuryArray(root) {
  if (Array.isArray(root?.injuries)) return root.injuries;
  if (Array.isArray(root?.data)) return root.data;
  if (Array.isArray(root)) return root;
  return [];
}

function normalizeInjRow(x) {
  if (!x || typeof x !== "object") return null;

  const p = x?.player ?? null;

  const id = x?.player_id ?? x?.playerId ?? p?.id ?? x?.id ?? null;

  const status =
    x?.status ??
    x?.game_status ??
    x?.injury_status ??
    x?.practice_status ??
    x?.designation ??
    null;

  const description =
    x?.description ??
    x?.injury ??
    x?.injury_description ??
    x?.notes ??
    x?.detail ??
    null;

  const date =
    x?.date ??
    x?.report_date ??
    x?.updated_at ??
    x?.created_at ??
    x?.updatedAt ??
    null;

  return { id, status, description, date };
}

/* =======================
   Team logo + manual headshot (name-based, typo-tolerant)
   ======================= */
function teamAbbrFromAny(rosterPlayer, statRow) {
  const a =
    rosterPlayer?.team?.abbreviation ||
    rosterPlayer?.team_abbreviation ||
    rosterPlayer?.team ||
    statRow?.player?.team?.abbreviation ||
    statRow?.team_abbreviation ||
    "SEA";
  return String(a || "SEA").toUpperCase();
}

function teamLogoUrl(abbr) {
  return `/images/nfl/teams/${String(abbr || "SEA").toUpperCase()}.png`;
}

// Normalize a name / filename to a "comparable" key:
// - lowercase
// - remove diacritics
// - keep only a-z0-9
function normKey(s) {
  return String(s || "")
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "") // strip accents
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "");
}

// Small Levenshtein distance for "slight typo"
function levenshtein(a, b) {
  a = String(a || "");
  b = String(b || "");
  const n = a.length;
  const m = b.length;
  if (n === 0) return m;
  if (m === 0) return n;

  const dp = new Array(m + 1);
  for (let j = 0; j <= m; j++) dp[j] = j;

  for (let i = 1; i <= n; i++) {
    let prev = dp[0];
    dp[0] = i;
    for (let j = 1; j <= m; j++) {
      const tmp = dp[j];
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[j] = Math.min(
        dp[j] + 1,      // deletion
        dp[j - 1] + 1,  // insertion
        prev + cost     // substitution
      );
      prev = tmp;
    }
  }
  return dp[m];
}

// Build a directory index ONCE per page module load.
// Put images here (any extension): public/images/nfl/players/<anything>.jpg|png|webp...
const projectRoot = Astro.root ?? process.cwd();
const playersDirDisk = path.join(projectRoot, "public", "images", "nfl", "players");
const allowedExt = new Set([".jpg", ".jpeg", ".png", ".webp", ".avif"]);

function listPlayerImageFiles() {
  try {
    const files = fs.readdirSync(playersDirDisk);
    return files.filter((f) => allowedExt.has(path.extname(f).toLowerCase()));
  } catch {
    return [];
  }
}

const playerImageFiles = listPlayerImageFiles();

// Index by normalized basename for exact-ish lookup
const imageIndex = new Map(); // normBase -> filename
for (const f of playerImageFiles) {
  const base = path.basename(f, path.extname(f));
  const k = normKey(base);
  if (!k) continue;
  // keep first if duplicates
  if (!imageIndex.has(k)) imageIndex.set(k, f);
}

/**
 * Find an image by display name:
 * - exact match on normalized base
 * - else best Levenshtein match within small threshold (typo tolerance)
 *
 * Your manual workflow:
 *   Save files in: public/images/nfl/players/
 *   Name them like: "DK Metcalf.jpg" or "dk_metcalf.png" or even "Dk Metcalf.webp"
 */
function findHeadshotForName(displayName) {
  const target = normKey(displayName);
  if (!target) return null;

  // exact normalized match
  const exact = imageIndex.get(target);
  if (exact) return `/images/nfl/players/${encodeURIComponent(exact)}`;

  // prefix contains check (handles extra middle initials, etc.)
  for (const [k, f] of imageIndex.entries()) {
    if (k.startsWith(target) || target.startsWith(k)) {
      return `/images/nfl/players/${encodeURIComponent(f)}`;
    }
  }

  // typo-tolerant match
  let bestFile = null;
  let bestDist = Infinity;

  for (const [k, f] of imageIndex.entries()) {
    // quick length guard (avoid weird matches)
    if (Math.abs(k.length - target.length) > 3) continue;

    const d = levenshtein(target, k);
    if (d < bestDist) {
      bestDist = d;
      bestFile = f;
      if (bestDist === 1) break; // good enough
    }
  }

  // allow only "slight typo"
  if (bestFile && bestDist <= 2) {
    return `/images/nfl/players/${encodeURIComponent(bestFile)}`;
  }

  return null;
}

/* =======================
   Page data
   ======================= */
const rosterPlayer = findRosterPlayer(playerId);
const statRow = bestStatRowForPlayer(playerId);

const rawProfile = getProfileFor(playerId);
const profile = normalizeProfile(rawProfile);

const injuries = getInjuryArray(injuriesData).map(normalizeInjRow).filter(Boolean);
const injuryMatches = injuries.filter((r) => String(r.id ?? "") === String(playerId));

const displayName =
  playerNameFromAny(rosterPlayer) !== "Unknown"
    ? playerNameFromAny(rosterPlayer)
    : (playerNameFromAny(statRow?.player) !== "Unknown"
        ? playerNameFromAny(statRow?.player)
        : (profile?.name || "Player"));

const position =
  (rosterPlayer?.position_abbreviation || rosterPlayer?.position || statRow?.player?.position_abbreviation || "—");

const jersey =
  rosterPlayer?.jersey_number ?? rosterPlayer?.jersey ?? rosterPlayer?.number ?? "—";

const height =
  rosterPlayer?.height ?? rosterPlayer?.height_feet_inches ?? "—";

const weight =
  rosterPlayer?.weight ?? rosterPlayer?.weight_lbs ?? "—";

const experience =
  rosterPlayer?.experience ?? rosterPlayer?.years_pro ?? "—";

const updatedAtForPage =
  playerProfilesData?.updatedAt ?? seasonData?.updatedAt ?? null;

const pageTitle = `${displayName} — Player Profile`;

// image URLs
const abbr = teamAbbrFromAny(rosterPlayer, statRow);
const fallbackImg = teamLogoUrl(abbr);
const headshotImg = findHeadshotForName(displayName) || fallbackImg;
---

<SeahawksLayout title={pageTitle} description="Player profile page." activePath="/players">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/players">Players</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
  </div>

  <article class="card">
    <div class="card-top">
      <div class="avatar-wrap">
        <img
          class="avatar"
          src={headshotImg}
          alt={`${displayName} headshot`}
          width="104"
          height="104"
          loading="lazy"
          decoding="async"
          onerror={`this.onerror=null;this.src='${fallbackImg}';`}
        />
      </div>

      <div class="top-text">
        <div class="name">{displayName}</div>
        <div class="sub">
          <span><strong>Pos:</strong> {String(position).toUpperCase()}</span>
          <span class="dot">•</span>
          <span><strong>Jersey:</strong> {String(jersey)}</span>
          <span class="dot">•</span>
          <span><strong>Updated:</strong> {fmtUpdatedPT(updatedAtForPage)} PT</span>
        </div>
      </div>
    </div>

    <div class="grid">
      <div class="panel">
        <div class="panel-title">Bio</div>
        {profile?.bio ? (
          <p class="body">{profile.bio}</p>
        ) : (
          <div class="empty">Bio coming soon.</div>
        )}
      </div>

      <div class="panel">
        <div class="panel-title">Season snapshot</div>

        {!statRow ? (
          <div class="empty">No season stats found for this player in the current file.</div>
        ) : (
          <div class="stats">
            <div class="stat"><span class="k">GP</span><span class="v">{dash(statRow?.games_played)}</span></div>
            <div class="stat"><span class="k">Pass Yds</span><span class="v">{dash(statRow?.passing_yards)}</span></div>
            <div class="stat"><span class="k">Rush Yds</span><span class="v">{dash(statRow?.rushing_yards)}</span></div>
            <div class="stat"><span class="k">Rec Yds</span><span class="v">{dash(statRow?.receiving_yards)}</span></div>
            <div class="stat"><span class="k">Pass TD</span><span class="v">{dash(statRow?.passing_touchdowns)}</span></div>
            <div class="stat"><span class="k">Rush TD</span><span class="v">{dash(statRow?.rushing_touchdowns)}</span></div>
            <div class="stat"><span class="k">Rec TD</span><span class="v">{dash(statRow?.receiving_touchdowns)}</span></div>
          </div>
        )}

        <div class="mini">
          <div class="mini-row"><span class="k">Height</span><span class="v">{String(height)}</span></div>
          <div class="mini-row"><span class="k">Weight</span><span class="v">{String(weight)}</span></div>
          <div class="mini-row"><span class="k">Experience</span><span class="v">{String(experience)}</span></div>
        </div>
      </div>
    </div>

    <div class="panel" style="margin-top:.85rem;">
      <div class="panel-title">Gameplay recap</div>
      {profile?.recap?.paragraph ? (
        <>
          <p class="body">{profile.recap.paragraph}</p>
          {Array.isArray(profile?.recap?.bullets) && profile.recap.bullets.length > 0 && (
            <ul class="bullets">
              {profile.recap.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </>
      ) : (
        <div class="empty">Recap coming soon.</div>
      )}
    </div>

    <div class="panel" style="margin-top:.85rem;">
      <div class="panel-title">Injury report</div>
      {injuryMatches.length === 0 ? (
        <div class="empty">No injury entries found for this player.</div>
      ) : (
        <div class="inj-list">
          {injuryMatches.slice(0, 25).map((it) => (
            <div class="inj">
              <div class="inj-top">
                <div class="inj-status">{it.status ? String(it.status) : "Injury"}</div>
                <div class="inj-date">{it.date ? fmtUpdatedPT(it.date) + " PT" : ""}</div>
              </div>
              {it.description ? <div class="inj-desc">{String(it.description)}</div> : null}
            </div>
          ))}
        </div>
      )}
    </div>
  </article>

  <style>
    .meta-line,
    .card,
    .card-top,
    .grid,
    .panel,
    .stats,
    .mini,
    .inj-list {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .name,
    .sub,
    .body,
    .bullets,
    .inj-desc {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .dot { opacity: .5; }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .95rem 1rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card-top {
      padding-bottom: .75rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .85rem;

      display: flex;
      align-items: center;
      gap: .85rem;
    }

    .avatar-wrap {
      flex: 0 0 auto;
      width: 104px;
      height: 104px;
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(0,34,68,0.03);
      display: grid;
      place-items: center;
    }

    .avatar {
      width: 104px;
      height: 104px;
      object-fit: cover;
      display: block;
    }

    .top-text {
      min-width: 0;
      flex: 1 1 auto;
    }

    .name {
      font-size: 1.35rem;
      font-weight: 1000;
      color: var(--navy);
      line-height: 1.15;
    }

    .sub {
      margin-top: .35rem;
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      font-weight: 800;
      font-size: .95rem;
      align-items: center;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .85rem;
      align-items: start;
    }

    @media (max-width: 820px) {
      .grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .card-top { align-items: flex-start; }
      .avatar-wrap { width: 88px; height: 88px; }
      .avatar { width: 88px; height: 88px; }
    }

    .panel {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(0,34,68,0.03);
      padding: .75rem .85rem;
    }

    .panel-title {
      font-weight: 1000;
      color: rgba(0,34,68,.92);
      margin: 0 0 .45rem;
    }

    .body {
      margin: 0;
      line-height: 1.55;
      font-weight: 750;
      color: rgba(0,34,68,.92);
    }

    .empty {
      padding: .7rem .8rem;
      border-radius: 12px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 850;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .5rem .75rem;
      margin-top: .2rem;
    }

    .stat {
      display: flex;
      justify-content: space-between;
      gap: .5rem;
      padding: .4rem .5rem;
      border-radius: 12px;
      background: rgba(255,255,255,.7);
      border: 1px solid rgba(0,34,68,.10);
    }

    .k { font-weight: 900; color: rgba(0,34,68,.70); }
    .v { font-weight: 950; color: rgba(0,34,68,.92); font-variant-numeric: tabular-nums; }

    .mini {
      margin-top: .65rem;
      display: grid;
      gap: .35rem;
    }

    .mini-row {
      display: flex;
      justify-content: space-between;
      gap: .5rem;
      color: rgba(0,34,68,.85);
      font-weight: 850;
    }

    .bullets { margin: .6rem 0 0; padding-left: 1.1rem; }
    .bullets li { margin: .35rem 0; font-weight: 750; color: rgba(0,34,68,.92); }

    .inj-list { display: grid; gap: .55rem; margin-top: .35rem; }
    .inj {
      border-radius: 12px;
      border: 1px solid rgba(0,34,68,.12);
      background: rgba(255,255,255,.72);
      padding: .6rem .65rem;
    }
    .inj-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: .75rem;
    }
    .inj-status {
      font-weight: 1000;
      color: rgba(0,34,68,.92);
    }
    .inj-date {
      color: rgba(15,23,32,.60);
      font-weight: 800;
      font-size: .92rem;
      text-align: right;
    }
    .inj-desc {
      margin-top: .35rem;
      color: rgba(0,34,68,.88);
      font-weight: 750;
      line-height: 1.45;
    }
  </style>
</SeahawksLayout>

