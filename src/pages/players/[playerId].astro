---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import teamData from "../../data/nfl/seahawks.json";
import playersData from "../../data/nfl/players.json";
import playerProfiles from "../../data/nfl/playerProfiles.json";
import injuriesData from "../../data/nfl/injuries.json";

/* ========= helpers ========= */

function n(v) {
  return typeof v === "number" ? v : 0;
}
function dashIfNull(v) {
  return typeof v === "number" ? v : "-";
}
function totalYards(r) {
  return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
}
function playerName(p) {
  if (!p) return "Unknown";
  const full = `${p.first_name || ""} ${p.last_name || ""}`.trim();
  return full || p.full_name || "Unknown";
}
function fmtUpdatedPT(iso) {
  if (!iso) return "—";
  return new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso)) + " PT";
}

const roster = Array.isArray(playersData?.data)
  ? playersData.data
  : Array.isArray(playersData?.players)
    ? playersData.players
    : Array.isArray(playersData)
      ? playersData
      : [];

function rosterSorted() {
  return roster.slice().sort((a, b) => {
    const an = playerName(a).toLowerCase();
    const bn = playerName(b).toLowerCase();
    return an.localeCompare(bn);
  });
}

export function getStaticPaths() {
  const ids = roster
    .map((p) => String(p?.id))
    .filter((x) => x && x !== "undefined" && x !== "null");

  return ids.map((id) => ({ params: { playerId: id } }));
}

/* ========= page logic ========= */

const { playerId } = Astro.params;

const rosterOrdered = rosterSorted();
const idx = rosterOrdered.findIndex((p) => String(p?.id) === String(playerId));
const player = idx >= 0 ? rosterOrdered[idx] : null;

const prev = idx > 0 ? rosterOrdered[idx - 1] : null;
const next = idx >= 0 && idx < rosterOrdered.length - 1 ? rosterOrdered[idx + 1] : null;

const statRows = Array.isArray(teamData?.playerSeasonStats) ? teamData.playerSeasonStats : [];
const matching = statRows.filter((r) => String(r?.player?.id ?? r?.player_id ?? "") === String(playerId));
const bestStat = matching.reduce((best, r) => (!best || totalYards(r) > totalYards(best) ? r : best), null);

const prof = playerProfiles?.profiles?.[String(playerId)] || null;
const inj = injuriesData?.injuries?.[String(playerId)] || null;

const title = player ? `${playerName(player)} — Player` : "Player not found";
---

<SeahawksLayout title={title} description="Player page." activePath="/players">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/players">Players</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
  </div>

  {!player ? (
    <div class="empty">Couldn’t find that player.</div>
  ) : (
    <>
      <article class="card">
        <div class="card-top">
          <div class="name">{playerName(player)}</div>
          <div class="sub">
            <span class="pill">{(player?.position_abbreviation || player?.position || "-").toString().toUpperCase()}</span>
            {player?.jersey_number ? <span class="pill">#{player.jersey_number}</span> : null}
          </div>
        </div>

        <div class="grid">
          <div class="kv">
            <div class="k">Team</div>
            <div class="v">{player?.team?.abbreviation || "SEA"}</div>
          </div>
          <div class="kv">
            <div class="k">Height</div>
            <div class="v">{player?.height || player?.height_inches || "-"}</div>
          </div>
          <div class="kv">
            <div class="k">Weight</div>
            <div class="v">{player?.weight || player?.weight_pounds || "-"}</div>
          </div>
          <div class="kv">
            <div class="k">Updated</div>
            <div class="v">{fmtUpdatedPT(playerProfiles?.updatedAt || injuriesData?.updatedAt || teamData?.updatedAt || "")}</div>
          </div>
        </div>

        <div class="links-row">
          {prev ? (
            <a class="pill pill--ghost" href={`/players/${encodeURIComponent(String(prev.id))}`}>← Prev</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">← Prev</span>
          )}

          {next ? (
            <a class="pill pill--ghost" href={`/players/${encodeURIComponent(String(next.id))}`}>Next →</a>
          ) : (
            <span class="pill pill--ghost pill--disabled">Next →</span>
          )}
        </div>
      </article>

      <section class="section">
        <h3 class="section-title">Bio</h3>
        {!prof?.bio ? (
          <div class="empty">Bio coming soon.</div>
        ) : (
          <p class="text">{prof.bio}</p>
        )}
      </section>

      <section class="section">
        <h3 class="section-title">Season snapshot</h3>
        {!bestStat ? (
          <div class="empty">No season stats found yet.</div>
        ) : (
          <div class="stats-grid">
            <div class="stat"><div class="k">GP</div><div class="v">{dashIfNull(bestStat.games_played)}</div></div>
            <div class="stat"><div class="k">Pass Yds</div><div class="v">{dashIfNull(bestStat.passing_yards)}</div></div>
            <div class="stat"><div class="k">Rush Yds</div><div class="v">{dashIfNull(bestStat.rushing_yards)}</div></div>
            <div class="stat"><div class="k">Rec Yds</div><div class="v">{dashIfNull(bestStat.receiving_yards)}</div></div>
          </div>
        )}
      </section>

      <section class="section">
        <h3 class="section-title">Gameplay recap</h3>
        {!prof?.recap?.paragraph ? (
          <div class="empty">Recap coming soon.</div>
        ) : (
          <>
            <p class="text">{prof.recap.paragraph}</p>
            {Array.isArray(prof?.recap?.bullets) && prof.recap.bullets.length > 0 ? (
              <ul class="bullets">
                {prof.recap.bullets.map((b) => <li>{b}</li>)}
              </ul>
            ) : null}
          </>
        )}
      </section>

      <section class="section">
        <h3 class="section-title">Injury report</h3>
        {!inj ? (
          <div class="empty">No injury listed.</div>
        ) : (
          <div class="injury">
            <div class="inj-row">
              <span class="pill">{inj?.status || "Injury"}</span>
              <span class="muted">{inj?.updatedAt ? fmtUpdatedPT(inj.updatedAt) : null}</span>
            </div>
            {inj?.description ? <p class="text" style="margin-top:.5rem;">{inj.description}</p> : null}
            {inj?.practice_status ? <p class="muted" style="margin-top:.35rem;"><strong>Practice:</strong> {inj.practice_status}</p> : null}
            {inj?.game_status ? <p class="muted" style="margin-top:.2rem;"><strong>Game:</strong> {inj.game_status}</p> : null}
          </div>
        )}
      </section>
    </>
  )}

  <style>
    .meta-line,
    .card,
    .card-top,
    .grid,
    .links-row,
    .section,
    .text,
    .bullets,
    .stats-grid,
    .injury {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .text,
    .bullets,
    .empty,
    .name,
    .muted {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }
    .dot { opacity: .5; }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: .75rem;
      padding-bottom: .65rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .65rem;
      flex-wrap: wrap;
    }

    .name { font-weight: 950; color: var(--navy); font-size: 1.15rem; }
    .sub { display: inline-flex; gap: .4rem; flex-wrap: wrap; align-items: center; }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .65rem;
    }
    @media (max-width: 820px) {
      .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .kv {
      border: 1px solid rgba(0,34,68,.12);
      border-radius: 12px;
      padding: .6rem .65rem;
      background: rgba(0,34,68,.03);
      min-width: 0;
    }
    .k { font-weight: 900; color: rgba(0,34,68,.70); font-size: .82rem; }
    .v { font-weight: 900; color: rgba(0,34,68,.92); margin-top: .15rem; }

    .links-row{
      display:flex;
      gap:.5rem;
      margin-top:.75rem;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      text-decoration: none;
      user-select: none;
      white-space: nowrap;
    }
    .pill:hover{ background: rgba(0,34,68,.07); }
    .pill--ghost{ background: transparent; }
    .pill--disabled{ opacity: .5; pointer-events: none; }

    .section { margin-top: 1.1rem; }
    .section-title { margin: 0 0 .5rem; color: var(--navy); }
    .text { line-height: 1.6; font-weight: 750; color: rgba(0,34,68,.92); }
    .muted { color: rgba(15,23,32,.65); font-weight: 800; }

    .stats-grid{
      display:grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .65rem;
    }
    @media (max-width: 820px) {
      .stats-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .stat{
      border: 1px solid rgba(0,34,68,.12);
      border-radius: 12px;
      padding: .6rem .65rem;
      background: #fff;
      min-width: 0;
    }

    .bullets { margin: .6rem 0 0; padding-left: 1.1rem; }
    .bullets li { margin: .35rem 0; }

    .injury{
      border: 1px solid rgba(0,34,68,.14);
      border-radius: 14px;
      padding: .8rem .9rem;
      background: #fff;
      box-shadow: 0 10px 22px rgba(0,0,0,.06);
    }
    .inj-row{
      display:flex;
      justify-content: space-between;
      gap:.75rem;
      flex-wrap: wrap;
      align-items: center;
    }
  </style>
</SeahawksLayout>
