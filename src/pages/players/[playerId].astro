---
import SeahawksLayout from "../../layouts/SeahawksLayout.astro";
import playersData from "../../data/nfl/players.json";
import playerRecaps from "../../data/nfl/playerRecaps.json";
import injuryReport from "../../data/nfl/injuryReport.json";

function normalizePlayers(data) {
  if (Array.isArray(data)) return data;
  if (Array.isArray(data?.players)) return data.players;
  if (Array.isArray(data?.data)) return data.data;
  return [];
}

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function isActiveSeahawksPlayer(p) {
  const abbr = teamAbbr(p?.team, p?.team_abbreviation || p?.teamAbbr || "");
  if (abbr !== "SEA") return false;

  const status = String(p?.status || p?.player_status || p?.roster_status || "").toLowerCase();
  if (status.includes("retired")) return false;
  if (status.includes("free agent")) return false;
  if (status.includes("practice squad")) return false;

  if (p?.active === false) return false;
  return true;
}

function playerId(p, idx) {
  return String(p?.id ?? p?.player_id ?? p?.playerId ?? idx);
}

function playerName(p) {
  return (
    p?.full_name ||
    p?.name ||
    [p?.first_name, p?.last_name].filter(Boolean).join(" ") ||
    "Unknown Player"
  );
}

function posText(p) {
  return String(p?.position || p?.pos || "").toUpperCase();
}

function jerseyText(p) {
  const j = p?.jersey_number ?? p?.jerseyNumber ?? p?.number;
  return j === null || j === undefined || j === "" ? "" : `#${j}`;
}

function heightText(p) {
  const ht = p?.height ?? p?.height_in ?? p?.heightIn ?? null;
  if (ht === null || ht === undefined || ht === "") return "";
  // if inches number, format as feet/inches
  const n = Number(ht);
  if (Number.isFinite(n) && n > 20) {
    const ft = Math.floor(n / 12);
    const inch = n % 12;
    return `${ft}'${inch}"`;
  }
  return String(ht);
}

function weightText(p) {
  const wt = p?.weight ?? p?.weight_lbs ?? p?.weightLbs ?? null;
  if (wt === null || wt === undefined || wt === "") return "";
  return `${wt} lb`;
}

function collegeText(p) {
  return String(p?.college || p?.college_name || "").trim();
}

function expText(p) {
  const exp = p?.experience ?? p?.exp ?? p?.years_exp ?? null;
  if (exp === null || exp === undefined || exp === "") return "";
  return `${exp} yrs`;
}

function sortByName(a, b) {
  return playerName(a).localeCompare(playerName(b));
}

/* =======================
   getStaticPaths
   ======================= */
export function getStaticPaths() {
  const allPlayers = normalizePlayers(playersData);
  const active = allPlayers.filter(isActiveSeahawksPlayer).sort(sortByName);

  return active.map((p, idx) => ({
    params: { playerId: playerId(p, idx) },
  }));
}

/* =======================
   Page logic
   ======================= */
const { playerId: pid } = Astro.params;

const allPlayers = normalizePlayers(playersData);
const player =
  allPlayers.find((p, idx) => playerId(p, idx) === String(pid)) || null;

const name = player ? playerName(player) : "Player not found";
const pos = player ? posText(player) : "";
const jersey = player ? jerseyText(player) : "";

const bioBits = [];
if (pos) bioBits.push(pos);
if (jersey) bioBits.push(jersey);
const ht = player ? heightText(player) : "";
const wt = player ? weightText(player) : "";
if (ht) bioBits.push(ht);
if (wt) bioBits.push(wt);

const college = player ? collegeText(player) : "";
const exp = player ? expText(player) : "";

const recap = playerRecaps?.recaps?.[String(pid)] || null;
const injury = injuryReport?.byPlayerId?.[String(pid)] || null;

function safeText(x, fallback = "—") {
  const s = String(x ?? "").trim();
  return s ? s : fallback;
}
---

<SeahawksLayout title={`${name} — Seahawks Player`} description="Player page" activePath="">
  <div class="meta-line">
    <span><strong>Back:</strong> <a href="/players">Players</a></span>
    <span class="dot">•</span>
    <span><strong>Also:</strong> <a href="/schedule">Schedule</a></span>
  </div>

  {!player ? (
    <div class="empty">Couldn’t find that player.</div>
  ) : (
    <>
      <article class="card">
        <div class="card-top">
          <div class="player-title">
            <div class="player-name">{name}</div>
            <div class="player-sub">{bioBits.join(" · ")}</div>
          </div>

          <div class="player-mini">
            {college && <div><span class="label">College</span> {college}</div>}
            {exp && <div><span class="label">Experience</span> {exp}</div>}
          </div>
        </div>
      </article>

      <section class="section">
        <h3 class="section-title">Injury report</h3>

        {!injury ? (
          <div class="empty">No injury info available.</div>
        ) : (
          <article class="info-card">
            <div class="info-row">
              <span class="label">Status</span>
              <span class="value">{safeText(injury?.status)}</span>
            </div>
            {injury?.detail && (
              <div class="info-row">
                <span class="label">Detail</span>
                <span class="value">{safeText(injury?.detail)}</span>
              </div>
            )}
            {injury?.updatedAt && (
              <div class="info-row">
                <span class="label">Updated</span>
                <span class="value">
                  {new Date(injury.updatedAt).toLocaleString("en-US", { timeZone: "America/Los_Angeles" })} PT
                </span>
              </div>
            )}
          </article>
        )}
      </section>

      <section class="section">
        <h3 class="section-title">Gameplay recap</h3>

        {!recap ? (
          <div class="empty">Recap coming soon.</div>
        ) : (
          <article class="info-card">
            <p class="recap-text">{safeText(recap?.recap, "")}</p>

            {Array.isArray(recap?.bullets) && recap.bullets.length > 0 && (
              <ul class="recap-bullets">
                {recap.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </article>
        )}
      </section>
    </>
  )}

  <style>
    .meta-line,
    .card,
    .card-top,
    .player-title,
    .player-mini,
    .section,
    .section-title,
    .info-card,
    .info-row,
    .label,
    .value,
    .recap-text,
    .recap-bullets {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }
    .dot { opacity: .5; }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card-top{
      display:flex;
      justify-content: space-between;
      gap: .9rem;
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .player-name{
      font-weight: 900;
      color: var(--navy);
      font-size: 1.35rem;
      line-height: 1.15;
    }

    .player-sub{
      margin-top: .25rem;
      font-weight: 800;
      color: rgba(15,23,32,.65);
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }

    .player-mini{
      text-align: right;
      font-weight: 800;
      color: rgba(0,34,68,.80);
      display:flex;
      flex-direction: column;
      gap: .25rem;
    }

    @media (max-width: 820px){
      .player-mini{ text-align: left; }
    }

    .label{
      font-weight: 900;
      color: rgba(0,34,68,.60);
      margin-right: .35rem;
    }

    .section{ margin-top: 1.1rem; }
    .section-title{
      color: var(--navy);
      margin: 0 0 .6rem;
    }

    .info-card{
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.12);
      background: rgba(165,172,175,0.10);
      padding: .9rem 1rem;
      overflow: hidden;
    }

    .info-row{
      display:flex;
      justify-content: space-between;
      gap: .75rem;
      padding: .35rem 0;
      border-top: 1px solid rgba(0,34,68,0.08);
    }
    .info-row:first-child{ border-top: none; padding-top: 0; }

    .value{
      font-weight: 900;
      color: rgba(0,34,68,.90);
      text-align: right;
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }
    @media (max-width: 820px){
      .value{ text-align: left; }
    }

    .recap-text{
      margin: 0;
      line-height: 1.6;
      font-weight: 700;
      color: rgba(0,34,68,.92);
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }

    .recap-bullets{
      margin: .75rem 0 0;
      padding-left: 1.1rem;
    }
    .recap-bullets li{
      margin: .35rem 0;
      line-height: 1.45;
    }
  </style>
</SeahawksLayout>
