---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import SeasonContextView from "../components/SeasonContext.astro";
import NfcWestTable from "../components/NfcWestTable.astro";
import { getAvailableSeasonContexts, getSeasonContext, unavailableMessage } from "../lib/season-context";
import scheduleData from "../data/nfl/seahawks.json";

let standingsData: any = null;
try { standingsData = (await import("../data/nfl/standings.json")).default; } catch {}

const WEST = new Set(["SEA", "LAR", "SF", "ARI"]);
const NAMES: Record<string, string> = { SEA: "Seattle Seahawks", LAR: "Los Angeles Rams", SF: "San Francisco 49ers", ARI: "Arizona Cardinals" };
const contextData = standingsData || scheduleData;
const seasonContext = getSeasonContext(contextData, "regular season");
const seasonOptions = getAvailableSeasonContexts(contextData, "regular season");
const season = seasonContext.seasonYear ?? standingsData?.season ?? scheduleData?.season ?? "Current";

function first(row: any, keys: string[]) { for (const key of keys) if (row?.[key] !== undefined && row?.[key] !== null && row?.[key] !== "") return row[key]; return null; }
function team(row: any) { return row?.team ?? row?.team_info ?? row?.teamInfo ?? row; }
function abbr(value: any) {
  const raw = first(team(value), ["abbreviation", "abbr", "team_abbreviation", "teamAbbreviation"]) ?? first(value, ["team_abbreviation", "teamAbbreviation", "abbreviation", "abbr"]);
  const result = String(raw ?? "").toUpperCase().replaceAll(".", "");
  if (result === "LA" || result === "LA RAMS") return "LAR";
  if (result === "SFO") return "SF";
  return result;
}
function rowsFrom(value: any): any[] { if (Array.isArray(value)) return value; for (const key of ["data", "teams", "standings", "rows"]) if (Array.isArray(value?.[key])) return value[key]; return []; }
function divisionRows(value: any) {
  const direct = rowsFrom(value).filter((row) => WEST.has(abbr(row)));
  if (direct.length) return direct;
  const divisions = value?.divisions;
  if (Array.isArray(divisions)) return rowsFrom(divisions.find((item: any) => /nfc\s*west/i.test(String(item?.name ?? item?.division ?? "")))).filter((row) => WEST.has(abbr(row)));
  const entry = divisions && typeof divisions === "object" ? Object.entries(divisions).find(([key]) => /nfc[_\s-]*west/i.test(key)) : null;
  return rowsFrom(entry?.[1]).filter((row) => WEST.has(abbr(row)));
}
function priorPayload(value: any) {
  for (const key of ["previousSeason", "previous_season", "priorSeason", "prior_season", "previous", "prior"]) if (divisionRows(value?.[key]).length) return value[key];
  const candidates = Array.isArray(value?.seasons) ? value.seasons.filter((item: any) => Number(item?.season ?? item?.year) < Number(season)) : [];
  return candidates.sort((a: any, b: any) => Number(b?.season ?? b?.year) - Number(a?.season ?? a?.year))[0] ?? null;
}
function shown(row: any, keys: string[]) { const value = first(row, keys); return value === null ? "—" : String(value); }
function num(row: any, keys: string[]) { const value = first(row, keys); const parsed = Number(value); return value === null || !Number.isFinite(parsed) ? null : parsed; }
function splitRecord(row: any, prefix: "division" | "conference") {
  const supplied = first(row, [`${prefix}_record`, `${prefix}Record`, prefix === "division" ? "div_record" : "conf_record"]);
  if (supplied !== null) return String(supplied);
  const wins = first(row, [`${prefix}_wins`, `${prefix}Wins`]), losses = first(row, [`${prefix}_losses`, `${prefix}Losses`]), ties = first(row, [`${prefix}_ties`, `${prefix}Ties`]);
  return wins === null || losses === null ? "—" : ties !== null && Number(ties) !== 0 ? `${wins}-${losses}-${ties}` : `${wins}-${losses}`;
}
function marker(row: any) {
  const label = first(row, ["playoff_status", "playoffStatus", "clinched_status", "clinchedStatus", "elimination_status", "eliminationStatus"]);
  if (label !== null) return String(label);
  if (first(row, ["clinched", "clinched_playoffs", "clinchedPlayoffs"]) === true) return "Clinched playoff berth";
  if (first(row, ["eliminated", "eliminated_from_playoffs", "eliminatedFromPlayoffs"]) === true) return "Eliminated";
  return null;
}
function standingsRows(value: any) {
  return divisionRows(value).map((row, index) => {
    const suppliedDiff = num(row, ["point_differential", "pointDifferential", "points_differential", "differential"]);
    const pf = num(row, ["points_for", "pointsFor", "pf"]), pa = num(row, ["points_against", "pointsAgainst", "pa"]);
    const diff = suppliedDiff ?? (pf !== null && pa !== null ? pf - pa : null);
    const pctValue = num(row, ["win_percentage", "winPercentage", "win_pct", "winPct", "percentage", "pct"]);
    const pct = pctValue === null ? "—" : (pctValue > 1 ? pctValue / 100 : pctValue).toFixed(3).replace(/^0/, "");
    const code = abbr(row);
    return { rank: shown(row, ["division_rank", "divisionRank", "rank", "position"]) === "—" ? String(index + 1) : shown(row, ["division_rank", "divisionRank", "rank", "position"]), abbreviation: code, name: first(team(row), ["full_name", "fullName", "name", "display_name", "displayName"]) ?? first(row, ["team_name", "teamName"]) ?? NAMES[code] ?? code, wins: shown(row, ["wins", "win", "w"]), losses: shown(row, ["losses", "loss", "l"]), ties: shown(row, ["ties", "tie", "t"]), percentage: pct, pointsFor: shown(row, ["points_for", "pointsFor", "pf"]), pointsAgainst: shown(row, ["points_against", "pointsAgainst", "pa"]), differential: diff === null ? "—" : diff > 0 ? `+${diff}` : String(diff), division: splitRecord(row, "division"), conference: splitRecord(row, "conference"), streak: shown(row, ["streak", "current_streak", "currentStreak"]), marker: marker(row) };
  });
}
function ordinal(value: any) { const n = Number(value); if (!Number.isFinite(n)) return String(value ?? "—"); const suffix = n % 100 >= 11 && n % 100 <= 13 ? "th" : n % 10 === 1 ? "st" : n % 10 === 2 ? "nd" : n % 10 === 3 ? "rd" : "th"; return `${n}${suffix}`; }
function playoff(game: any) { const type = String(game?.seasonType ?? game?.season_type ?? "").toLowerCase(); return type.includes("post") || type.includes("playoff") || game?.postseason === true || game?.is_postseason === true; }
function final(game: any) { return /final|finished|complete/i.test(String(game?.status ?? "")); }
function opponent(game: any) { const home = abbr(game?.home_team), away = abbr(game?.visitor_team); return home === "SEA" ? away : home; }
function home(game: any) { return abbr(game?.home_team) === "SEA"; }
function gameHref(game: any, index: number) { return `/games/${encodeURIComponent(String(game?.id ?? game?.game_id ?? index))}`; }
function formatDate(value: any) { const date = new Date(String(value ?? "")); return Number.isFinite(date.getTime()) ? `${date.toLocaleString("en-US", { timeZone: "America/Los_Angeles", weekday: "short", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })} PT` : "Date TBD"; }
function result(game: any) { const hs = num(game, ["home_team_score", "homeTeamScore"]), as = num(game, ["visitor_team_score", "away_team_score", "visitorTeamScore"]); if (hs === null || as === null) return "Final score unavailable"; const sea = home(game) ? hs : as, opp = home(game) ? as : hs; return `${sea === opp ? "T" : sea > opp ? "W" : "L"} ${sea}–${opp}`; }

const currentRows = standingsRows(standingsData);
const priorData = priorPayload(standingsData);
const previousRows = standingsRows(priorData);
const previousSeason = priorData?.season ?? priorData?.year ?? (Number(season) ? Number(season) - 1 : "Previous");
const seattle = currentRows.find((row) => row.abbreviation === "SEA");
const rawGames = Array.isArray(scheduleData?.games) ? scheduleData.games : [...(scheduleData?.gamesRegular ?? []), ...(scheduleData?.gamesPostseason ?? [])];
const divisionalGames = rawGames.filter((game: any) => !playoff(game) && WEST.has(opponent(game)) && opponent(game) !== "SEA").sort((a: any, b: any) => new Date(a?.date ?? 0).getTime() - new Date(b?.date ?? 0).getTime());
const upcoming = divisionalGames.filter((game: any) => !final(game));
const completed = divisionalGames.filter(final);
const hasStarted = seasonContext.seasonStatus !== "upcoming" || currentRows.some((row) => Number(row.wins) + Number(row.losses) > 0);
const hasMarkers = [...currentRows, ...previousRows].some((row) => row.marker);
---

<SeahawksLayout title={`NFC West Standings (${season})`} description="Seattle's position in the NFC West, divisional schedule, and season-series results." activePath="/standings">
  <SeasonContextView context={seasonContext} options={seasonOptions} prefix="Data through" />
  <header class="race-header">
    <p class="eyebrow">Seattle Seahawks division tracker</p><h1>NFC West Race</h1>
    {seattle ? <div class="sea-summary" aria-label="Seattle Seahawks NFC West summary">
      <div><span>Division rank</span><strong>{ordinal(seattle.rank)}</strong></div><div><span>Record</span><strong>{seattle.ties !== "—" && seattle.ties !== "0" ? `${seattle.wins}-${seattle.losses}-${seattle.ties}` : `${seattle.wins}-${seattle.losses}`}</strong></div><div><span>Division</span><strong>{seattle.division}</strong></div><div><span>Streak</span><strong>{seattle.streak}</strong></div>
      {(seattle.marker || first(divisionRows(standingsData).find((row) => abbr(row) === "SEA"), ["games_behind", "gamesBehind", "gb"]) !== null) && <div><span>{seattle.marker ? "Playoff status" : "Games behind"}</span><strong>{seattle.marker ?? first(divisionRows(standingsData).find((row) => abbr(row) === "SEA"), ["games_behind", "gamesBehind", "gb"])}</strong></div>}
    </div> : <p class="race-empty">Seattle’s division position is not available in the current standings source.</p>}
  </header>

  {!hasStarted && <aside class="season-notice"><strong>The {season} regular season has not started.</strong>{previousRows.length ? ` The prior season’s final standings are under the ${previousSeason} Final tab.` : " Current standings will appear once games have been played."}</aside>}

  <section class="standings-section" aria-labelledby="standings-title">
    <div class="section-heading"><div><p class="eyebrow">Division order</p><h2 id="standings-title">NFC West standings</h2></div>{previousRows.length > 0 && <div class="tabs" role="tablist" aria-label="Standings season"><button id="current-tab" role="tab" aria-selected="true" aria-controls="current-panel">{season} Standings</button><button id="previous-tab" role="tab" aria-selected="false" aria-controls="previous-panel" tabindex="-1">{previousSeason} Final</button></div>}</div>
    <div id="current-panel" role={previousRows.length ? "tabpanel" : undefined} aria-labelledby={previousRows.length ? "current-tab" : undefined}>{currentRows.length ? <NfcWestTable rows={currentRows} label={`${season} NFC West standings`} /> : <div class="empty">{unavailableMessage(seasonContext)}</div>}</div>
    {previousRows.length > 0 && <div id="previous-panel" role="tabpanel" aria-labelledby="previous-tab" hidden><p class="archive-label"><strong>{previousSeason} final standings.</strong> Archived results, not active standings.</p><NfcWestTable rows={previousRows} label={`${previousSeason} final NFC West standings`} /></div>}
    {hasMarkers && <p class="marker-note"><strong>Markers:</strong> Clinching and elimination labels come directly from the standings source. Clinched means the team secured the status shown; eliminated means it can no longer qualify for that status.</p>}
  </section>

  <div class="division-grid">
    <section class="module" aria-labelledby="ahead-title"><p class="eyebrow">What matters next</p><h2 id="ahead-title">Divisional Games Ahead</h2>
      {upcoming.length ? <ol class="game-list">{upcoming.map((game) => <li><div><span>{Number.isFinite(Number(game?.week)) ? `Week ${game.week}` : "Regular season"}</span><strong>{home(game) ? "vs." : "at"} {NAMES[opponent(game)] ?? opponent(game)}</strong><small>{formatDate(game?.date)}</small></div><a href={gameHref(game, rawGames.indexOf(game))}>Game page →</a></li>)}</ol> : <p class="empty">No upcoming NFC West games are present in the schedule.</p>}
    </section>
    <section class="module" aria-labelledby="series-title"><p class="eyebrow">Results so far</p><h2 id="series-title">Season Series</h2>
      {completed.length ? <ul class="series-list">{["LAR", "SF", "ARI"].map((code) => { const games = completed.filter((game) => opponent(game) === code); return games.length ? <li><strong>{NAMES[code]}</strong><span>{games.map(result).join(" · ")}</span></li> : null; })}</ul> : <p class="empty">No NFC West games have been completed this season.</p>}
    </section>
  </div>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const selectTab = (index: number) => tabs.forEach((item, itemIndex) => { const selected = itemIndex === index; item.setAttribute("aria-selected", String(selected)); item.tabIndex = selected ? 0 : -1; const panel = document.getElementById(item.getAttribute("aria-controls") ?? ""); if (panel) panel.hidden = !selected; });
    tabs.forEach((tab, index) => { tab.addEventListener("click", () => selectTab(index)); tab.addEventListener("keydown", (event) => { if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return; event.preventDefault(); const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length; tabs[next].focus(); selectTab(next); }); });
  </script>
  <style>
    .eyebrow{margin:0 0:.25rem;color:var(--slate-700);font:900 .72rem var(--font-display);letter-spacing:.1em;text-transform:uppercase}.race-header{padding:clamp(1.1rem,4vw,2rem);border-top:7px solid var(--action-green);background:var(--navy-950);color:#fff;box-shadow:var(--shadow-lg)}.race-header .eyebrow{color:var(--action-green)}.race-header h1{margin:0;font:900 clamp(2rem,7vw,4rem)/1 var(--font-display)}.sea-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1px;margin-top:1.25rem;background:#ffffff24;border:1px solid #ffffff24}.sea-summary div{padding:.8rem;background:var(--navy-900)}.sea-summary span{display:block;color:var(--slate-300);font-size:.68rem;font-weight:800;text-transform:uppercase}.sea-summary strong{display:block;margin-top:.15rem;font:900 clamp(1.1rem,3vw,1.55rem) var(--font-display)}.race-empty{margin:1rem 0 0;color:var(--slate-300)}.season-notice,.archive-label,.marker-note,.empty{padding:.8rem 1rem;border:var(--border-crisp);background:var(--slate-100);color:var(--navy-900)}.season-notice{margin-top:1rem;border-left:5px solid var(--action-green)}.standings-section,.division-grid{margin-top:1.25rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.7rem}.section-heading h2,.module h2{margin:0;color:var(--navy-900);font:900 1.55rem var(--font-display)}.tabs{display:flex;gap:.35rem}.tabs button{padding:.55rem .7rem;border:var(--border-crisp);background:#fff;color:var(--navy-900);font-weight:800;cursor:pointer}.tabs button[aria-selected="true"]{border-color:var(--navy-900);background:var(--navy-900);color:#fff;box-shadow:inset 0 -3px var(--action-green)}.archive-label,.marker-note{margin:.65rem 0;font-size:.85rem}.division-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:1rem}.module{min-width:0;padding:1rem;border:var(--border-crisp);background:#fff;box-shadow:var(--shadow-sm)}.game-list,.series-list{margin:.8rem 0 0;padding:0;list-style:none}.game-list li{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 0;border-top:var(--border-crisp)}.game-list li div{display:grid;gap:.1rem}.game-list span,.game-list small{color:var(--slate-700);font-size:.72rem}.game-list a{flex:0 0 auto;color:var(--navy-900);font-weight:900}.series-list li{display:grid;grid-template-columns:minmax(9rem,1fr) 1fr;gap:.75rem;padding:.7rem 0;border-top:var(--border-crisp)}.series-list span{color:var(--slate-700)}@media(max-width:760px){.sea-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.section-heading{align-items:stretch;flex-direction:column}.division-grid{grid-template-columns:1fr}}@media(max-width:420px){.race-header{margin-inline:-.6rem}.game-list li{align-items:flex-start;flex-direction:column}.series-list li{grid-template-columns:1fr}.tabs{width:100%}.tabs button{flex:1}}
  </style>
</SeahawksLayout>
