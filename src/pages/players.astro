---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import teamData from "../data/nfl/seahawks.json";
import playersData from "../data/nfl/players.json";

const pageTitle = `Players (${teamData.season})`;

const fmtUpdatedPT = (iso) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));

function n(v) {
  return typeof v === "number" ? v : 0;
}
function dashIfNull(v) {
  return typeof v === "number" ? v : "-";
}
function tdTriplet(r) {
  return `${n(r.passing_touchdowns)}/${n(r.rushing_touchdowns)}/${n(r.receiving_touchdowns)}`;
}
function totalYards(r) {
  return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
}

function playerNameFromPlayerObj(p) {
  if (!p) return "Unknown";
  const first = p.first_name || "";
  const last = p.last_name || "";
  const full = `${first} ${last}`.trim();
  return full || p.full_name || "Unknown";
}

// players.json shape can vary: {data: [...]}, {players: [...]}, or [...]
const roster = Array.isArray(playersData?.data)
  ? playersData.data
  : Array.isArray(playersData?.players)
    ? playersData.players
    : Array.isArray(playersData)
      ? playersData
      : [];

// Treat roster file as “active Seahawks players”
const activeIds = new Set(
  roster.map((p) => String(p?.id)).filter((x) => x && x !== "undefined" && x !== "null")
);

const statRows = Array.isArray(teamData?.playerSeasonStats) ? teamData.playerSeasonStats : [];

// Best stat line per player id (most total yards)
const bestStatById = new Map();
for (const r of statRows) {
  const pid = r?.player?.id ?? r?.player_id ?? null;
  if (!pid) continue;
  const key = String(pid);
  if (activeIds.size > 0 && !activeIds.has(key)) continue;

  const existing = bestStatById.get(key);
  if (!existing || totalYards(r) > totalYards(existing)) bestStatById.set(key, r);
}

// Build rows from roster (so active players with no stats still show up)
const rows = roster.map((p) => {
  const id = String(p?.id ?? "");
  const stat = bestStatById.get(id) || {};
  const mergedPlayer = stat?.player || p || {};
  return {
    id,
    player: mergedPlayer,
    // prefer stats if present
    games_played: stat?.games_played,
    passing_yards: stat?.passing_yards,
    rushing_yards: stat?.rushing_yards,
    receiving_yards: stat?.receiving_yards,
    passing_touchdowns: stat?.passing_touchdowns,
    rushing_touchdowns: stat?.rushing_touchdowns,
    receiving_touchdowns: stat?.receiving_touchdowns,
    _sortYards: totalYards(stat),
  };
});

// Positions for dropdown
const positions = Array.from(
  new Set(
    rows
      .map((r) => (r?.player?.position_abbreviation || "").toUpperCase())
      .filter(Boolean)
  )
).sort();

// Sort: most production first, then name
rows.sort((a, b) => {
  const yd = (b?._sortYards || 0) - (a?._sortYards || 0);
  if (yd !== 0) return yd;
  const an = playerNameFromPlayerObj(a?.player).toLowerCase();
  const bn = playerNameFromPlayerObj(b?.player).toLowerCase();
  return an.localeCompare(bn);
});

const updatedAt = teamData?.updatedAt || playersData?.updatedAt || "";
const fmtUpdatedLine = updatedAt ? `${fmtUpdatedPT(updatedAt)} PT` : "—";

function playerHref(id) {
  const sid = String(id || "");
  // Only link if the player page will exist (i.e., in active roster)
  return activeIds.has(sid) ? `/players/${encodeURIComponent(sid)}` : null;
}
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Active roster + sortable season stats" activePath="/players">
  <div class="sfz-topbar">
    <div class="sfz-meta">
      <div class="sfz-sub">
        Season: {teamData.season} &nbsp; • &nbsp; Updated: {fmtUpdatedLine}
      </div>
    </div>

    <div class="sfz-controls">
      <label class="sfz-label" for="pos">Position</label>

      <select id="pos" class="sfz-select">
        <option value="ALL">All</option>
        {positions.map((p) => (
          <option value={p}>{p}</option>
        ))}
      </select>

      <div class="sfz-count"><span id="playerCount">{rows.length}</span> players</div>
    </div>
  </div>

  <div class="sfz-table-wrap" role="region" aria-label="Players table">
    <table class="sfz-table">
      <thead>
        <tr>
          <th class="sticky">Player</th>
          <th class="sticky">Pos</th>
          <th class="sticky num">GP</th>
          <th class="sticky num">Pass Yds</th>
          <th class="sticky num">Rush Yds</th>
          <th class="sticky num">Rec Yds</th>
          <th class="sticky num">TD P/R/Rec</th>
        </tr>
      </thead>

      <tbody id="playersBody">
        {rows.map((r) => {
          const pos = (r?.player?.position_abbreviation || "").toUpperCase();
          const name = playerNameFromPlayerObj(r?.player);
          const href = playerHref(r?.id);

          return (
            <tr data-pos={pos}>
              <td class="name">
                {href ? <a class="name-link" href={href}>{name}</a> : <span>{name}</span>}
              </td>
              <td class="pos">{r?.player?.position_abbreviation || "-"}</td>
              <td class="num">{dashIfNull(r.games_played)}</td>
              <td class="num">{dashIfNull(r.passing_yards)}</td>
              <td class="num">{dashIfNull(r.rushing_yards)}</td>
              <td class="num">{dashIfNull(r.receiving_yards)}</td>
              <td class="num">{tdTriplet(r)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <script is:inline>
    (() => {
      const select = document.getElementById("pos");
      const body = document.getElementById("playersBody");
      const countEl = document.getElementById("playerCount");

      function getPosFromUrl() {
        const params = new URLSearchParams(window.location.search);
        return (params.get("pos") || "ALL").toUpperCase();
      }

      function setUrlPos(pos) {
        const url = new URL(window.location.href);
        if (!pos || pos === "ALL") url.searchParams.delete("pos");
        else url.searchParams.set("pos", pos);
        window.history.replaceState({}, "", url);
      }

      function applyFilter(pos) {
        const rows = body.querySelectorAll("tr[data-pos]");
        let shown = 0;

        rows.forEach((tr) => {
          const rpos = (tr.getAttribute("data-pos") || "").toUpperCase();
          const visible = (pos === "ALL") || (rpos === pos);
          tr.style.display = visible ? "" : "none";
          if (visible) shown++;
        });

        countEl.textContent = String(shown);
      }

      const initialPos = getPosFromUrl();
      select.value = initialPos;
      applyFilter(initialPos);

      select.addEventListener("change", () => {
        const pos = (select.value || "ALL").toUpperCase();
        setUrlPos(pos);
        applyFilter(pos);
      });
    })();
  </script>

  <style>
    .sfz-topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.85rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.12);
    }

    .sfz-sub {
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .sfz-controls {
      display: inline-flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .sfz-label {
      font-weight: 900;
      color: rgba(0, 34, 68, 0.72);
      font-size: 0.9rem;
    }

    .sfz-select {
      border-radius: 10px;
      padding: 0.5rem 0.65rem;
      border: 1px solid rgba(0, 34, 68, 0.18);
      font-weight: 900;
      background: #fff;
      color: rgba(0, 34, 68, 0.9);
      min-width: 160px;
    }

    .sfz-count {
      color: rgba(0, 34, 68, 0.85);
      font-weight: 900;
      font-size: 0.95rem;
    }

    .sfz-table-wrap {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      overflow: auto;
      max-height: 70vh;
    }

    .sfz-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
      font-size: 0.95rem;
    }

    .sfz-table th,
    .sfz-table td {
      padding: 0.65rem 0.7rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.10);
      white-space: nowrap;
    }

    .sfz-table thead th {
      background: rgba(0, 34, 68, 0.04);
      color: rgba(0, 34, 68, 0.88);
      font-weight: 900;
      letter-spacing: 0.2px;
    }

    .sticky {
      position: sticky;
      top: 0;
      z-index: 2;
    }

    .sfz-table tbody tr:hover td {
      background: rgba(105, 190, 40, 0.10);
    }

    .name {
      font-weight: 900;
      color: var(--navy);
      max-width: 360px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .name-link {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .name-link:hover { opacity: .85; }

    .pos {
      color: rgba(15, 23, 32, 0.7);
      font-weight: 800;
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      color: rgba(15, 23, 32, 0.75);
    }
  </style>
</SeahawksLayout>



