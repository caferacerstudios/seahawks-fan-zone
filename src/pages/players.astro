---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import seahawks from "../data/nfl/seahawks.json";
import playersData from "../data/nfl/players.json";

const pageTitle = `Player Stats (${seahawks.season})`;

const fmtUpdatedPT = (iso) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));

function n(v) {
  return typeof v === "number" ? v : 0;
}
function dashIfNull(v) {
  return typeof v === "number" ? v : "-";
}
function tdTriplet(r) {
  return `${n(r.passing_touchdowns)}/${n(r.rushing_touchdowns)}/${n(r.receiving_touchdowns)}`;
}
function totalYards(r) {
  return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
}

function getRoster(playersJson) {
  if (Array.isArray(playersJson?.data)) return playersJson.data;
  if (Array.isArray(playersJson?.players)) return playersJson.players;
  if (Array.isArray(playersJson)) return playersJson;
  return [];
}

function playerIdFromPlayer(p) {
  return p?.id ?? p?.player_id ?? null;
}

function playerNameFromPlayer(p) {
  if (!p) return "Unknown";
  const full = `${p.first_name || ""} ${p.last_name || ""}`.trim();
  return full || p.full_name || "Unknown";
}

// --------------------
// Build best stat line per player (if present in seahawks.json)
// --------------------
const statRows = Array.isArray(seahawks?.playerSeasonStats) ? seahawks.playerSeasonStats : [];

// Deduplicate rows by player id, keeping the “best” stat line (most total yards)
const bestStatsById = new Map();
for (const r of statRows) {
  const pid = r?.player?.id ?? r?.player_id ?? null;
  if (!pid) continue;

  const key = String(pid);
  const existing = bestStatsById.get(key);
  if (!existing || totalYards(r) > totalYards(existing)) bestStatsById.set(key, r);
}

// --------------------
// Build final rows: roster-first, stats if available
// --------------------
const roster = getRoster(playersData);

// Dedup roster by id (keep first)
const seenRoster = new Set();
const rosterDedup = [];
for (const p of roster) {
  const id = playerIdFromPlayer(p);
  if (id === null || id === undefined) continue;
  const key = String(id);
  if (seenRoster.has(key)) continue;
  seenRoster.add(key);
  rosterDedup.push(p);
}

function posFromPlayer(p) {
  return String(p?.position_abbreviation || p?.position || "").toUpperCase() || "";
}

// Build combined row objects shaped like your old stat rows,
// but guaranteed one per roster player.
const rows = rosterDedup.map((p) => {
  const pid = String(playerIdFromPlayer(p));
  const stats = bestStatsById.get(pid) || {};
  return {
    __playerId: pid,
    player: {
      id: Number.isFinite(Number(pid)) ? Number(pid) : pid,
      first_name: p?.first_name,
      last_name: p?.last_name,
      full_name: playerNameFromPlayer(p),
      position_abbreviation: (p?.position_abbreviation || p?.position || "").toUpperCase() || "-",
    },
    games_played: stats?.games_played,
    passing_yards: stats?.passing_yards,
    rushing_yards: stats?.rushing_yards,
    receiving_yards: stats?.receiving_yards,
    passing_touchdowns: stats?.passing_touchdowns,
    rushing_touchdowns: stats?.rushing_touchdowns,
    receiving_touchdowns: stats?.receiving_touchdowns,
  };
});

// Sort by total yards (stats missing => 0)
rows.sort((a, b) => totalYards(b) - totalYards(a));

// Positions dropdown from roster (not stats)
const positions = Array.from(new Set(rosterDedup.map((p) => posFromPlayer(p)).filter(Boolean))).sort();

function playerHref(id) {
  return `/players/${encodeURIComponent(String(id))}`;
}
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Active roster + sortable season stats" activePath="/players">
  <div class="sfz-topbar">
    <div class="sfz-meta">
      <div class="sfz-sub">
        Season: {seahawks.season} &nbsp; • &nbsp; Updated: {fmtUpdatedPT(seahawks.updatedAt)} PT
      </div>
    </div>

    <div class="sfz-controls">
      <label class="sfz-label" for="pos">Position</label>

      <select id="pos" class="sfz-select">
        <option value="ALL">All</option>
        {positions.map((p) => (
          <option value={p}>{p}</option>
        ))}
      </select>

      <div class="sfz-count"><span id="playerCount">{rows.length}</span> players</div>
    </div>
  </div>

  <div class="sfz-table-wrap" role="region" aria-label="Player stats table">
    <table class="sfz-table">
      <thead>
        <tr>
          <th class="sticky">Player</th>
          <th class="sticky">Pos</th>
          <th class="sticky num">GP</th>
          <th class="sticky num">Pass Yds</th>
          <th class="sticky num">Rush Yds</th>
          <th class="sticky num">Rec Yds</th>
          <th class="sticky num">TD P/R/Rec</th>
        </tr>
      </thead>

      <tbody id="playersBody">
        {rows.map((r) => {
          const pos = (r?.player?.position_abbreviation || "").toUpperCase();
          const pid = r?.__playerId ?? r?.player?.id ?? "";
          return (
            <tr data-pos={pos}>
              <td class="name">
                <a class="player-link" href={playerHref(pid)}>{r?.player?.full_name || "Unknown"}</a>
              </td>
              <td class="pos">{r?.player?.position_abbreviation || "-"}</td>
              <td class="num">{dashIfNull(r.games_played)}</td>
              <td class="num">{dashIfNull(r.passing_yards)}</td>
              <td class="num">{dashIfNull(r.rushing_yards)}</td>
              <td class="num">{dashIfNull(r.receiving_yards)}</td>
              <td class="num">{tdTriplet(r)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <script is:inline>
    (() => {
      const select = document.getElementById("pos");
      const body = document.getElementById("playersBody");
      const countEl = document.getElementById("playerCount");

      function getPosFromUrl() {
        const params = new URLSearchParams(window.location.search);
        return (params.get("pos") || "ALL").toUpperCase();
      }

      function setUrlPos(pos) {
        const url = new URL(window.location.href);
        if (!pos || pos === "ALL") url.searchParams.delete("pos");
        else url.searchParams.set("pos", pos);
        window.history.replaceState({}, "", url);
      }

      function applyFilter(pos) {
        const rows = body.querySelectorAll("tr[data-pos]");
        let shown = 0;

        rows.forEach((tr) => {
          const rpos = (tr.getAttribute("data-pos") || "").toUpperCase();
          const visible = (pos === "ALL") || (rpos === pos);
          tr.style.display = visible ? "" : "none";
          if (visible) shown++;
        });

        countEl.textContent = String(shown);
      }

      const initialPos = getPosFromUrl();
      select.value = initialPos;
      applyFilter(initialPos);

      select.addEventListener("change", () => {
        const pos = (select.value || "ALL").toUpperCase();
        setUrlPos(pos);
        applyFilter(pos);
      });
    })();
  </script>

  <style>
    .sfz-topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.85rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.12);
    }

    .sfz-sub {
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
    }

    .sfz-controls {
      display: inline-flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .sfz-label {
      font-weight: 900;
      color: rgba(0, 34, 68, 0.72);
      font-size: 0.9rem;
    }

    .sfz-select {
      border-radius: 10px;
      padding: 0.5rem 0.65rem;
      border: 1px solid rgba(0, 34, 68, 0.18);
      font-weight: 900;
      background: #fff;
      color: rgba(0, 34, 68, 0.9);
      min-width: 160px;
    }

    .sfz-count {
      color: rgba(0, 34, 68, 0.85);
      font-weight: 900;
      font-size: 0.95rem;
    }

    .sfz-table-wrap {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      overflow: auto;
      max-height: 70vh;
    }

    .sfz-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
      font-size: 0.95rem;
    }

    .sfz-table th,
    .sfz-table td {
      padding: 0.65rem 0.7rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.10);
      white-space: nowrap;
    }

    .sfz-table thead th {
      background: rgba(0, 34, 68, 0.04);
      color: rgba(0, 34, 68, 0.88);
      font-weight: 900;
      letter-spacing: 0.2px;
    }

    .sticky {
      position: sticky;
      top: 0;
      z-index: 2;
    }

    .sfz-table tbody tr:hover td {
      background: rgba(105, 190, 40, 0.10);
    }

    .name {
      font-weight: 900;
      color: var(--navy);
    }

    .player-link {
      color: inherit;
      text-decoration: none;
    }
    .player-link:hover {
      text-decoration: underline;
      opacity: .9;
    }

    .pos {
      color: rgba(15, 23, 32, 0.7);
      font-weight: 800;
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      color: rgba(15, 23, 32, 0.75);
    }
  </style>
</SeahawksLayout>
