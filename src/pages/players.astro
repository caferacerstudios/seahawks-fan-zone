---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import SeasonContextView from "../components/SeasonContext.astro";
import { getAvailableSeasonContexts, getSeasonContext } from "../lib/season-context";
import data from "../data/nfl/seahawks.json";

const context = getSeasonContext(data, "regular season");
const seasons = getAvailableSeasonContexts(data, "regular season");
const GROUP = {
  offense: new Set(["QB","RB","FB","WR","TE","OT","T","OG","G","C","OL"]),
  defense: new Set(["DE","DT","DL","NT","LB","OLB","ILB","MLB","CB","DB","S","FS","SS"]),
  special: new Set(["K","P","LS","KR","PR"]),
};
const numeric = (v) => typeof v === "number" && Number.isFinite(v) ? v : null;
const stat = (r, keys) => { for (const key of keys) if (numeric(r?.[key]) !== null) return r[key]; return null; };
const id = (r) => r?.player?.id ?? r?.player_id;
const name = (r) => r?.player?.full_name || `${r?.player?.first_name || ""} ${r?.player?.last_name || ""}`.trim() || "Unknown player";
const pos = (r) => String(r?.player?.position_abbreviation || r?.player?.position || "").toUpperCase();
const jersey = (r) => r?.player?.jersey_number ?? r?.player?.jersey ?? r?.player?.number ?? null;
const group = (p) => GROUP.offense.has(p) ? "offense" : GROUP.defense.has(p) ? "defense" : GROUP.special.has(p) ? "special" : "other";
const score = (r) => Object.values(r || {}).filter((v) => numeric(v) !== null).length;
const byId = new Map();
for (const row of (data?.playerSeasonStats || [])) { const key = id(row); if (key == null) continue; const old = byId.get(String(key)); if (!old || score(row) > score(old)) byId.set(String(key), row); }
const rows = [...byId.values()].sort((a,b) => name(a).localeCompare(name(b)));
const currentRosterCount = Array.isArray(data?.currentRoster)
  ? new Set(data.currentRoster.map((player) => player?.id ?? player?.player_id).filter((value) => value !== null && value !== undefined)).size
  : null;
const positions = [...new Set(rows.map(pos).filter(Boolean))].sort();
const columnSets = {
  all: [{label:"GP",keys:["games_played"]}],
  offense: [{label:"GP",keys:["games_played"]},{label:"Pass Yds",keys:["passing_yards"]},{label:"Pass TD",keys:["passing_touchdowns"]},{label:"Rush Yds",keys:["rushing_yards"]},{label:"Rec",keys:["receptions"]},{label:"Rec Yds",keys:["receiving_yards"]},{label:"TD",keys:["total_touchdowns","touchdowns"]}],
  defense: [{label:"GP",keys:["games_played"]},{label:"Tackles",keys:["total_tackles","tackles"]},{label:"Sacks",keys:["sacks"]},{label:"INT",keys:["defensive_interceptions","interceptions"]},{label:"PD",keys:["passes_defended","passes_defensed"]},{label:"FF",keys:["forced_fumbles"]}],
  special: [{label:"GP",keys:["games_played"]},{label:"FGM",keys:["field_goals_made"]},{label:"FGA",keys:["field_goals_attempted"]},{label:"XP",keys:["extra_points_made"]},{label:"Punts",keys:["punts"]},{label:"Punt Avg",keys:["punt_average","punting_average"]}],
};
const columns = Object.fromEntries(Object.entries(columnSets).map(([unit, defs]) => [unit, defs.filter((def) => rows.some((r) => (unit === "all" || group(pos(r)) === unit) && stat(r, def.keys) !== null))]));
const leaders = [
  ["Passing",["passing_yards"],"YDS"],["Rushing",["rushing_yards"],"YDS"],["Receiving",["receiving_yards"],"YDS"],
  ["Tackles",["total_tackles","tackles"],"TACKLES"],["Sacks",["sacks"],"SACKS"],["Interceptions",["defensive_interceptions","interceptions"],"INT"],["Kicking",["field_goals_made"],"FG"],
].map(([label,keys,suffix]) => { const found = rows.filter((r) => stat(r,keys) !== null).sort((a,b) => stat(b,keys)-stat(a,keys))[0]; return found ? {label,keys,suffix,row:found,value:stat(found,keys)} : null; }).filter(Boolean);
---
<SeahawksLayout pageTitle="Seattle Seahawks Roster" pageTagline="Search the roster and explore position-relevant season statistics." activePath="/players" pageType="players" season={context.seasonYear}>
  <section class="hub" aria-labelledby="hub-title"><div><p class="eyebrow">Current roster</p><h3 id="hub-title">{currentRosterCount !== null ? `${currentRosterCount} players` : "Roster directory"}</h3><p>{context.label} statistics</p></div><div class="hub-controls"><label>Season<select id="seasonSelect" aria-label="Season" data-analytics-event="schedule_filter" data-analytics-filter-type="season">{seasons.map((s) => <option selected={s.seasonYear===context.seasonYear}>{s.seasonYear}</option>)}</select></label><label>Search roster<input id="search" type="search" placeholder="Name or number" autocomplete="off" /></label></div></section>
  <SeasonContextView context={context} options={seasons} prefix="Data through" />
  {leaders.length > 0 && <section class="section"><p class="eyebrow">Season snapshot</p><h2>Team Leaders</h2><div class="leader-grid">{leaders.map((lead) => <a class="leader" href={`/players/${encodeURIComponent(String(id(lead.row)))}`}><span>{lead.label}</span><strong>{lead.value}</strong><small>{lead.suffix}</small><b>{name(lead.row)}</b></a>)}</div></section>}
  <section class="section"><div class="section-top"><div><p class="eyebrow">Players</p><h2>Roster directory</h2></div><p id="filter-status" role="status" aria-live="polite" aria-atomic="true"><b id="count">{rows.length}</b> shown</p></div>
    <div class="tabs" role="group" aria-label="Roster unit"><button class="active" data-group="all" aria-pressed="true">All</button><button data-group="offense" aria-pressed="false">Offense</button><button data-group="defense" aria-pressed="false">Defense</button><button data-group="special" aria-pressed="false">Special teams</button></div>
    <label class="position">Position group <select id="position"><option value="ALL">All positions</option>{positions.map((p) => <option value={p}>{p}</option>)}</select></label>
    <p class="table-help" id="roster-table-help">Activate a column heading to sort. On smaller screens, statistics are reformatted as player cards.</p>
    <div class="table-wrap" role="region" aria-label="Sortable roster table" aria-describedby="roster-table-help" tabindex="0"><table><thead><tr><th aria-sort="ascending"><button class="sort" data-sort="name">Player <span aria-hidden="true">↕</span></button></th><th aria-sort="none"><button class="sort" data-sort="number">No. <span aria-hidden="true">↕</span></button></th><th aria-sort="none"><button class="sort" data-sort="position">Pos. <span aria-hidden="true">↕</span></button></th>{Object.entries(columns).map(([unit,defs]) => defs.map((def) => <th class={`stats stats-${unit}`} data-stat-group={unit} aria-sort="none"><button class="sort" data-sort={def.keys[0]}>{def.label} <span aria-hidden="true">↕</span></button></th>))}</tr></thead><tbody id="body">{rows.map((r) => <tr data-group={group(pos(r))} data-position={pos(r)} data-name={name(r).toLowerCase()} data-number={String(jersey(r)??"")}><td class="player"><a href={`/players/${encodeURIComponent(String(id(r)))}`}><span class="badge">{jersey(r)??pos(r)}</span><span><b>{name(r)}</b><small>View profile</small></span></a></td><td data-label="No.">{jersey(r)??""}</td><td data-label="Position">{pos(r)}</td>{Object.entries(columns).map(([unit,defs]) => defs.map((def) => <td class={`stats stats-${unit}`} data-stat-group={unit} data-stat-key={def.keys[0]} data-value={stat(r,def.keys)??""} data-label={def.label}>{stat(r,def.keys)??""}</td>))}</tr>)}</tbody></table></div><p id="empty" class="empty" role="status" hidden>No players match those filters.</p>
  </section>
  <script is:inline>
    (()=>{const body=document.getElementById('body');if(!body)return;const search=document.getElementById('search'),position=document.getElementById('position'),count=document.getElementById('count'),empty=document.getElementById('empty'),tabs=[...document.querySelectorAll('.tabs button')];let group='all',sortKey='name',direction=1;function update(){const q=(search.value||'').trim().toLowerCase(),p=position.value;let shown=0;[...body.rows].forEach(row=>{row.hidden=!((group==='all'||row.dataset.group===group)&&(p==='ALL'||row.dataset.position===p)&&(!q||row.dataset.name.includes(q)||row.dataset.number===q.replace(/^#/,'')));if(!row.hidden)shown++});count.textContent=shown;empty.hidden=shown!==0;document.querySelectorAll('[data-stat-group]').forEach(cell=>{cell.hidden=group==='all'?cell.dataset.statGroup!=='all':cell.dataset.statGroup!==group})}tabs.forEach(button=>button.addEventListener('click',()=>{group=button.dataset.group;tabs.forEach(x=>{const on=x===button;x.classList.toggle('active',on);x.setAttribute('aria-pressed',String(on))});position.value='ALL';update()}));search.addEventListener('input',update);position.addEventListener('change',update);document.querySelectorAll('.sort').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.sort;if(key===sortKey)direction*=-1;else{sortKey=key;direction=1}[...body.rows].sort((a,b)=>{const get=(row)=>key==='name'?row.dataset.name:key==='number'?row.dataset.number:key==='position'?row.dataset.position:row.querySelector(`[data-stat-key="${key}"]`)?.dataset.value||'';const av=get(a),bv=get(b),an=Number(av),bn=Number(bv);return direction*(av!==''&&bv!==''&&!isNaN(an)&&!isNaN(bn)?an-bn:String(av).localeCompare(String(bv),undefined,{numeric:true}))}).forEach(row=>body.append(row));document.querySelectorAll('th[aria-sort]').forEach(th=>th.setAttribute('aria-sort',th.contains(button)?(direction===1?'ascending':'descending'):'none'))}));update()})();
  </script>
  <style>
    .hub,.section{border:1px solid #d8dfe5;border-radius:18px;background:#fff;box-shadow:0 12px 30px rgba(0,34,68,.07)}.hub{display:flex;justify-content:space-between;align-items:end;gap:1rem;padding:1.2rem;background:linear-gradient(120deg,#002244,#16456e);color:#fff}.hub h3,.hub p,.section h3{margin:.1rem 0}.eyebrow{margin:0!important;color:#69be28;text-transform:uppercase;letter-spacing:.12em;font-size:.7rem;font-weight:950}.hub-controls{display:flex;gap:.7rem;flex-wrap:wrap}.hub label,.position{display:grid;gap:.25rem;font-size:.78rem;font-weight:900}.hub input,.hub select,.position select{min-height:42px;padding:.45rem .6rem;border:1px solid #bbc7d1;border-radius:9px;background:#fff;color:#002244;font:inherit}.hub input{min-width:220px}.section{margin-top:1rem;padding:1rem}.leader-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:.6rem;margin-top:.7rem}.leader{display:grid;grid-template-columns:1fr auto;padding:.75rem;border-left:4px solid #69be28;border-radius:10px;background:#f2f5f7;color:#002244;text-decoration:none}.leader strong{font-size:1.5rem}.leader small{text-align:right}.leader b{grid-column:1/-1;font-size:.78rem}.section-top{display:flex;justify-content:space-between;align-items:end}.tabs{display:flex;gap:.4rem;overflow:auto;margin:.7rem 0}.tabs button{padding:.5rem .8rem;border:1px solid #cbd5dc;border-radius:999px;background:#fff;color:#002244;font-weight:900;white-space:nowrap}.tabs .active{background:#002244;color:#fff}.position{display:flex;align-items:center;gap:.5rem;margin-bottom:.65rem}.table-wrap{overflow:auto;border:1px solid #d8dfe5;border-radius:12px}table{width:100%;min-width:620px;border-collapse:collapse}th,td{padding:.65rem;text-align:right;border-bottom:1px solid #e3e8ec}th{position:sticky;top:0;background:#f2f5f7}.sort{border:0;background:none;font-weight:950;color:#334e68;cursor:pointer}.player{text-align:left}.player a{display:flex;align-items:center;gap:.6rem;color:#002244;text-decoration:none}.player small{display:block;color:#687c8f}.badge{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#002244;color:#fff;font-weight:950}.empty{text-align:center;padding:1rem;background:#f2f5f7}[hidden]{display:none!important}button:focus-visible,input:focus-visible,select:focus-visible,.table-wrap:focus-visible{outline:3px solid #69be28;outline-offset:2px}
    @media(max-width:680px){.hub{align-items:stretch;flex-direction:column}.hub-controls,.hub label,.hub input,.hub select{width:100%;box-sizing:border-box}.leader-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.table-wrap{border:0;overflow:visible}table,tbody{display:block;min-width:0}thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}tbody{display:grid;gap:.55rem}tr{display:grid;grid-template-columns:1fr auto auto;gap:.3rem .65rem;padding:.7rem;border:1px solid #d8dfe5;border-radius:12px}td{display:flex;justify-content:space-between;padding:.12rem 0;border:0}.player{grid-column:1/-1;border-bottom:1px solid #e3e8ec;padding-bottom:.45rem}.stats::before{content:attr(data-label);font-size:.7rem;font-weight:900;color:#687c8f}}
    .hub h2,.hub p,.section h2{margin:.1rem 0}
  </style>
</SeahawksLayout>
