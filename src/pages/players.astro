---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import playersData from "../data/nfl/players.json";

const season = playersData?.season ?? "";
const updatedAt = playersData?.updatedAt ?? "";
const rows = Array.isArray(playersData?.players) ? playersData.players : [];

// derive unique positions
const posSet = new Set();
for (const r of rows) {
  const p = String(r?.player?.position || "").trim();
  if (p) posSet.add(p);
}
const positions = ["All", ...Array.from(posSet).sort((a, b) => a.localeCompare(b))];

function n(v) {
  const x = Number(v);
  return Number.isFinite(x) ? x : null;
}
function show(v) {
  const x = n(v);
  return x === null ? "–" : x.toLocaleString("en-US");
}
---

<SeahawksLayout title={`Player Stats (${season})`} description="Sortable totals with quick position filters" activePath="/players">
  <div class="players-head">
    <div>
      <h2 class="lr-post-title">Player Stats</h2>
      <div class="meta-line">
        <span><strong>Season:</strong> {season}</span>
        <span class="dot">•</span>
        <span><strong>Updated:</strong> {updatedAt ? new Date(updatedAt).toLocaleString("en-US", { timeZone: "America/Los_Angeles" }) + " PT" : "—"}</span>
      </div>
    </div>
    <div class="count">{rows.length.toLocaleString("en-US")} players</div>
  </div>

  <div class="controls">
    <label class="control">
      <div class="control-label">Position</div>
      <select id="posFilter" class="select">
        {positions.map((p) => <option value={p}>{p}</option>)}
      </select>
    </label>
  </div>

  <div class="table-wrap">
    <table class="tbl" id="playersTable">
      <thead>
        <tr>
          <th>Player</th>
          <th>Pos</th>
          <th>GP</th>
          <th>Pass Yds</th>
          <th>Rush Yds</th>
          <th>Rec Yds</th>
          <th>TD P/R/Rec</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => {
          const name = r?.player?.full_name ?? "Unknown";
          const pos = r?.player?.position ?? "-";
          const gp = show(r?.games_played ?? r?.gp);

          const passY = show(r?.passing_yards ?? r?.pass_yds ?? r?.pass_yards);
          const rushY = show(r?.rushing_yards ?? r?.rush_yds ?? r?.rush_yards);
          const recY  = show(r?.receiving_yards ?? r?.rec_yds ?? r?.rec_yards);

          const tdp = n(r?.passing_tds ?? r?.pass_tds) ?? 0;
          const tdr = n(r?.rushing_tds ?? r?.rush_tds) ?? 0;
          const tdrc = n(r?.receiving_tds ?? r?.rec_tds) ?? 0;

          return (
            <tr data-pos={String(pos)}>
              <td class="player">{name}</td>
              <td class="pos">{pos}</td>
              <td>{gp}</td>
              <td>{passY}</td>
              <td>{rushY}</td>
              <td>{recY}</td>
              <td class="tds">{tdp}/{tdr}/{tdrc}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <script is:inline>
    const sel = document.getElementById("posFilter");
    const tbody = document.querySelector("#playersTable tbody");

    function apply() {
      const want = sel.value;
      for (const tr of tbody.querySelectorAll("tr")) {
        const pos = tr.getAttribute("data-pos") || "";
        const ok = want === "All" || pos === want;
        tr.style.display = ok ? "" : "none";
      }
    }

    sel.addEventListener("change", apply);
    apply();
  </script>

  <style>
    .players-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:1rem;
      flex-wrap:wrap;
      margin-bottom:.75rem;
    }
    .meta-line{
      display:flex;
      align-items:center;
      gap:.5rem;
      color:rgba(15,23,32,.65);
      margin-top:.25rem;
      flex-wrap:wrap;
    }
    .dot{opacity:.5}
    .count{
      color:rgba(15,23,32,.65);
      font-weight:800;
    }
    .controls{
      display:flex;
      gap:1rem;
      align-items:flex-end;
      flex-wrap:wrap;
      margin: .75rem 0 1rem;
    }
    .control-label{
      font-size:.85rem;
      color:rgba(15,23,32,.65);
      font-weight:800;
      margin-bottom:.25rem;
    }
    .select{
      padding:.55rem .65rem;
      border-radius: 12px;
      border: 1px solid rgba(0,34,68,.18);
      background: #fff;
      font-weight: 800;
      min-width: 160px;
    }
    .table-wrap{
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      overflow:auto;
      background:#fff;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
    }
    .tbl{
      width:100%;
      border-collapse:collapse;
      font-size:.95rem;
    }
    thead th{
      text-align:left;
      padding:.7rem .8rem;
      background: rgba(0,34,68,.04);
      border-bottom: 1px solid rgba(0,34,68,.12);
      color: rgba(0,34,68,.90);
      font-weight: 900;
      white-space:nowrap;
    }
    tbody td{
      padding:.65rem .8rem;
      border-bottom: 1px solid rgba(0,34,68,.08);
      vertical-align:middle;
      white-space:nowrap;
    }
    tbody tr:hover{
      background: rgba(105,190,40,.06);
    }
    .player{ font-weight: 900; color: rgba(0,34,68,.92); }
    .pos{ font-weight: 900; color: rgba(15,23,32,.65); }
    .tds{ font-weight: 900; color: rgba(0,34,68,.85); }
  </style>
</SeahawksLayout>

