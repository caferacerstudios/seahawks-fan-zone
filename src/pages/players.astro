---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import data from "../data/nfl/seahawks.json";

const pageTitle = `Player Stats (${data.season})`;

const fmtUpdatedPT = (iso) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    dateStyle: "short",
    timeStyle: "medium",
  }).format(new Date(iso));

function n(v) {
  return typeof v === "number" ? v : 0;
}
function dashIfNull(v) {
  return typeof v === "number" ? v : "-";
}
function tdTriplet(r) {
  return `${n(r.passing_touchdowns)}/${n(r.rushing_touchdowns)}/${n(r.receiving_touchdowns)}`;
}

function totalYards(r) {
  return n(r.passing_yards) + n(r.rushing_yards) + n(r.receiving_yards);
}

// Position filter via query param
const posParam = (Astro.url?.searchParams?.get("pos") || "All").toUpperCase();

// Deduplicate rows by player id, keeping the “best” stat line (most total yards)
const byPlayer = new Map();

for (const r of (data.playerSeasonStats || [])) {
  const pid = r?.player?.id ?? r?.player_id ?? null;
  if (!pid) continue;

  const existing = byPlayer.get(pid);
  if (!existing) {
    byPlayer.set(pid, r);
    continue;
  }

  // Keep whichever row seems “more complete”
  if (totalYards(r) > totalYards(existing)) byPlayer.set(pid, r);
}

const deduped = Array.from(byPlayer.values());

// Build list of positions present (nice for dropdown)
const positions = Array.from(
  new Set(
    deduped
      .map((r) => (r?.player?.position_abbreviation || "").toUpperCase())
      .filter(Boolean)
  )
).sort();

// Apply filter
const filtered =
  posParam === "ALL"
    ? deduped
    : deduped.filter(
        (r) => (r?.player?.position_abbreviation || "").toUpperCase() === posParam
      );

// Sort (same idea as your original)
const rows = filtered
  .slice()
  .sort((a, b) => totalYards(b) - totalYards(a));

function playerName(r) {
  const p = r?.player;
  if (!p) return "Unknown";
  const first = p.first_name || "";
  const last = p.last_name || "";
  const full = `${first} ${last}`.trim();
  return full || "Unknown";
}
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Sortable season stats by player" activePath="/players">
  <div class="sfz-topbar">
    <div class="sfz-meta">
      <div class="sfz-sub">Season: {data.season} &nbsp; • &nbsp; Updated: {fmtUpdatedPT(data.updatedAt)} PT</div>
    </div>

    <div class="sfz-controls">
      <label class="sfz-label" for="pos">Position</label>
      <select
        id="pos"
        class="sfz-select"
        onChange="location.href=this.value"
      >
        <option value="/players" selected={posParam === "ALL"}>All</option>
        {positions.map((p) => (
          <option value={`/players?pos=${encodeURIComponent(p)}`} selected={posParam === p}>
            {p}
          </option>
        ))}
      </select>

      <div class="sfz-count">{rows.length} players</div>
    </div>
  </div>

  <div class="sfz-table-wrap" role="region" aria-label="Player stats table">
    <table class="sfz-table">
      <thead>
        <tr>
          <th class="sticky">Player</th>
          <th class="sticky">Pos</th>
          <th class="sticky num">GP</th>
          <th class="sticky num">Pass Yds</th>
          <th class="sticky num">Rush Yds</th>
          <th class="sticky num">Rec Yds</th>
          <th class="sticky num">TD P/R/Rec</th>
        </tr>
      </thead>

      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="name">{playerName(r)}</td>
            <td class="pos">{r?.player?.position_abbreviation || "-"}</td>
            <td class="num">{dashIfNull(r.games_played)}</td>
            <td class="num">{dashIfNull(r.passing_yards)}</td>
            <td class="num">{dashIfNull(r.rushing_yards)}</td>
            <td class="num">{dashIfNull(r.receiving_yards)}</td>
            <td class="num">{tdTriplet(r)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="sfz-note">
    <strong>Note:</strong> This page is deduped by player id. Next upgrade: leader views per position.
  </div>

  <style>
    .sfz-topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.85rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.12);
    }

    .sfz-sub {
      color: rgba(15, 23, 32, 0.65);
      font-weight: 800;
      font-size: 0.95rem;
    }

    .sfz-controls {
      display: inline-flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .sfz-label {
      font-weight: 900;
      color: rgba(0, 34, 68, 0.72);
      font-size: 0.9rem;
    }

    .sfz-select {
      border-radius: 10px;
      padding: 0.5rem 0.65rem;
      border: 1px solid rgba(0, 34, 68, 0.18);
      font-weight: 900;
      background: #fff;
      color: rgba(0, 34, 68, 0.9);
      min-width: 160px;
    }

    .sfz-count {
      color: rgba(0, 34, 68, 0.85);
      font-weight: 900;
      font-size: 0.95rem;
    }

    .sfz-table-wrap {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      overflow: auto;
      max-height: 70vh;
    }

    .sfz-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
      font-size: 0.95rem;
    }

    .sfz-table th,
    .sfz-table td {
      padding: 0.65rem 0.7rem;
      border-bottom: 1px solid rgba(0, 34, 68, 0.10);
      white-space: nowrap;
    }

    .sfz-table thead th {
      background: rgba(0, 34, 68, 0.04);
      color: rgba(0, 34, 68, 0.88);
      font-weight: 900;
      letter-spacing: 0.2px;
    }

    .sticky {
      position: sticky;
      top: 0;
      z-index: 2;
    }

    .sfz-table tbody tr:hover td {
      background: rgba(105, 190, 40, 0.10);
    }

    .name {
      font-weight: 900;
      color: var(--navy);
    }

    .pos {
      color: rgba(15, 23, 32, 0.7);
      font-weight: 800;
    }

    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      color: rgba(15, 23, 32, 0.75);
    }

    .sfz-note {
      margin-top: 1rem;
      padding: 0.85rem 0.95rem;
      border-radius: 14px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: rgba(165, 172, 175, 0.18);
      color: rgba(15, 23, 32, 0.85);
    }
  </style>
</SeahawksLayout>
