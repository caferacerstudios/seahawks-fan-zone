---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";

const title = "About | Seahawks Fan Zone";
const description =
  "About Seahawks Fan Zone on seahawksfanzone.com – what this site is and what it covers.";
---

<SeahawksLayout {title} {description}>
  <h1>About Seahawks Fan Zone</h1>

  <div class="card">
    <h2>What This Site Is</h2>
    <p>
      Seahawks Fan Zone is a simple stats-and-highlights hub for the 12s.
      I track the season with schedules, scores, team trends, and player numbers—plus quick-hit notes and links to the best clips so you can catch up fast.
      You won’t find comment threads here. Just the info, the moments, and occasional Seahawks-themed gear finds.
      Go Hawks. 💙💚
    </p>
  </div>

  <div class="card">
    <h2>Contact</h2>
    <p>
      If you spot an error,
      you can reach the site owner at:
      <br />
      <a href="mailto:laura@caferacerstudios.com">laura@caferacerstudios.com</a>
      <!-- replace with your real email or contact method -->
    </p>
  </div>
</SeahawksLayout>
