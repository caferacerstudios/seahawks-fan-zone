---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import scheduleData from "../data/nfl/seahawks.json";

const PT_TZ = "America/Los_Angeles";

function formatUpdatedPT(iso) {
  const d = iso ? new Date(iso) : new Date();
  return (
    new Intl.DateTimeFormat("en-US", {
      timeZone: PT_TZ,
      year: "numeric",
      month: "numeric",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(d) + " PT"
  );
}

function formatKickoffPT(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);

  const datePart = new Intl.DateTimeFormat("en-US", {
    timeZone: PT_TZ,
    weekday: "short",
    month: "short",
    day: "numeric",
  }).format(d);

  const timePart = new Intl.DateTimeFormat("en-US", {
    timeZone: PT_TZ,
    hour: "numeric",
    minute: "2-digit",
  }).format(d);

  return `${datePart}, ${timePart} PT`;
}

function safeAbbr(team) {
  return (team?.abbreviation || "").toUpperCase();
}

function teamLogoPath(abbr) {
  return abbr ? `/images/nfl/teams/${abbr}.png` : "";
}

function isFinal(game) {
  const s = String(game?.status || "").toLowerCase();
  return s.includes("final");
}

function parseScore(game) {
  const home = Number(game?.home_team_score ?? game?.home_score ?? 0);
  const away = Number(game?.visitor_team_score ?? game?.visitor_score ?? 0);
  return { home, away };
}

function seahawksSide(game) {
  const homeAbbr = safeAbbr(game?.home_team);
  const awayAbbr = safeAbbr(game?.visitor_team);
  if (homeAbbr === "SEA") return "home";
  if (awayAbbr === "SEA") return "away";
  return "";
}

function seahawksWon(game) {
  if (!isFinal(game)) return false;
  const side = seahawksSide(game);
  const { home, away } = parseScore(game);
  if (side === "home") return home > away;
  if (side === "away") return away > home;
  return false;
}

function seahawksLost(game) {
  if (!isFinal(game)) return false;
  const side = seahawksSide(game);
  const { home, away } = parseScore(game);
  if (side === "home") return home < away;
  if (side === "away") return away < home;
  return false;
}

function matchupLine(game) {
  const homeAbbr = safeAbbr(game?.home_team);
  const awayAbbr = safeAbbr(game?.visitor_team);

  const seaHome = homeAbbr === "SEA";
  const left = seaHome ? awayAbbr : "SEA";
  const right = seaHome ? "SEA" : homeAbbr;

  return { left, right, seaHome, homeAbbr, awayAbbr };
}

function weekLabel(game) {
  const w = game?.week;
  const isPlayoffs = Boolean(game?.postseason || game?.is_postseason);
  if (isPlayoffs) return w ? `Playoffs Week ${w}` : "Playoffs";
  return w ? `Week ${w}` : "Week";
}

function seasonFromGames(games) {
  // Prefer explicit season if present, else derive from first regular season game date.
  const explicit = scheduleData?.season;
  if (explicit) return String(explicit);

  const first = games?.find((g) => g?.date)?.date;
  if (!first) return "";
  const d = new Date(first);

  // NFL season year is usually the year regular season starts (Sep–Jan)
  // If game date is Jan/Feb, treat as previous season start year.
  const y = d.getUTCFullYear();
  const m = d.getUTCMonth() + 1;
  return m <= 2 ? String(y - 1) : String(y);
}

const games = Array.isArray(scheduleData?.games) ? scheduleData.games : [];
const seasonYear = seasonFromGames(games);
const updatedText = formatUpdatedPT(scheduleData?.updatedAt);

const pageTitle = "Seahawks Schedule";
const pageTagline = "Season results and upcoming games";
---

<SeahawksLayout pageTitle={pageTitle} pageTagline={pageTagline} activePath="/schedule">
  <section class="sfz-top">
    <p class="sfz-meta">
      <strong>Season:</strong> {seasonYear || "Current"}
      <span class="sfz-dot">•</span>
      <strong>Updated:</strong> {updatedText}
    </p>
  </section>

  <section class="sfz-grid" aria-label="Schedule">
    {games.map((g) => {
      const { left, right, seaHome, homeAbbr, awayAbbr } = matchupLine(g);

      const leftLogo = teamLogoPath(left);
      const rightLogo = teamLogoPath(right);

      const kickoff = formatKickoffPT(g?.date);
      const final = isFinal(g);

      const { home, away } = parseScore(g);
      const scoreMap = { [homeAbbr]: home, [awayAbbr]: away };

      const leftPts = scoreMap[left] ?? 0;
      const rightPts = scoreMap[right] ?? 0;

      const cardClass =
        seahawksWon(g) ? "sfz-card sfz-card--win" :
        seahawksLost(g) ? "sfz-card sfz-card--loss" :
        "sfz-card";

      return (
        <article class={cardClass}>
          <header class="sfz-card-head">
            <div class="sfz-week">{weekLabel(g)}</div>
            <div class="sfz-kickoff">{kickoff}</div>
          </header>

          <div class="sfz-divider" aria-hidden="true"></div>

          <div class="sfz-matchup">
            <div class="sfz-team">
              <img
                class="sfz-logo"
                src={leftLogo}
                alt={`${left} logo`}
                loading="lazy"
                onerror="this.style.display='none';"
              />
              <div class="sfz-abbr">{left}</div>
              <div class="sfz-homeaway">
                {left === "SEA" ? (seaHome ? "H" : "A") : (seaHome ? "A" : "H")}
              </div>
            </div>

            <div class="sfz-at">@</div>

            <div class="sfz-team sfz-team--right">
              <img
                class="sfz-logo"
                src={rightLogo}
                alt={`${right} logo`}
                loading="lazy"
                onerror="this.style.display='none';"
              />
              <div class="sfz-abbr">{right}</div>
              <div class="sfz-homeaway">
                {right === "SEA" ? (seaHome ? "H" : "A") : (seaHome ? "A" : "H")}
              </div>
            </div>
          </div>

          <footer class="sfz-card-foot">
            <div class="sfz-status">{final ? "Final" : (g?.status || "Scheduled")}</div>

            <div class="sfz-score" aria-label="Score">
              {final ? (
                <>
                  <span class={left === "SEA" ? "sfz-scorepart sfz-scorepart--sea" : "sfz-scorepart"}>
                    {leftPts}
                  </span>
                  <span class="sfz-scoresep">:</span>
                  <span class={right === "SEA" ? "sfz-scorepart sfz-scorepart--sea" : "sfz-scorepart"}>
                    {rightPts}
                  </span>
                </>
              ) : (
                <span class="sfz-scorepart sfz-scorepart--pending">TBD</span>
              )}
            </div>
          </footer>
        </article>
      );
    })}
  </section>

  <style>
    .sfz-top {
      margin-bottom: 0.9rem;
    }

    .sfz-meta {
      margin: 0;
      color: rgba(15, 23, 32, 0.65);
      font-weight: 850;
      font-size: 0.95rem;
    }

    .sfz-dot {
      padding: 0 0.4rem;
      color: rgba(0, 34, 68, 0.35);
      font-weight: 900;
    }

    .sfz-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
      align-items: start;
    }

    .sfz-card {
      border-radius: 16px;
      border: 1px solid rgba(0, 34, 68, 0.14);
      background: #ffffff;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      padding: 0.9rem 0.95rem;
      overflow: hidden;
    }

    .sfz-card--win {
      border-color: rgba(105, 190, 40, 0.7);
      box-shadow: 0 10px 26px rgba(105, 190, 40, 0.12);
    }

    .sfz-card--loss {
      border-color: rgba(210, 60, 60, 0.55);
      box-shadow: 0 10px 26px rgba(210, 60, 60, 0.10);
    }

    .sfz-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.6rem;
      flex-wrap: wrap;
      min-width: 0;
    }

    .sfz-week {
      font-weight: 950;
      color: var(--navy);
      font-size: 1rem;
      line-height: 1.2;
      flex: 0 0 auto;
    }

    .sfz-kickoff {
      color: rgba(15, 23, 32, 0.62);
      font-weight: 850;
      font-size: 0.92rem;
      line-height: 1.25;
      white-space: normal;
      min-width: 0;
      flex: 1 1 12rem;
      text-align: right;
    }

    .sfz-divider {
      height: 1px;
      background: rgba(0, 34, 68, 0.10);
      margin: 0.65rem 0 0.7rem;
    }

    .sfz-matchup {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.7rem;
      min-width: 0;
    }

    .sfz-team {
      display: grid;
      grid-template-columns: 34px auto;
      grid-template-rows: auto auto;
      column-gap: 0.55rem;
      row-gap: 0.05rem;
      align-items: center;
      min-width: 0;
    }

    .sfz-team--right {
      justify-items: end;
      grid-template-columns: auto 34px;
    }

    .sfz-logo {
      width: 34px;
      height: 34px;
      object-fit: contain;
      grid-row: 1 / span 2;
      filter: drop-shadow(0 2px 2px rgba(0,0,0,0.08));
    }

    .sfz-team--right .sfz-logo {
      grid-column: 2;
    }

    .sfz-abbr {
      font-weight: 950;
      color: var(--navy);
      font-size: 1.05rem;
      line-height: 1.05;
      white-space: nowrap;
    }

    .sfz-homeaway {
      font-weight: 900;
      font-size: 0.85rem;
      color: rgba(15, 23, 32, 0.55);
      white-space: nowrap;
    }

    .sfz-at {
      font-weight: 950;
      color: rgba(0, 34, 68, 0.55);
      padding: 0 0.1rem;
    }

    .sfz-card-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      min-width: 0;
    }

    .sfz-status {
      font-weight: 950;
      color: rgba(0, 34, 68, 0.78);
    }

    .sfz-score {
      font-weight: 950;
      color: rgba(0, 34, 68, 0.85);
      display: inline-flex;
      align-items: baseline;
      gap: 0.25rem;
      white-space: nowrap;
    }

    .sfz-scorepart--sea {
      color: var(--navy);
    }

    .sfz-scorepart--pending {
      color: rgba(0, 34, 68, 0.55);
      font-weight: 900;
      font-size: 0.95rem;
    }

    .sfz-scoresep {
      color: rgba(0, 34, 68, 0.35);
      font-weight: 900;
    }

    @media (max-width: 980px) {
      .sfz-grid {
        grid-template-columns: 1fr;
      }
      .sfz-kickoff {
        text-align: left;
        flex: 1 1 100%;
      }
    }
  </style>
</SeahawksLayout>
