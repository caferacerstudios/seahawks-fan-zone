---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import data from "../data/nfl/seahawks.json";

const games = data.games
  .slice()
  .sort((a, b) => new Date(a.date) - new Date(b.date));

const pageTitle = `Seahawks Schedule (${data.season})`;
---

<SeahawksLayout pageTitle={pageTitle} pageTagline="Schedule, stats, and highlights for the 12s" activePath="/schedule">
  <p class="muted">Updated: {new Date(data.updatedAt).toLocaleString()}</p>

  <ul class="lr-list">
    {games.map((g) => (
      <li class="lr-list-item">
        <strong>Week {g.week}</strong>{" "}
        {new Date(g.date).toLocaleString()} —{" "}
        {g.visitor_team.abbreviation} @ {g.home_team.abbreviation}
        {" — "}
        {g.status}
        {g.status === "Final" ? ` (${g.visitor_team_score}-${g.home_team_score})` : ""}
      </li>
    ))}
  </ul>
</SeahawksLayout>
