---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import SeasonContextView from "../components/SeasonContext.astro";
import { getAvailableSeasonContexts, getSeasonContext, unavailableMessage } from "../lib/season-context";
import scheduleData from "../data/nfl/seahawks.json";

const seasonContext = getSeasonContext(scheduleData, "regular season");
const seasonOptions = getAvailableSeasonContexts(scheduleData, "regular season");
const season = seasonContext.seasonYear ?? "";

// Accept both shapes:
// 1) { games: [...] }
// 2) { gamesRegular: [...], gamesPostseason: [...] }
const rawGames = Array.isArray(scheduleData?.games)
  ? scheduleData.games
  : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
    ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
    : [];

// Normalize "is playoff" across possible fields
function isPlayoffGame(g) {
  const st = String(g?.seasonType ?? g?.season_type ?? "").toLowerCase();
  if (st.includes("post") || st.includes("playoff")) return true;
  if (g?.postseason === true) return true;
  if (g?.is_postseason === true) return true;
  return false;
}

const regular = rawGames.filter((g) => !isPlayoffGame(g));
const playoffs = rawGames.filter((g) => isPlayoffGame(g));

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function teamConf(teamObj) {
  // best-effort: BDL often includes conference on the team object
  return String(teamObj?.conference ?? "").toUpperCase();
}

function teamLogo(abbr) {
  return `/images/nfl/teams/${abbr}.png`;
}

function isSeahawksWin(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  if (game?.home_team_score == null || game?.visitor_team_score == null) return null;
  const hs = Number(game.home_team_score);
  const as = Number(game.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  const seaIsHome = home === "SEA";
  const seaIsAway = away === "SEA";
  if (!seaIsHome && !seaIsAway) return null;

  const seaScore = seaIsHome ? hs : as;
  const oppScore = seaIsHome ? as : hs;

  if (seaScore === oppScore) return null;
  return seaScore > oppScore;
}

function fmtPT(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  try {
    return d.toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "short",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }) + " PT";
  } catch {
    return d.toISOString();
  }
}

function statusText(game) {
  const s = String(game?.status || "").toLowerCase();
  if (s.includes("final")) return "Final";
  if (s.includes("in progress")) return "Live";
  if (s.includes("scheduled")) return "Scheduled";
  return game?.status || "";
}

function isFinal(game) {
  return /final|finished|complete/i.test(String(game?.status || ""));
}

function scoreText(game) {
  const hs = game?.home_team_score;
  const as = game?.visitor_team_score;

  if (hs === null || hs === undefined || as === null || as === undefined) return "TBD";

  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);

  if (home === "SEA") return `${hs} : ${as}`;
  if (away === "SEA") return `${as} : ${hs}`;
  return `${as} : ${hs}`;
}

function oppAbbr(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  return home === "SEA" ? away : home;
}

function seaIsHome(game) {
  return teamAbbr(game?.home_team) === "SEA";
}

function gameKey(g, idx) {
  return String(g?.id ?? g?.game_id ?? idx);
}

function gameHref(g, idx) {
  return `/games/${encodeURIComponent(gameKey(g, idx))}`;
}

// Sort by date, then by week as a fallback
function sortByDate(a, b) {
  const ad = a?.date ? new Date(a.date).getTime() : 0;
  const bd = b?.date ? new Date(b.date).getTime() : 0;
  if (ad !== bd) return ad - bd;
  const aw = Number(a?.week);
  const bw = Number(b?.week);
  if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
  return 0;
}

regular.sort(sortByDate);
playoffs.sort(sortByDate);

/* =======================
   Playoff labeling (FIXED)
   ======================= */

function isSuperBowlGame(g) {
  // 1) explicit seasonType hint
  const st = String(g?.seasonType ?? g?.season_type ?? "").toLowerCase();
  if (st.includes("super") && st.includes("bowl")) return true;

  // 2) if we have conferences and they differ, it's AFC vs NFC => Super Bowl
  const hc = teamConf(g?.home_team);
  const vc = teamConf(g?.visitor_team);
  if (hc && vc && hc !== vc) return true;

  return false;
}

function playoffRoundLabel(g, i, allPlayoffs) {
  // If this game itself is SB, call it SB no matter what.
  if (isSuperBowlGame(g)) return "Super Bowl";

  // If SB exists in this postseason set, then 3-game run means:
  // Divisional -> NFC Championship -> Super Bowl (bye week happened)
  const sbIndex = allPlayoffs.findIndex(isSuperBowlGame);
  if (sbIndex !== -1) {
    // Everything before SB is ordered chronologically already
    // Typical: i=0 Divisional, i=1 NFC Championship, i=2 Super Bowl
    if (i === sbIndex - 1) return "NFC Championship";
    return "Divisional";
  }

  // Otherwise, fallback by count (no SB present in data yet)
  // Use shorter labels so they don't wrap ugly.
  const total = allPlayoffs.length;
  if (total >= 3) {
    if (i === total - 1) return "NFC Championship";
    if (i === total - 2) return "Divisional";
    return "Wild Card";
  }
  if (total === 2) return i === 1 ? "Divisional" : "Wild Card";
  return "Playoffs";
}
---

<SeahawksLayout
  title={`Seahawks Schedule (${season})`}
  description="Season results and upcoming games"
  activePath="/schedule"
  pageType="schedule"
  season={season}
>
  <SeasonContextView context={seasonContext} options={seasonOptions} prefix="Data through" />

  <h3 class="section-title">Regular season</h3>

  {regular.length === 0 ? (
    <div class="empty">{unavailableMessage(seasonContext)}</div>
  ) : (
    <div class="cards-grid cards-grid--regular">
      {regular.map((g, i) => {
        const opp = oppAbbr(g);
        const win = isSeahawksWin(g);
        const cardClass =
          win === true ? "card card--win" : win === false ? "card card--loss" : "card";

        return (
          <article class={cardClass}>
            <div class="card-top">
              <div class="week">
                <a class="week-link" href={gameHref(g, i)} aria-label={`Open ${isFinal(g) ? "recap" : "matchup preview"} for week ${g?.week ?? ""}`}>
                  {Number.isFinite(Number(g?.week)) ? `Week ${g.week}` : String(g?.week || "")}
                </a>
              </div>
              <div class="date">{fmtPT(g?.date)}</div>
            </div>

            <div class="matchup">
              <div class="team">
                <img class="logo" src={teamLogo("SEA")} alt="SEA logo" loading="lazy" />
                <div class="abbr">SEA</div>
                <div class="ha">{seaIsHome(g) ? "H" : "A"}</div>
              </div>

              <div class="at">@</div>

              <div class="team">
                <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} loading="lazy" />
                <div class="abbr">{opp}</div>
                <div class="ha">{seaIsHome(g) ? "A" : "H"}</div>
              </div>
            </div>

            <div class="card-bottom">
              <div class="status">{statusText(g)}</div>
              <div class="score">{scoreText(g)}</div>
            </div>

            <div class="card-links">
              <a class="pill pill--ghost" href={gameHref(g, i)}>{isFinal(g) ? "Recap" : "Matchup"} →</a>
            </div>
          </article>
        );
      })}
    </div>
  )}

  {playoffs.length > 0 && (
    <>
      <h3 class="section-title playoffs-title" style="margin-top: 1.5rem;">
        Playoffs
        <span class="playoffs-subtitle"> — road to the Super Bowl</span>
      </h3>

      <div class="cards-grid cards-grid--playoffs">
        {playoffs.map((g, i) => {
          const opp = oppAbbr(g);
          const win = isSeahawksWin(g);
          const baseClass =
            win === true ? "card card--win" : win === false ? "card card--loss" : "card";

          const idx = regular.length + i; // avoid fallback-id collisions
          const round = playoffRoundLabel(g, i, playoffs);
          const isSB = round === "Super Bowl";

          const cls = isSB ? `${baseClass} card--sb` : `${baseClass} card--po`;

          return (
            <article class={cls}>
              <div class="card-top">
                <div class="week">
                  <a class="week-link" href={gameHref(g, idx)} aria-label={`Open ${isFinal(g) ? "recap" : "matchup preview"} for ${round}`}>
                    {round}
                  </a>
                  <span class={`round-badge ${isSB ? "round-badge--sb" : ""}`}>SEA vs {opp}</span>
                </div>

                <div class="date">{fmtPT(g?.date)}</div>
              </div>

              <div class="matchup">
                <div class="team">
                  <img class="logo" src={teamLogo("SEA")} alt="SEA logo" loading="lazy" />
                  <div class="abbr">SEA</div>
                  <div class="ha">{seaIsHome(g) ? "H" : "A"}</div>
                </div>

                <div class="at">@</div>

                <div class="team">
                  <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} loading="lazy" />
                  <div class="abbr">{opp}</div>
                  <div class="ha">{seaIsHome(g) ? "A" : "H"}</div>
                </div>
              </div>

              <div class="card-bottom">
                <div class={`status ${isSB ? "status--sb" : ""}`}>{statusText(g)}</div>
                <div class={`score ${isSB ? "score--sb" : ""}`}>{scoreText(g)}</div>
              </div>

              <div class="card-links">
                <a class={`pill pill--ghost ${isSB ? "pill--sb" : ""}`} href={gameHref(g, idx)}>{isFinal(g) ? "Recap" : "Matchup"} →</a>
              </div>
            </article>
          );
        })}
      </div>
    </>
  )}

  <style>
    .meta-line,
    .cards-grid,
    .card,
    .card-top,
    .matchup,
    .team,
    .card-bottom,
    .week,
    .date,
    .status,
    .score,
    .card-links {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .meta-line,
    .week,
    .date,
    .status,
    .score,
    .empty,
    .section-title {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .dot { opacity: .5; }

    .section-title {
      color: var(--navy);
      margin: 0.75rem 0 0.7rem;
      display:flex;
      align-items: baseline;
      gap: .5rem;
      flex-wrap: wrap;
    }

    .playoffs-subtitle{
      font-weight: 800;
      color: rgba(15,23,32,.55);
      font-size: .95rem;
    }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .85rem;
      align-items: start;
    }

    .cards-grid > *:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(520px, 100%);
    }

    /* ✅ Regular season: DO NOT make last card span (fix Week 18 giant card) */
    .cards-grid--regular > *:last-child:nth-child(odd) {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
    }

    @media (max-width: 820px) {
      .cards-grid { grid-template-columns: 1fr; }
      .cards-grid > *:last-child:nth-child(odd) {
        grid-column: auto;
        justify-self: stretch;
        width: 100%;
      }
      .cards-grid--regular > *:last-child:nth-child(odd) { width: 100%; }
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
      position: relative;
    }

    .card--win { border-color: rgba(105,190,40,.65); box-shadow: 0 10px 22px rgba(105,190,40,.12); }
    .card--loss { border-color: rgba(220,38,38,.45); box-shadow: 0 10px 22px rgba(220,38,38,.10); }

    /* Playoff card */
    .card--po{
      border-color: rgba(0,34,68,0.20);
      box-shadow: 0 14px 30px rgba(0,0,0,.10);
    }

    /* ✅ Super Bowl: full width + extra glow */
    .cards-grid--playoffs .card--sb{
      grid-column: 1 / -1;
      justify-self: center;
      width: min(720px, 100%);
      border-color: rgba(105,190,40,.55);
      box-shadow: 0 18px 46px rgba(105,190,40,.16);
      padding-top: 1.15rem;
    }

    .sb-ribbon{
      position:absolute;
      top: 10px;
      right: 10px;
      padding: .22rem .55rem;
      border-radius: 999px;
      border: 1px solid rgba(105,190,40,.50);
      background: rgba(105,190,40,.12);
      color: rgba(0,34,68,.96);
      font-weight: 1000;
      letter-spacing: .04em;
      font-size: .78rem;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .6rem;
    }

    .week {
      font-weight: 900;
      color: var(--navy);
      display:flex;
      align-items:center;
      gap:.5rem;
      flex-wrap: wrap;
      min-width: 0;
    }

    .date { color: rgba(15,23,32,.65); font-weight: 700; }

    .week-link{
      color: inherit;
      text-decoration: underline;
      font-weight: 1000;
      white-space: nowrap; /* prevents Wild Card breaking into 3 lines */
    }
    .week-link:hover{ opacity: .85; }

    .round-badge{
      display:inline-flex;
      align-items:center;
      padding: .18rem .5rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.14);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.88);
      font-weight: 900;
      font-size: .78rem;
      white-space: nowrap;
    }

    .round-badge--sb{
      border-color: rgba(105,190,40,.45);
      background: rgba(105,190,40,.10);
    }

    .matchup {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .55rem;
      padding: .2rem 0 .65rem;
    }

    .team {
      display: flex;
      align-items: center;
      gap: .55rem;
      justify-content: center;
    }

    .logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      display: block;
      flex: 0 0 auto;
    }

    .abbr { font-weight: 900; color: var(--navy); }
    .ha { font-size: .78rem; color: rgba(15,23,32,.55); font-weight: 800; }
    .at { font-weight: 900; color: rgba(0,34,68,.55); text-align: center; }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      margin-top: .25rem;
    }

    .status { font-weight: 900; color: rgba(0,34,68,.80); }
    .score { font-weight: 900; color: rgba(0,34,68,.90); }

    .status--sb{ color: rgba(0,34,68,.98); }
    .score--sb{ color: rgba(0,34,68,.98); }

    .card-links{
      margin-top: .65rem;
      display:flex;
      justify-content:flex-end;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      text-decoration: none;
      user-select: none;
    }
    .pill:hover{ background: rgba(0,34,68,.07); }
    .pill--ghost{ background: transparent; }

    .pill--sb{
      border-color: rgba(105,190,40,.45);
      background: rgba(105,190,40,.10);
    }
  </style>
</SeahawksLayout>
