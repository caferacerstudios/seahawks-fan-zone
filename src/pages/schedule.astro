---
import SeahawksLayout from "../layouts/SeahawksLayout.astro";
import scheduleData from "../data/nfl/seahawks.json";

const season = scheduleData?.season ?? "";
const updatedAt = scheduleData?.updatedAt ?? "";

// Accept both shapes:
// 1) { games: [...] }
// 2) { gamesRegular: [...], gamesPostseason: [...] }
const rawGames = Array.isArray(scheduleData?.games)
  ? scheduleData.games
  : Array.isArray(scheduleData?.gamesRegular) || Array.isArray(scheduleData?.gamesPostseason)
    ? [...(scheduleData.gamesRegular || []), ...(scheduleData.gamesPostseason || [])]
    : [];

// Normalize "is playoff" across possible fields
function isPlayoffGame(g) {
  const st = String(g?.seasonType ?? g?.season_type ?? "").toLowerCase();
  if (st.includes("post") || st.includes("playoff")) return true;
  if (g?.postseason === true) return true;
  if (g?.is_postseason === true) return true;
  return false;
}

const regular = rawGames.filter((g) => !isPlayoffGame(g));
const playoffs = rawGames.filter((g) => isPlayoffGame(g));

function teamAbbr(teamObj, fallback = "") {
  return String(teamObj?.abbreviation || fallback).toUpperCase();
}

function teamLogo(abbr) {
  return `/images/nfl/teams/${abbr}.png`;
}

function isSeahawksWin(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  const hs = Number(game?.home_team_score);
  const as = Number(game?.visitor_team_score);

  if (!Number.isFinite(hs) || !Number.isFinite(as)) return null;

  const seaIsHome = home === "SEA";
  const seaIsAway = away === "SEA";
  if (!seaIsHome && !seaIsAway) return null;

  const seaScore = seaIsHome ? hs : as;
  const oppScore = seaIsHome ? as : hs;

  if (seaScore === oppScore) return null;
  return seaScore > oppScore;
}

function fmtPT(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  try {
    return d.toLocaleString("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "short",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  } catch {
    return d.toISOString();
  }
}

function statusText(game) {
  const s = String(game?.status || "").toLowerCase();
  if (s.includes("final")) return "Final";
  if (s.includes("in progress")) return "Live";
  if (s.includes("scheduled")) return "Scheduled";
  return game?.status || "";
}

function scoreText(game) {
  const hs = game?.home_team_score;
  const as = game?.visitor_team_score;

  if (hs === null || hs === undefined || as === null || as === undefined) return "TBD";

  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);

  if (home === "SEA") return `${hs} : ${as}`;
  if (away === "SEA") return `${as} : ${hs}`;
  return `${as} : ${hs}`;
}

function oppAbbr(game) {
  const home = teamAbbr(game?.home_team);
  const away = teamAbbr(game?.visitor_team);
  return home === "SEA" ? away : home;
}

function seaIsHome(game) {
  return teamAbbr(game?.home_team) === "SEA";
}

function gameKey(g, idx) {
  return String(g?.id ?? g?.game_id ?? idx);
}

function gameHref(g, idx) {
  return `/games/${encodeURIComponent(gameKey(g, idx))}`;
}

// Sort by date, then by week as a fallback
function sortByDate(a, b) {
  const ad = a?.date ? new Date(a.date).getTime() : 0;
  const bd = b?.date ? new Date(b.date).getTime() : 0;
  if (ad !== bd) return ad - bd;
  const aw = Number(a?.week);
  const bw = Number(b?.week);
  if (Number.isFinite(aw) && Number.isFinite(bw)) return aw - bw;
  return 0;
}

regular.sort(sortByDate);
playoffs.sort(sortByDate);

const fmtUpdatedLine = updatedAt
  ? new Date(updatedAt).toLocaleString("en-US", { timeZone: "America/Los_Angeles" }) + " PT"
  : "—";
---

<SeahawksLayout
  title={`Seahawks Schedule (${season})`}
  description="Season results and upcoming games"
  activePath="/schedule"
>
  <div class="meta-line">
    <span><strong>Season:</strong> {season}</span>
    <span class="dot">•</span>
    <span><strong>Updated:</strong> {fmtUpdatedLine}</span>
  </div>

  <h3 class="section-title">Regular season</h3>

  {regular.length === 0 ? (
    <div class="empty">No regular season games found in the current data file.</div>
  ) : (
    <div class="cards-grid">
      {regular.map((g, i) => {
        const opp = oppAbbr(g);
        const win = isSeahawksWin(g);
        const cardClass =
          win === true ? "card card--win" : win === false ? "card card--loss" : "card";

        return (
          <article class={cardClass}>
            <div class="card-top">
              <div class="week">
                <a class="week-link" href={gameHref(g, i)} aria-label={`Open recap for week ${g?.week ?? ""}`}>
                  {Number.isFinite(Number(g?.week)) ? `Week ${g.week}` : String(g?.week || "")}
                </a>
              </div>
              <div class="date">{fmtPT(g?.date)}</div>
            </div>

            <div class="matchup">
              <div class="team">
                <img class="logo" src={teamLogo("SEA")} alt="SEA logo" loading="lazy" />
                <div class="abbr">SEA</div>
                <div class="ha">{seaIsHome(g) ? "H" : "A"}</div>
              </div>

              <div class="at">@</div>

              <div class="team">
                <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} loading="lazy" />
                <div class="abbr">{opp}</div>
                <div class="ha">{seaIsHome(g) ? "A" : "H"}</div>
              </div>
            </div>

            <div class="card-bottom">
              <div class="status">{statusText(g)}</div>
              <div class="score">{scoreText(g)}</div>
            </div>

            <div class="card-links">
              <a class="pill pill--ghost" href={gameHref(g, i)}>Recap →</a>
            </div>
          </article>
        );
      })}
    </div>
  )}

  {playoffs.length > 0 && (
    <>
      <h3 class="section-title" style="margin-top: 1.5rem;">Playoffs</h3>
      <div class="cards-grid">
        {playoffs.map((g, i) => {
          const opp = oppAbbr(g);
          const win = isSeahawksWin(g);
          const cardClass =
            win === true ? "card card--win" : win === false ? "card card--loss" : "card";

          // Use offset so keys/hrefs don’t collide with regular index if fallback-id is used
          const idx = regular.length + i;

          return (
            <article class={cardClass}>
              <div class="card-top">
                <div class="week">
                  <a class="week-link" href={gameHref(g, idx)} aria-label={`Open recap for playoffs week ${g?.week ?? ""}`}>
                    {Number.isFinite(Number(g?.week)) ? `Playoffs Week ${g.week}` : "Playoffs"}
                  </a>
                </div>
                <div class="date">{fmtPT(g?.date)}</div>
              </div>

              <div class="matchup">
                <div class="team">
                  <img class="logo" src={teamLogo("SEA")} alt="SEA logo" loading="lazy" />
                  <div class="abbr">SEA</div>
                  <div class="ha">{seaIsHome(g) ? "H" : "A"}</div>
                </div>

                <div class="at">@</div>

                <div class="team">
                  <img class="logo" src={teamLogo(opp)} alt={`${opp} logo`} loading="lazy" />
                  <div class="abbr">{opp}</div>
                  <div class="ha">{seaIsHome(g) ? "A" : "H"}</div>
                </div>
              </div>

              <div class="card-bottom">
                <div class="status">{statusText(g)}</div>
                <div class="score">{scoreText(g)}</div>
              </div>

              <div class="card-links">
                <a class="pill pill--ghost" href={gameHref(g, idx)}>Recap →</a>
              </div>
            </article>
          );
        })}
      </div>
    </>
  )}

  <style>
    /* ✅ prevent grid/flex overflow */
    .meta-line,
    .cards-grid,
    .card,
    .card-top,
    .matchup,
    .team,
    .card-bottom,
    .week,
    .date,
    .status,
    .score,
    .card-links {
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    /* ✅ wrap text safely */
    .meta-line,
    .week,
    .date,
    .status,
    .score,
    .empty,
    .section-title {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: rgba(15,23,32,.65);
      margin: .35rem 0 1rem;
      flex-wrap: wrap;
    }

    .dot { opacity: .5; }

    .section-title {
      color: var(--navy);
      margin: 0.75rem 0 0.7rem;
    }

    .empty {
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.14);
      background: rgba(165,172,175,0.18);
      color: rgba(15,23,32,0.85);
      font-weight: 800;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .85rem;
      align-items: start;
    }

    /* ✅ if odd number of cards, last one spans & centers */
    .cards-grid > *:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(520px, 100%);
    }

    @media (max-width: 820px) {
      .cards-grid { grid-template-columns: 1fr; }
      .cards-grid > *:last-child:nth-child(odd) {
        grid-column: auto;
        justify-self: stretch;
        width: 100%;
      }
    }

    .card {
      border-radius: 14px;
      border: 1px solid rgba(0,34,68,0.16);
      background: #fff;
      padding: .85rem .9rem;
      box-shadow: 0 10px 22px rgba(0,0,0,.08);
      overflow: hidden;
    }

    .card--win { border-color: rgba(105,190,40,.65); box-shadow: 0 10px 22px rgba(105,190,40,.12); }
    .card--loss { border-color: rgba(220,38,38,.45); box-shadow: 0 10px 22px rgba(220,38,38,.10); }

    .card-top {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .55rem;
      border-bottom: 1px solid rgba(0,34,68,.10);
      margin-bottom: .6rem;
    }

    .week { font-weight: 900; color: var(--navy); }
    .date { color: rgba(15,23,32,.65); font-weight: 700; }

    .week-link{
      color: inherit;
      text-decoration: underline;
      font-weight: 900;
    }
    .week-link:hover{ opacity: .85; }

    .matchup {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .55rem;
      padding: .2rem 0 .65rem;
    }

    .team {
      display: flex;
      align-items: center;
      gap: .55rem;
      justify-content: center;
    }

    .logo {
      width: 28px;
      height: 28px;
      object-fit: contain;
      display: block;
      flex: 0 0 auto;
    }

    .abbr { font-weight: 900; color: var(--navy); }
    .ha { font-size: .78rem; color: rgba(15,23,32,.55); font-weight: 800; }
    .at { font-weight: 900; color: rgba(0,34,68,.55); text-align: center; }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      margin-top: .25rem;
    }

    .status { font-weight: 900; color: rgba(0,34,68,.80); }
    .score { font-weight: 900; color: rgba(0,34,68,.90); }

    .card-links{
      margin-top: .65rem;
      display:flex;
      justify-content:flex-end;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      padding:.38rem .6rem;
      border-radius: 999px;
      border: 1px solid rgba(0,34,68,.16);
      background: rgba(0,34,68,.04);
      color: rgba(0,34,68,.86);
      font-weight: 900;
      text-decoration: none;
      user-select: none;
    }
    .pill:hover{ background: rgba(0,34,68,.07); }
    .pill--ghost{ background: transparent; }
  </style>
</SeahawksLayout>


