---
import TeamMark from "./TeamMark.astro";
import { groupScheduleMonths, scheduleRow } from "../lib/schedule-display.mjs";
import { gameCalendar } from "../lib/game-day.mjs";

const { sections, nextGameId, canonicalBase } = Astro.props;
const slug = (value) => String(value).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<nav class="phase-jumps" aria-label="Jump to schedule phase">
  {sections.map((section) => <a href={`#${section.id}`}>{section.label}<span>{section.games.length}</span></a>)}
</nav>

{sections.map((section) => <section class="schedule-phase" id={section.id} aria-labelledby={`${section.id}-title`}>
  <header class="phase-title"><h2 id={`${section.id}-title`}>{section.label}</h2><span>{section.games.length} {section.games.length === 1 ? "week" : "weeks"}</span></header>
  {section.games.length ? groupScheduleMonths(section.games).map((group, groupIndex) => {
    const monthId = `${section.id}-${slug(group.label)}-${groupIndex}`;
    return <section class="month-group" aria-labelledby={monthId}>
      <h3 id={monthId}>{group.label}</h3>
      <div class="schedule-grid" role="table" aria-label={`${section.label}, ${group.label}`}>
        <div class="schedule-head" role="row">
          <span role="columnheader">Week</span><span role="columnheader">Day & date</span><span role="columnheader">Opponent</span>
          <span role="columnheader">Kickoff</span><span role="columnheader">TV / stream</span><span role="columnheader">Venue</span>
          <span role="columnheader">Status / result</span><span role="columnheader">Action</span>
        </div>
        <div role="rowgroup">
          {group.games.map((game, index) => {
            const row = scheduleRow(game, { nextGameId, index });
            const calendar = gameCalendar(game, canonicalBase);
            const copyText = [row.week, `${row.homeAwayLabel}: ${row.opponentName}`, `${row.date}, ${row.kickoff}`, row.network && `Watch: ${row.network}`, row.venue && `Venue: ${row.venue}`, row.resultLabel].filter(Boolean).join(" · ");
            return row.kind === "bye" ? <div class="schedule-row bye-row" role="row" data-state="bye">
              <div class="week-status" role="cell"><strong>{row.week}</strong><span class="state-badge">Bye</span></div>
              <div class="bye-message" role="cell"><strong>Bye week</strong><span>{row.detail}</span></div>
            </div> : <article class:list={["schedule-row", `state-${row.state}`]} role="row" data-state={row.state}>
              <div class="week-status" role="cell" data-label="Week"><strong>{row.week}</strong><span class="mobile-state">{row.stateLabel}</span></div>
              <div class="date-cell" role="cell" data-label="Day and date">{row.date}</div>
              <div class="opponent-cell" role="cell" data-label={row.homeAwayLabel}>
                <TeamMark abbreviation={row.opponentAbbr} name={row.opponentName} size={40} decorative loading="lazy" />
                <div><span class="location-word"><span class="sr-only">{row.homeAwayLabel}, </span>{row.homeAway}</span><strong>{row.opponentName}</strong><div class="badges">{row.division && <span>Division</span>}{row.primeTime && <span>Prime Time</span>}</div></div>
              </div>
              <div class="kickoff-cell" role="cell" data-label="Kickoff">{row.kickoff}</div>
              <div class="network-cell" role="cell" data-label={row.network ? "TV or stream" : undefined}>{row.network}</div>
              <div class="venue-cell" role="cell" data-label={row.venue ? "Venue" : undefined}>{row.venue}</div>
              <div class="result-cell" role="cell" data-label="Status or result">{row.result && <span class:list={["result-mark", `result-${row.result.outcome.toLowerCase()}`]}>{row.result.outcome}</span>}<strong>{row.resultLabel ?? row.stateLabel}</strong>{row.record && <small>Record {row.record}</small>}</div>
              <div class="action-cell" role="cell">
                <a href={row.href} rel={/^https?:/.test(row.href) ? "noopener noreferrer" : undefined}>{row.action}<span aria-hidden="true"> →</span></a>
                <details class="more-actions"><summary aria-label={`More actions for Seahawks ${row.homeAway === "vs" ? "versus" : "at"} ${row.opponentName}`}>More</summary><div>
                  {calendar.enabled && <a href={calendar.href} download={calendar.filename}>Add this game to calendar</a>}
                  <button type="button" class="copy-game" data-copy={copyText}>Copy game information</button>
                  {row.venueUrl && <a href={row.venueUrl} target="_blank" rel="noopener noreferrer" aria-label={`Venue information for ${row.venue} (opens in a new tab)`}>Venue information</a>}
                  {row.watchUrl && <a href={row.watchUrl} target="_blank" rel="noopener noreferrer" aria-label={`Watch or listen information for Seahawks ${row.homeAway === "vs" ? "versus" : "at"} ${row.opponentName} (opens in a new tab)`}>Watch/listen information</a>}
                </div></details>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>;
  }) : <div class="empty-state"><h3>{section.id === "postseason" ? "The playoff picture is still taking shape" : `No ${section.label.toLowerCase()} games are available`}</h3><p>Games will appear here when matchups are confirmed.</p></div>}
</section>)}

<style>
  .phase-jumps{display:flex;gap:.4rem;flex-wrap:wrap;margin:1rem 0 1.35rem;padding:.35rem;background:var(--slate-300)}
  .phase-jumps a{display:flex;align-items:center;gap:.55rem;min-height:40px;padding:.45rem .7rem;background:#fff;color:var(--navy-900);font:800 .78rem var(--font-display);text-decoration:none}
  .phase-jumps a:hover,.phase-jumps a:focus-visible{background:var(--navy-800);color:#fff}.phase-jumps span{display:grid;min-width:1.35rem;height:1.35rem;place-items:center;border-radius:50%;background:#00224415;font-size:.67rem}
  .schedule-phase{scroll-margin-top:1rem}.schedule-phase+.schedule-phase{margin-top:2rem}.phase-title{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding-bottom:.45rem;border-bottom:4px solid var(--navy-800)}
  .phase-title h2{margin:0;font-size:1.35rem;text-transform:uppercase}.phase-title>span{color:var(--slate-700);font-size:.75rem;font-weight:800;text-transform:uppercase}
  .month-group{margin-top:.8rem;scroll-margin-top:1rem}.month-group h3{margin:0;padding:.34rem .6rem;background:var(--navy-800);color:#fff;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
  .schedule-grid{border:var(--border-crisp);border-top:0;background:#fff}.schedule-head,.schedule-row{display:grid;grid-template-columns:58px 88px minmax(170px,1.35fr) 74px 72px minmax(110px,1fr) 108px 68px;align-items:center}
  .schedule-head{min-height:30px;background:var(--slate-100);color:var(--slate-700);font-size:.61rem;font-weight:900;letter-spacing:.03em;text-transform:uppercase}
  .schedule-head span,.schedule-row>div{min-width:0;padding:.35rem .45rem}.schedule-row{position:relative;min-height:58px;border-top:1px solid var(--slate-300);font-size:.75rem;font-variant-numeric:tabular-nums}
  .schedule-row:first-child{border-top:0}.schedule-row::before{position:absolute;inset:0 auto 0 0;width:4px;background:var(--slate-500);content:""}.schedule-row.state-completed::before{background:var(--navy-800)}.schedule-row.state-next{background:linear-gradient(90deg,#69be2818,transparent 50%);box-shadow:inset 0 0 0 2px #69be2860}.schedule-row.state-next::before,.schedule-row.state-in_progress::before{background:var(--action-green)}.schedule-row.state-tbd{background:var(--slate-100)}
  .week-status{display:flex;gap:.2rem;flex-direction:column;padding-left:.6rem!important;color:var(--slate-700);font-size:.68rem;text-transform:uppercase}.mobile-state{display:none}.date-cell,.kickoff-cell,.network-cell{font-weight:800}.opponent-cell{display:flex;align-items:center;gap:.5rem}.opponent-cell>div{min-width:0}.opponent-cell strong{display:block;line-height:1.15}.location-word{float:left;margin-right:.25rem;color:var(--slate-700);font-size:.68rem;font-weight:900;text-transform:uppercase}.badges{display:flex;gap:.25rem;margin-top:.22rem}.badges span,.state-badge{padding:.12rem .3rem;background:#00224412;color:var(--navy-900);font-size:.58rem;font-weight:900;letter-spacing:.03em;text-transform:uppercase}.venue-cell,.network-cell{overflow-wrap:anywhere;color:var(--slate-700)}
  .result-cell{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap}.result-cell small{width:100%;color:var(--slate-700)}.result-mark{display:grid;width:1.45rem;height:1.45rem;flex:0 0 auto;place-items:center;background:var(--action-green);color:var(--navy-950);font-weight:950}.result-l{background:#9f2d27;color:#fff}.result-t{background:var(--slate-500);color:var(--navy-950)}.action-cell>a{font-weight:900;white-space:nowrap}.more-actions{position:relative;margin-top:.2rem;color:var(--slate-700);font-size:.65rem}.more-actions summary{cursor:pointer}.more-actions>div{position:absolute;z-index:3;right:0;width:190px;padding:.35rem;border:var(--border-crisp);background:#fff;box-shadow:var(--shadow-sm)}.more-actions a,.more-actions button{display:block;width:100%;padding:.4rem;border:0;background:none;color:var(--navy-900);font:700 .7rem inherit;text-align:left;text-decoration:underline;white-space:normal;cursor:pointer}.bye-row{grid-template-columns:146px 1fr;background:repeating-linear-gradient(135deg,var(--slate-100),var(--slate-100) 8px,#fff 8px,#fff 16px)}.bye-row::before{background:var(--navy-800)}.bye-message{display:flex;align-items:baseline;gap:.55rem}.bye-message span{color:var(--slate-700)}.empty-state{padding:1.25rem;border:var(--border-crisp);background:var(--slate-100);text-align:center}.empty-state h3,.empty-state p{margin:.2rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:900px){.schedule-head,.schedule-row{grid-template-columns:55px 80px minmax(160px,1.35fr) 70px 65px minmax(95px,1fr) 102px 62px}.schedule-head span,.schedule-row>div{padding:.32rem}.schedule-row{font-size:.71rem}}
  @media(max-width:820px){.phase-jumps{display:grid;grid-template-columns:repeat(3,1fr)}.phase-jumps a{justify-content:center;padding:.4rem .25rem}.schedule-head{display:none}.schedule-grid{border:0;background:transparent}.schedule-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem .75rem;margin-top:.55rem;padding:.7rem .75rem .75rem;border:var(--border-crisp)!important;background:#fff;font-size:.78rem}.schedule-row>div{padding:0}.week-status{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;flex-direction:row;padding:0!important}.mobile-state{display:inline;padding:.15rem .35rem;background:var(--slate-100);font-size:.62rem;font-weight:900}.opponent-cell{grid-column:1/-1;grid-row:2}.opponent-cell :global(.team-mark){--team-mark-size:44px!important}.opponent-cell strong{font-size:.96rem}.date-cell{grid-column:1;grid-row:3}.kickoff-cell{grid-column:2;grid-row:3;text-align:right}.network-cell{grid-column:1/-1;grid-row:4}.network-cell:not(:empty)::before{content:"Watch: ";color:var(--slate-700);font-weight:500}.venue-cell{grid-column:1/-1;grid-row:5}.venue-cell:not(:empty)::before{content:"Venue: ";font-weight:500}.result-cell{grid-column:1;grid-row:6}.action-cell{grid-column:2;grid-row:6;text-align:right}.state-upcoming .result-cell,.state-tbd .result-cell,.state-next .result-cell{display:none}.state-upcoming .action-cell,.state-tbd .action-cell,.state-next .action-cell{grid-column:1/-1}.bye-row{grid-template-columns:1fr}.bye-message{grid-column:1/-1;flex-direction:column;gap:.1rem}.schedule-phase+.schedule-phase{margin-top:1.5rem}}
  @media(max-width:360px){.phase-jumps a{font-size:.68rem}.phase-jumps span{display:none}.schedule-row{padding:.65rem}.date-cell,.kickoff-cell{font-size:.72rem}}
</style>

<script>
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest(".copy-game") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy || "");
      button.textContent = "Copied";
    } catch { button.textContent = "Copy failed"; }
  });
</script>
