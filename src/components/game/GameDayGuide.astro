---
import GuideSourceLink from "./GuideSourceLink.astro";
const { guide = null } = Astro.props;
const populated = (value) => typeof value === "string" ? value.trim().length > 0 : Array.isArray(value) ? value.length > 0 : value !== null && value !== undefined;
const entries = (value, fields) => Array.isArray(value) ? value.filter((item) => item && typeof item === "object" && fields.some((field) => populated(item[field]))) : [];
const alerts = entries(guide?.alerts, ["title", "text"]);
const transportation = entries(guide?.transportation, ["name", "recommendation", "details"]);
const parking = entries(guide?.parking, ["name", "details"]);
const timeline = entries(guide?.timeline, ["time", "event", "details"]);
const tailgates = entries(guide?.tailgates, ["name", "location", "startTime", "description", "price", "ageRestriction"]);
const watchParties = entries(guide?.watchParties, ["name", "location", "startTime", "description", "specials", "ageRestriction"]);
const stadiumTips = entries(guide?.stadiumTips, ["title", "details"]);
const weather = guide?.weather && typeof guide.weather === "object" && [guide.weather.summary, guide.weather.temperature, guide.weather.precipitationChance, guide.weather.wind].some(populated) ? guide.weather : null;
const severity = (value) => ({ critical: { key:"critical", label:"Critical" }, warning: { key:"warning", label:"Important" }, info: { key:"info", label:"Info" } }[value] ?? { key:"info", label:"Info" });
const updated = populated(guide?.lastUpdated) && !Number.isNaN(Date.parse(guide.lastUpdated))
  ? new Intl.DateTimeFormat("en-US", { month:"long", day:"numeric", year:"numeric", hour:"numeric", minute:"2-digit", timeZoneName:"short", timeZone:"America/Los_Angeles" }).format(new Date(guide.lastUpdated))
  : null;
---
<section class="detail-panel game-day-guide" aria-labelledby="game-day-guide-heading">
  <header class="guide-header">
    <h2 id="game-day-guide-heading">Game Day Guide</h2>
    {guide && updated && <p class="guide-updated">Last updated <time datetime={guide.lastUpdated}>{updated}</time></p>}
  </header>
  {!guide ? <p>Game Day Guide coming soon.</p> : <div class="guide-content">
    {populated(guide.summary) && <p class="guide-summary">{guide.summary}</p>}
    {alerts.length > 0 && <section class="guide-section alerts" aria-labelledby="guide-alerts"><h3 id="guide-alerts">Important Alerts</h3><ul class="guide-grid">{alerts.map((item) => { const level = severity(item.severity); return <li class={`guide-card alert alert-${level.key}`}><p class="alert-label">{level.label}</p>{populated(item.title) && <h4>{item.title}</h4>}{populated(item.text) && <p>{item.text}</p>}<GuideSourceLink url={item.sourceUrl} /></li>; })}</ul></section>}
    {transportation.length > 0 && <section class="guide-section" aria-labelledby="guide-transportation"><h3 id="guide-transportation">Getting There</h3><ul class="guide-grid two-column">{transportation.map((item) => <li class="guide-card">{populated(item.name) && <h4>{item.name}</h4>}{populated(item.recommendation) && <p class="recommendation">{item.recommendation}</p>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Transportation details" /></li>)}</ul></section>}
    {parking.length > 0 && <section class="guide-section" aria-labelledby="guide-parking"><h3 id="guide-parking">Parking</h3><ul class="guide-grid two-column">{parking.map((item) => <li class="guide-card">{populated(item.name) && <h4>{item.name}</h4>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Parking details" /></li>)}</ul></section>}
    {timeline.length > 0 && <section class="guide-section" aria-labelledby="guide-timeline"><h3 id="guide-timeline">Game Day Timeline</h3><ol class="timeline">{timeline.map((item) => <li><p class="timeline-time">{item.time}</p><div>{populated(item.event) && <h4>{item.event}</h4>}{populated(item.details) && <p>{item.details}</p>}</div></li>)}</ol></section>}
    {tailgates.length > 0 && <section class="guide-section" aria-labelledby="guide-tailgates"><h3 id="guide-tailgates">Tailgates &amp; Pregame</h3><ul class="guide-grid two-column">{tailgates.map((item) => <li class="guide-card">{item.official === true && <p class="official-label">Official Seahawks Event</p>}{populated(item.name) && <h4>{item.name}</h4>}{populated(item.location) && <p><strong>Location:</strong> {item.location}</p>}{populated(item.startTime) && <p><strong>Starts:</strong> {item.startTime}</p>}{populated(item.description) && <p>{item.description}</p>}{typeof item.price === "number" && <p><strong>Price:</strong> ${item.price}</p>}{populated(item.ageRestriction) && <p><strong>Age restriction:</strong> {item.ageRestriction}</p>}<GuideSourceLink url={item.sourceUrl} label="Event details" /></li>)}</ul></section>}
    {watchParties.length > 0 && <section class="guide-section" aria-labelledby="guide-watch-parties"><h3 id="guide-watch-parties">Watch Parties</h3><ul class="guide-grid two-column">{watchParties.map((item) => { const specials = Array.isArray(item.specials) ? item.specials.filter(populated) : []; return <li class="guide-card">{populated(item.name) && <h4>{item.name}</h4>}{populated(item.location) && <p><strong>Location:</strong> {item.location}</p>}{populated(item.startTime) && <p><strong>Starts:</strong> {item.startTime}</p>}{populated(item.description) && <p>{item.description}</p>}{specials.length > 0 && <div><h5>Specials</h5><ul class="specials">{specials.map((special) => <li>{special}</li>)}</ul></div>}{populated(item.ageRestriction) && <p><strong>Age restriction:</strong> {item.ageRestriction}</p>}<GuideSourceLink url={item.sourceUrl} label="Event details" /></li>; })}</ul></section>}
    {stadiumTips.length > 0 && <section class="guide-section" aria-labelledby="guide-stadium-tips"><h3 id="guide-stadium-tips">Stadium Tips</h3><ul class="guide-grid two-column">{stadiumTips.map((item) => <li class="guide-card">{populated(item.title) && <h4>{item.title}</h4>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Official information" /></li>)}</ul></section>}
    {weather && <section class="guide-section" aria-labelledby="guide-weather"><h3 id="guide-weather">Weather</h3><div class="guide-card weather">{populated(weather.summary) && <p>{weather.summary}</p>}<dl>{populated(weather.temperature) && <div><dt>Temperature</dt><dd>{weather.temperature}</dd></div>}{populated(weather.precipitationChance) && <div><dt>Precipitation</dt><dd>{weather.precipitationChance}</dd></div>}{populated(weather.wind) && <div><dt>Wind</dt><dd>{weather.wind}</dd></div>}</dl><GuideSourceLink url={weather.sourceUrl} label="Forecast source" /></div></section>}
  </div>}
</section>

<style>
  .game-day-guide{grid-column:1/-1}.guide-header{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;flex-wrap:wrap}.guide-header h2{margin-bottom:0}.guide-updated{margin:0!important;color:var(--muted);font-size:.75rem;font-weight:800;text-transform:uppercase}.guide-summary{max-width:72rem;margin:1rem 0 0;font-size:1.02rem}.guide-section{margin-top:1.5rem}.guide-section>h3{margin:0 0 .75rem;color:var(--navy);font-size:1.2rem}.guide-grid{display:grid;gap:.75rem;margin:0!important;padding:0!important;list-style:none}.guide-grid.two-column{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-card{min-width:0;padding:1rem;border:1px solid var(--line);border-radius:.65rem;background:#fff;box-shadow:0 2px 8px rgba(0,34,68,.05)}.guide-card h4{margin:0 0 .45rem;color:var(--navy);font-size:1.02rem}.guide-card h5{margin:.75rem 0 .3rem;font-size:.9rem}.guide-card p{margin:.35rem 0!important}.recommendation{padding-left:.65rem;border-left:3px solid var(--green);font-weight:800}.guide-source{display:inline-flex;min-height:40px;align-items:center;margin-top:.45rem;color:#174f79;font-size:.85rem;font-weight:800}.alert{border-left:5px solid #4d718f}.alert-warning{border-left-color:#b36b00;background:#fffaf0}.alert-critical{border-left-width:7px;border-left-color:#a61b1b;background:#fff5f5}.alert-label,.official-label{display:inline-block;margin:0 0 .45rem!important;padding:.18rem .45rem;border-radius:.25rem;background:#e8eef3;color:#173b5a;font-size:.72rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.alert-warning .alert-label{background:#f7dfb8;color:#714100}.alert-critical .alert-label{background:#a61b1b;color:#fff}.official-label{background:#e4f3d8;color:#245f12}.timeline{margin:0;padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:minmax(7.5rem,10rem) 1fr;gap:1rem;padding:.8rem 0;border-top:1px solid var(--line)}.timeline li:last-child{border-bottom:1px solid var(--line)}.timeline-time{margin:0!important;color:var(--navy);font-weight:900}.timeline h4{margin:0;font-size:1rem}.timeline div p{margin:.2rem 0 0!important}.specials{margin:.25rem 0 0!important;padding-left:1.1rem!important}.weather dl{display:grid;gap:.6rem;margin:.8rem 0}.weather dl div{display:grid;grid-template-columns:minmax(7rem,9rem) 1fr;gap:.75rem}.weather dt{font-weight:900}.weather dd{margin:0}@media(max-width:700px){.guide-grid.two-column{grid-template-columns:1fr}.timeline li{grid-template-columns:1fr;gap:.15rem}.weather dl div{grid-template-columns:1fr;gap:.1rem}}@media(max-width:600px){.game-day-guide{padding:1rem}.guide-card{padding:.85rem}.guide-summary{font-size:.96rem}}
</style>
