---
import type { NewsArticle } from "../lib/news";
import { categorySlug, formatArticleDate } from "../lib/news";

interface Props { article: NewsArticle; prominent?: boolean; }
const { article, prominent = false } = Astro.props;
---
<article class:list={["news-card", { "news-card--prominent": prominent }]} data-news-card data-search={`${article.headline} ${article.dek} ${article.category} ${article.tags.join(" ")}`.toLowerCase()}>
  {prominent && <img src={article.hero.src} alt={article.hero.alt} width={article.hero.width} height={article.hero.height} loading="eager" decoding="async" />}
  <div class="news-card__body">
    <a class="news-card__category" href={`/news/category/${categorySlug(article.category)}/`}>{article.category}</a>
    <h3><a href={`/news/${article.slug}/`}>{article.headline}</a></h3>
    <p>{article.dek}</p>
    <div class="news-card__meta"><time datetime={article.publishedAt}>{formatArticleDate(article.publishedAt)}</time><span>By {article.author}</span></div>
  </div>
</article>
<style>
  .news-card{border:1px solid #c7d1d6;background:#fff;box-shadow:var(--shadow-sm)}.news-card__body{padding:1rem}.news-card__category{color:#386f13;font:900 .72rem var(--font-display);letter-spacing:.08em;text-transform:uppercase}.news-card h3{margin:.35rem 0;font:900 1.35rem/1.05 var(--font-display)}.news-card h3 a{color:var(--navy-900);text-decoration:none}.news-card p{margin:.55rem 0;color:var(--slate-700)}.news-card__meta{display:flex;flex-wrap:wrap;gap:.25rem 1rem;padding-top:.6rem;border-top:1px solid #d8dfe3;color:var(--slate-700);font-size:.75rem}.news-card--prominent{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(240px,1fr);background:var(--navy-950);border:0}.news-card--prominent img{width:100%;height:100%;min-height:300px;object-fit:cover}.news-card--prominent .news-card__body{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.2rem,4vw,2.2rem)}.news-card--prominent h3{font-size:clamp(2rem,5vw,3.5rem)}.news-card--prominent h3 a,.news-card--prominent p{color:#fff}.news-card--prominent .news-card__meta{color:var(--slate-300);border-color:#ffffff30}@media(max-width:680px){.news-card--prominent{grid-template-columns:1fr}.news-card--prominent img{min-height:180px;aspect-ratio:16/9}}
</style>
