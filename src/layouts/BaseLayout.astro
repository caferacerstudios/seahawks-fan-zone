---
import type { SeoMetadata } from "../lib/seo";
import { absoluteUrl, pageMetadata, SITE_NAME } from "../lib/seo";

const props = Astro.props as { seo?: SeoMetadata; title?: string; description?: string; canonical?: string; robots?: string; article?: any; structuredData?: object | object[] };
const routeSeo = pageMetadata(Astro.url.pathname);
const seo: SeoMetadata = props.seo ?? {
  title: props.title ?? routeSeo?.title ?? SITE_NAME,
  description: props.description ?? routeSeo?.description ?? "Independent Seattle Seahawks statistics, schedules, recaps, and history.",
  canonicalPath: props.canonical ?? routeSeo?.canonicalPath ?? Astro.url.pathname,
  robots: props.robots ?? routeSeo?.robots,
  article: props.article,
};
const canonicalUrl = absoluteUrl(seo.canonicalPath);
const article = seo.article ?? props.article;
const structuredData = props.structuredData;
const jsonLd = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{seo.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots ?? "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={seo.openGraphTitle ?? seo.title} />
    <meta property="og:description" content={seo.openGraphDescription ?? seo.description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    {seo.openGraphImage && <meta property="og:image" content={absoluteUrl(seo.openGraphImage)} />}
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />)}

    <!-- Impact site verification -->
    <meta
      name="impact-site-verification"
      value="2e6bc996-daec-4978-9c6b-7be402806885"
    />

    <!-- Site CSS -->
    <link rel="stylesheet" href="/styles/main.css" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6319637311271773"
     crossorigin="anonymous"
    ></script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />

    <!-- Cloudflare Insights beacon -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015"
      integrity="sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ=="
      data-cf-beacon='{"version":"2024.11.0","token":"801357a12d58445c9921f3793c929ed9","r":1,"server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}'
      crossorigin="anonymous"
    ></script>
  </body>
</html>
