---
const {
  title = "Seahawks Fan Zone",
  description = "",
  pageTitle = title,
  pageTagline = description,
  activePath = "",
  // allow overrides, but provide defaults
  navPages = [
    { href: "/", label: "Home" },
    { href: "/schedule", label: "Schedule" },
    { href: "/weekly-recap", label: "Weekly Recap" },
    { href: "/standings", label: "Standings" },
    { href: "/team", label: "Team Stats" },
    { href: "/players", label: "Players" },
    { href: "/about", label: "About" },
  ],
  quickLinks = [],
  rightLinks = [],
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Impact site verification -->
    <meta
      name="impact-site-verification"
      value="2e6bc996-daec-4978-9c6b-7be402806885"
    />

    <!-- Site CSS -->
    <link rel="stylesheet" href="/styles/main.css" />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6319637311271773"
      crossorigin="anonymous"
    ></script>
  </head>

  <body>
    <header class="lr-header seahawks-header">
      <div class="lr-header-bg seahawks-header-bg" aria-hidden="true"></div>

      <div class="lr-header-inner">
        <h1 class="lr-site-title">Seahawks Fan Zone</h1>
        <p class="lr-site-tagline">{pageTagline}</p>

        <nav class="top-nav" aria-label="Primary">
          {navPages.map((p) => (
            <a
              class="top-nav-link"
              href={p.href}
              aria-current={activePath === p.href ? "page" : undefined}
            >
              {p.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <div class="lr-middle">
      <aside class="lr-sidebar lr-sidebar-left">
        <section class="lr-panel">
          <h3 class="lr-panel-title">Quick links</h3>
          <ul class="lr-nav lr-subnav">
            {(quickLinks.length
              ? quickLinks
              : [
                  { href: "/schedule", label: "Schedule" },
                  { href: "/team", label: "Team Stats" },
                  { href: "/players", label: "Player Stats" },
                  { href: "/methodology", label: "Methodology" },
                ]
            ).map((x) => (
              <li><a href={x.href}>{x.label}</a></li>
            ))}
          </ul>
        </section>

        <section class="lr-panel">
          <h3 class="lr-panel-title">Site</h3>
          <ul class="lr-nav">
            <li><a href="/privacy-policy">Privacy Policy</a></li>
            <li><a href="/methodology">Methodology</a></li>
            <li><a href="/disclosure">Disclosure</a></li>
          </ul>
        </section>
      </aside>

      <main class="lr-main">
        <article class="lr-paper seahawks-paper">
          <header class="lr-post-header">
            <h2 class="lr-post-title">{pageTitle}</h2>
          </header>

          <div class="lr-post-content">
            <slot />
          </div>
        </article>

        <footer class="lr-footer">
          <a href="/about">About</a> · <a href="/privacy-policy">Privacy Policy</a> ·{" "}
          <a href="/methodology">Methodology</a> · <a href="/disclosure">Disclosure</a>

          <div class="lr-footer-note">
            Seahawks Fan Zone is an independent fan site and is not affiliated with the NFL or the Seattle Seahawks.
          </div>

          <div class="lr-copyright">
            &copy; {new Date().getFullYear()} seahawksfanzone
          </div>
        </footer>
      </main>

      <aside class="lr-sidebar lr-sidebar-right">
        <section class="lr-panel">
          <h3 class="lr-panel-title">Popular</h3>
          <ul class="lr-nav">
            {(rightLinks.length
              ? rightLinks
              : [
                  { href: "/schedule", label: "Schedule" },
                  { href: "/players", label: "Player leaders (soon)" },
                  { href: "/team", label: "Team totals" },
                ]
            ).map((x) => (
              <li><a href={x.href}>{x.label}</a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>

    <!-- Cloudflare Insights beacon -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015"
      integrity="sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ=="
      data-cf-beacon='{"version":"2024.11.0","token":"801357a12d58445c9921f3793c929ed9","r":1,"server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}'
      crossorigin="anonymous"
    ></script>
  </body>
</html>

