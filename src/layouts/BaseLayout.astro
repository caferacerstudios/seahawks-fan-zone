---
const { title = "Seahawks Fan Zone", description = "", canonical, article, structuredData, pageType, season, opponent, articleCategory } = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.site ?? Astro.url).toString() : null;
const analyticsExcludedHosts = String(import.meta.env.PUBLIC_ANALYTICS_EXCLUDE_HOSTS || "").split(",").map((host) => host.trim().toLowerCase()).filter(Boolean);
const analyticsProduction = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}

    <!-- Impact site verification -->
    <meta
      name="impact-site-verification"
      value="2e6bc996-daec-4978-9c6b-7be402806885"
    />

    <!-- Site CSS -->
    <link rel="stylesheet" href="/styles/main.css" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6319637311271773"
     crossorigin="anonymous"
    ></script>
  </head>

  <body data-page-type={pageType} data-season={season} data-opponent={opponent} data-article-category={articleCategory}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />

    <script src="../lib/analytics.ts"></script>
    <script is:inline define:vars={{ analyticsExcludedHosts, analyticsProduction }}>
      (() => {
        const consent = () => window.sfzConsent?.analytics === true || (() => { try { const value = JSON.parse(localStorage.getItem('sfz-consent') || localStorage.getItem('sfz_consent') || 'false'); return value === true || value?.analytics === true; } catch { return false; } })();
        const load = () => {
          const host = location.hostname.toLowerCase();
          if (!analyticsProduction || !consent() || document.querySelector('[data-cf-beacon]') || /^(localhost|127\.0\.0\.1|::1)$/.test(host) || analyticsExcludedHosts.some((entry) => host === entry || host.endsWith(`.${entry}`))) return;
          const script = document.createElement('script'); script.defer = true; script.src = 'https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015'; script.integrity = 'sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ=='; script.crossOrigin = 'anonymous'; script.dataset.cfBeacon = JSON.stringify({ version: '2024.11.0', token: '801357a12d58445c9921f3793c929ed9', r: 1 }); document.body.append(script);
        };
        load(); window.addEventListener('sfz:consent-change', (event) => { if (typeof event.detail?.analytics === 'boolean') window.sfzConsent = { ...(window.sfzConsent || {}), analytics: event.detail.analytics }; load(); });
      })();
    </script>
  </body>
</html>
