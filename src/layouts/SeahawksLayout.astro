---
import BaseLayout from "./BaseLayout.astro";
import { absoluteUrl, pageMetadata, SITE_NAME } from "../lib/seo";

const {
  title = "Seahawks Fan Zone",
  description = "Schedule, team stats, and player stats.",
  pageTitle = title,
  pageTagline = description,
  activePath = "",
  quickLinks = [],
  rightLinks = [],
  showPageHeader = true,
  canonical,
  article,
  structuredData,
  monetizationEligible = true,
  pageType,
  season,
  opponent,
  articleCategory,
  seo,
  breadcrumbs,
} = Astro.props;
const nonMonetizedPaths = new Set(["/privacy-policy", "/disclosure", "/404"]);
const pageCanBeMonetized = monetizationEligible && !nonMonetizedPaths.has(Astro.url.pathname.replace(/\/$/, "") || "/");

const resolvedSeo = seo ?? pageMetadata(Astro.url.pathname) ?? { title, description, canonicalPath: canonical ?? Astro.url.pathname, article };
const fallbackCrumbs = Astro.url.pathname === "/" ? [] : [{ name: "Home", href: "/" }, { name: resolvedSeo.title.replace(/\s*\|.*$/, ""), href: resolvedSeo.canonicalPath }];
const visualCrumbs = (breadcrumbs?.length ? breadcrumbs : fallbackCrumbs).filter((crumb) => crumb?.name && crumb?.href);
const crumbs = visualCrumbs.map((crumb, index) => ({ "@type": "ListItem", position: index + 1, name: crumb.name, item: absoluteUrl(crumb.href) }));
const baseStructuredData = [
  ...(Astro.url.pathname === "/" ? [{ "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, url: absoluteUrl("/") }] : []),
  ...(crumbs.length ? [{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs }] : []),
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];

let latestRecapHref = "/weekly-recap";
try {
  const schedule = (await import("../data/nfl/seahawks.json")).default;
  const recaps = (await import("../data/nfl/gameRecaps.json")).default?.recaps ?? {};
  const games = [...(schedule?.gamesPreseason ?? []), ...(schedule?.gamesRegular ?? []), ...(schedule?.gamesPostseason ?? []), ...(schedule?.games ?? [])];
  const latest = games.filter((game) => /final|finished|complete/i.test(String(game?.status ?? "")) && recaps[String(game?.id ?? game?.game_id)]).sort((a, b) => new Date(b?.date ?? 0).getTime() - new Date(a?.date ?? 0).getTime())[0];
  if (latest) latestRecapHref = `/games/${encodeURIComponent(String(latest?.id ?? latest?.game_id))}`;
} catch {}

const navPages = [
  { href: "/", label: "Home" },
  { href: "/news", label: "News" },
  { href: "/schedule", label: "Schedule" },
  { href: latestRecapHref, label: "Latest Recap", activeHref: "/weekly-recap" },
  { href: "/news/around-the-web", label: "Around the Web" },
  { href: "/standings", label: "Standings" },
  { href: "/team", label: "Team Stats" },
  { href: "/players", label: "Players" },
  { href: "/team/transactions", label: "Moves" },
  { href: "/history", label: "History & The 12s" },
  { href: "/about", label: "About" },
];
---

<BaseLayout
  seo={resolvedSeo}
  article={resolvedSeo.article ?? article}
  structuredData={baseStructuredData}
  monetizationEligible={pageCanBeMonetized}
  {pageType}
  {season}
  {opponent}
  {articleCategory}
>
  <header class="lr-header seahawks-header">
    <div class="lr-header-bg seahawks-header-bg" aria-hidden="true"></div>

    <div class="lr-header-inner">
      <a class="sfz-brand" href="/" aria-label="Seahawks Fan Zone home">
        <span class="sfz-mark" aria-hidden="true"><span>SFZ</span></span>
        <span class="sfz-brand-copy"><span class="lr-site-title">Seahawks Fan Zone</span><span class="lr-site-tagline">Independent coverage · Pacific Northwest</span></span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open primary navigation">
        <span class="nav-toggle-label">Menu</span><span class="nav-toggle-icon" aria-hidden="true"></span>
      </button>

      <nav class="top-nav" id="primary-nav" aria-label="Primary">
        {navPages.map((p) => (
          <a
            class="top-nav-link"
            href={p.href}
            aria-current={activePath === (p.activeHref ?? p.href) ? "page" : undefined}
          >
            {p.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <div class="lr-middle">
    <aside class="lr-sidebar lr-sidebar-left">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Quick links</h3>
        <ul class="lr-nav lr-subnav">
          {(quickLinks.length ? quickLinks : [
            { href: "/news", label: "Newsroom" },
            { href: "/weekly-recap", label: "Recap archive" },
            { href: "/schedule", label: "Schedule" },
            { href: "/team", label: "Team Stats" },
            { href: "/players", label: "Player Stats" },
            { href: "/team/transactions", label: "Transactions" },
            { href: "/team/injuries", label: "Injuries & Status" },
            { href: "/history", label: "History & The 12s" },
            { href: "/methodology", label: "Methodology" },
          ]).map((x) => (
            <li><a href={x.href}>{x.label}</a></li>
          ))}
        </ul>
      </section>

      <section class="lr-panel">
        <h3 class="lr-panel-title">Site</h3>
        <ul class="lr-nav">
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/methodology">Methodology</a></li>
        </ul>
      </section>
    </aside>

    <main class="lr-main" id="main-content" tabindex="-1">
      <article class="lr-paper seahawks-paper">
        {visualCrumbs.length > 0 && <nav aria-label="Breadcrumb"><ol class="seo-breadcrumbs">{visualCrumbs.map((crumb, index) => <li aria-current={index === visualCrumbs.length - 1 ? "page" : undefined}>{index === visualCrumbs.length - 1 ? crumb.name : <a href={crumb.href}>{crumb.name}</a>}</li>)}</ol></nav>}
        {showPageHeader && <header class="lr-post-header">
          <p class="page-eyebrow">Seahawks Fan Zone</p>
          <h1 class="lr-post-title">{pageTitle}</h1>
          {pageTagline && <p class="page-deck">{pageTagline}</p>}
        </header>}

        <div class="lr-post-content">
          <slot />
        </div>
      </article>

    </main>

    <aside class="lr-sidebar lr-sidebar-right">
      <section class="lr-panel">
        <h3 class="lr-panel-title">Popular</h3>
        <ul class="lr-nav">
          {(rightLinks.length ? rightLinks : [
            { href: "/schedule", label: "Schedule" },
            { href: "/players", label: "Players" },
            { href: "/team", label: "Team totals" },
          ]).map((x) => (
            <li><a href={x.href}>{x.label}</a></li>
          ))}
        </ul>
      </section>
    </aside>
  </div>

  <footer class="lr-footer">
    <div class="footer-inner">
      <div class="footer-brand"><span class="footer-mark">SFZ</span><span>Independent football coverage for the 12s.</span></div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/disclosure">Disclosure</a><a href="/methodology">Methodology</a><a href="/about#contact">Contact</a><a href="/sources">Data updates</a><a href="/privacy-policy">Privacy</a><a href="#" data-manage-privacy>Manage Privacy Choices</a>
      </nav>
      <p class="lr-footer-note">Seahawks Fan Zone is an independent fan site and is not affiliated with the NFL or the Seattle Seahawks. Data refreshes during scheduled site builds.</p>
      <div class="lr-copyright">&copy; {new Date().getFullYear()} Seahawks Fan Zone</div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const button = document.querySelector('.nav-toggle');
      const nav = document.getElementById('primary-nav');
      if (!button || !nav) return;
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        button.setAttribute('aria-label', `${open ? 'Open' : 'Close'} primary navigation`);
        nav.classList.toggle('is-open', !open);
      });
      nav.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', 'Open primary navigation');
          nav.classList.remove('is-open');
          button.focus();
        }
      });
      nav.addEventListener('click', (event) => {
        if (event.target.closest('a')) {
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', 'Open primary navigation');
          nav.classList.remove('is-open');
        }
      });
    })();
  </script>
  <script is:inline>
    document.querySelectorAll('[data-manage-privacy]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const opened = window.sfzPrivacy?.manage?.();
        if (!opened) window.location.assign('/privacy-policy#privacy-choices');
      });
    });
  </script>
</BaseLayout>
