# Copy to /etc/sfz-ticket-finder/dev.env or prod.env, make it root-owned mode
# 0600, and replace values as approved. Never commit the resulting file.
TICKETS_ENV=development
TICKETS_FIXTURE=false
TICKETS_PROVIDERS_JSON={}
TICKETS_LOCK_STALE_MS=1800000

# Host-side Compose settings. The service overrides TICKETS_OUTPUT_DIR to the
# container path /srv/ticket-data/current.
TICKET_DATA_ROOT=/var/lib/sfz-ticket-finder/dev
TICKET_SYNC_ENV_FILE=/etc/sfz-ticket-finder/dev.env

# Provider credentials use non-PUBLIC names and belong only in the operator
# copy. Example (leave commented until an approved adapter requires it):
# TICKETS_PROVIDER_NAME_API_KEY=
