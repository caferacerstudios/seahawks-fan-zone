# Disabled until an operator promotes a reviewed immutable browser image digest.
EVENTSPY_ENABLED=false
EVENTSPY_RUNTIME_ROOT=/srv/eventspy
EVENTSPY_MAX_ATTEMPTS_PER_GAME_PER_PACIFIC_DAY=2
EVENTSPY_NAVIGATIONS_PER_GAME_PER_RUN=1
EVENTSPY_NAVIGATION_TIMEOUT_MS=20000
EVENTSPY_RENDER_TIMEOUT_MS=15000
EVENTSPY_PARSE_TIMEOUT_MS=5000
EVENTSPY_USER_AGENT=SeahawksFanZone-EventSpyCollector/1.0 (+https://seahawksfanzone.com/about)
EVENTSPY_DATA_ROOT=./runtime/eventspy
EVENTSPY_ENV_FILE=deployment/eventspy-collector/example.env
# Compose build requires BROWSER_BASE_IMAGE=<reviewed-playwright-v1.55-family>@sha256:<digest>.
# EVENTSPY_COLLECTOR_IMAGE and TICKET_SYNC_IMAGE select immutable promoted images.
