[Unit]
Description=Seahawks Fan Zone EventSpy observation collector (%i)
Documentation=file:/home/laurawkr/seahawksfanzone-dev/source/docs/ticket-sync-deployment.md
After=docker.service
Requires=docker.service
ConditionPathIsReadWrite=/var/lib/sfz-eventspy/%i

[Service]
Type=oneshot
EnvironmentFile=/etc/sfz-eventspy/%i.env
Environment=EVENTSPY_DATA_ROOT=/var/lib/sfz-eventspy/%i
Environment=EVENTSPY_ENV_FILE=/etc/sfz-eventspy/%i.env
WorkingDirectory=/home/laurawkr/seahawksfanzone-dev
ExecStart=/usr/bin/flock --nonblock /run/lock/sfz-eventspy-%i.lock /bin/sh source/deployment/run-eventspy-collector-dev.sh %i
SuccessExitStatus=2
TimeoutStartSec=20min
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
